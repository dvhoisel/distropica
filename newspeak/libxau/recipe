NAME=libxau
VERSION=1.0.12
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto"
ABOUT="A autorização do X11: lê e escreve o ~/.Xauthority, o arquivo com o cookie que prova ao servidor que o cliente pode conectar. Duzentas linhas de C. Está aqui porque o libxcb a exige, e o libxcb existe porque o libxul.so do Firefox o tem no NEEDED. Nesta distro ela nunca autoriza nada — não há servidor — mas precisa estar montada para que a corrente feche."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXau-$VERSION.tar.xz"
SHA256=74d0e4dfa3d39ad8939e99bda37f5967aba528211076828464d2777d477fc0fb

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXau.so.6" ] || {
        echo "libxau: libXau.so.6 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
