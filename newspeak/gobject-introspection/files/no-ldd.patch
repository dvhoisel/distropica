+    def test_resolves_needed_entries(self):
+        output = """\
+/tmp/tmp-introspect/Gio-2.0: file format elf64-x86-64
+  NEEDED               libgio-2.0.so.0
+  NEEDED               libglib-2.0.so.0
+  SONAME               libnot-a-dependency.so.0
+  RUNPATH              /tmp/libalso-not-a-dependency.so.0
