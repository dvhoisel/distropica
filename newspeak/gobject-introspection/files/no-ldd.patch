 # We might need to hunt down the .lib in the compile-time path and
 # use that to figure out the name of the DLL.
 #
+def _objdump_needed(output):
+    needed = []
+    for line in output.splitlines():
+        fields = line.split()
+        # Ignore headers, SONAME, RPATH/RUNPATH and version tables: only
+        # DT_NEEDED is evidence that the inspected binary links the library.
+        if len(fields) == 2 and fields[0] == 'NEEDED':
+            needed.append(fields[1])
+    return "\n".join(needed)
+
