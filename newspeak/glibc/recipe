NAME=glibc
VERSION=2.42
KIND=source
TOOLCHAIN=cross
RETRIES=50
BUILD_DEPS="gcc binutils-cross linux-headers binutils bison gawk python"
ABOUT="A ABI glibc — o divisor de águas do Estágio 2. COMPILA com o gcc da passada 1 (verificado 2026-07-19): libc.so.6 (2.42), ld-linux-x86-64.so.2, libm/libpthread/libdl saem como ELFs válidos. python é BUILD_DEP (a glibc exige Python no build). Ressalvas: o gcc-passada-1 (feito por zig cc/clang) é flaky — ICE segfault aleatório na math; um loop de make atravessa. O único não-compilável é links-dso-program.cc (helper de teste C++; pass-1 é só C). Falta fechar: make install no rootfs, symlinks do ld.so, e a passada 2 do gcc (que traz C++ e um gcc estável)."
LICENSE="LGPL-2.1-or-later AND GPL-2.0-or-later"
SRC="https://ftp.gnu.org/gnu/glibc/glibc-$VERSION.tar.xz"
SHA256=d1775e32e4628e64ef930f435b67bb63af7599acb6be2b335b9f19f16509f17f

build() {
    tar -xJf "$DL" --strip-components=1
    # glibc exige build fora da árvore. Usa o gcc da passada 1 (CC) e o awk
    # do build (BUILD_CC=cc, o zig cc, para ferramentas que rodam no build).
    # -fno-use-linker-plugin: o gcc não passa o LTO plugin ao ld (que estático
    # não o carrega); redundante com --disable-lto do gcc, mas robusto.
    # --with-headers aponta a uapi do kernel em /usr.
    mkdir -p build && cd build
    ../configure --prefix=/usr \
        --host=x86_64-distropica-linux-gnu --build="$(../scripts/config.guess)" \
        CC="x86_64-distropica-linux-gnu-gcc -fno-use-linker-plugin" BUILD_CC=cc \
        --enable-kernel=5.4 --with-headers="$ROOT/usr/include" \
        --disable-nscd libc_cv_slibdir=/usr/lib \
        MSGFMT=:
    # retry: o gcc-passada-1 é flaky (ICE aleatório na math); cada tentativa
    # do make incremental resume de onde parou até fechar (SPEC-0005/0010).
    retry make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # O upstream instala estas ferramentas no /sbin legado. No usr-merge da
    # Distrópica, /sbin já é /usr/bin; manter as duas grafias dentro do mesmo
    # STAGE criaria claims sobrepostas. A lista explícita faz uma mudança
    # upstream falhar fechado em vez de mesclar silenciosamente outro arquivo.
    if [ ! -d "$STAGE/sbin" ] || [ -L "$STAGE/sbin" ]; then
        return 1
    fi
    if [ ! -d "$STAGE/usr" ] || [ -L "$STAGE/usr" ]; then
        return 1
    fi
    mkdir -p "$STAGE/usr/bin"
    if [ ! -d "$STAGE/usr/bin" ] || [ -L "$STAGE/usr/bin" ]; then
        return 1
    fi
    for name in ldconfig sln; do
        source=$STAGE/sbin/$name
        destination=$STAGE/usr/bin/$name
        if [ ! -f "$source" ] || [ -L "$source" ]; then
            return 1
        fi
        if [ -e "$destination" ] || [ -L "$destination" ]; then
            return 1
        fi
        mv "$source" "$destination"
    done
    rmdir "$STAGE/sbin"

    # A glibc entrega cinco utilitários que são SCRIPT, não ABI: ldd, tzselect,
    # xtrace e sotruss em '#!/bin/bash', mtrace em '#!/bin/sh'. A auditoria de
    # fechamento (SPEC-0013 §4) os acusou: os quatro de bash estavam quebrados
    # no sistema publicado — não há bash na base — e o de sh só funcionava por
    # acaso, porque alguém instalou busybox.
    #
    # A saída não é fazer a biblioteca C depender de um shell: é não entregar o
    # que não é dela. O ldd, em particular, é o que esta distro recusa como
    # ferramenta de confiança — ele é o loader executando o objeto sob suspeita
    # (SPEC-0013 §4.1). Quem quer saber de que um binário depende usa
    # `minitrue audit`, que lê sem executar.
    for auxiliar in ldd tzselect xtrace sotruss mtrace; do
        rm -f "$STAGE/usr/bin/$auxiliar"
    done

    # A glibc cria /usr/share/locale/<idioma>/LC_MESSAGES para as próprias
    # traduções, mas não há msgfmt disponível quando ela é construída — e não
    # pode haver: o gettext precisa do gcc-pass2, que precisa da glibc. Sobram
    # 39 diretórios VAZIOS, um por idioma.
    #
    # Isso não é sujeira inofensiva. Diretório vazio no mundo B vira claim de
    # ÁRVORE: prende o caminho e tudo abaixo dele. Como
    # /usr/share/locale/<idioma>/LC_MESSAGES é precisamente onde TODO pacote
    # deposita tradução, a glibc estava confiscando o diretório de traduções do
    # sistema inteiro — gettext, glib, atk, gdk-pixbuf e GTK batiam todos em
    # doublethink ali, e o pt_BR era um dos 39 confiscados.
    #
    # A regra é não reivindicar o que não se preenche. O /usr/share/locale em
    # si permanece, porque locale.alias é arquivo de verdade da glibc.
    # MSGFMT=: no configure acima é o que torna isto determinístico, e a razão
    # merece ficar escrita. A glibc NÃO PODE depender do gettext: o gettext
    # precisa do gcc-pass2, que precisa da glibc — declarar seria ciclo. Mas o
    # build dela não é hermético: ele procura msgfmt no ambiente e, no dia em
    # que o gettext entrou na árvore por causa do GTK, a glibc passou a compilar
    # 39 catálogos libc.mo que nunca compilava antes. Mesma receita, mesmo
    # fingerprint, payload diferente — decidido por acidente de ordem de build.
    #
    # ':' é o valor que o próprio configure.ac da glibc usa quando não acha a
    # ferramenta (linha 569), então isto não inventa um estado novo: fixa o
    # estado que sempre valeu aqui. Quem compila os catálogos da glibc é o
    # pacote locales, que já depende dela e PODE depender do gettext.
    mo_indevido=$(find "$STAGE/usr/share/locale" -name '*.mo' 2>/dev/null || true)
    if [ -n "$mo_indevido" ]; then
        echo "FATAL: a glibc gerou catálogo .mo; MSGFMT não foi pinado:" >&2
        echo "$mo_indevido" >&2
        exit 1
    fi
    find "$STAGE/usr/share/locale" -mindepth 1 -type d -empty -delete
    vazio=$(find "$STAGE/usr/share/locale" -mindepth 1 -type d -empty 2>/dev/null || true)
    if [ -n "$vazio" ]; then
        echo "FATAL: sobrou diretório vazio sob /usr/share/locale:" >&2
        echo "$vazio" >&2
        exit 1
    fi

    # getconf e seus nomes de ABI são instalados como hardlinks. O manifesto
    # mundo-B ainda não representa esses grupos; normalize-os para arquivos
    # regulares independentes antes de selar o payload.
    # Processe um nome por vez: em lote, separar o primeiro nome altera o nlink
    # dos demais durante a travessia e pode deixar um alias escapar.
    find "$STAGE" -type f -links +1 -exec sh -ec '
        for path do
            copy=$path.minitrue-copy
            if [ -e "$copy" ] || [ -L "$copy" ]; then
                exit 1
            fi
            cp -p "$path" "$copy"
            mv -f "$copy" "$path"
        done
    ' sh {} \;
}
