NAME=at-spi2-core
VERSION=2.62.0.1
KIND=source
TOOLCHAIN=native
DEPS="glibc glib dbus libxml2"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc gettext glib dbus libxml2"
ABOUT="A acessibilidade inteira, num pacote só: o ATK (as interfaces que um widget usa para se descrever), a PONTE atk-bridge (que publica essas descrições no D-Bus) e a libatspi (o lado de quem lê). Desde a versão 2.46 o upstream fundiu os três, e por isso ESTE PACOTE SUBSTITUI o antigo 'atk' avulso — que ficou na 2.38.0 e não existe mais em distribuição nenhuma. Quem tinha o atk instalado precisa de memoryhole antes: os dois entregam libatk-1.0.so.0 e colidiriam no manifesto. Por que está aqui: o meson.build do GTK3 exige o ATK como dependência DURA (atk_dep), e o GIMP, o Inkscape, o atkmm e o WebKitGTK o pedem por nome. A ponte atk-bridge vem no mesmo pacote do upstream; o GTK3 só a carrega no backend X11, que nesta árvore está desligado desde que o Firefox saiu. Sem X11 aqui dentro (-Dx11=disabled): o at-spi2 usa o X só para atalhos globais de teclado, que não fazem sentido sem servidor. Sem systemd, sem introspection, sem gtk2_atk_adaptor. Uma armadilha de opção que custou um build: 'dbus_broker' NÃO é booleano, é uma string com o CAMINHO do executável, e passar -Ddbus_broker=false faz o meson entender que o broker está em um programa chamado 'false', exigir systemd por causa dele e abortar. O jeito de não ter broker é -Ddefault_bus=dbus-daemon, que deixa o caminho vazio e o systemd desnecessário. Vale a mesma lição do libdisplay-info: ler o meson_options.txt antes de supor o tipo."
LICENSE=LGPL-2.1-or-later
SRC="https://download.gnome.org/sources/at-spi2-core/2.62/at-spi2-core-$VERSION.tar.xz"
SHA256="fa462f1834bae569c5944c34608872f9447e5a2889ba2aa4d5ff9f2d6ff8a395"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dx11=disabled \
        -Duse_systemd=false \
        -Dintrospection=disabled \
        -Dgtk2_atk_adaptor=false \
        -Ddocs=false \
        -Ddefault_bus=dbus-daemon \
        -Datk_only=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # As TRÊS peças, conferidas uma a uma porque cada uma tem um consumidor
    # diferente e a falta de qualquer delas quebra em lugar distinto.
    # O atk é o que o GTK3 pede sempre; a ponte é o que o backend X11 pede; a
    # libatspi é o que um leitor de tela usaria.
    [ -e "$STAGE/usr/lib/libatk-1.0.so.0" ] || {
        echo "at-spi2-core: libatk-1.0.so.0 não foi produzida (atk_only?)" >&2
        exit 1
    }
    [ -e "$STAGE/usr/lib/libatk-bridge-2.0.so.0" ] || {
        echo "at-spi2-core: a ponte libatk-bridge não foi produzida" >&2
        exit 1
    }
    [ -e "$STAGE/usr/lib/libatspi.so.0" ] || {
        echo "at-spi2-core: libatspi.so.0 não foi produzida" >&2
        exit 1
    }
    # O .pc é o que o meson do GTK3 procura pelo nome exato 'atk-bridge-2.0';
    # sem ele o build de lá para na configuração, não no link.
    for pc in atk atk-bridge-2.0 atspi-2; do
        [ -e "$STAGE/usr/lib/pkgconfig/$pc.pc" ] || {
            echo "at-spi2-core: $pc.pc não foi instalado" >&2
            exit 1
        }
    done
    find "$STAGE" -type d -empty -delete
}
