NAME=libxrender
VERSION=0.9.12
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto glibc libx11"
ABOUT="A extensão Render: composição com canal alfa e antialiasing do lado do servidor X. Foi ela que, em 2000, tornou possível texto suavizado no X — e é sobre ela que o cairo desenhava antes do Wayland. Nesta distro o cairo desenha em memória e no Wayland; a libXrender está aqui só porque o libxul.so a nomeia e porque libXcursor e libXrandr dependem dela."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXrender-$VERSION.tar.xz"
SHA256=b832128da48b39c8d608224481743403ad1691bf4e554e4be9c174df171d1b97

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXrender.so.1" ] || {
        echo "libxrender: libXrender.so.1 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
