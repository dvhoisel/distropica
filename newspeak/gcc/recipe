NAME=gcc
VERSION=15.3.0
KIND=source
DEPS="binutils gmp mpfr mpc"
BUILD_DEPS="linux-headers gawk"
ABOUT="FRONTEIRA. O compilador C/C++ da passada 1 (cross, --without-headers). gawk 5.3.2 é BUILD_DEP (o 5.4.1 gera options.cc malformado); gcov-tool isolado de LANGUAGES; cc1 estático (LDFLAGS=-static). A versão c-only DESTA config compilou sob zig cc e a glibc 2.42 saiu dela. RESSALVA (2026-07-19): reconfigurar para c,c++ é a config correta p/ a passada 2, mas o rebuild falha quando a GLIBC JÁ ESTÁ INSTALADA — a configure do GCC passa a mis-detectar rlim_t/sbrk/strsignal e gera auto-host.h que colide com os headers musl do zig cc (build/gengenrtl.o). Causa estrutural: falta isolar o build da toolchain num sysroot separado (à la /tools do LFS), senão a glibc do sistema contamina a configure. Ver SPEC-0005 §4."
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/gcc/gcc-$VERSION/gcc-$VERSION.tar.xz"
SHA256=fa59c1beef8995f27c4d71c1df227587189315d3e6faff1bb4306e61b0c530eb

build() {
    tar -xJf "$DL" --strip-components=1
    # Isola o gcov-tool da passada 1 (retira-o de LANGUAGES): seu
    # libgcov-driver-tool.o compila um .c com o compilador C++, e o zig c++
    # (clang) compila .c como C — quebra nos headers C++ do gcc (system.h:
    # 'class'). g++ forçaria C++; não vale patchar isso na passada 1, onde o
    # gcov-tool nem é necessário. gcov e gcov-dump continuam.
    sed -i 's/ gcov-tool\$(exeext)//' gcc/Makefile.in
    # As três libs matemáticas são achadas em /usr via --with-* (zig cc não
    # busca /usr por conta própria). --disable-bootstrap: um estágio só, com o
    # zig cc como compilador semente. --without-headers/--with-newlib: constrói
    # o compilador + libgcc estático sem depender de um libc-alvo que ainda não
    # existe. --disable-lto: sem o LTO plugin (liblto_plugin.so), que o ld
    # estático não consegue carregar (dlopen) — e a passada 1 não usa LTO.
    # Passo seguinte da cadeia: glibc compilada com este gcc, e então
    # uma passada 2 (linguagens c,c++, sem --without-headers) hospedada na glibc.
    mkdir -p build && cd build
    ../configure --prefix=/usr \
        --target=x86_64-distropica-linux-gnu \
        --disable-bootstrap --disable-multilib --disable-nls \
        --disable-shared --disable-threads --disable-lto \
        --without-headers --with-newlib --enable-languages=c,c++ \
        --with-gmp="$ROOT/usr" --with-mpfr="$ROOT/usr" --with-mpc="$ROOT/usr" \
        --disable-dependency-tracking
    # LDFLAGS=-static: o cc1/xgcc linkam estáticos, para rodarem no rootfs
    # (que não tem loader musl instalado; o resto do sistema é estático).
    # SELFTEST_TARGETS=: desliga o self-test do all-gcc (a passada 1 não o
    # roda, à la LFS) — ele tentaria executar o cc1 durante o build.
    # c,c++: build o compilador (cc1 + cc1plus) e a libgcc mínima. libstdc++
    # NÃO entra aqui (--without-headers); vem depois, com a glibc instalada.
    make -j"$JOBS" all-gcc all-target-libgcc LDFLAGS=-static SELFTEST_TARGETS=
    make install-gcc install-target-libgcc DESTDIR="$STAGE" SELFTEST_TARGETS=
}
