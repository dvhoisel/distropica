NAME=libxcursor
VERSION=1.2.3
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxrender libxfixes"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto glibc libx11 libxrender libxfixes gawk"
ABOUT="Os cursores do X11: carrega temas de cursor do disco e os envia ao servidor. No Wayland esse papel é da libwayland-cursor, que já está na árvore e que o weston usa. Entra pelo NEEDED do libxul.so."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXcursor-$VERSION.tar.xz"
SHA256=fde9402dd4cfe79da71e2d96bb980afc5e6ff4f8a7d74c159e1966afb2b2c2c0

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXcursor.so.1" ] || {
        echo "libxcursor: libXcursor.so.1 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
