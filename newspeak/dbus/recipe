NAME=dbus
VERSION=1.16.2
KIND=source
TOOLCHAIN=native
DEPS="glibc expat busybox"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf"
ABOUT="Barramento de mensagens entre processos. Entra por necessidade e não por gosto — foi ele que evitei ao desligar o X11 no GTK3, o que dispensou o atk-bridge e o at-spi2 inteiros. Mas o iwd só fala D-Bus: a API dele não é biblioteca nem socket próprio, é uma árvore de objetos no barramento do sistema, e a ferramenta gráfica conversa com o daemon por ali. Não havia como ter Wi-Fi gerenciável sem isto. Sem systemd, que esta distro não tem e não pretende ter, e por isso também sem user_session e sem a ativação por unidade — a ativação tradicional, por fork do próprio daemon, é a que resta e a que funciona aqui. Sem SELinux, AppArmor e libaudit, que são camadas de política que a árvore não usa; sem x11_autolaunch, que existiria para descobrir o barramento pela sessão X. As políticas em /etc/dbus-1 são padrão de fábrica, e é nelas que o iwd instala a sua."
LICENSE="AFL-2.1 OR GPL-2.0-or-later"
SRC="https://dbus.freedesktop.org/releases/dbus/dbus-$VERSION.tar.xz"
SHA256=0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --buildtype=release \
        -Dsystemd=disabled \
        -Duser_session=false \
        -Dselinux=disabled \
        -Dapparmor=disabled \
        -Dlibaudit=disabled \
        -Dx11_autolaunch=disabled \
        -Dlaunchd=disabled \
        -Dkqueue=disabled \
        -Ddoxygen_docs=disabled \
        -Dducktype_docs=disabled \
        -Dxml_docs=disabled \
        -Dmodular_tests=disabled \
        -Dmessage_bus=true \
        -Dtraditional_activation=true
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    [ -x "$STAGE/usr/bin/dbus-daemon" ] || {
        echo "dbus: dbus-daemon não foi produzido" >&2
        exit 1
    }
    # O socket do sistema e o diretório de máquina são estado de execução, não
    # payload: nascem no boot, e reivindicá-los faria o manifesto discordar do
    # disco no primeiro start.
    rm -rf "$STAGE/var/run" "$STAGE/var/lib/dbus"

    mkdir -p "$STAGE/etc/rc.d/rcS.d"
    cat > "$STAGE/etc/rc.d/rcS.d/06-dbus.sh" <<'DBUSDROP'
# Drop-in de inicializacao: o barramento do sistema. Sourced pelo rcS do base.
#
# ESTE ARQUIVO NAO EXISTIA, e a falta so aparecia no fim da cadeia: o pacote
# instalava o dbus-daemon, o iwd instalava a politica dele em
# /usr/share/dbus-1/system.d, o iwgtk aparecia no painel — e clicar no icone
# nao abria nada. O iwgtk pergunta pelo nome net.connman.iwd no barramento do
# sistema, nao acha barramento nenhum, e sai. O binario ate carrega a string
# "iwd is down" para esse caso. Nada falha em voz alta em lugar nenhum.
#
# Tres coisas sao criadas AQUI e nao no pacote:
#
# 1. A CONTA 'messagebus'. O /usr/share/dbus-1/system.conf diz
#    <user>messagebus</user>: o daemon comeca como root, abre o socket e larga
#    privilegio para essa conta. Sem ela ele sai com "Failed to change to
#    user". Conta e estado do admin e nenhum pacote a reivindica no manifesto —
#    mesmo argumento do sshd.
# 2. O /run/dbus. O system.conf aponta o socket e o pidfile para la, e o /run e
#    tmpfs montado do zero a cada boot.
# 3. O machine-id, que ja veio do 01-machine-id.sh. Por isso este drop-in e 06
#    e nao 00: o dbus-daemon RECUSA subir sem /etc/machine-id ou
#    /var/lib/dbus/machine-id.
if [ -x /usr/bin/dbus-daemon ]; then
    if ! grep -q '^messagebus:' /etc/passwd 2>/dev/null; then
        # 81 e o uid/gid que a maioria das distros usa para esta conta.
        echo 'messagebus:x:81:81:D-Bus message bus:/run/dbus:/sbin/nologin' \
            >> /etc/passwd
        grep -q '^messagebus:' /etc/group 2>/dev/null ||
            echo 'messagebus:x:81:' >> /etc/group
        echo "distropica: conta do barramento D-Bus criada"
    fi
    # 'wheel' e 'netdev' sao citados pelas POLITICAS: o system.conf do proprio
    # dbus da wheel poder de administrar o barramento, e o iwd-dbus.conf do iwd
    # da netdev poder de falar com o daemon de Wi-Fi. Sem os grupos existirem, o
    # dbus reclama "Unknown group" a cada boot e a regra correspondente vira
    # letra morta. Sao criados vazios: nesta distro so ha a conta root, que
    # nao precisa de grupo para nada — o que se ganha e a politica passar a
    # significar o que diz, e o log parar de acusar defeito que nao ha.
    for grupo_nome in wheel:97 netdev:98; do
        grep -q "^${grupo_nome%%:*}:" /etc/group 2>/dev/null ||
            echo "${grupo_nome%%:*}:x:${grupo_nome##*:}:" >> /etc/group
    done
    unset grupo_nome
    mkdir -p /run/dbus
    chown root:root /run/dbus 2>/dev/null || true
    chmod 0755 /run/dbus

    # O QUE DECIDE SE SUBIU E O SOCKET, E NAO O STATUS DE SAIDA. Esta linha ja
    # foi 'if dbus-daemon --system --fork 2>/dev/null; then echo iniciado', e
    # ela MENTIA duas vezes:
    #
    #   1. O --fork faz o processo pai sair assim que termina o fork, ANTES de o
    #      filho abrir o socket e antes de ele poder falhar. Medido: status 0 e
    #      /run/dbus vazio cinco segundos depois. O 'iniciado' saia no console
    #      com o barramento inexistente.
    #   2. O 2>/dev/null jogava fora a unica coisa que diria POR QUE. Foi essa
    #      redirecao que me obrigou a caçar o defeito por eliminacao em vez de
    #      ler a mensagem.
    #
    # Agora o erro vai para o console junto com o resto do boot, e a espera e
    # pelo arquivo que importa. Trinta tentativas de 100ms: o daemon abre o
    # socket em alguns milissegundos numa maquina real, e tres segundos e folga
    # para o pior caso sob emulacao sem aceleracao.
    /usr/bin/dbus-daemon --system --fork
    espera=0
    while [ ! -S /run/dbus/system_bus_socket ] && [ "$espera" -lt 30 ]; do
        espera=$((espera + 1))
        sleep 0.1
    done
    if [ -S /run/dbus/system_bus_socket ]; then
        echo "distropica: barramento D-Bus do sistema iniciado"
    else
        echo "distropica: D-Bus do sistema NAO subiu; sem ele nao ha Wi-Fi" >&2
        echo "            gerenciavel — o iwgtk abre e nao acha o iwd" >&2
    fi
    unset espera
fi
DBUSDROP
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/06-dbus.sh"
    find "$STAGE" -type d -empty -delete
}
