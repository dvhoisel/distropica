NAME=python-cssselect
VERSION=1.5.0
KIND=source
TOOLCHAIN=native
DEPS="python-glibc"
BUILD_DEPS="python-glibc busybox findutils"
ABOUT="Tradução de seletores CSS para XPath, Python puro. Entra porque o inkex do Inkscape o importa em inkex/css/parser.py e inkex/css/compiler.py, que são como as extensões acham elementos por seletor; é também o que faz o lxml.cssselect funcionar."
LICENSE=BSD-3-Clause
SRC="https://files.pythonhosted.org/packages/8e/5a/6d6fcf922709391fac986f0a03ad4546f4f45b94d10aeb6c1ee041599993/cssselect-$VERSION.tar.gz"
SHA256=3cbe82dd7acbee9ba9e5723b5f9e4749826912f1fb31cd7f92aabed5fde15b15

build() {
    tar -xzf "$DL" --strip-components=1
    sitedir=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
    install -dm755 "$STAGE$sitedir"
    cp -a cssselect "$STAGE$sitedir/"
    find "$STAGE$sitedir/cssselect" -type d -name __pycache__ -exec rm -rf {} +
    # O mínimo da PEP 566, pela mesma razão do python-markupsafe: sem o
    # dist-info, importlib.metadata não reconhece o pacote.
    install -dm755 "$STAGE$sitedir/cssselect-$VERSION.dist-info"
    cat > "$STAGE$sitedir/cssselect-$VERSION.dist-info/METADATA" <<METADATA
Metadata-Version: 2.1
Name: cssselect
Version: $VERSION
METADATA
    chmod 644 "$STAGE$sitedir/cssselect-$VERSION.dist-info/METADATA"
    install -Dm644 LICENSE "$STAGE/usr/share/licenses/python-cssselect/LICENSE"
    python3 -c "
import sys; sys.path.insert(0, '$STAGE$sitedir')
import cssselect, importlib.metadata as m
assert m.version('cssselect') == '$VERSION', m.version('cssselect')
" || { echo "python-cssselect: o módulo não importa" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
