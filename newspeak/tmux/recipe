NAME=tmux
VERSION=3.7b
KIND=source
TOOLCHAIN=native
DEPS="glibc ncurses libevent"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
# bison: o configure do tmux ABORTA sem yacc — `as_fn_error $? "\"yacc not
# found\""`, linha 6133 do configure pinado, e não é um aviso: o cmd-parse.y é
# gerado, não vem pronto no tarball. Quem instala /usr/bin/yacc nesta árvore é o
# bison, conferido no manifest dele. O caminho existia na raiz e mesmo assim
# faltava aqui, porque a view se monta do que a receita DECLARA — a mesma lição
# do hwdata.pc no wlroots, três horas antes.
#
# O candidato que o autoconf procura é `'bison -y' byacc`, com aspas e argumento,
# e é por isso que grep ingênuo não encontra: quem varrer atrás desta classe tem
# de partir o candidato antes do espaço.
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf gawk bison findutils"
ABOUT="Multiplexador de terminal, e ele ganhou razão de existir junto com o openssh e o minicom que entraram na mesma leva: uma sessão que sobrevive à queda da conexão deixa de ser conforto quando o acesso à máquina é por SSH numa rede ruim ou por serial numa placa que reinicia. Sem ele, ligação caída é trabalho perdido. Também é o que torna o console serial utilizável para mais de uma coisa ao mesmo tempo, num sistema cujo modo gráfico pode nem ter subido. Depende da libevent, que entrou nesta árvore exclusivamente por causa dele."
LICENSE="ISC AND BSD-2-Clause AND BSD-3-Clause"
SRC="https://github.com/tmux/tmux/releases/download/$VERSION/tmux-$VERSION.tar.gz"
SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --sysconfdir=/etc --disable-utf8proc
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -x "$STAGE/usr/bin/tmux" ] || {
        echo "tmux: o binario nao foi produzido" >&2; exit 1;
    }
    # As DUAS bibliotecas que decidem se ele funciona: sem a libevent ele nao
    # multiplexa, sem o ncurses ele nao desenha. Conferir o .pc nao pega o caso
    # de o configure ter achado uma e nao a outra.
    #
    # Sao duas condicoes DIFERENTES e por isso duas conferencias, nao um laco.
    # A primeira versao disto varria 'libevent libtinfo libncurses' num for com
    # um 'continue' para o ultimo caso, o que na pratica EXIGIA a libtinfo e
    # tornava a libncurses opcional — o oposto da intencao escrita no
    # comentario, que era exigir uma das duas. Aqui passaria por sorte, porque
    # o ncurses desta arvore e --with-termlib=tinfo e o tmux acaba na libtinfo;
    # mas uma arvore sem termlib separada teria sido reprovada com o binario
    # correto na mao. Mesmo erro que o minicom cometeu, e pela mesma razao:
    # 'biblioteca de terminal' aqui e libtinfo OU libncurses, e o sufixo 'w'
    # das variantes wide entra pelo casamento parcial.
    ligacoes=$(readelf -dW "$STAGE/usr/bin/tmux" 2>/dev/null | grep NEEDED)
    printf '%s\n' "$ligacoes" | grep -q 'libevent' || {
        echo "tmux: o binario nao referencia a libevent — sem ela nao multiplexa" >&2
        printf '%s\n' "$ligacoes" >&2
        exit 1
    }
    printf '%s\n' "$ligacoes" | grep -qE 'libtinfo|libncurses' || {
        echo "tmux: o binario nao referencia biblioteca de terminal" >&2
        printf '%s\n' "$ligacoes" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
