NAME=tmux
VERSION=3.7b
KIND=source
TOOLCHAIN=native
DEPS="glibc ncurses libevent"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf"
ABOUT="Multiplexador de terminal, e ele ganhou razão de existir junto com o openssh e o minicom que entraram na mesma leva: uma sessão que sobrevive à queda da conexão deixa de ser conforto quando o acesso à máquina é por SSH numa rede ruim ou por serial numa placa que reinicia. Sem ele, ligação caída é trabalho perdido. Também é o que torna o console serial utilizável para mais de uma coisa ao mesmo tempo, num sistema cujo modo gráfico pode nem ter subido. Depende da libevent, que entrou nesta árvore exclusivamente por causa dele."
LICENSE="ISC AND BSD-2-Clause AND BSD-3-Clause"
SRC="https://github.com/tmux/tmux/releases/download/$VERSION/tmux-$VERSION.tar.gz"
SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --sysconfdir=/etc --disable-utf8proc
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -x "$STAGE/usr/bin/tmux" ] || {
        echo "tmux: o binario nao foi produzido" >&2; exit 1;
    }
    # As DUAS bibliotecas que decidem se ele funciona: sem a libevent ele nao
    # multiplexa, sem o ncurses ele nao desenha. Conferir o .pc nao pega o caso
    # de o configure ter achado uma e nao a outra.
    for lib in libevent libtinfo libncurses; do
        readelf -dW "$STAGE/usr/bin/tmux" 2>/dev/null | grep -q "NEEDED.*$lib" && continue
        [ "$lib" = libncurses ] && continue
        echo "tmux: o binario nao referencia $lib" >&2
        readelf -dW "$STAGE/usr/bin/tmux" 2>/dev/null | grep NEEDED >&2
        exit 1
    done
    find "$STAGE" -type d -empty -delete
}
