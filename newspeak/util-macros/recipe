NAME=util-macros
VERSION=1.20.2
KIND=source
TOOLCHAIN=native
DEPS=""
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf gawk"
ABOUT="As macros de autoconf que TODA biblioteca do X.Org usa e nenhuma carrega. Instala um único arquivo, xorg-macros.m4, com XORG_DEFAULT_OPTIONS e companhia; sem ele o autoreconf de libX11, libXext e das outras dez para com 'macro XORG_DEFAULT_OPTIONS not found' e o configure sai vazio. Não produz biblioteca nem binário, só o .m4 e o .pc que o aclocal encontra — é BUILD_DEPS de todas elas e DEPS de nenhuma. Primeira peça da corrente X11 que existe aqui por uma razão só: o binário oficial do Firefox tem libX11 e outras dez no NEEDED, ligação dura, e sem elas o carregador dinâmico recusa o libxul.so antes de qualquer janela existir."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/util/util-macros-$VERSION.tar.xz"
SHA256=9ac269eba24f672d7d7b3574e4be5f333d13f04a7712303b1821b2a51ac82e8e

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/share/aclocal/xorg-macros.m4" ] || {
        echo "util-macros: xorg-macros.m4 não foi instalado" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
