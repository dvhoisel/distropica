NAME=libstdcxx
VERSION=15.3.0
KIND=source
TOOLCHAIN=cross
RETRIES=50
# Scaffolding: existe só para o pass-1 g++ conseguir LINKAR C++ e construir o
# gcc-pass2. A libstdc++ FINAL é a que o próprio gcc-pass2 constrói (target-lib).
# PROVISIONAL faz esta libstdc++ ceder à do gcc-pass2 sem doublethink. SPEC-0005 §4.
PROVISIONAL=1
DEPS="glibc"
# gawk: o `./configure` desta fonte chama awk para gerar o config.status, e
# declarar só `busybox` NÃO garante awk — o gawk supersede o busybox e leva
# /usr/bin/awk embora. A falta só aparece quando o gawk já foi construído no
# mesmo plano, então a quebra é sensível à ordem. Conferido no próprio
# configure da fonte pinada, não suposto.
BUILD_DEPS="gcc binutils-cross make busybox gawk"
ABOUT="A libstdc++ (runtime C++), do subdir libstdc++-v3 do fonte do gcc, buildada pelo gcc da passada 1 AGORA que a glibc existe (headers presentes). É o elo que faltava entre a passada 1 (--without-headers: tem cc1plus mas nenhuma libstdc++) e a passada 2: sem uma libstdc++, o pass-1 g++ compila C++ mas não LINKA, então não conseguiria buildar o gcc, que é C++. Ordem LFS 5.7 (glibc → libstdc++ → gcc final)."
LICENSE="GPL-3.0-or-later WITH GCC-exception-3.1"
SRC="https://ftp.gnu.org/gnu/gcc/gcc-$VERSION/gcc-$VERSION.tar.xz"
SHA256=fa59c1beef8995f27c4d71c1df227587189315d3e6faff1bb4306e61b0c530eb
# Chave extraída do keyring oficial https://ftp.gnu.org/gnu/gnu-keyring.gpg;
# signer observado 7F74F97C103468EE5D750B583AB00996FC26A641, primária abaixo.
SIG_1="https://ftp.gnu.org/gnu/gcc/gcc-15.3.0/gcc-15.3.0.tar.xz.sig"
SIG_EPOCH_1=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=13975A70E63C361C73AE69EF6EEB81F8981C74C7

build() {
    tar -xJf "$DL" --strip-components=1
    mkdir -p build && cd build
    # O gcc da passada 1 é --without-headers: seu path de include é só o dele
    # (/usr/lib/gcc/.../include), NÃO /usr/include (glibc), e ele não acha os
    # startfiles em /usr/lib. Aponta os três explicitamente (verificado
    # 2026-07-20: -I p/ headers glibc, -B p/ crt1.o/crti.o, -L p/ libc). É
    # por-receita de propósito — não se mexe no build da glibc, que já é
    # reprodutível. (O conserto estrutural seria rebuildar a passada 1 com
    # sysroot; fica para depois.)
    export CFLAGS="-I/usr/include -B/usr/lib -L/usr/lib"
    export CXXFLAGS="$CFLAGS"
    export LDFLAGS="-B/usr/lib -L/usr/lib"
    # Configura só o subdir libstdc++-v3 (não o gcc inteiro), como cross-host:
    # o CC/CXX é o gcc da passada 1 (perfil cross), que já produz binários glibc.
    # --disable-libstdcxx-pch: PCH atrasa e não é essencial na base.
    ../libstdc++-v3/configure --prefix=/usr \
        --host=x86_64-distropica-linux-gnu --build="$(../config.guess)" \
        --disable-multilib --disable-nls --disable-libstdcxx-pch \
        --disable-dependency-tracking
    # retry: o gcc-passada-1 (feito por clang) é flaky ao COMPILAR (ICE); o
    # make incremental resume a cada tentativa (SPEC-0005/0010).
    retry make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # Reconcilia lib64→lib: o gcc x86_64 instala a libstdc++ em /usr/lib64, mas
    # o sistema é /usr/lib (a glibc forçou libc_cv_slibdir=/usr/lib). Sem isto a
    # libstdc++ fica em lib64 e o shim g++ do gcc-pass2 (-L/usr/lib) não a acha
    # ("C++ compiler cannot create executables"). Achado no E2-clean — o rootfs
    # sujo tinha a libstdc++ copiada à mão em /usr/lib, o que mascarava.
    if [ -d "$STAGE/usr/lib64" ]; then
        mkdir -p "$STAGE/usr/lib"
        cp -a "$STAGE/usr/lib64/." "$STAGE/usr/lib/"
        rm -rf "$STAGE/usr/lib64"
    fi
}
