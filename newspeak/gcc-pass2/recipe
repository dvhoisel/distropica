NAME=gcc-pass2
VERSION=15.3.0
KIND=source
TOOLCHAIN=cross
RETRIES=100
SUPERSEDES="gcc libstdcxx"
DEPS="linux-headers glibc mathlibs-glibc zlib binutils-glibc busybox"
BUILD_DEPS="gcc binutils-cross libstdcxx"
ABOUT="O gcc NATIVO da passada 2 (c,c++, GCC 15.3.0, hospedado na glibc) — o fecho do Estágio 2 (SPEC-0005 §4, vencido 2026-07-20). Construído pelo gcc da passada 1 (cross), com a glibc, os mathlibs-glibc e o binutils-glibc já presentes. Produz gcc/g++ nativos que compilam e rodam C e C++/STL sem shims. Oito muros vencidos na investigação, todos aqui codificados: (1) triple nativo build=host=target=distropica (senão a configure exige um g++ de build sem prefixo); (2/3) shims que injetam /usr no pass-1 gcc/g++, com -isystem (buscado após os -I do pacote, senão o obstack.h da glibc sombreia o da libiberty); (4) SELFTEST_TARGETS= (o pass-1 é flaky); (5) mathlibs+binutils glibc (DEPS/BUILD_DEPS acima); (6) mathlibs com -std=gnu17 (na receita mathlibs-glibc); (7/8) --disable-lto (o plugin depende do binutils-glibc, e o LTO fica off por opção, coerente com o pass-1). SUPERSEDE o gcc-passada-1 nos mesmos caminhos (cross-gcc, cc1/cc1plus em /usr/libexec) — colisão = dívida de 'fingerprint de build' (§4)."
# O payload reúne compilador GPL, runtimes com GCC Runtime Library Exception,
# manuais GFDL e componentes compiler-rt/BSD. Até existir SBOM arquivo a
# arquivo, uma expressão agregada manual seria uma falsa precisão.
LICENSE=NOASSERTION
SRC="https://ftp.gnu.org/gnu/gcc/gcc-15.3.0/gcc-15.3.0.tar.xz"
SHA256=fa59c1beef8995f27c4d71c1df227587189315d3e6faff1bb4306e61b0c530eb

build() {
    # Shims do pass-1 gcc/g++ injetando os paths /usr. O g++ precisa dos dirs
    # da libstdc++ ANTES de /usr/include (por causa do #include_next de
    # <cstdlib>), na ordem -isystem. Cobre as invocações de host E de build
    # (CC_FOR_BUILD) transparentemente — o que flags-por-fase não fariam.
    # -Wl,-rpath-link,/usr/lib: o ld do pass-1 gcc não conhece /usr, e ao
    # linkar um programa CONTRA os mathlibs (libmpc → libm.so.6, sqrt) precisa
    # resolver o dep transitivo — o -L cobre só o -l direto. Sem isso, o teste
    # de gmp/mpfr/mpc da configure do gcc falha ("requires GMP 4.2+"). Achado
    # ao rodar o E2 pelo rectify (o build manual não batia neste teste).
    mkdir -p "$WORK/.tc"
    cat > "$WORK/.tc/x86_64-distropica-linux-gnu-gcc" <<'SHIM'
#!/bin/sh
exec /usr/bin/x86_64-distropica-linux-gnu-gcc -isystem /usr/include -B/usr/lib -L/usr/lib -Wl,-rpath-link,/usr/lib "$@"
SHIM
    cat > "$WORK/.tc/x86_64-distropica-linux-gnu-g++" <<SHIM
#!/bin/sh
exec /usr/bin/x86_64-distropica-linux-gnu-g++ -isystem /usr/include/c++/$VERSION -isystem /usr/include/c++/$VERSION/x86_64-distropica-linux-gnu -isystem /usr/include -B/usr/lib -L/usr/lib -Wl,-rpath-link,/usr/lib "\$@"
SHIM
    chmod +x "$WORK/.tc"/*
    export PATH="$WORK/.tc:$PATH"

    tar -xJf "$DL" --strip-components=1
    mkdir -p build && cd build
    # build=host=target=distropica: build NATIVO puro (a máquina, sob o chroot,
    # É distropica) — evita a exigência de um compilador de build sem prefixo.
    # --disable-lto: o LTO fica off (coerente com o pass-1). --with-gmp=/usr:
    # os mathlibs agora são glibc, sem contaminar (o gcc é nativo glibc).
    ../configure --prefix=/usr \
        --build=x86_64-distropica-linux-gnu --host=x86_64-distropica-linux-gnu \
        --target=x86_64-distropica-linux-gnu \
        --enable-languages=c,c++ --disable-multilib --disable-bootstrap \
        --disable-nls --disable-lto --enable-shared --enable-threads=posix \
        --with-gmp=/usr --with-mpfr=/usr --with-mpc=/usr \
        --with-system-zlib \
        --disable-dependency-tracking
    # SELFTEST_TARGETS=: o selftest roda o cc1 recém-feito; o pass-1 é flaky.
    retry make -j"$JOBS" SELFTEST_TARGETS=
    # A imagem mínima precisa do compilador, não de ~750 MiB de DWARF nos
    # executáveis cc1/cc1plus. O target upstream preserva os binários e
    # bibliotecas de desenvolvimento, removendo apenas símbolos de depuração;
    # um pacote -dbg separado poderá conservá-los no futuro.
    make install-strip DESTDIR="$STAGE" SELFTEST_TARGETS=

    # Reconcilia lib64→lib: o gcc x86_64 instala libstdc++/libgcc_s em
    # /usr/lib64; a glibc fixou /usr/lib (libc_cv_slibdir). Move para bater.
    if [ -d "$STAGE/usr/lib64" ]; then
        mkdir -p "$STAGE/usr/lib"
        cp -a "$STAGE/usr/lib64/." "$STAGE/usr/lib/"
        rm -rf "$STAGE/usr/lib64"
    fi

    # Make e muitos configure scripts usam o nome POSIX `cc`. O upstream
    # instala gcc/g++/c++, mas não esse alias; o buildbase deve funcionar sem
    # exigir que cada projeto conheça a escolha concreta do compilador C.
    ln -s gcc "$STAGE/usr/bin/cc"

    # Como no pass-1, descarte apenas o scaffolding vazio criado por
    # `installdirs`; diretórios que contêm payload permanecem no STAGE.
    find "$STAGE" -mindepth 1 -depth -type d -empty -delete

    # O GCC instala os nomes nativo, prefixado e versionado do driver como
    # hardlinks. O manifesto mundo-B ainda não representa esses grupos; sele
    # cada alias como arquivo regular independente antes de empacotar. Um nome
    # por execução evita que a alteração de nlink deixe um alias escapar.
    find "$STAGE" -type f -links +1 -exec sh -ec '
        for path do
            copy=$path.minitrue-copy
            if [ -e "$copy" ] || [ -L "$copy" ]; then
                exit 1
            fi
            cp -p "$path" "$copy"
            mv -f "$copy" "$path"
        done
    ' sh {} \;
}
