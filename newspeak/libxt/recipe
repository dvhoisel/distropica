NAME=libxt
VERSION=1.3.1
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libice libsm libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto libx11 libice libsm"
ABOUT="A biblioteca Xt Intrinsics. A libXmu a exige e o GIMP exige libXmu porque o gtk+-3.0.pc desta árvore anuncia X11 além de Wayland. Testes e especificações não entram no payload."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXt-$VERSION.tar.xz"
SHA256=e0a774b33324f4d4c05b199ea45050f87206586d81655f8bef4dba434d931288

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --disable-specs --disable-unit-tests --without-xmlto --without-fop \
        --without-xsltproc --without-perl --without-glib
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libXt.so.6" ] || { echo "libxt: libXt.so.6 ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
