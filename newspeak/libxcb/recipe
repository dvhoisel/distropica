NAME=libxcb
VERSION=1.17.0
KIND=source
TOOLCHAIN=native
DEPS="glibc libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto xcb-proto python-glibc libxau libxdmcp"
ABOUT="A ligação binária moderna com o protocolo X11 — a que o libX11 usa por baixo desde 2008 e a que o Firefox lista diretamente no NEEDED, tanto libxcb.so.1 quanto libxcb-shm.so.0. Quase todo o seu código é GERADO no build pelo c_client.py do xcb-proto a partir dos XMLs; o que vem no tarball é a máquina de conexão e o despacho de eventos. Produz uma dúzia de .so pequenas (xcb-shm, xcb-render, xcb-randr…) porque cada extensão do protocolo vira uma biblioteca. Sem --enable-xinput as extensões de entrada não saem, e o libXi de mais adiante precisa delas."
LICENSE=MIT
SRC="https://xcb.freedesktop.org/dist/libxcb-$VERSION.tar.xz"
SHA256=599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --enable-xinput --enable-xkb --without-doxygen
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    # As duas que o libxul.so nomeia. Conferir só a libxcb.so.1 deixaria passar
    # um build sem as extensões, que falha no carregamento do Firefox e não aqui.
    for so in libxcb.so.1 libxcb-shm.so.0 libxcb-render.so.0 libxcb-randr.so.0; do
        [ -e "$STAGE/usr/lib/$so" ] || {
            echo "libxcb: $so não foi produzida" >&2
            exit 1
        }
    done
    find "$STAGE" -type d -empty -delete
}
