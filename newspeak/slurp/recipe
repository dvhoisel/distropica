NAME=slurp
VERSION=1.5.0
KIND=source
TOOLCHAIN=native
DEPS="glibc wayland cairo libxkbcommon"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf wayland-protocols scdoc busybox findutils"
ABOUT="Seleção de região na tela para Wayland: desenha um retângulo com o rato e imprime a geometria. É a metade interativa da captura de tela — o grim recorta o que o slurp devolve —, e serve a qualquer outro comando que precise de um ponto ou de uma área. Cliente wlr-layer-shell puro, desenhado com cairo; sem toolkit, como o foot."
LICENSE=MIT
SRC="https://github.com/emersion/slurp/releases/download/v$VERSION/slurp-$VERSION.tar.gz"
SHA256=eeb282b2adc8db5614b852596340b69da6f3954cf6cfbdc4392da509c934208a

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dman-pages=enabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -x "$STAGE/usr/bin/slurp" ] || { echo "slurp: o binário não foi produzido" >&2; exit 1; }
    for lib in libcairo libxkbcommon libwayland-client libwayland-cursor; do
        readelf -d "$STAGE/usr/bin/slurp" | grep -q "$lib" || {
            echo "slurp: $lib ausente do NEEDED" >&2; exit 1; }
    done
    [ -e "$STAGE/usr/share/man/man1/slurp.1" ] || {
        echo "slurp: página de manual não veio" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
