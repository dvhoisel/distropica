NAME=pygobject
VERSION=3.58.0
KIND=source
TOOLCHAIN=native
DEPS="glibc python-glibc glib glib-introspection libffi cairo pycairo"
# xorgproto: quem roda pkg-config em cairo (ou em x11/xext/xrender) precisa dos
# .pc dos PROTOCOLOS, e eles são do xorgproto. A cadeia é indireta e por isso
# passava despercebida: cairo.pc traz `Requires.private: ... x11, xext, xrender`,
# o x11.pc traz `Requires: xproto kbproto`, e o xrender.pc traz `xproto
# renderproto`. Sem o xorgproto na view, o pkg-config falha ao gerar os cflags do
# cairo e o meson conclui que o cairo NÃO existe — indo tentar baixar um
# subprojeto. Conferido nos .pc instalados, não suposto.
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc glib glib-introspection libffi cairo pycairo gobject-introspection findutils"
ABOUT="Binding Python de GLib, Gio e GObject Introspection. É a ponte usada pelos plug-ins Python do GIMP para carregar Gimp, Gegl e GExiv2; a integração com pycairo fica explicitamente ligada."
LICENSE=LGPL-2.1-or-later
SRC="https://files.pythonhosted.org/packages/source/p/pygobject/pygobject-$VERSION.tar.gz"
SHA256="45068697de3ffe46840ca369705f23118b34db4f7deb63f6eff079a6734ddcca"

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release \
        -Dpython=python3 -Dpycairo=enabled -Dtests=false -Dwheel=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    find "$STAGE" -type d -name __pycache__ -prune -exec rm -rf {} +
    find "$STAGE" -type f -name '*.pyc' -delete
    find "$STAGE" -type f -path '*/gi/_gi*.so' -print -quit | grep -q . || {
        echo "pygobject: extensão gi._gi ausente" >&2
        exit 1
    }
}
