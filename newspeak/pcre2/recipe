NAME=pcre2
VERSION=10.47
KIND=source
TOOLCHAIN=native
DEPS="glibc busybox"
BUILD_DEPS="make gcc-pass2 binutils-glibc"
ABOUT="Expressões regulares compatíveis com Perl, segunda geração. Entra por causa da glib: o GRegex é uma casca fina sobre a PCRE2, e a glib não constrói sem ela. Só a variante de 8 bits — a de 16 e a de 32 existem para quem trabalha com UTF-16/UTF-32, e nada nesta árvore o faz. Com JIT, que a própria glib procura: sem ele toda expressão regular do GTK e do GLib passa a ser interpretada. Sem as ferramentas de linha de comando pcre2grep e pcre2test, que são superfície que ninguém pediu."
LICENSE=BSD-3-Clause
SRC="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$VERSION/pcre2-$VERSION.tar.bz2"
SHA256=47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7

build() {
    # bzip2 por um cano, como em libmnl e ndisc6: não se presume tar com bz2.
    bunzip2 -c "$DL" | tar -x --strip-components=1
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --enable-unicode \
        --enable-jit \
        --disable-pcre2-16 \
        --disable-pcre2-32 \
        --disable-pcre2grep-callout \
        --disable-static
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    # pcre2grep e pcre2test são ferramentas de diagnóstico do próprio projeto;
    # a distro quer a biblioteca, não a linha de comando.
    rm -f "$STAGE/usr/bin/pcre2grep" "$STAGE/usr/bin/pcre2test" \
          "$STAGE/usr/share/man/man1/pcre2grep.1" \
          "$STAGE/usr/share/man/man1/pcre2test.1"
    find "$STAGE" -type d -empty -delete
}
