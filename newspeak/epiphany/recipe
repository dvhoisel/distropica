NAME=epiphany
VERSION=49.9.1
KIND=source
TOOLCHAIN=native
DEPS="glibc glib gtk4 libadwaita webkitgtk libsoup libsecret gcr json-glib libarchive libportal libxml2 sqlite3 nettle iso-codes gsettings-desktop-schemas gstreamer cairo pango gdk-pixbuf"
# xorgproto: quem roda pkg-config em cairo (ou em x11/xext/xrender) precisa dos
# .pc dos PROTOCOLOS, e eles são do xorgproto. A cadeia é indireta e por isso
# passava despercebida: cairo.pc traz `Requires.private: ... x11, xext, xrender`,
# o x11.pc traz `Requires: xproto kbproto`, e o xrender.pc traz `xproto
# renderproto`. Sem o xorgproto na view, o pkg-config falha ao gerar os cflags do
# cairo e o meson conclui que o cairo NÃO existe — indo tentar baixar um
# subprojeto. Conferido nos .pc instalados, não suposto.
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf busybox python-glibc gettext"
ABOUT="O NAVEGADOR. GNOME Web, o cliente canonico da API webkitgtk-6.0 e o unico navegador maduro cuja interface e GTK4 nativa — todo o resto ou e GTK3, ou e Qt, ou linka X11 duro. Substitui o Firefox nesta arvore, e a troca e de UM pacote por um: medido, tirar o Firefox da closure da base remove exatamente ele mesmo, porque tudo que ele puxava e compartilhado com a pilha grafica. O que muda de verdade e a natureza do que fica: C e C++ auditaveis por NEEDED, em vez de um binario upstream opaco. Traz sincronizacao com conta Firefox (favoritos, senhas e historico), bloqueio de conteudo embutido pelos content blockers do WebKit, e nada de WebExtensions — nao ha uBlock aqui, o filtro nativo cobre parte. SEM VIDEO, herdado do WebKit construido sem decodificador nenhum: e posicao declarada, nao surpresa. O gstreamer aparece em DEPS mesmo assim porque o meson deste pacote faz dependency('gstreamer-1.0') sem 'required:' — e dependencia dura do proprio navegador, independente do motor. Sem granite (integracao com elementary OS), sem testes e sem man-pages, que exigiriam rst2man."
LICENSE=GPL-3.0-or-later
SRC="https://download.gnome.org/sources/epiphany/49/epiphany-$VERSION.tar.xz"
SHA256="0b6aafe1f51da155a19825135c8dc9955587c64f8dff3db8954e829a0f01006b"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # O HELP SAI DA ÁRVORE DE BUILD, e não é economia: é que ele não tem leitor.
    # O meson.build faz `subdir('help')` INCONDICIONALMENTE (linha 161 da fonte
    # pinada) e o help/meson.build chama gnome.yelp(), que exige o itstool. Não
    # há opção de configure para desligar — a lista inteira de meson_options.txt
    # foi conferida: developer_mode, tech_preview, profile, unit_tests, granite,
    # man-pages, e nada de help.
    #
    # Trazer o itstool custaria uma receita nova mais os bindings Python do
    # libxml2, para produzir documentação Mallard que nenhum programa desta
    # distro sabe abrir: não há yelp aqui, e não vai haver. Editar a fonte é a
    # convenção da árvore para este caso — gcc, librsvg, linux, nftables e
    # mypaint-brushes já o fazem, sempre com o motivo escrito.
    sed -i "/^subdir('help')$/d" meson.build
    # A guarda existe porque um sed que não casa nada FALHA EM SILÊNCIO: se o
    # upstream mudar a linha, o build voltaria a morrer no itstool e o motivo
    # pareceria outro.
    grep -q "^subdir('help')$" meson.build && {
        echo "epiphany: o sed não removeu subdir('help') — a linha mudou de forma" >&2
        grep -n "help" meson.build >&2
        exit 1
    }

    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Ddeveloper_mode=false \
        -Dtech_preview=false \
        -Dunit_tests=disabled \
        -Dgranite=disabled \
        -Dman-pages=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    [ -x "$STAGE/usr/bin/epiphany" ] || {
        echo "epiphany: o binario nao foi produzido" >&2
        exit 1
    }
    # O .desktop e o que faz o navegador aparecer no menu do labwc; sem ele o
    # unico jeito de abrir seria pela linha de comando.
    [ -e "$STAGE/usr/share/applications/org.gnome.Epiphany.desktop" ] || {
        echo "epiphany: o arquivo .desktop nao foi instalado" >&2
        ls "$STAGE/usr/share/applications" 2>/dev/null >&2
        exit 1
    }
    # Os esquemas do GSettings sao dependencia invisivel para a auditoria: nenhum
    # ELF aponta para eles, e sem eles o navegador aborta ao ler a primeira
    # preferencia. O gschemas.compiled em si e recompilado no boot pelo drop-in
    # do pacote 'desktop', entao a copia parcial daqui sai.
    [ -e "$STAGE/usr/share/glib-2.0/schemas/org.gnome.Epiphany.gschema.xml" ] || {
        echo "epiphany: o esquema do GSettings nao foi instalado" >&2
        exit 1
    }
    rm -f "$STAGE/usr/share/glib-2.0/schemas/gschemas.compiled"
    # A promessa que a receita do WebKit sustenta, conferida do lado de ca: se
    # X11 voltar por qualquer caminho, e aqui que aparece.
    for lib in libX11 libxcb; do
        if readelf -d "$STAGE/usr/bin/epiphany" | grep -q "$lib"; then
            echo "epiphany: ligou $lib — X11 entrou pela porta do navegador" >&2
            readelf -d "$STAGE/usr/bin/epiphany" | grep NEEDED >&2
            exit 1
        fi
    done
    find "$STAGE" -type d -empty -delete
}
