NAME=nftables
VERSION=1.1.6
KIND=source
TOOLCHAIN=native
DEPS="glibc libmnl libnftnl mathlibs-glibc"
BUILD_DEPS="make gcc-pass2 binutils-glibc flex bison"
ABOUT="Ferramenta de espaço de usuário do netfilter: é ela que carrega regra no kernel. Sem nftables a distro não tem filtragem de pacote nenhuma, e o wg-quick com 'Table = auto' não consegue instalar a regra por marca de que depende. Compilado sem CLI interativa, sem JSON e sem página de manual, para não arrastar readline, jansson e a cadeia docbook. Usa libgmp, fornecida por mathlibs-glibc."
LICENSE=GPL-2.0-only
SRC="https://ftp.netfilter.org/pub/nftables/nftables-$VERSION.tar.xz"
SHA256=372931bda8556b310636a2f9020adc710f9bab66f47efe0ce90bff800ac2530c

build() {
    tar -xJf "$DL" --strip-components=1
    # Caminhos explícitos no lugar do pkg-config, como em libnftnl.
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sbindir=/usr/bin \
        --without-cli \
        --disable-python \
        --disable-man-doc \
        --disable-json \
        LIBMNL_CFLAGS="-I/usr/include" \
        LIBMNL_LIBS="-lmnl" \
        LIBNFTNL_CFLAGS="-I/usr/include" \
        LIBNFTNL_LIBS="-lnftnl"
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
