NAME=python-glibc
VERSION=3.14.6
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib openssl ncurses libffi busybox e2fsprogs readline xz"
# gawk: o `./configure` desta fonte chama awk para gerar o config.status, e
# declarar só `busybox` NÃO garante awk — o gawk supersede o busybox e leva
# /usr/bin/awk embora. A falta só aparece quando o gawk já foi construído no
# mesmo plano, então a quebra é sensível à ordem. Conferido no próprio
# configure da fonte pinada, não suposto.
BUILD_DEPS="make gcc-pass2 binutils-glibc pkgconf busybox gawk"
SUPERSEDES="python"
ABOUT="O Python de verdade da distro, sucessor do interpretador-semente. O python semente é BUILD_DEPS do glibc: ele precisa existir ANTES da libc, então é compilado com o toolchain-semente musl do Zig, estático e sem nenhum módulo de extensão C — sem zlib, sem ssl, sem hashlib, sem ctypes. Isso basta para os scripts de build do glibc e para nada mais; o Meson, por exemplo, importa gzip e morre. Um Python nativo não pode ocupar o lugar do semente, porque seria circular. Daí a sucessão provisional, o mesmo padrão de gcc→gcc-pass2 e binutils→binutils-glibc: o semente cede os caminhos quando este chega. O Python nativo traz zlib, TLS, ctypes, curses, readline e lzma com provedores declarados. _bz2 continua deliberadamente desligado: bzip2 pertence apenas à closure de build do GIMP, e autodetectá-lo faria a mesma receita gerar payload diferente numa raiz GIMP. _sqlite3 também continua ausente. SEM pip, deliberadamente: uma distro cuja premissa é não ter gerenciador de pacotes não ganha um segundo pela porta dos fundos."
LICENSE=Python-2.0.1
SRC="https://www.python.org/ftp/python/$VERSION/Python-$VERSION.tar.xz"
SHA256=143b1dddefaec3bd2e21e3b839b34a2b7fb9842272883c576420d605e9f30c63

build() {
    tar -xJf "$DL" --strip-components=1
    # O CPython 3.14.6 não compila contra o OpenSSL 4.0: o _ssl referencia
    # TLSv1_method, TLSv1_1_method e SSLv3_method, que o OpenSSL 4 removeu, e
    # o módulo falha ao importar com "undefined symbol". Sem o _ssl a guarda
    # abaixo aborta — e um Python sem ssl é o mesmo problema que esta receita
    # existe para resolver.
    #
    # É o conserto do PRÓPRIO upstream, e é temporário por construção: PR
    # #146403 do CPython, o backport para o ramo 3.14 de gh-146207, assinado
    # por Victor Stinner em 2026-03-25. Sai daqui quando houver uma 3.14.7 —
    # a 3.14.6 é a última publicada e o diretório da 3.15.0 ainda responde 404.
    #
    # É o segundo patch de fonte da árvore, e pelo mesmo motivo do primeiro (o
    # nmap): o OpenSSL 4.0 mudou API e o mundo ainda não alcançou. O conteúdo
    # entra no FINGERPRINT pelo snapshot de files/.
    patch -p1 < "$WORK/openssl4.patch"
    patch -p1 < "$WORK/disable-bzip2.patch"
    # Setup.local é a interface suportada pelo CPython para impedir um módulo
    # independentemente do que o configure encontre. bzip2 não pertence à
    # closure da base, mas estará instalado quando uma raiz limpa construir a
    # closure do GIMP; sem este bloqueio, a MESMA receita/fingerprint ganharia
    # _bz2 apenas nessa raiz. Isso é não determinismo por sujeira do rootfs.
    printf '*disabled*\n_bz2\n' > Modules/Setup.local

    # Setup.local impede o .so. O patch acima também zera a decisão final do
    # configure e os dados de sysconfig; as respostas de cache impedem que o
    # fallback Autoconf grave HAVE_BZLIB_H antes dessa decisão.
    # Ao contrário do semente, aqui os módulos de extensão são .so em
    # lib-dynload: é o que faz `import zlib` funcionar. Sem MODULE_BUILDTYPE.
    #
    # -rpath-link,/usr/lib: padrão recorrente desta toolchain. A libcrypto
    # precisa da libz, a libncursesw precisa da libtinfo, e o ld nativo não
    # resolve dependência transitiva sozinho — sem isto os testes de link do
    # configure respondem "não" e os módulos somem em silêncio, que é
    # exatamente o modo de falha que trouxe esta receita à existência.
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ac_cv_header_bzlib_h=no \
    ac_cv_lib_bz2_BZ2_bzCompress=no \
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --with-openssl=/usr \
        --without-ensurepip \
        --with-ensurepip=no \
        --disable-test-modules \
        --enable-optimizations=no
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    # Guarda: esta receita existe para que os módulos de extensão existam.
    # Se o configure decidir em silêncio que zlib ou ssl não estão lá, o
    # build "passa" e entrega o mesmo Python inútil de antes.
    for modulo in zlib _ssl _hashlib _ctypes _curses readline _lzma; do
        ls "$STAGE"/usr/lib/python*/lib-dynload/"$modulo"*.so >/dev/null 2>&1 || {
            echo "FATAL: módulo $modulo não foi construído"
            echo "lib-dynload contém:"
            ls "$STAGE"/usr/lib/python*/lib-dynload/ 2>/dev/null | head -30
            exit 1
        }
    done
    ! ls "$STAGE"/usr/lib/python*/lib-dynload/_bz2*.so >/dev/null 2>&1 || {
        echo "FATAL: _bz2 foi construído apesar do bloqueio de hermeticidade"
        exit 1
    }
    ! grep -q '^#define HAVE_BZLIB_H 1$' \
        "$STAGE"/usr/include/python*/pyconfig.h || {
        echo "FATAL: pyconfig.h ainda varia com bzlib presente no rootfs"
        exit 1
    }
    # __pycache__ prende caminho absoluto e mtime dentro do .pyc.
    find "$STAGE" -type d -name __pycache__ -exec rm -rf {} +

    # Mesmo resquício da stdlib tratado no `python`: encodings/rot_13.py vem com
    # modo 755 e '#!/usr/bin/env python', um comando que esta árvore não instala.
    # É codec, não programa — importado, nunca executado por shebang. Some-se o
    # bit de execução, não o arquivo nem a linha, para não divergir dos bytes do
    # upstream. Sem isto a auditoria recusa o payload, e com razão: um
    # executável declara o interpretador que exige.
    find "$STAGE/usr/lib" -type f -name '*.py' -perm -u+x \
        -exec head -1 {} \; -print 2>/dev/null |
        awk '/^#!.*\/env python$/ { getline caminho; print caminho }' |
        while IFS= read -r resquicio; do
            [ -n "$resquicio" ] || continue
            chmod a-x "$resquicio"
            echo "  bit de execução removido de ${resquicio#"$STAGE"}"
        done

    find "$STAGE" -type d -empty -delete
}
