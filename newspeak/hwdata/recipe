NAME=hwdata
VERSION=0.410
KIND=source
TOOLCHAIN=none
DEPS=""
BUILD_DEPS=busybox
ABOUT="A tabela que traduz número PCI em nome: pci.ids, e desde 01/09/2026 SÓ ela — com consumidor de verdade. A primeira escrita deste pacote dizia que o BusyBox 'já traz lspci e lsusb e o que falta é a base que ele consulta', e a premissa era FALSA: o applet do BusyBox não consulta base nenhuma (lido no util-linux/lspci.c pinado — o único fopen é o uevent), então as duas tabelas viajaram mortas na mídia da 0.14 e da 0.15. Quem consulta o pci.ids agora é o lspci do pciutils, compilado com IDSDIR apontando para cá e declarando este pacote como dependência de runtime. O usb.ids SAI pelo mesmo recorte honesto do hwdata-pnp: o lsusb do usbutils desta era tira nomes do HWDB do udev (via libudev), cujos fragmentos o eudev instala e cujo hwdb.bin o drop-in 04-hwdb.sh compila no primeiro boot — uma segunda cópia da tabela USB aqui seria peso sem leitor. oui.txt e iab.txt continuam fora, sem consumidor."
LICENSE="GPL-2.0-or-later OR XFree86-1.1"
SRC="https://github.com/vcrhonek/hwdata/archive/refs/tags/v$VERSION.tar.gz"
SHA256="2864b061b179b8ad8cb6a7339ca07678240a183d9cedce8677a4950acaf798e0"

build() {
    tar -xzf "$DL" --strip-components=1
    install -d "$STAGE/usr/share/hwdata"
    # So as duas tabelas que tem consumidor aqui. O configure/make do upstream
    # instalaria tambem oui.txt e iab.txt (registro de MAC, ~10 MiB juntos) e
    # regras de udev que esta arvore nao usa; copiar o que se quer e mais
    # honesto que instalar tudo e apagar depois.
    install -m 0644 pci.ids "$STAGE/usr/share/hwdata/pci.ids"

    # Guarda: tabela existe e tem conteudo. Um arquivo truncado responde a
    # consulta com silencio, que e indistinguivel de tabela ausente.
    for tabela in pci.ids; do
        linhas=$(grep -c . "$STAGE/usr/share/hwdata/$tabela" || echo 0)
        [ "$linhas" -ge 1000 ] || {
            echo "hwdata: $tabela tem so $linhas linhas" >&2
            exit 1
        }
    done
}
