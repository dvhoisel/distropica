NAME=wayland-protocols
VERSION=1.49
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="meson ninja pkgconf wayland"
ABOUT="As descrições XML dos protocolos estáveis e experimentais do Wayland: xdg-shell (janelas de verdade), xdg-decoration, pointer-constraints, e o resto do que um compositor e um cliente precisam combinar. Não tem código compilado — instala XML e um arquivo .pc, e o wayland-scanner de cada consumidor gera o C a partir daqui. O GTK e o Firefox não abrem uma janela sem o xdg-shell, que mora neste pacote e não no wayland."
LICENSE=MIT
SRC="https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/$VERSION/downloads/wayland-protocols-$VERSION.tar.xz"
SHA256=ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14

build() {
    tar -xJf "$DL" --strip-components=1
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dtests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    # Guarda: o xdg-shell é o protocolo sem o qual não existe janela.
    ls "$STAGE/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml" >/dev/null 2>&1 || {
        echo "FATAL: xdg-shell.xml não foi instalado"
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
