NAME=libportal
VERSION=0.10.0
KIND=source
TOOLCHAIN=native
DEPS="glibc glib gtk4"
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf busybox python-glibc"
ABOUT="A biblioteca cliente dos portais XDG, na variante GTK4 — libportal-gtk4 é o nome exato que o meson do Epiphany exige. Portais são a forma de um aplicativo confinado pedir ao sistema coisas que ele não pode fazer sozinho: abrir um seletor de arquivos, definir o navegador padrão, imprimir. Esta árvore NÃO tem um serviço de portal rodando, e mesmo assim a biblioteca é obrigatória para compilar; sem servidor do outro lado, as chamadas falham de forma controlada e o Epiphany cai para os diálogos próprios do GTK. É dívida honesta: está aqui porque o upstream a exige, não porque o recurso funcione. Só o backend GTK4 — os de GTK3, Qt5 e Qt6 ficam explicitamente desligados, senão o 'auto' os ligaria conforme o que estivesse na raiz de build."
LICENSE=LGPL-3.0-or-later
SRC="https://github.com/flatpak/libportal/releases/download/$VERSION/libportal-$VERSION.tar.xz"
SHA256="1c74a3f7becbd4ff745d7f565afd06e97e50eb080a0e268cb14bb55289a745bf"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dbackend-gtk3=disabled \
        -Dbackend-gtk4=enabled \
        -Dbackend-qt5=disabled \
        -Dbackend-qt6=disabled \
        -Dintrospection=false \
        -Dvapi=false \
        -Ddocs=false \
        -Dtests=false \
        -Dportal-tests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -e "$STAGE/usr/lib/pkgconfig/libportal-gtk4.pc" ] || {
        echo "libportal: libportal-gtk4.pc não foi produzido — o Epiphany exige este nome" >&2
        ls "$STAGE/usr/lib/pkgconfig" 2>/dev/null >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
