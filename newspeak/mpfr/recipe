NAME=mpfr
VERSION=4.2.2
KIND=source
# Semente musl: cede /usr/lib/libmpfr* ao rebuild glibc (mathlibs-glibc).
PROVISIONAL=1
DEPS=gmp
BUILD_DEPS="binutils make busybox"
ABOUT="ponto flutuante de precisão múltipla; dependência do gcc. --with-gmp aponta o gmp em /usr porque o zig cc não busca lá por conta própria"
LICENSE=LGPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/mpfr/mpfr-$VERSION.tar.xz"
SHA256=b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01
# Chave extraída do keyring oficial https://ftp.gnu.org/gnu/gnu-keyring.gpg;
# signer observado e primária A534BE3F83E241D918280AEB5831D11A0D4DB02A.
SIG_1="https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz.sig"
SIG_EPOCH_1=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=A534BE3F83E241D918280AEB5831D11A0D4DB02A

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --disable-nls --disable-dependency-tracking \
        --with-gmp="$ROOT/usr"
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
