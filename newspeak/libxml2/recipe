NAME=libxml2
VERSION=2.15.4
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib busybox"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf zlib gawk findutils"
ABOUT="Leitor e escritor de XML em C. Consumidores não faltam, e nenhum é exótico: o WebKitGTK, a libsoup, a libxslt, o librsvg, o appstream, o shared-mime-info, o labwc (o rc.xml e o tema são XML), o at-spi2-core, a libarchive e o Inkscape. Até a 0.16 a árvore segurava a série 2.13, com o argumento de que Alpine e Void a pinavam por quebra de ABI nas seguintes — e o conferidor de versões, que só olhava dentro da série da URL, nunca mostrou que a 2.15 estável existia. Agora a receita segue o estável. A 2.14 trocou o soname de libxml2.so.2 para libxml2.so.16 e a 2.15 removeu o cliente HTTP e o LZMA; como a árvore é reconstruída inteira, todo consumidor é recompilado contra ela na mesma cadeia. Sem Python e sem ICU; a compatibilidade de ABI do HTTP removido fica desligada, e o zlib fica porque a descompressão de documento é barata e já está na árvore."
LICENSE=MIT
SRC="https://download.gnome.org/sources/libxml2/2.15/libxml2-$VERSION.tar.xz"
SHA256="98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --without-python --without-icu --without-http \
        --with-zlib
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    # O soname é o da 2.14 em diante (a NEWS do upstream: "bumped from
    # libxml2.so.2 to libxml2.so.16"). Conferir o nome é conferir que a ABI
    # que os consumidores vão ligar é a que se pensa.
    [ -e "$STAGE/usr/lib/libxml2.so.16" ] || {
        echo "libxml2: libxml2.so.16 não foi produzida" >&2
        exit 1
    }
    [ -e "$STAGE/usr/lib/pkgconfig/libxml-2.0.pc" ] || {
        echo "libxml2: libxml-2.0.pc não foi produzido" >&2
        exit 1
    }
    # O --without-python evita a extensão, mas o build ainda instala scripts
    # auxiliares; nenhum deles deve trazer dependência de python para cá.
    ! grep -rlq "^#!.*python" "$STAGE/usr/bin" 2>/dev/null || {
        echo "libxml2: sobrou script python no /usr/bin apesar de --without-python" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
