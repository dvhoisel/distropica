NAME=libxfixes
VERSION=6.0.2
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto glibc libx11"
ABOUT="A extensão Fixes: regiões, cursores e seleções — os remendos que o protocolo original não previu. Base de libXdamage, libXcomposite e libXcursor, além de estar no NEEDED do libxul.so diretamente."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXfixes-$VERSION.tar.xz"
SHA256=39f115d72d9c5f8111e4684164d3d68cc1fd21f9b27ff2401b08fddfc0f409ba

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXfixes.so.3" ] || {
        echo "libxfixes: libXfixes.so.3 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
