NAME=bzip2
VERSION=1.0.8
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="gcc-pass2 binutils-glibc make"
ABOUT="A libbz2 compartilhada. O GIMP 3.2 a procura sem opção de desligar e a libarchive a usa para recursos comprimidos. Instala-se apenas a biblioteca e o cabeçalho, pois nenhum consumidor desta closure precisa dos scripts de linha de comando."
LICENSE=bzip2-1.0.6
SRC="https://sourceware.org/pub/bzip2/bzip2-$VERSION.tar.gz"
SHA256=ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269

build() {
    tar -xzf "$DL" --strip-components=1
    make -f Makefile-libbz2_so CC=gcc AR=ar RANLIB=ranlib -j"$JOBS"
    install -Dm755 libbz2.so.$VERSION "$STAGE/usr/lib/libbz2.so.$VERSION"
    ln -s "libbz2.so.$VERSION" "$STAGE/usr/lib/libbz2.so.1.0"
    ln -s libbz2.so.1.0 "$STAGE/usr/lib/libbz2.so.1"
    ln -s libbz2.so.1 "$STAGE/usr/lib/libbz2.so"
    install -Dm644 bzlib.h "$STAGE/usr/include/bzlib.h"
    install -Dm644 LICENSE "$STAGE/usr/share/licenses/bzip2/LICENSE"
    [ -e "$STAGE/usr/lib/libbz2.so.1" ] || { echo "bzip2: libbz2.so.1 ausente" >&2; exit 1; }
}
