NAME=nano
VERSION=9.2
KIND=source
TOOLCHAIN=native
DEPS="glibc ncurses"
BUILD_DEPS="make gcc-pass2 binutils-glibc"
ABOUT="editor de texto opcional; receita online-only que baixa a fonte oficial do GNU nano e a compila localmente com a toolchain nativa"
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/nano/nano-$VERSION.tar.xz"
SHA256="05ecb99247b782e8a5b3a25ed4101dd034b0236902f7449bc9795b717642f7e9"

build() {
    tar -xJf "$DL" --strip-components=1
    LIBS="-ltinfo" ./configure --prefix=/usr --sysconfdir=/etc \
        --enable-utf8 --disable-nls --disable-libmagic \
        --disable-dependency-tracking
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    rm -rf -- "$STAGE/usr/share/locale"
}
