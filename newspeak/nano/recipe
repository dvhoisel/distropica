NAME=nano
VERSION=9.2
KIND=source
TOOLCHAIN=native
DEPS="glibc ncurses"
# gawk: o configure gerado pelo autoconf usa $AWK dentro do config.status,
# e sem ele a configuração morre em "config.status: error: could not create
# ..." depois de já ter respondido a todos os testes — erro tardio e de
# leitura ruim. Conferido no configure da fonte pinada, não suposto: são 8 a
# 12 usos de $AWK na seção do config.status. É a convenção da árvore, que
# tem 75 receitas declarando gawk pelo mesmo motivo.
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk"
ABOUT="editor de texto opcional; receita online-only que baixa a fonte oficial do GNU nano e a compila localmente com a toolchain nativa"
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/nano/nano-$VERSION.tar.xz"
SHA256="05ecb99247b782e8a5b3a25ed4101dd034b0236902f7449bc9795b717642f7e9"

build() {
    tar -xJf "$DL" --strip-components=1
    LIBS="-ltinfo" ./configure --prefix=/usr --sysconfdir=/etc \
        --enable-utf8 --disable-nls --disable-libmagic \
        --disable-dependency-tracking
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    rm -rf -- "$STAGE/usr/share/locale"
}
