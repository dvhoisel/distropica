NAME=libarchive
VERSION=3.8.9
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib xz openssl libxml2"
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk busybox"
ABOUT="Leitura e escrita de arquivos compactados em vários formatos. O Epiphany o exige por nome, e o usa para abrir pacotes de extensão da web e para exportar a coleção de favoritos. Entra só a BIBLIOTECA: o bsdtar e o bsdcpio ficam de fora, porque o tar desta árvore é o do busybox e ter dois é convidar ambiguidade de qual está no PATH. Sem bzip2, sem lzo, sem zstd e sem nettle — os formatos que sobram (tar, zip, gzip, xz) cobrem o que o navegador abre, e cada codec a mais é uma superfície de parsing exposta a arquivo baixado da internet."
LICENSE=BSD-2-Clause
SRC="https://github.com/libarchive/libarchive/releases/download/v$VERSION/libarchive-$VERSION.tar.xz"
SHA256="888c934f9d95648ecb9163dc8e23ab80a476ecb81a8f1154704a227b5b676dde"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static \
        --disable-bsdtar \
        --disable-bsdcpio \
        --disable-bsdcat \
        --disable-bsdunzip \
        --without-bz2lib \
        --without-lzo2 \
        --without-nettle \
        --without-zstd
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libarchive.so" ] || {
        echo "libarchive: a biblioteca compartilhada não foi produzida" >&2
        exit 1
    }
    # Um bsdtar no PATH disputaria o nome com o applet do busybox.
    if [ -d "$STAGE/usr/bin" ] && [ -n "$(ls -A "$STAGE/usr/bin" 2>/dev/null)" ]; then
        echo "libarchive: sobraram binários no payload:" >&2
        ls "$STAGE/usr/bin" >&2
        exit 1
    fi
    find "$STAGE" -type d -empty -delete
}
