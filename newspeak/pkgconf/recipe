NAME=pkgconf
VERSION=3.0.5
KIND=source
TOOLCHAIN=native
DEPS="glibc"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk"
ABOUT="Implementação do pkg-config. Ferramenta de build, não superfície: entra porque o configure da libnftnl e do nftables usa PKG_CHECK_MODULES, que é exigência dura — sem ela os dois recusam a construir, e nenhum flag os convence do contrário. pkgconf e não o pkg-config da freedesktop: este último embute uma cópia da glib só para se construir, e arrastar a glib para dentro de uma ferramenta de build seria pagar caro por um resolvedor de arquivos .pc. Instala o binário pkgconf e o nome pkg-config como link, que é o que todo configure procura. --disable-shared porque uma libpkgconf.so acrescentaria um provedor à closure sem que nada além dela própria a use."
LICENSE=ISC
SRC="https://distfiles.ariadne.space/pkgconf/pkgconf-$VERSION.tar.xz"
SHA256="3acd3a8a3cce65a8d620321855d92fb602e026cbe8e13ee36bdec58483b59ace"

build() {
    tar -xJf "$DL" --strip-components=1
    # Os três caminhos precisam casar com a árvore usr-merged, senão o pkgconf
    # anuncia -L/usr/lib64 e -I de diretórios que aqui não existem.
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-shared \
        --with-pkg-config-dir=/usr/lib/pkgconfig:/usr/share/pkgconfig \
        --with-system-libdir=/usr/lib \
        --with-system-includedir=/usr/include
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    # Todo configure procura por `pkg-config`; o upstream instala só `pkgconf`.
    ln -sf pkgconf "$STAGE/usr/bin/pkg-config"
}
