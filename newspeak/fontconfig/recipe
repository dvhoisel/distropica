NAME=fontconfig
VERSION=2.18.3
KIND=source
TOOLCHAIN=native
DEPS="glibc freetype expat libpng zlib"
BUILD_DEPS="make gcc-pass2 binutils-glibc pkgconf gperf"
ABOUT="Descoberta e casamento de fontes: é quem responde 'qual arquivo de fonte atende a este pedido'. O FreeType desenha o glifo, mas não sabe onde as fontes estão nem qual substituir quando a pedida falta; a fontconfig resolve isso, e cairo, pango e GTK dependem dela para qualquer texto. Lê configuração em XML, daí o expat. Precisa do gperf: gera fcobjshash.h e o tarball não o traz pronto. Baixado do GitLab do freedesktop e não do site do projeto: o caminho antigo em freedesktop.org/software responde uma página HTML, e pinar o hash dela seria pinar um erro 404 — foi o que quase aconteceu ao escrever esta receita, e só a conferência contra um canal independente pegou."
LICENSE=MIT
SRC="https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/$VERSION/fontconfig-$VERSION.tar.xz"
SHA256="4f7b554a38cdf78c033f666c8871f3749e14a094f65a07f630c91ed0b43d35e3"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # --disable-docs: a documentação exige docbook2x, uma cadeia inteira de
    # SGML que esta árvore não tem e que serve só para gerar man pages.
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --disable-docs \
        --disable-nls
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    # O cache de fontes é estado de máquina, gerado por fc-cache no primeiro
    # uso; não é payload do pacote e não pode entrar no manifesto.
    rm -rf "$STAGE/var"
    find "$STAGE" -type d -empty -delete
}
