NAME=gawk
VERSION=5.3.2
KIND=source
DEPS="busybox"
# Toma o applet homônimo do busybox (awk) — SPEC-0003 §7.
SUPERSEDES="busybox"
BUILD_DEPS=binutils
ABOUT="AWK do GNU; a glibc e o gerador de opções do gcc usam scripts awk que o busybox não cobre. PINADO em 5.3.2 de propósito: o 5.4.1 tem uma regressão — um elemento de array não-inicializado comparado a \"\" e depois concatenado vira \"0\" (quebra optc-gen.awk do gcc; SPEC-0005 §4). 5.3.2 é sadio."
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/gawk/gawk-$VERSION.tar.xz"
SHA256=f8c3486509de705192138b00ef2c00bbbdd0e84c30d5c07d23fc73a9dc4cc9cc

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --disable-nls --disable-dependency-tracking
    make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # O upstream instala gawk e o nome versionado como hardlinks. O manifesto
    # mundo-B ainda não representa grupos de hardlinks; sele explicitamente o
    # alias conhecido como arquivo regular independente. Não dependa de
    # `find -links`: o applet disponível varia durante a troca de toolchains.
    versioned="$STAGE/usr/bin/gawk-$VERSION"
    copy=$versioned.minitrue-copy
    [ -f "$STAGE/usr/bin/gawk" ] && [ ! -L "$STAGE/usr/bin/gawk" ]
    [ -f "$versioned" ] && [ ! -L "$versioned" ]
    [ ! -e "$copy" ] && [ ! -L "$copy" ]
    cp -p "$versioned" "$copy"
    mv -f "$copy" "$versioned"

    # Os 12 módulos de extensão de /usr/lib/gawk NÃO são entregues, e a razão
    # é dupla. Primeiro: este gawk é ESTÁTICO — construído com o toolchain
    # semente, sem interpretador dinâmico — e binário estático não faz dlopen.
    # Carregar qualquer um deles responde literalmente
    # "gawk: fatal: load_ext: Dynamic loading not supported". Segundo: eles
    # saíram malformados, com DT_NEEDED em "libc.so", que nesta árvore é o
    # SCRIPT do GNU ld em texto e não uma biblioteca — nenhum objeto
    # compartilhado deveria pedir isso.
    #
    # A auditoria acusava 12 erros aqui, um por módulo, e a leitura ingênua
    # seria declarar glibc em DEPS. Isso seria errado duas vezes: mascararia
    # módulos que não carregam de todo modo, e criaria ciclo, porque o gawk é
    # BUILD_DEPS da própria glibc. A regra é a mesma que a glibc aplica ao
    # largar ldd e tzselect: não entregar o que não funciona.
    rm -rf "$STAGE/usr/lib/gawk"
    find "$STAGE" -type d -empty -delete
}
