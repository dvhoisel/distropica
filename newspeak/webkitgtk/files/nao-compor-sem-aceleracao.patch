 {
+    // Distropica: with accelerated compositing disabled in the settings there is
+    // no compositor to build. Handing out a factory here used to enter
+    // accelerated compositing mode with a null root layer: WebCore creates no
+    // layers, the LayerTreeHost composites an empty scene, and the page turns
+    // blank (measured on youtube.com, whose page overlays request a factory
+    // before any video plays). A null factory is safe: GraphicsLayer::create
+    // then builds a standalone layer that nothing composites.
+    if (!m_webPage->corePage()->settings().acceleratedCompositingEnabled())
+        return nullptr;
     if (!m_layerTreeHost)
         enterAcceleratedCompositingMode(nullptr);
     return m_layerTreeHost ? m_layerTreeHost->graphicsLayerFactory() : nullptr;
@@ -440,6 +449,17 @@
 
 void DrawingAreaCoordinatedGraphics::enterAcceleratedCompositingMode(GraphicsLayer* graphicsLayer)
 {
+    // Distropica: the hardware-acceleration policy 'never' disables accelerated
+    // compositing in the settings, and every caller of this function must obey
+    // it. Otherwise the LayerTreeHost would composite a tree WebCore never
+    // populates: the UI process leaves the software path and the page goes
+    // blank, reload included. The root layer WebCore attached (for a page
+    // overlay, measured on youtube.com) stays a standalone layer; the page
+    // keeps painting through the bitmap path. Every caller copes with a null
+    // m_layerTreeHost afterwards: setRootCompositingLayer() returns, and
+    // graphicsLayerFactory() hands out no factory.
+    if (!m_webPage->corePage()->settings().acceleratedCompositingEnabled())
+        return;
     m_exitCompositingTimer.stop();
     m_wantsToExitAcceleratedCompositingMode = false;
 
