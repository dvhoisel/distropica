NAME=webkitgtk
VERSION=2.52.5
KIND=source
TOOLCHAIN=native
# gcc-pass2 e não libstdcxx: nesta árvore libstdc++.so.6 e libgcc_s.so.1
# pertencem ao gcc-pass2, que sobrescreve os do libstdcxx de bootstrap. O icu
# foi construído declarando libstdcxx e a auditoria acusou 44 erros por isso,
# derrubando o fechamento da v42; estas três receitas trazem o mesmo defeito e
# ainda não chegaram a construir.
# As cinco últimas saíram da AUDITORIA sobre o binário pronto, não da leitura
# do CMake: a libwebkitgtk-6.0.so.4.16.9 e os três processos auxiliares ligam
# libgdk_pixbuf, libgraphene e libexpat DIRETAMENTE; a biblioteca ainda liga
# libgpg-error (por baixo do libgcrypt) e libgbm (da mesa, pelo caminho de
# buffer gráfico). Todas chegavam transitivamente e por isso a receita parecia
# completa — 17 erros de audit depois de sete horas de C++.
DEPS="glibc gcc-pass2 glib gtk4 cairo pango harfbuzz icu libsoup libxml2 libxslt sqlite3 libjpeg-turbo libpng libwebp lcms2 libgcrypt libtasn1 libepoxy zlib at-spi2-core fontconfig freetype wayland libseccomp bubblewrap xdg-dbus-proxy libsecret libdrm gdk-pixbuf graphene expat libgpg-error mesa gstreamer gst-plugins-base gst-plugins-good"
# xorgproto: quem roda pkg-config em cairo (ou em x11/xext/xrender) precisa dos
# .pc dos PROTOCOLOS, e eles são do xorgproto. A cadeia é indireta e por isso
# passava despercebida: cairo.pc traz `Requires.private: ... x11, xext, xrender`,
# o x11.pc traz `Requires: xproto kbproto`, e o xrender.pc traz `xproto
# renderproto`. Sem o xorgproto na view, o pkg-config falha ao gerar os cflags do
# cairo e o meson conclui que o cairo NÃO existe — indo tentar baixar um
# subprojeto. Conferido nos .pc instalados, não suposto.
BUILD_DEPS="make gcc-pass2 binutils-glibc cmake ninja pkgconf busybox python-glibc ruby gperf gettext perl wayland-protocols findutils"
ABOUT="O MOTOR DE NAVEGACAO, e o maior build desta arvore — C++ na escala de horas. E a variante GTK4 da API, webkitgtk-6.0, que o Epiphany exige e que e o unico caminho para um navegador maduro sem X11 duro na interface. SEM LLVM, e isso nao e detalhe: o JIT do JavaScriptCore usa o backend B3 proprio desde 2016, entao nada de clang nem de libLLVM — a mesma recusa escrita na receita da Mesa continua de pe. Renderiza por SOFTWARE: desde a 2.46 o WebKit rasteriza com Skia e tem caminho de CPU real, que e o que casa com o pixman e a Mesa softpipe daqui. COM VIDEO E AUDIO desde a 0.14, e a posicao anterior era o contrario: ate a 0.13 esta receita desligava ENABLE_VIDEO, ENABLE_WEB_AUDIO e ENABLE_WEB_CODECS, o que pelo GStreamerDependencies.cmake desligava USE_GSTREAMER inteiro e deixava a arvore sem um unico decodificador — 'o preco e o YouTube nao tocar', dizia aqui. O preco foi cobrado e a decisao mudou. O que entrou foi a pilha LIVRE e so ela: gst-plugins-base pelo encanamento e pelo audio da Xiph, gst-plugins-good pelo matroskademux e pelo vpxdec, que sao o WebM e o VP9. H.264 e AAC continuam de fora, porque moram no 'bad' e no 'ugly' e trazem a conversa de patente que o LICENSING.md nao quer — uma pagina que so ofereca MP4/H.264 segue sem tocar, e isso continua sendo posicao. O ENABLE_MEDIA_SOURCE vem junto e ligado por default do proprio port (GStreamerDefinitions.cmake), que e o que faz streaming adaptativo funcionar. USE_GSTREAMER_GL fica OFF: a arvore compoe por software. ENABLE_SPEECH_SYNTHESIS segue desligado, que exigiria flite ou spiel. O CONFINAMENTO fica LIGADO: cada processo que interpreta HTML de origem desconhecida roda dentro de um bubblewrap com syscalls filtradas pela libseccomp e o D-Bus atras do xdg-dbus-proxy; desligar compilaria e regrediria seguranca em relacao ao que o Firefox ja entregava. Sem XWayland e sem alvo X11 — o ENABLE_X11_TARGET exigiria um GTK com backend X11 e traria as bibliotecas cliente de volta pela porta do navegador. Sem introspection, sem documentacao, sem journald, sem MiniBrowser e sem corretor ortografico, que exigiria enchant e dicionarios."
LICENSE=LGPL-2.1-or-later
SRC="https://webkitgtk.org/releases/webkitgtk-$VERSION.tar.xz"
SHA256="8a531a9abd2215936e8a8a914c077b586c0228b31d652f205286a8ec90f3364b"

build() {
    tar -xJf "$DL" --strip-components=1
    # NÃO COMPOR SEM ACELERAÇÃO. Com hardware-acceleration-policy=never, o
    # WebProcess recebe acceleratedCompositingEnabled=false e o WebCore não
    # cria camada nenhuma — mas havia DUAS portas para o modo composto que
    # ignoravam isso, medidas uma de cada vez no youtube.com (o Wikipedia e
    # páginas locais nunca as cruzam, e por isso renderizavam):
    #  1. DrawingAreaCoordinatedGraphics::graphicsLayerFactory() entrava no
    #     modo quando alguém pedia uma fábrica de camadas;
    #  2. RenderLayerCompositor::updateCompositingLayers() liga o modo composto
    #     ao ver um page overlay, sem olhar se há aceleração, e a raiz que ele
    #     anexa chega a setRootCompositingLayer() → enterAcceleratedCompositingMode(),
    #     que no GTK é irreversível (m_alwaysUseCompositing).
    # Nos dois casos o LayerTreeHost compõe uma árvore VAZIA e a página fica
    # branca do carregamento em diante, recarregar incluído; com o env
    # WEBKIT_DISABLE_COMPOSITING_MODE, que deixa o backing store do UI nulo, a
    # mesma entrada virava segfault em AcceleratedBackingStore::update — os
    # dois sintomas do beta tester, com a mesma causa. O patch fecha a porta 1
    # (fábrica nula; GraphicsLayer::create cria camada avulsa que nada compõe),
    # a porta 2 no WebCore (overlay não liga composição sem aceleração) e, por
    # garantia, a própria enterAcceleratedCompositingMode() recusa sob never.
    # Sem a política never nada muda: o WebKitSettings padrão segue em always.
    # O sha do patch fica aqui para que a impressão digital da receita mude
    # com ele — a impressão vem do texto da receita, não de files/.
    echo "26619849dca1754276d09fc68def06f3876c31cb7dcbba05e03f6f6d45d1aca8  $WORK/nao-compor-sem-aceleracao.patch" \
        | sha256sum -c --quiet || { echo "webkitgtk: o patch nao e o esperado" >&2; exit 1; }
    patch -p1 < "$WORK/nao-compor-sem-aceleracao.patch"
    [ "$(grep -c 'corePage()->settings().acceleratedCompositingEnabled())$' \
        Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/DrawingAreaCoordinatedGraphics.cpp)" = 2 ] || {
        echo "webkitgtk: o patch nao-compor-sem-aceleracao nao aplicou na DrawingArea" >&2
        exit 1
    }
    grep -q '!m_compositing && m_hasAcceleratedCompositing && (m_forceCompositingMode' \
        Source/WebCore/rendering/RenderLayerCompositor.cpp || {
        echo "webkitgtk: o patch nao-compor-sem-aceleracao nao aplicou no RenderLayerCompositor" >&2
        exit 1
    }
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # USE_SYSPROF_CAPTURE=OFF, e aqui a escolha é o OPOSTO da do unifdef, de
    # propósito. O CMake oferece dois caminhos — usar a libsysprof-capture-4 do
    # sistema, ou compilar a cópia em ThirdParty/libsysprof-capture, que existe
    # no tarball (34 arquivos, conferido). Não se toma nenhum dos dois: uma
    # ÚNICA chave desliga o recurso inteiro, porque
    # WEBKIT_OPTION_DEPEND(USE_SYSTEM_SYSPROF_CAPTURE USE_SYSPROF_CAPTURE) faz a
    # do sistema depender desta, e com ela OFF os dois ramos do if ficam falsos.
    #
    # O que é: buffer de tracing para profiling. Numa árvore que recusou LLVM,
    # GStreamer, vídeo, WebRTC, síntese de voz, gamepad e hifenização, telemetria
    # de desempenho do navegador é a coisa mais dispensável da lista. Diferente
    # do unifdef, que é FERRAMENTA e sem ele o build não sai, este é RECURSO — e
    # a resposta certa para recurso indesejado é desligar, não embutir.

    # USE_SYSTEM_UNIFDEF=OFF, e este é o caso em que embutir está CERTO. O
    # Source/CMakeLists.txt faz `if (USE_SYSTEM_UNIFDEF) find_package(Unifdef
    # REQUIRED) else() add_subdirectory(ThirdParty/unifdef) endif()`, e a opção
    # é PRIVATE ON por padrão — pensada para distros que já empacotam a
    # ferramenta. Esta não empacota, e a alternativa seria uma receita nova para
    # um programa de mil linhas usado só para preprocessar cabeçalhos.
    #
    # A objeção que esta árvore faz a subprojeto embutido — a do wlroots, "uma
    # segunda cópia invisível para o audit" — NÃO se aplica: o unifdef é
    # ferramenta de BUILD, não vai para o payload, e o fonte dele já está dentro
    # do tarball pinado pelo SHA256. Embutir aqui é mais hermético que trazer um
    # tarball a mais.

    # AS OPÇÕES QUE ABORTAM. O OptionsGTK.cmake tem dezenove message(FATAL_ERROR)
    # e vários deles guardam opções que o upstream deixa ON por padrão — o CMake
    # não avisa nem degrada, ele PARA, depois de resolver todo o resto. Varridas
    # todas de uma vez em vez de uma por rodada de build:
    #
    #   GAMEPAD          ON  -> OFF, libmanette não existe aqui
    #   USE_LIBHYPHEN    ON  -> OFF, libhyphen não existe (perde-se a hifenização
    #                          automática de texto, que é perda visual e não
    #                          funcional)
    #   USE_LIBBACKTRACE ON  -> OFF, libbacktrace não existe (backtrace de crash
    #                          fica menos detalhado)
    #   USE_JPEGXL/AVIF/WOFF2  ON -> OFF, já estavam
    #   USE_LCMS         ON  -> fica ON, o lcms2 ESTÁ na árvore
    #   USE_LIBDRM/USE_GBM   -> ficam no padrão, ambas achadas (libdrm e mesa)
    #   USE_LIBSECRET    ON  -> fica ON, o libsecret ESTÁ na árvore
    #   ENABLE_WEBXR         -> o CMake o faz depender de GAMEPAD, e desliga só
    #
    # ENABLE_GAMEPAD exige a libmanette, e o CMake não avisa: ele ABORTA com
    # "libmanette is required for ENABLE_GAMEPAD" depois de resolver tudo o mais.
    # O padrão da porta GTK é ON (OptionsGTK.cmake:103). Um navegador sem vídeo,
    # sem WebRTC e sem síntese de voz não tem por que falar com joystick, e
    # desligar isto tira também o WEBXR, que o próprio CMake faz depender dele
    # (linha 162).
    #
    # O comentário fica AQUI e não entre as opções: comentário no meio de uma
    # continuação `\` encerra o comando, e o `sh -n` não acusa.
    cmake -S . -B build -G Ninja \
        -DPORT=GTK \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DUSE_GTK4=ON \
        -DENABLE_WAYLAND_TARGET=ON \
        -DENABLE_X11_TARGET=OFF \
        -DENABLE_VIDEO=ON \
        -DENABLE_WEB_AUDIO=ON \
        -DENABLE_WEB_CODECS=ON \
        -DENABLE_SPEECH_SYNTHESIS=OFF \
        -DENABLE_WEB_RTC=OFF \
        -DENABLE_GAMEPAD=OFF \
        -DUSE_GSTREAMER=ON \
        -DUSE_GSTREAMER_GL=OFF \
        -DUSE_GSTREAMER_MPEGTS=OFF \
        -DUSE_GSTREAMER_WEBRTC=OFF \
        -DENABLE_BUBBLEWRAP_SANDBOX=ON \
        -DUSE_LIBSECRET=ON \
        -DENABLE_INTROSPECTION=OFF \
        -DENABLE_DOCUMENTATION=OFF \
        -DENABLE_JOURNALD_LOG=OFF \
        -DENABLE_MINIBROWSER=OFF \
        -DENABLE_SPELLCHECK=OFF \
        -DUSE_WOFF2=OFF \
        -DUSE_AVIF=OFF \
        -DUSE_JPEGXL=OFF \
        -DUSE_LIBHYPHEN=OFF \
        -DUSE_LIBBACKTRACE=OFF \
        -DUSE_SYSTEM_UNIFDEF=OFF \
        -DUSE_SYSPROF_CAPTURE=OFF
    # O PARALELISMO É LIMITADO AQUI, e o número saiu de medição e não de gosto.
    # Os unified sources do WebCore concatenam dezenas de .cpp por unidade de
    # tradução, e o cc1plus de cada um chega a 4,9 GB de RSS — medidos, com
    # quatro em paralelo somando 12,6 GB numa máquina de 31 GB. O efeito não foi
    # falha: foi THRASHING. O swap encheu (8,5 de 8,5 GB), o kswapd0 subiu a 73%
    # de CPU, o tempo de sistema foi a 95% contra 3% de usuário, e o load bateu
    # 69 em 8 núcleos. O build ficou dezessete minutos sem produzir um objeto,
    # vivo e sem progredir — que é o modo de falha mais caro de diagnosticar,
    # porque não deixa log nenhum.
    #
    # Duas coisas que essa medição desmente: a cadeia roda em SCHED_IDLE e isso
    # NÃO protege contra pressão de memória, que é global; e o pacote não era
    # vítima da carga da máquina, era a causa dela.
    #
    # O teto é 2 e não 4: dois cc1plus de ~5 GB cabem com folga, e o custo é
    # tempo de parede, que é o recurso barato aqui.
    JOBS_WEBKIT=$JOBS
    [ "$JOBS_WEBKIT" -gt 2 ] && JOBS_WEBKIT=2
    ninja -C build -j"$JOBS_WEBKIT"
    DESTDIR="$STAGE" ninja -C build install

    # E a API 6.0 que o Epiphany exige, e ela vem de USE_GTK4=ON. Se um dia a
    # opcao mudar de nome, o build entregaria a 4.1 (GTK3) sem reclamar e o
    # Epiphany e que falharia, horas depois, procurando um .pc que nao existe.
    for pc in webkitgtk-6.0.pc webkitgtk-web-process-extension-6.0.pc; do
        [ -e "$STAGE/usr/lib/pkgconfig/$pc" ] || {
            echo "webkitgtk: $pc nao foi produzido — a API 6.0 nao saiu" >&2
            ls "$STAGE/usr/lib/pkgconfig" 2>/dev/null >&2
            exit 1
        }
    done
    # As duas promessas centrais desta receita, conferidas no ELF e nao na linha
    # de comando: nada de GStreamer (nao ha decodificador nenhum na arvore) e
    # nada de X11 (o alvo e Wayland puro).
    SO=$(ls "$STAGE"/usr/lib/libwebkitgtk-6.0.so* 2>/dev/null | head -1)
    [ -n "$SO" ] || {
        echo "webkitgtk: libwebkitgtk-6.0.so nao foi produzida" >&2
        exit 1
    }
    for lib in libX11 libxcb; do
        if readelf -d "$SO" | grep -q "$lib"; then
            echo "webkitgtk: o motor ligou $lib, contrariando as opcoes" >&2
            readelf -d "$SO" | grep NEEDED >&2
            exit 1
        fi
    done
    # A GUARDA DO GSTREAMER INVERTEU DE SINAL, e a inversao e a mudanca: ate a
    # 0.13 ela cobrava a AUSENCIA do libgstreamer, porque a arvore nao tocava
    # midia por decisao. Agora toca, e o que se cobra e a presenca — de novo
    # aqui e nao na tela do usuario. Sem estas ligacoes o motor compila e o
    # <video> fica mudo, que e o silencio que esta receita existe para negar.
    for lib in libgstreamer libgstapp libgstpbutils libgsttag libgstvideo libgstaudio libgstfft; do
        readelf -d "$SO" | grep -q "$lib" || {
            echo "webkitgtk: o motor NAO ligou $lib; o video nao vai tocar" >&2
            readelf -d "$SO" | grep NEEDED >&2
            exit 1
        }
    done
    unset lib
    # GL do GStreamer fora: a arvore compoe por software, e o caminho GL
    # exigiria EGL/GLES que o wlroots e a Mesa daqui nao oferecem.
    if readelf -d "$SO" | grep -q 'libgstgl'; then
        echo "webkitgtk: ligou o GStreamer GL, que esta arvore nao tem" >&2
        exit 1
    fi
    # O confinamento e o outro compromisso: sem os processos auxiliares no
    # lugar, o navegador nao sobe.
    [ -d "$STAGE/usr/libexec/webkitgtk-6.0" ] || {
        echo "webkitgtk: os processos auxiliares nao foram instalados" >&2
        find "$STAGE/usr/libexec" -maxdepth 2 2>/dev/null >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
