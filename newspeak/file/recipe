NAME=file
VERSION=5.48
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="gcc-pass2 binutils-glibc make gawk"
ABOUT="Identifica o tipo de um arquivo pelos bytes dele, e instala a libmagic junto. Entra por um argumento concreto e não por completude: o próprio ferramental desta distro depende dele. O bootstrap/sbom, que extrai a evidência de licenciamento de dentro dos artefatos, decide como abrir cada um chamando 'file -b' — e a Distrópica não conseguia rodar a própria ferramenta. Com zlib, para que ele enxergue dentro de arquivo comprimido em vez de parar em 'gzip compressed data'; sem bzip2, xz e zstd porque nenhuma das três está na árvore como biblioteca, e o BusyBox as descomprime pela linha de comando quando alguém precisa."
LICENSE="BSD-2-Clause"
SRC="https://astron.com/pub/file/file-$VERSION.tar.gz"
SHA256="ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283"

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr \
        --enable-zlib \
        --disable-bzlib \
        --disable-xzlib \
        --disable-zstdlib \
        --disable-lzlib \
        --disable-static
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -x "$STAGE/usr/bin/file" ] || {
        echo "file: o binario nao foi produzido" >&2; exit 1;
    }
    # A base magica e o pacote inteiro: sem ela o comando roda e nao reconhece
    # nada, que e pior do que nao existir.
    [ -s "$STAGE/usr/share/misc/magic.mgc" ] || {
        echo "file: a base magica compilada nao foi instalada" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
