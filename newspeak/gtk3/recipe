NAME=gtk3
VERSION=3.24.52
KIND=source
TOOLCHAIN=native
DEPS="glibc glib cairo pango gdk-pixbuf at-spi2-core libepoxy fribidi wayland wayland-protocols libxkbcommon mesa fontconfig freetype harfbuzz"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc wayland-protocols gettext at-spi2-core findutils"
ABOUT="Toolkit gráfico de compatibilidade, presente pelos dois programas grandes que ainda não saíram dele: o GIMP 3.2, cujo meson.build pede gtk+-3.0, e o Inkscape 1.4, construído sobre o gtkmm-3.0. Não é o toolkit da distro — esse é o gtk4, e a distinção não é acadêmica. O GTK3 está em manutenção desde 2020 e foi sucedido pelo 4 em 2021; numa distro edge, deixá-lo ocupar o lugar de padrão seria inversão. Entrou com o Firefox, que também exigia gtk+3.0, e ficou quando o navegador passou a ser o Epiphany, sobre GTK4. Quando o GIMP e o Inkscape tiverem porte para o 4, esta receita sai. O que se escreve e se traz de fora nesta árvore é GTK4. UM backend, Wayland; X11, broadway, win32 e quartz desligados. O X11 esteve ligado enquanto o Firefox estava aqui — o libxul.so referenciava vinte e um símbolos gdk_x11_* e era ligado com -z now, então o carregador o recusava sem eles — e saiu com ele: as bibliotecas cliente do X, o backend xlib do cairo e o GLX no libepoxy foram junto, e o atk-bridge, que o GTK3 só usa no backend X11, deixou de ser carregado. Medido em 2026-09-24: nenhum binário do GIMP ou do Inkscape liga libX11. Sem introspection, que serviria a ligações para outras linguagens e exigiria o gobject-introspection; sem colord, que é gestão de perfil de cor; sem tracker3, que é indexação de arquivos para o diálogo de busca; sem cloudproviders, que integra armazenamento remoto por dbus. O único backend de impressão é o de arquivo: os outros exigiriam CUPS."
LICENSE=LGPL-2.0-or-later
SRC="https://download.gnome.org/sources/gtk/3.24/gtk-$VERSION.tar.xz"
SHA256=80931fa472a77b9a164f6740e3c0b444fac6770054632d35a7ff9d679e5e7b9f

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dwayland_backend=true \
        -Dx11_backend=false \
        -Dbroadway_backend=false \
        -Dwin32_backend=false \
        -Dquartz_backend=false \
        -Dxinerama=no \
        -Dcolord=no \
        -Dcloudproviders=false \
        -Dtracker3=false \
        -Dprofiler=false \
        -Dprint_backends=file \
        -Dintrospection=false \
        -Dgtk_doc=false \
        -Dman=false \
        -Ddemos=false \
        -Dexamples=false \
        -Dtests=false \
        -Dinstalled_tests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # O que importa é o que o Firefox e qualquer aplicação GTK vão procurar.
    # A Mesa ensinou que conferir a intenção da opção não basta: assertam-se
    # os artefatos.
    [ -e "$STAGE/usr/lib/pkgconfig/gtk+-3.0.pc" ] || {
        echo "gtk3: gtk+-3.0.pc não foi produzido" >&2
        exit 1
    }
    [ -e "$STAGE/usr/lib/pkgconfig/gtk+-wayland-3.0.pc" ] || {
        echo "gtk3: backend Wayland não foi produzido" >&2
        exit 1
    }
    # Pela AUSÊNCIA. O backend X11 existia por um motivo único e documentado: o
    # libxul.so do Firefox referenciava vinte e um símbolos gdk_x11_* e era
    # ligado com -z now, então o carregador os exigia todos antes da primeira
    # linha. O Firefox saiu, e com ele o único consumidor de X desta árvore.
    ! [ -e "$STAGE/usr/lib/pkgconfig/gtk+-x11-3.0.pc" ] || {
        echo "gtk3: backend X11 foi produzido e não deveria" >&2
        exit 1
    }
    # E o Wayland tem que continuar lá: é o backend que de fato roda.
    readelf -sW --dyn-syms "$STAGE/usr/lib/libgdk-3.so.0" 2>/dev/null \
        | grep -q " gdk_wayland_display_get_wl_display\$" || {
        echo "gtk3: libgdk-3 não exporta os símbolos Wayland" >&2
        exit 1
    }
    # Estado de máquina não entra no manifesto: o cache de módulos de entrada
    # é gerado por gtk-query-immodules-3.0 e depende do que está instalado.
    rm -f "$STAGE/usr/lib/gtk-3.0/3.0.0/immodules.cache"
    find "$STAGE" -type d -empty -delete
}
