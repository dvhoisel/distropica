NAME=wbg
VERSION=1.3.0
KIND=source
TOOLCHAIN=native
DEPS="glibc pixman wayland libpng"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf busybox tllist wayland-protocols"
ABOUT="O PAPEL DE PAREDE. Um programa que faz UMA coisa: desenha uma imagem na camada de fundo (wlr-layer-shell, camada background) e fica de pé segurando a superfície até a sessão acabar. Da mesma família minimalista do foot — C, pixman, wayland-client e mais nada. Só o decodificador PNG entra (libpng, já paga): a parede desta árvore é um PNG gerado na própria receita desktop, e cada decodificador extra — jpeg, webp, jxl, svg — seria superfície de ataque e bytes mortos a serviço de um formato que ninguém embarca. Quem escolhe a imagem é a receita desktop, no autostart; este pacote entrega o programa."
LICENSE=MIT
SRC="https://codeberg.org/dnkl/wbg/releases/download/$VERSION/wbg-$VERSION.tar.gz"
SHA256="5e23555c599e58f8fc76f2f8a697149c9fe96702a337a3e0457d503becb307a5"

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dwerror=false \
        -Dpng=enabled \
        -Djpeg=disabled \
        -Dwebp=disabled \
        -Djxl=disabled \
        -Dsvg=false \
        -Dsystem-nanosvg=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    [ -x "$STAGE/usr/bin/wbg" ] || {
        echo "wbg: o binário não foi produzido" >&2
        exit 1
    }
    install -d "$STAGE/usr/share/doc/wbg"
    install -m 0644 LICENSE "$STAGE/usr/share/doc/wbg/LICENSE"
    [ -s "$STAGE/usr/share/doc/wbg/LICENSE" ] || {
        echo "wbg: LICENSE não instalada" >&2
        exit 1
    }
    # Um decodificador, e nenhum a mais.
    readelf -d "$STAGE/usr/bin/wbg" | grep -q 'libpng' || {
        echo "wbg: não ligou a libpng; a parede é um PNG" >&2
        exit 1
    }
    if readelf -d "$STAGE/usr/bin/wbg" | grep -qE 'libjpeg|libwebp|libjxl|libX11|libxcb'; then
        echo "wbg: ligou decodificador ou X11 que deveria estar fora" >&2
        readelf -d "$STAGE/usr/bin/wbg" | grep NEEDED >&2
        exit 1
    fi
    if readelf -d "$STAGE/usr/bin/wbg" | grep -qE 'RPATH|RUNPATH'; then
        echo "wbg: o binário saiu com RPATH; a auditoria vai recusar" >&2
        exit 1
    fi
    find "$STAGE" -type d -empty -delete
}
