NAME=harfbuzz
VERSION=14.3.1
KIND=source
TOOLCHAIN=native
DEPS="glibc gcc-pass2 glib freetype zlib icu"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf"
ABOUT="Motor de moldagem de texto: recebe uma sequência de caracteres e uma fonte e devolve quais glifos desenhar, onde e com que ligaduras. É o que transforma 'fi' em um glifo só e o que faz o árabe e o devanágari serem escritos corretamente em vez de letra a letra. O Pango o exige, e por isso o GTK também. Escrito em C++, daí o gcc-pass2 em DEPS — quem é dono da libstdc++ nesta árvore é ele. COM ICU, e isto MUDOU: até a 0.12 o ICU estava desligado porque o glib cobria as propriedades Unicode que esta árvore usava, e uma base de 30 MB de tabelas não se justificava. O WebKitGTK obriga — o find_package(HarfBuzz REQUIRED COMPONENTS ICU) do OptionsGTK.cmake procura o módulo harfbuzz-icu, e sem ele o motor do navegador não configura. Como o ICU entrou na árvore por causa do WebKit de qualquer forma, ligá-lo aqui não acrescenta pacote: acrescenta a libharfbuzz-icu e move o FINGERPRINT deste pacote, e por transitividade o de pango, cairo, gtk4 e GIMP. Sem graphite2 e sem cairo: o primeiro é um motor de moldagem alternativo que ninguém aqui pede, e o segundo só serve ao hb-view, que é utilitário de depuração e está desligado junto."
LICENSE=MIT
SRC="https://github.com/harfbuzz/harfbuzz/releases/download/$VERSION/harfbuzz-$VERSION.tar.xz"
SHA256="9dae9538aae2ffdf70cec31f2c27bf68e2aaeeae3112688467697d5faf6194f7"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dglib=enabled \
        -Dgobject=enabled \
        -Dfreetype=enabled \
        -Dcairo=disabled \
        -Dchafa=disabled \
        -Dpng=disabled \
        -Dicu=enabled \
        -Dgraphite2=disabled \
        -Dtests=disabled \
        -Ddocs=disabled \
        -Dutilities=disabled \
        -Dbenchmark=disabled \
        -Dintrospection=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    find "$STAGE" -type d -empty -delete
}
