NAME=python
VERSION=3.14.6
KIND=source
# gawk: o `./configure` desta fonte chama awk para gerar o config.status, e
# declarar só `busybox` NÃO garante awk — o gawk supersede o busybox e leva
# /usr/bin/awk embora. A falta só aparece quando o gawk já foi construído no
# mesmo plano, então a quebra é sensível à ordem. Conferido no próprio
# configure da fonte pinada, não suposto.
BUILD_DEPS="binutils make busybox gawk"
PROVISIONAL=1
# NOTA: esta correção só tem efeito em bootstrap NOVO. Numa árvore onde a
# semente já cedeu caminhos ao sucessor, o minitrue recusa reconstruí-la
# ("provisório X já cedeu caminhos; baseline preservado") — e com razão:
# reconstruir retomaria os arquivos do sucessor. Os erros de auditoria que
# ela resolve permanecem na árvore atual como dívida de bootstrap.
ABOUT="interpretador Python SEMENTE; prereq de build da glibc (scripts .py do build). PROVISIONAL: cede os caminhos ao python-glibc, que é o interpretador de verdade — este aqui não tem nenhum módulo de extensão C e existe só para a glibc conseguir se construir. python.org não publica binário Linux (SPEC-0007) — daí a ironia de ter que compilá-lo antes da glibc. Build mínimo: sem shared, pip, módulos de teste ou bindings externos de OpenSSL/zlib; a glibc só usa Python básico"
LICENSE=Python-2.0.1
SRC="https://www.python.org/ftp/python/$VERSION/Python-$VERSION.tar.xz"
SHA256=143b1dddefaec3bd2e21e3b839b34a2b7fb9842272883c576420d605e9f30c63

build() {
    tar -xJf "$DL" --strip-components=1
    # zig cc gera binário estático no alvo musl, e um Python estático não faz
    # dlopen dos módulos de extensão. MODULE_BUILDTYPE=static compila os módulos
    # da stdlib EMBUTIDOS no interpretador (a tag *@MODULE_BUILDTYPE@* do
    # Setup.stdlib.in). CFLAGS: zig cc trata __DATE__/__TIME__ como erro
    # (getbuildinfo.c). Desabilitar explicitamente os módulos externos que já
    # existem no root pós-E2 impede que um rebuild do bootstrap misture o alvo
    # musl do Zig com libcrypto/libz da glibc. A glibc só usa Python básico.
    cat > Modules/Setup.local <<'SETUP'
*disabled*
_ssl
_hashlib
zlib
SETUP
    # PKG_CONFIG=/bin/false: este interpretador tem de ser CEGO ao rootfs.
    # Ele compila com zig/musl, mas o configure inspeciona o ambiente — e no
    # dia em que o pkgconf entrou na árvore (por causa do netfilter, sem
    # nenhuma relação com Python), o check de zlib passou a responder "sim",
    # o USE_ZLIB_CRC32 foi ligado e o binascii falhou procurando zlib.h que o
    # sysroot musl não tem. Acrescentar uma ferramenta de build mudou a
    # configuração de um pacote sem relação com ela: é a não-hermeticidade da
    # SPEC-0013 §5. Enquanto a view de build não for fechada, declarar a
    # cegueira é a defesa disponível.
    MODULE_BUILDTYPE=static PKG_CONFIG=/bin/false ./configure --prefix=/usr --disable-shared \
        --without-ensurepip --with-ensurepip=no --disable-test-modules \
        CFLAGS="-Wno-error=date-time -Wno-error"
    make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # config-3.14/ é a configuração de build de MÓDULOS DE EXTENSÃO C, e este
    # interpretador é estático e não tem nenhum — os módulos da stdlib estão
    # embutidos nele (MODULE_BUILDTYPE=static, acima). Nada aqui pode usar
    # aquilo, e o diretório trazia três defeitos que a auditoria acusou:
    # makesetup e install-sh com '#!/bin/sh', que a semente não fornece, e um
    # python-config.py com '#!/usr/bin/python3.14' — um interpretador que ela
    # NÃO É e não instala, porque quem o instala é o sucessor python-glibc.
    #
    # O sucessor tem o próprio config-3.14-x86_64-linux-gnu/, em caminho
    # DIFERENTE, então não havia cessão possível: esta cópia era peso morto
    # apontando para quem veio depois. Mesmo princípio do glibc largando ldd e
    # tzselect — não entregar o que não é seu nem funciona.
    rm -rf "$STAGE/usr/lib/python3.14/config-3.14"

    # Mesmo princípio, um degrau abaixo: encodings/rot_13.py vem do upstream com
    # modo 755 e '#!/usr/bin/env python' — um comando `python` que esta árvore
    # não tem e não pretende ter (instala python3.14, e PEP 394 deixa o nome nu
    # a cargo da distro). O arquivo NÃO é um programa: é o codec usado por
    # "x".encode("rot13") e por `python -m encodings.rot_13`, sempre importado,
    # nunca executado por shebang.
    #
    # Some-se o BIT DE EXECUÇÃO, não o arquivo nem o shebang: o módulo é
    # necessário, e reescrever a linha divergiria dos bytes do upstream sem
    # necessidade. Sem o bit, ele deixa de ser executável e para de declarar um
    # interpretador inexistente — que é exatamente o que a auditoria acusa.
    #
    # A busca é por padrão, e não pelo nome do arquivo, para que uma stdlib
    # futura com outro resquício igual seja tratada em vez de reabrir isto.
    # Sem `awk`: o pipeline anterior usava um, e a view desta receita pode não
    # ter awk nenhum — o busybox está lá, mas já cedeu /usr/bin/awk ao gawk. O
    # awk falhava, o `while read` recebia vazio e saía com 0, então o conserto
    # não acontecia EM SILÊNCIO. `case` do shell resolve sem ferramenta externa.
    find "$STAGE/usr/lib/python3.14" -type f -name '*.py' -perm -u+x -exec sh -c '
        for arquivo do
            case $(head -1 "$arquivo") in
                "#!"*"/env python")
                    chmod a-x "$arquivo"
                    echo "  bit de execução removido de $arquivo" ;;
            esac
        done
    ' _ {} +

    find "$STAGE" -type d -empty -delete
}
