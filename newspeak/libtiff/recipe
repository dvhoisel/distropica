NAME=libtiff
VERSION=4.7.2
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib libjpeg-turbo"
BUILD_DEPS="gcc-pass2 binutils-glibc make"
ABOUT="Leitor de TIFF. Está aqui pelo mesmo motivo do libjpeg-turbo e por nenhum outro: o GTK4 o pede com dependency() incondicional. Sem ele o meson do gtk4 tenta BAIXAR o subprojeto do wrapdb durante o build — o que esta distro não aceita, porque build que busca fonte na rede não é reproduzível e não passa pelo SHA256 pinado da receita. Ao contrário do jpeg, este ainda constrói com autotools, então não precisou de cmake. Sem os utilitários de linha de comando e sem as codificações exóticas — LZMA, WebP, ZSTD e JBIG exigiriam quatro bibliotecas que não existem aqui, para formatos que ninguém nesta árvore abre. Com zlib e jpeg, que são as duas compressões que TIFF de verdade usa."
LICENSE="libtiff"
SRC="https://download.osgeo.org/libtiff/tiff-$VERSION.tar.gz"
SHA256=672bd7d10aee4606171afb864f3570b83340f6a33e2c186dc0512f7145ffdf6a

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr \
        --disable-static \
        --disable-tests \
        --disable-lzma --disable-webp --disable-zstd --disable-jbig \
        --disable-libdeflate \
        --disable-cxx \
        --with-zlib-include-dir=/usr/include \
        --with-jpeg-include-dir=/usr/include
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -f "$STAGE/usr/lib/pkgconfig/libtiff-4.pc" ] || {
        echo "libtiff: libtiff-4.pc ausente; o gtk4 nao a encontraria" >&2
        exit 1
    }
    # --disable-cxx e a guarda que o acompanha: sem eles o pacote instala a
    # libtiffxx, um wrapper C++ de tres classes sobre a mesma API, e ela arrasta
    # libstdc++ e libgcc_s para o fechamento de EXECUCAO — que nesta arvore
    # significa declarar o gcc-pass2 inteiro em DEPS.
    #
    # E ninguem a usa. Varri /usr/lib e /usr/bin do rootfs com readelf: os unicos
    # arquivos que referenciam libtiffxx sao os proprios links dela. O gtk4, o
    # unico consumidor de TIFF aqui, pede dependency('libtiff-4') e chama a API
    # C. Pagar uma dependencia de runtime por uma biblioteca que nada abre seria
    # o pior dos dois mundos.
    achado=$(find "$STAGE" -name 'libtiffxx*' -print)
    [ -z "$achado" ] || {
        echo "libtiff: a libtiffxx foi construida apesar do --disable-cxx" >&2
        echo "$achado" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
