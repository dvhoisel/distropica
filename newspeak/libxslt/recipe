NAME=libxslt
VERSION=1.1.45
KIND=source
TOOLCHAIN=native
DEPS="glibc libxml2 busybox"
# gawk: o configure gerado pelo autoconf usa $AWK dentro do config.status,
# e sem ele a configuração morre em "config.status: error: could not create
# ..." depois de já ter respondido a todos os testes — erro tardio e de
# leitura ruim. Conferido no configure da fonte pinada, não suposto: são 8 a
# 12 usos de $AWK na seção do config.status. É a convenção da árvore, que
# tem 75 receitas declarando gawk pelo mesmo motivo.
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf libxml2 gawk"
ABOUT="Processador XSLT e o xsltproc usado pelos geradores do GIMP. Segue o estável junto com a libxml2: a 1.1.44 em diante exige libxml2 2.15.1, e até a 0.16 a árvore segurava a 1.1.43 por causa da série 2.13 da libxml2, que saiu. Python, extensões criptográficas, plugins, depurador e profiler ficam desligados; as bibliotecas compartilhadas e a ferramenta de transformação permanecem."
LICENSE=MIT
SRC="https://download.gnome.org/sources/libxslt/1.1/libxslt-$VERSION.tar.xz"
SHA256="9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --without-python --without-crypto --without-plugins \
        --without-debug --without-debugger --without-profiler
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -x "$STAGE/usr/bin/xsltproc" ] || { echo "libxslt: xsltproc ausente" >&2; exit 1; }
    [ -e "$STAGE/usr/lib/libxslt.so.1.1.43" ] || { echo "libxslt: libxslt.so.1.1.43 ausente" >&2; exit 1; }
    [ -e "$STAGE/usr/lib/libexslt.so.0.8.24" ] || { echo "libxslt: libexslt.so.0.8.24 ausente" >&2; exit 1; }
    [ -e "$STAGE/usr/lib/pkgconfig/libxslt.pc" ] || { echo "libxslt: libxslt.pc ausente" >&2; exit 1; }
    [ -e "$STAGE/usr/lib/pkgconfig/libexslt.pc" ] || { echo "libxslt: libexslt.pc ausente" >&2; exit 1; }
    readelf -d "$STAGE/usr/bin/xsltproc" | grep -Fq 'Shared library: [libxslt.so.1]' || {
        echo "libxslt: xsltproc não referencia libxslt.so.1" >&2
        exit 1
    }
    ! find "$STAGE" -type f -name '*.a' -print -quit | grep -q . || {
        echo "libxslt: biblioteca estática inesperada" >&2
        exit 1
    }
    ! find "$STAGE" -type f -path '*/python*' -print -quit | grep -q . || {
        echo "libxslt: payload Python inesperado" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
