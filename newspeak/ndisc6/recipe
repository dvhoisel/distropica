NAME=ndisc6
VERSION=1.0.8
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="make gcc-pass2 binutils-glibc"
ABOUT="Ferramentas de descoberta IPv6. Entra por um motivo específico: o kernel faz SLAAC sozinho, mas ignora o RDNSS do Router Advertisement, e o busybox não sabe lê-lo — numa rede que anuncia DNS só por RA, o sistema ficaria com endereço IPv6 e sem resolver nome nenhum. O rdisc6 resolve isso em UMA execução: manda um Router Solicitation, imprime o RA e sai, sem daemon — o que importa num sistema que ainda não tem gerenciador de serviço. Traz junto ndisc6, tcptraceroute6 e traceroute6, úteis para diagnóstico. Sem os auxiliares que exigem privilégio permanente."
LICENSE=GPL-2.0-only
SRC="https://www.remlab.net/files/ndisc6/ndisc6-$VERSION.tar.bz2"
SHA256=1f2fb2dc1172770aa5a09d39738a44d8b753cc5e2e25e306ca78682f9fea0b4f

build() {
    # bzip2 por um cano, como em libmnl: não se presume tar com bz2 embutido.
    bunzip2 -c "$DL" | tar -x --strip-components=1
    # --disable-rdnssd: o daemon de RDNSS é justamente o que NÃO queremos —
    # sem gerenciador de serviço ele não teria onde viver. O rcS usa o rdisc6
    # de uma vez só.
    ./configure \
        --prefix=/usr \
        --disable-rdnssd \
        --disable-suid-install
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
