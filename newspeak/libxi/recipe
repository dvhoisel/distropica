NAME=libxi
VERSION=1.8.3
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxext libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto glibc libx11 libxext libxfixes"
ABOUT="A extensão XInput2: teclado, mouse, touchpad e tablet com múltiplos dispositivos e eventos brutos. No Wayland quem faz isso é a libinput, já construída aqui e usada pelo weston. Entra pelo NEEDED do libxul.so."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXi-$VERSION.tar.xz"
SHA256=7ad60056f01af4f786cfe93b3a7707447711626fc8da2637bec71a90409babe5

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static --without-xmlto --without-fop --without-xsltproc
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXi.so.6" ] || {
        echo "libxi: libXi.so.6 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
