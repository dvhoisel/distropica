NAME=libevent
VERSION=2.1.13
KIND=source
TOOLCHAIN=native
DEPS="glibc openssl"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="gcc-pass2 binutils-glibc make gawk findutils"
ABOUT="Laço de eventos. Está aqui por UM consumidor — o tmux — e por nada mais, o que é o suficiente: sem ela o tmux não constrói. Ele usa a libevent para multiplexar as janelas, os clientes e os pseudo-terminais num processo só, que é o que permite a sessão sobreviver ao cliente que a abriu. Com openssl, porque o bufferevent_openssl faz parte da biblioteca e desacoplá-lo exigiria --disable-openssl, o que deixaria um pedaço da API faltando para qualquer consumidor futuro por economia de nada — o openssl já está na árvore. Sem os testes e sem o benchmark, que não são payload."
LICENSE="BSD-3-Clause AND ISC"
SRC="https://github.com/libevent/libevent/releases/download/release-$VERSION-stable/libevent-$VERSION-stable.tar.gz"
SHA256=f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr \
        --disable-static \
        --disable-samples \
        --disable-libevent-regress
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    ls "$STAGE/usr/lib/libevent.so"* >/dev/null 2>&1 || {
        echo "libevent: a biblioteca compartilhada nao foi produzida" >&2
        exit 1
    }
    # O event_rpcgen.py sai. Ele comeca com '#!/usr/bin/env python' e gera codigo
    # C para a camada de RPC da libevent — camada que nada nesta arvore usa; o
    # tmux, unico consumidor, quer o laco de eventos e mais nada. Manter o script
    # custaria declarar busybox em DEPS pelo /usr/bin/env E um interpretador
    # python que nao esta no fechamento de execucao: o resultado seria um
    # gerador de codigo instalado e incapaz de rodar, que e pior do que ausente.
    # A auditoria de fechamento nao aceitaria o meio-termo, e tem razao.
    rm -f "$STAGE/usr/bin/event_rpcgen.py" "$STAGE/usr/bin/event_rpcgen"
    achado=$(find "$STAGE" ! -type d -name 'event_rpcgen*' -print)
    [ -z "$achado" ] || {
        echo "libevent: o gerador de RPC continua instalado:" >&2
        echo "$achado" >&2
        exit 1
    }
    # `.py` instalado com modo 755 e '#!/usr/bin/env python' declara um
    # interpretador que esta árvore não tem: ela instala python3.14, e a PEP 394
    # deixa o nome nu a cargo da distro. A auditoria recusa o payload, e com
    # razão — um executável declara o que exige. Some-se o BIT DE EXECUÇÃO e não
    # a linha, para não divergir dos bytes do upstream.
    #
    # Sem `awk`, de propósito: a view desta receita pode não ter awk nenhum, já
    # que o busybox cedeu /usr/bin/awk ao gawk. `case` do shell basta.
    find "$STAGE" -type f -name '*.py' -perm -u+x -exec sh -c '
        for arquivo do
            case $(head -1 "$arquivo") in
                "#!"*"/env python")
                    chmod a-x "$arquivo"
                    echo "  bit de execução removido de $arquivo" ;;
            esac
        done
    ' _ {} +
    find "$STAGE" -type d -empty -delete
}
