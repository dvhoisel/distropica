NAME=iwd
VERSION=3.12
KIND=source
TOOLCHAIN=native
DEPS="glibc dbus readline ncurses"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="make gcc-pass2 binutils-glibc pkgconf gawk"
ABOUT="O daemon de Wi-Fi. Substitui o wpa_supplicant e faz o trabalho inteiro: varredura, autenticação WPA2 e WPA3, e um cliente DHCP próprio — por isso não arrasta wpa_supplicant nem libnl, que seriam mais dois pacotes. Escrito pela Intel sobre a ell, que ele EMBUTE no tarball (134 arquivos em ell/); o --enable-external-ell é opt-in e não o usamos, o que dispensa um pacote separado. Delega criptografia ao kernel pela AF_ALG, então não depende de OpenSSL. Fala D-Bus e só D-Bus: a API dele é uma árvore de objetos no barramento do sistema, e é por ali que o iwgtk conversa com ele. Gere apenas Wi-Fi; a ethernet continua com o udhcpc do busybox no rc.d, que já funciona. Sem unidade systemd, que aqui não existe. O tarball é o .tar.xz do kernel.org, conferido contra o sha256sums.asc assinado que eles publicam e contra o pino do Void — fonte upstream assinada mais uma distro independente, que é conferência melhor que duas distros."
LICENSE=LGPL-2.1-or-later
SRC="https://mirrors.edge.kernel.org/pub/linux/network/wireless/iwd-$VERSION.tar.xz"
SHA256=d89a5e45c7180170e19be828f9e944a768c593758094fc57a358d0e7c4cb1a49

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # --enable-dbus-policy instala a política em /usr/share/dbus-1: sem ela o
    # daemon sobe e o barramento recusa o nome, o que falha longe da causa.
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --libexecdir=/usr/libexec \
        --disable-systemd-service \
        --enable-dbus-policy \
        --disable-manual-pages
    make -j"$JOBS"
    make install DESTDIR="$STAGE"

    [ -x "$STAGE/usr/libexec/iwd" ] || [ -x "$STAGE/usr/bin/iwd" ] || {
        echo "iwd: o daemon não foi produzido" >&2
        exit 1
    }
    # Sem a política, o daemon não consegue registrar net.connman.iwd no
    # barramento do sistema — e o sintoma aparece só no boot.
    ls "$STAGE"/usr/share/dbus-1/system.d/*.conf >/dev/null 2>&1 || {
        echo "iwd: política D-Bus não foi instalada" >&2
        exit 1
    }
    # /var/lib/iwd guarda as redes conhecidas e as senhas: é estado do usuário,
    # criado no primeiro uso, e não pode entrar no manifesto.
    rm -rf "$STAGE/var"

    mkdir -p "$STAGE/etc/rc.d/rcS.d"
    cat > "$STAGE/etc/rc.d/rcS.d/07-iwd.sh" <<'IWDDROP'
# Drop-in de inicializacao: o daemon de Wi-Fi. Sourced pelo rcS do base.
#
# ESTE ARQUIVO NAO EXISTIA, e a consequencia foi a Distropica 0.10 sair com uma
# ferramenta grafica de Wi-Fi que nao abria. Tudo o mais estava certo: o iwgtk
# compilado, ligado nas bibliotecas certas, com lancador no painel e icone de
# 32px conferido por guarda. Mas o iwgtk e um cliente D-Bus do iwd e nada
# subia o iwd — clicar no icone nao fazia nada, sem mensagem em lugar nenhum.
#
# A licao ficou registrada aqui porque e generalizavel: nesta distro, daemon
# que nenhum drop-in inicia e daemon que nao existe. Conferir que o binario foi
# produzido, como a guarda do build() faz, nao diz nada sobre isso.
#
# Depende do 06-dbus.sh, e a ordem e por isso: a API do iwd E o barramento do
# sistema. Sem ele, o daemon sobe, tenta registrar net.connman.iwd, falha e sai.
#
# O /var/lib/iwd e criado AQUI e nao no pacote: guarda as redes conhecidas e as
# senhas delas, que sao estado do usuario. 0700 porque o conteudo e segredo.
if [ -x /usr/libexec/iwd ]; then
    mkdir -p /var/lib/iwd
    chown root:root /var/lib/iwd 2>/dev/null || true
    chmod 0700 /var/lib/iwd
    if [ -S /run/dbus/system_bus_socket ]; then
        # Sem '>/dev/null 2>&1': se o daemon tiver o que dizer ao morrer, isso
        # precisa chegar ao console. A versao anterior desta linha silenciava a
        # saida dele, do mesmo modo que o drop-in do dbus silenciava a sua — e
        # foi assim que um Wi-Fi que nao funcionava virou "clicar no icone nao
        # faz nada", sem uma unica pista em lugar nenhum.
        /usr/libexec/iwd &
        iwd_pid=$!
        # E a conferencia e se ele CONTINUA VIVO, nao se o shell conseguiu
        # dispara-lo — coisa que sempre da certo. Um daemon que sai no primeiro
        # segundo (politica D-Bus recusada, nome ja tomado, socket sumindo) e
        # indistinguivel de um daemon saudavel para quem so olha o '&'.
        sleep 1
        if kill -0 "$iwd_pid" 2>/dev/null; then
            echo "distropica: iwd iniciado"
        else
            echo "distropica: iwd saiu logo apos iniciar; sem Wi-Fi" >&2
        fi
        unset iwd_pid
    else
        # Dizer POR QUE, e nao so que falhou: sem esta linha o sintoma volta a
        # ser "o botao de Wi-Fi nao faz nada", que nao aponta para lugar nenhum.
        echo "distropica: iwd NAO iniciado — sem barramento D-Bus do sistema" >&2
    fi
fi
IWDDROP
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/07-iwd.sh"
    find "$STAGE" -type d -empty -delete
}
