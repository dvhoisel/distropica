NAME=base
VERSION=0.2
KIND=source
TOOLCHAIN=none
DEPS="busybox"
ABOUT="Config de boot da Fase B (SPEC-0006): /etc/inittab (busybox init → getty → login), rc.d/rcS (monta proc/sys/devtmpfs/tmpfs, mdev, hostname e DHCP IPv4), rc.d/rcK, hostname, motd, os-release e a licença da Distrópica. Receita de MONTAGEM: sem SRC (não baixa nada), o build() gera arquivos legíveis e instala auxiliares que fazem parte do mesmo snapshot da receita. Instala defaults de /etc via fábrica (/usr/share/factory/etc → materializa em /etc). NÃO gerencia contas: passwd/shadow são estado do admin (um futuro base-files/adduser + doas cuida disso; SPEC-0006 §5)."
LICENSE="GPL-3.0-or-later"

build() {
    mkdir -p "$STAGE/etc/rc.d" "$STAGE/etc/udhcpc" \
        "$STAGE/usr/share/licenses/distropica"
    install -m 0755 "$WORK/udhcpc.script" \
        "$STAGE/etc/udhcpc/default.script"
    install -m 0644 "$WORK/GPL-3.0-or-later.txt" \
        "$STAGE/usr/share/licenses/distropica/GPL-3.0-or-later.txt"
    install -m 0644 "$WORK/NOTICE" \
        "$STAGE/usr/share/licenses/distropica/NOTICE"

    cat > "$STAGE/etc/inittab" <<'INITTAB'
# /etc/inittab — busybox init (SPEC-0006 Fase B). Legivel de cabo a rabo:
# `cat /etc/inittab` responde "o que roda no boot?".
::sysinit:/etc/rc.d/rcS
# console serial (QEMU/serial) e VGA tty1 — getty -> login
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100
tty1::respawn:/sbin/getty 38400 tty1
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/rc.d/rcK
INITTAB

    cat > "$STAGE/etc/rc.d/rcS" <<'RCS'
#!/bin/sh
# rcS — inicializacao unica (SPEC-0006 §3): monta o basico, popula /dev,
# configura hostname e tenta DHCP IPv4 sem tornar a rede requisito do login.
BB=/bin/busybox
$BB mount -t proc     proc /proc 2>/dev/null
$BB mount -t sysfs    sys  /sys  2>/dev/null
$BB mount -t devtmpfs dev  /dev  2>/dev/null
$BB mount -t tmpfs    tmp  /tmp  2>/dev/null
$BB mount -t tmpfs    run  /run  2>/dev/null
$BB mdev -s 2>/dev/null
[ -f /etc/hostname ] && $BB hostname -F /etc/hostname 2>/dev/null
$BB ip link set lo up 2>/dev/null
for network_path in /sys/class/net/*; do
    [ -e "$network_path" ] || continue
    interface=${network_path##*/}
    [ "$interface" != lo ] || continue
    if ! $BB ip link set "$interface" up 2>/dev/null; then
        echo "distropica: rede indisponivel em $interface (nao subi a interface)"
        continue
    fi
    if $BB udhcpc -n -q -t 2 -T 2 -i "$interface" \
        -s /etc/udhcpc/default.script >/dev/null 2>&1; then
        echo "distropica: rede configurada em $interface"
    else
        echo "distropica: DHCP indisponivel em $interface; seguindo sem rede"
    fi
done
echo "distropica: rcS ok (mounts, mdev, hostname)"
RCS
    chmod 755 "$STAGE/etc/rc.d/rcS"

    cat > "$STAGE/etc/rc.d/rcK" <<'RCK'
#!/bin/sh
# rcK — desligamento ordenado (SPEC-0006 §3).
/bin/busybox sync
/bin/busybox umount -a -r 2>/dev/null
RCK
    chmod 755 "$STAGE/etc/rc.d/rcK"

    cat > "$STAGE/etc/hostname" <<'HOST'
distropica
HOST

    cat > "$STAGE/etc/os-release" <<'OSREL'
NAME="Distropica"
ID=distropica
PRETTY_NAME="Distropica (edge/rolling)"
VERSION="rolling"
ANSI_COLOR="1;30"
HOME_URL="https://github.com/dvhoisel/distropica"
OSREL

    cat > "$STAGE/etc/motd" <<'MOTD'
Distrópica development
  minitrue archives             lista os registros instalados
  minitrue verify               confere a integridade do sistema
  minitrue rectify <pacote>     instala ou atualiza um pacote
MOTD
}
