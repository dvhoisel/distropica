    osrel_build=$(sed -n 's/^BUILD_ID="\(.*\)"/\1/p' "$STAGE/etc/os-release")
    [ "$osrel_pretty" = "$MIDIA" ] && [ "$osrel_build" = "$MIDIA" ] || {
