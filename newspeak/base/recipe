NAME=base
VERSION=0.2
KIND=source
TOOLCHAIN=none
DEPS="busybox ndisc6"
ABOUT="Config de boot da Fase B (SPEC-0006): /etc/inittab (busybox init → getty → login), rc.d/rcS (monta proc/sys/devtmpfs/tmpfs, mdev, hostname, DHCP IPv4 e, em IPv6, DHCPv6 mais o RDNSS do Router Advertisement lido de uma vez pelo rdisc6 — o kernel faz SLAAC sozinho mas ignora o RDNSS, e o busybox nao sabe le-lo), rc.d/rcK, hostname, motd, os-release e a licença da Distrópica. Duas peças existem por causa da separação de propriedade do manifesto, e não por gosto de indireção: o /etc/rc.d/session, despachante da tty1, e o laço de drop-ins /etc/rc.d/rcS.d/*.sh no fim do rcS. O /etc/inittab e o rcS pertencem a ESTE pacote; um pacote que precise subir daemon no boot ou tomar a tty1 — o 'desktop', com o seatd e o labwc, é o primeiro — não pode reescrevê-los sem colidir. Então o base pergunta em vez de saber: a tty1 sempre pede login, e se /usr/bin/distropica-desktop existir o despachante prepara como root o runtime e o log da sessão, que o pacote desktop sobe depois do login e nunca como root. Note que o base NÃO cria /etc/rc.d/rcS.d: diretório vazio vira claim de árvore no manifesto v2 e bloquearia o pacote que fosse depositar o drop-in ali — foi assim que a glibc confiscou o /usr/share/locale. Receita de MONTAGEM: sem SRC (não baixa nada), o build() gera arquivos legíveis e instala auxiliares que fazem parte do mesmo snapshot da receita. Instala defaults de /etc via fábrica (/usr/share/factory/etc → materializa em /etc). NÃO gerencia contas: passwd/shadow são estado do admin. Quem dá a senha da conta 'distropica' é o instalador, que a pede junto com a de root; o 04-usuario.sh cria a conta no primeiro boot se ela não existir e nunca troca uma senha já gravada (SPEC-0006 §5)."
LICENSE="GPL-3.0-or-later"

build() {
    mkdir -p "$STAGE/etc/rc.d" "$STAGE/etc/udhcpc" \
        "$STAGE/usr/share/licenses/distropica"
    install -m 0755 "$WORK/udhcpc.script" \
        "$STAGE/etc/udhcpc/default.script"
    install -m 0755 "$WORK/udhcpc6.script" \
        "$STAGE/etc/udhcpc/default6.script"
    install -m 0644 "$WORK/GPL-3.0-or-later.txt" \
        "$STAGE/usr/share/licenses/distropica/GPL-3.0-or-later.txt"
    install -m 0644 "$WORK/NOTICE" \
        "$STAGE/usr/share/licenses/distropica/NOTICE"
    install -m 0644 "$WORK/LICENSING.md" \
        "$STAGE/usr/share/licenses/distropica/LICENSING.md"

    # /var/run -> /run. O LINK DE COMPATIBILIDADE QUE FALTAVA, e a ausencia dele
    # custou uma rodada inteira de diagnostico.
    #
    # O /var/run foi o lugar historico dos sockets e pidfiles; ha mais de uma
    # decada o lugar e /run, e toda distro entrega este link para os programas
    # compilados contra o caminho antigo. Esta arvore nao entregava, e o
    # primeiro programa a notar foi o iwd: ele traz
    # 'unix:path=/var/run/dbus/system_bus_socket' compilado dentro (vem do ell,
    # que ele embute), o dbus-daemon escuta em /run/dbus/system_bus_socket, e o
    # resultado medido em QEMU foi 'Failed to initialize D-Bus' seguido de o
    # daemon sair — com o barramento no ar, funcionando, dois caracteres ao
    # lado. O sintoma final era o botao de Wi-Fi nao abrir nada.
    #
    # Conferido antes de escolher onde consertar: a glib e a libdbus desta
    # arvore ja usam /run; so o ell usa o caminho velho. Ainda assim o conserto
    # e aqui e nao no drop-in do iwd, porque quem esta errado e o LAYOUT — o
    # proximo binario de terceiro compilado contra /var/run bateria na mesma
    # parede, e um DBUS_SYSTEM_BUS_ADDRESS no drop-in so esconderia isso.
    #
    # Vai no payload e nao num drop-in porque e ESTRUTURA e nao estado: o /run e
    # tmpfs recriado a cada boot, mas o link que aponta para ele e tao estatico
    # quanto o /bin -> /usr/bin. Fica no manifesto e o verify o confere.
    mkdir -p "$STAGE/var"
    ln -s /run "$STAGE/var/run"

    cat > "$STAGE/etc/inittab" <<'INITTAB'
# /etc/inittab — busybox init (SPEC-0006 Fase B). Legivel de cabo a rabo:
# `cat /etc/inittab` responde "o que roda no boot?".
::sysinit:/etc/rc.d/rcS
# console serial (QEMU/serial) — getty -> login
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100
# tty1 e o console primario, e pede login. O /etc/rc.d/session prepara como
# root o que a sessao grafica vai precisar (runtime e log) e da o getty; quem
# sobe o modo grafico depois do login e o /etc/profile.d do pacote desktop. A
# separacao existe porque o /etc/inittab pertence ao pacote base e o modo
# grafico ao pacote desktop — um nao pode reescrever o arquivo do outro sem
# colidir no manifesto.
tty1::respawn:/etc/rc.d/session
# tty2 e a saida de emergencia: getty puro, sempre. Se a sessao grafica
# entrar em ciclo de respawn na tty1, ainda ha onde logar com Alt+F2.
tty2::respawn:/sbin/getty 38400 tty2
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/rc.d/rcK
INITTAB

    cat > "$STAGE/etc/rc.d/session" <<'SESSION'
#!/bin/sh
# session — o que roda na tty1, como root, antes do login.
#
# A TTY1 PEDE LOGIN DESDE A 0.17. Ate a 0.16 este script era a sessao
# grafica: preparava o terreno e dava `su -l distropica -c distropica-desktop`,
# e a maquina ligava direto na sessao, com a conta sem senha. Com o bloqueio de
# tela na suspensao, isso virou teatro — reiniciar contornaria o bloqueio —, e
# o modelo mudou por decisao do mantenedor: a conta tem senha (o instalador a
# pede), a tty1 pede login, e quem sobe a sessao grafica e o /etc/profile.d do
# pacote desktop, DEPOIS do login e nunca como root.
#
# O que fica aqui e so o que o usuario nao consegue fazer sozinho, porque
# exige root:
#
#   o /run/user/UID. /run e de root, modo 0755; o lancador tentava criar o
#   diretorio e o mkdir falhava calado, e o compositor saia por falta de
#   XDG_RUNTIME_DIR com uma mensagem que nao apontava para permissao nenhuma;
#
#   o /var/log/distropica-sessao.log, gravavel pelo usuario. O lancador manda
#   a saida do compositor para la, e /var/log e de root — foi assim que a
#   primeira sessao sem privilegio morreu na primeira linha com "Permission
#   denied". O NOME e do PAPEL, nao do programa: ele ja foi weston.log, o
#   compositor virou labwc, e esta linha continuou criando o arquivo antigo
#   enquanto o lancador escrevia outro. Truncado a cada volta da tty1 de
#   proposito: o que interessa e a falha desta sessao.
#
# A CONDICAO E 'A GLIBC RESOLVE A CONTA?', e nao 'o id acha?': o busybox tem
# parser proprio do /etc/passwd e aceita arquivo que a glibc recusa, e quem
# precisa da conta e o dbus da sessao, pela glibc. Sem a conta, nao ha o que
# preparar: a tty1 pede login do mesmo jeito, e o root entra para ver o que
# houve — o aviso do 04-usuario.sh no inicio do boot diz o que procurar.
if [ -x /usr/bin/distropica-desktop ] && getent passwd distropica >/dev/null 2>&1; then
    sessao_uid=$(id -u distropica)
    mkdir -p "/run/user/$sessao_uid"
    chown "$sessao_uid:$sessao_uid" "/run/user/$sessao_uid" 2>/dev/null || true
    chmod 0700 "/run/user/$sessao_uid"
    mkdir -p /var/log
    : > /var/log/distropica-sessao.log
    chown "$sessao_uid:$sessao_uid" /var/log/distropica-sessao.log 2>/dev/null || true
    chmod 0644 /var/log/distropica-sessao.log
    unset sessao_uid
fi
exec /sbin/getty 38400 tty1
SESSION
    chmod 755 "$STAGE/etc/rc.d/session"

    cat > "$STAGE/etc/busybox.conf" <<'BBCONF'
# /etc/busybox.conf — QUAIS applets do BusyBox mantem privilegio.
#
# O binario do busybox e setuid root (ver a receita dele, que explica por que).
# Sozinho, isso faria TODO applet rodar como root — um `ls` privilegiado, um
# `cp` privilegiado, uma superficie enorme por causa de um comando so. Este
# arquivo e o que impede isso: o busybox desta arvore e compilado com
# FEATURE_SUID_CONFIG, le esta lista no arranque e LARGA privilegio em tudo que
# nao estiver aqui.
#
# A sintaxe e '<applet> = <permissoes> <usuario>.<grupo>', e 'ssx' significa
# setuid, setgid e executavel por qualquer um.
#
# DOIS NOMES, e cada um tem de justificar-se:
#
#   su      e a razao de o bit existir. Sem ele um usuario comum nao tem como
#           virar root nesta distro — nao ha sudo, nao ha doas, nao ha shadow.
#           A sessao grafica roda como 'distropica' desde o 04-usuario.sh.
#   passwd  para a conta comum poder trocar a PROPRIA senha. Sem privilegio ele
#           nao escreve em /etc/shadow, e a alternativa seria pedir root para
#           uma operacao que e do dono da conta.
#
# O que NAO esta aqui e deliberado. `mount` e `umount` ficam de fora: montar
# disco e operacao de administrador nesta maquina, e liberar isso a qualquer um
# daria acesso ao conteudo de qualquer particao. `login` tambem: quem o invoca
# e o getty, que ja roda como root pelo inittab.
#
# Este arquivo precisa ser de root e nao ser gravavel por grupo ou outros; o
# busybox o ignora em silencio se nao for, e o efeito seria voltar ao
# comportamento embutido sem ninguem notar.
[SUID]
su = ssx root.root
passwd = ssx root.root
BBCONF
    chmod 0644 "$STAGE/etc/busybox.conf"

    cat > "$STAGE/etc/profile" <<'PROFILE'
# /etc/profile — o ambiente de um shell de LOGIN.
#
# ESTE ARQUIVO NAO EXISTIA, e a ausencia dele custava duas coisas.
#
# Sem ele o PATH vinha do default compilado no BusyBox — /usr/local/bin:/bin:
# /usr/bin — e isso deixava de fora:
#
#   /sbin e /usr/sbin, com 837 executaveis desta arvore. O sistema funcionava
#   porque o rcS e os drop-ins chamam tudo por caminho absoluto, mas quem
#   digitasse 'poweroff' ou 'connmand' no console recebia "not found";
#
#   $HOME/.local/bin, que e onde TODO instalador moderno de ferramenta de
#   usuario deposita binario — o do Claude Code e o do Codex entre eles.
#   Instalar qualquer um deles nesta distro terminava com o programa no disco,
#   funcionando, e invisivel para o shell.
#
# A ORDEM IMPORTA e nao e alfabetica: o que o usuario instalou vem PRIMEIRO,
# para que uma versao mais nova em $HOME preceda a do sistema; depois
# /usr/local/bin, que e o territorio do administrador; depois o sistema.
PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# O prompt diz QUEM e ONDE, e o '#' contra '$' distingue root de conta comum —
# que nesta distro e a diferenca entre poder reescrever o /usr e nao poder.
if [ "$(id -u 2>/dev/null || echo 0)" = 0 ]; then
    PS1='\u@\h:\w# '
else
    PS1='\u@\h:\w$ '
fi
export PS1

# Diretorios do XDG, declarados em vez de deixados ao default de cada programa.
# Sem eles cada ferramenta escolhe o proprio canto e o /home vira um deposito de
# pontos-arquivo sem dono.
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_DATA_HOME XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME

# DROP-INS, pelo mesmo motivo do /etc/rc.d/rcS.d: um pacote que precise por
# variavel no ambiente nao pode reescrever ESTE arquivo sem colidir com o base,
# que e o dono dele. Deposita um .sh ali e pronto. O laco tolera o diretorio
# vazio ou ausente — o base NAO o cria, porque diretorio vazio vira claim de
# arvore no manifesto v2 e bloquearia quem fosse depositar o primeiro.
for perfil_d in /etc/profile.d/*.sh; do
    [ -r "$perfil_d" ] && . "$perfil_d"
done
unset perfil_d
PROFILE
    chmod 0644 "$STAGE/etc/profile"

    mkdir -p "$STAGE/etc/acpi/PWRF"
    cat > "$STAGE/etc/acpi/PWRF/00000080" <<'PWRBTN'
#!/bin/sh
# O botao de energia. Chamado pelo acpid quando o firmware envia o evento
# PWRF/00000080, que e o que uma UEFI manda ao se apertar o botao — e o que o
# 'system_powerdown' do QEMU emula.
#
# Sem isto o botao nao faz NADA: o kernel gera o evento, ninguem escuta, e a
# unica forma de desligar e digitar poweroff num console. Numa maquina de
# verdade isso significa segurar o botao por cinco segundos e cortar a energia
# com o filesystem montado.
#
# E foi assim que esta arvore produziu um defeito que levou horas para
# entender: o aceite em QEMU matava a VM sem desligar, o journal do ext4 ficava
# com a atualizacao de TAMANHO do /etc/passwd sem os DADOS, e o boot seguinte
# replayava isso — arquivo com a primeira linha, um buraco de bytes nulos, e o
# resto. O parser do busybox pula nulos; o da glibc para neles. O sintoma final
# era a sessao grafica nao achar a propria conta.
exec /sbin/poweroff
PWRBTN
    chmod 0755 "$STAGE/etc/acpi/PWRF/00000080"

    mkdir -p "$STAGE/etc/acpi/LID"
    cat > "$STAGE/etc/acpi/LID/00000080" <<'TAMPA'
#!/bin/sh
# A tampa fechou. Chamado pelo acpid, como root. O nome do caminho e o que o
# acpid do BusyBox 1.35 monta, lido no acpid.c da fonte pinada e nao suposto: o
# evento SW_LID com valor 1 vira "button/lid LID0 00000080", e a tabela de acoes
# leva LID0 a LID/00000080. So o FECHAMENTO tem evento; abrir nao chama nada.
#
# Duas coisas, nesta ordem, e a ordem e o conteudo:
#
#   1. BLOQUEIA a sessao grafica, se houver uma. O swaylock -f so volta depois
#      de a tela estar trancada (ext-session-lock-v1: dali em diante o labwc
#      nao mostra janela nenhuma, nem se o swaylock morrer). Suspender antes
#      disso entregaria a sessao aberta a quem abrisse a tampa.
#   2. SUSPENDE em RAM.
#
# O swaylock roda como o DONO da sessao, e nao como root: e a senha dele que o
# bloqueio confere. Quem e o dono se le do runtime — o /run/user/UID que tem o
# socket do Wayland —, e nao de um nome fixo, para valer para qualquer conta.
exec >> /var/log/distropica-tampa.log 2>&1
echo "$(date '+%F %T') tampa fechada"

grep -qw mem /sys/power/state 2>/dev/null || {
    echo "  o kernel nao oferece suspensao em RAM; nada a fazer"
    exit 0
}

for socket in /run/user/*/wayland-[0-9]*; do
    [ -S "$socket" ] || continue
    runtime=${socket%/*}
    uid=${runtime##*/}
    dono=$(awk -F: -v u="$uid" '$3 == u { print $1; exit }' /etc/passwd)
    [ -n "$dono" ] && [ -x /usr/bin/swaylock ] || break
    # O timeout existe para um compositor travado nao impedir a maquina de
    # dormir com a bateria acabando. Sem bloqueio confirmado, o log diz.
    if timeout 15 su -s /bin/sh "$dono" -c \
        "XDG_RUNTIME_DIR='$runtime' WAYLAND_DISPLAY='${socket##*/}' exec /usr/bin/swaylock -f -c 1a1a1a"; then
        echo "  sessao de $dono bloqueada"
    else
        echo "  AVISO: o bloqueio da sessao de $dono nao confirmou (ja estava bloqueada?)"
    fi
    break
done

sync
echo "  suspendendo"
echo mem > /sys/power/state
echo "$(date '+%F %T') acordou"
TAMPA
    chmod 0755 "$STAGE/etc/acpi/LID/00000080"

    mkdir -p "$STAGE/etc/rc.d/rcS.d"
    cat > "$STAGE/etc/rc.d/rcS.d/02-swap.sh" <<'SWAPDROP'
# Drop-in de inicializacao: a area de troca. Sourced pelo rcS do base.
#
# 02 e cedo de proposito: quanto antes a swap entra, menos chance de o boot
# esbarrar em falta de memoria antes dela existir — e o que vem depois neste
# diretorio (dbus, iwd, connman, seatd, weston) e justamente o que aloca.
#
# ACHA PELO ROTULO, e nao por caminho de dispositivo. Nada aqui grava
# /dev/sda3 nem /dev/vda3 num arquivo: o instalador formata com
# 'mkswap -L DISTROPICA_SWAP' e este laco procura esse rotulo. A diferenca
# aparece no dia em que o disco muda de nome — de sda para nvme0n1, de vda para
# sda ao migrar de virtualizador — e um fstab com caminho fixo deixaria a
# maquina sem troca sem dizer por que.
#
# NAO HAVER SWAP NAO E ERRO. Instalacoes anteriores a esta mudanca nao tem
# nenhuma, disco pequeno recusa a particao, e o sistema roda sem ela.
if [ -x /sbin/swapon ] || [ -x /usr/sbin/swapon ] || command -v swapon >/dev/null 2>&1; then
    swap_dev=
    for bloco in /sys/class/block/*; do
        nome=$(basename "$bloco")
        # Discos inteiros nao tem 'partition'; so as particoes tem. Sem este
        # filtro o blkid seria chamado no disco todo, que e leitura inutil.
        [ -f "$bloco/partition" ] || continue
        rotulo=$(blkid -s LABEL -o value "/dev/$nome" 2>/dev/null)
        tipo=$(blkid -s TYPE -o value "/dev/$nome" 2>/dev/null)
        if [ "$rotulo" = DISTROPICA_SWAP ] && [ "$tipo" = swap ]; then
            swap_dev=/dev/$nome
            break
        fi
    done
    unset bloco nome rotulo tipo
    if [ -n "$swap_dev" ]; then
        if swapon "$swap_dev" 2>/dev/null; then
            # O tamanho sai junto porque 'ligou' sem numero nao permite notar
            # que a particao ficou de 8 MiB por um erro de calculo.
            echo "distropica: area de troca ligada em $swap_dev ($(awk -v d="$swap_dev" \
                '$1 == d { printf "%d MiB", $3 / 1024 }' /proc/swaps 2>/dev/null))"
        else
            echo "distropica: swapon falhou em $swap_dev; seguindo sem troca" >&2
        fi
    fi
    unset swap_dev
fi
SWAPDROP
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/02-swap.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/08-acpid.sh" <<'ACPIDROP'
# Drop-in de inicializacao: o escutador de eventos ACPI. Sourced pelo rcS.
#
# Existe para o botao de energia funcionar — ver /etc/acpi/PWRF/00000080, que
# explica o que a falta dele custou. O kernel tem CONFIG_ACPI_BUTTON=y e gera o
# evento; faltava alguem escutando.
#
# O acpid do BusyBox le /etc/acpi/<dispositivo>/<acao> e executa o arquivo
# correspondente. Sem -f ele vai para segundo plano sozinho.
if [ -x /usr/bin/acpid ] && [ -d /etc/acpi ]; then
    /usr/bin/acpid -c /etc/acpi
    # QUEM DECIDE E O PIDFILE, e nao o '$!' do shell — pela terceira vez nesta
    # arvore o mesmo engano: acpid, como o dbus-daemon --fork, DAEMONIZA
    # SOZINHO, entao o processo que o shell conhece e o pai que sai logo. Um
    # 'kill -0 $!' um segundo depois reprova um daemon perfeitamente vivo, e foi
    # o que aconteceu: o log dizia "acpid saiu logo apos iniciar" enquanto o
    # botao de energia desligava a maquina normalmente.
    espera=0
    while [ ! -f /run/acpid.pid ] && [ "$espera" -lt 20 ]; do
        espera=$((espera + 1))
        sleep 0.1
    done
    if [ -f /run/acpid.pid ] && kill -0 "$(cat /run/acpid.pid)" 2>/dev/null; then
        echo "distropica: acpid iniciado (botao de energia desliga a maquina)"
    else
        echo "distropica: acpid nao subiu; o botao de energia nao desliga" >&2
    fi
    unset espera
fi
ACPIDROP
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/08-acpid.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/07-efi.sh" <<'EFIDROP'
# Drop-in de inicializacao: o EFI de boot na ESP. Sourced pelo rcS do base.
#
# E o PAR do derivado que o minitrue refaz no rectify (DERIVED_ARTIFACTS): o
# pacote distropica-efi guarda em /opt o EFI que deve arrancar a maquina, e o
# `minipax boot-update` o leva a ESP com o anterior de reserva. Quando o
# rectify acontece no sistema vivo, o proprio minitrue chama o minipax; quando
# acontece numa raiz montada — o instalador, que retifica em /target —, ninguem
# chama, e e este drop-in que cumpre no boot seguinte.
#
# No sistema ja convergido ele confere e nao escreve nada: o EFI do pacote ja e
# byte a byte o atual da ESP. O que ele ainda faz nesse caso e repor a entrada
# de reserva na NVRAM, se uma atualizacao de BIOS a tiver apagado.
#
# Falhar aqui nao impede o boot, e nao pode: o EFI que arrancou ESTA sessao
# continua na ESP. Mas nao e silencioso — sem a linha, a descoberta de que o
# kernel novo nunca chegou a ESP ficaria para o dia em que ele fizesse falta.
if [ -x /usr/bin/minipax ] && [ -f /opt/distropica-efi/current/BOOTX64.EFI ] &&
   [ -d /sys/firmware/efi ]; then
    if efi_saida=$(/usr/bin/minipax boot-update 2>&1); then
        case "$efi_saida" in
            *BOOT_UPDATE=ja-atual*) : ;;
            *) echo "distropica: EFI de boot levado a ESP ($(printf '%s\n' "$efi_saida" |
                   sed -n 's/^BOOT_UPDATE=//p')); vale a partir do proximo boot" ;;
        esac
    else
        echo "distropica: o EFI de boot NAO chegou a ESP: $(printf '%s\n' "$efi_saida" | tail -1)" >&2
    fi
    unset efi_saida
fi
EFIDROP
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/07-efi.sh"

    mkdir -p "$STAGE/etc/rc.d/rcS.d"
    cat > "$STAGE/etc/rc.d/rcS.d/04-usuario.sh" <<'USUARIODROP'
# Drop-in de inicializacao: a conta comum. Sourced pelo rcS do base.
#
# ATE AQUI ESTA DISTRO TINHA UMA CONTA SO, root, e a sessao grafica rodava com
# ela: o Firefox, o terminal e tudo o que se abrisse na tela eram root. Isso
# nao e uma questao de etiqueta — e a diferenca entre um navegador comprometido
# poder ler o /home e poder reescrever o /usr.
#
# A conta e criada AQUI e nao no payload pelo mesmo motivo das contas do sshd e
# do messagebus, e o base e explicito sobre isso no ABOUT: passwd e shadow sao
# estado do admin, e nenhum pacote os reivindica no manifesto. Quem ja tiver a
# conta mantem a dele — todos os testes abaixo sao 'se ainda nao existir'.
#
# SEM SENHA DEFINIDA, e isso e escolha. O campo fica '!' (bloqueado), o que
# impede login por senha nesta conta; a sessao grafica nao passa por
# autenticacao porque quem a lanca e o init, como root. Definir uma e um
# `passwd distropica` como root. A alternativa — senha vazia — daria login sem
# nada em qualquer tty, e nao ha nesta distro um so lugar em que isso ajude.
distropica_uid=1000
if ! grep -q '^distropica:' /etc/passwd 2>/dev/null; then
    grep -q '^distropica:' /etc/group 2>/dev/null ||
        echo "distropica:x:$distropica_uid:" >> /etc/group
    echo "distropica:x:$distropica_uid:$distropica_uid:Distropica:/home/distropica:/bin/sh" \
        >> /etc/passwd
    grep -q '^distropica:' /etc/shadow 2>/dev/null ||
        echo 'distropica:!::0:99999:7:::' >> /etc/shadow
    # SYNC, e este e o conserto do defeito descrito logo abaixo — nao uma
    # precaucao generica. O '>>' acima escreve num buffer; o ext4 journala a
    # atualizacao de TAMANHO do inode antes de os DADOS chegarem ao disco. Se a
    # maquina perde energia nessa janela — e o PRIMEIRO boot e justamente
    # quando o operador ainda esta reiniciando a VM para ver se funcionou —, o
    # replay do journal devolve um arquivo do tamanho certo com um buraco de
    # bytes NUL no lugar da linha. O busybox pula o buraco e a glibc para nele:
    # 'id -u distropica' responde 1000, 'getent passwd distropica' nao responde
    # nada, e a sessao grafica sobe como root sem que nada tenha falhado em voz
    # alta.
    #
    # O sync custa uma fracao de segundo UMA VEZ na vida da instalacao, e e a
    # unica coisa que fecha a janela: o aviso abaixo detecta o estrago depois
    # de feito, e nao ha conserto automatico seguro para ele.
    sync
    echo "distropica: conta de usuario 'distropica' criada"
fi
# A CONTA TEM DE RESOLVER PELA GLIBC, e nao so pelo busybox. Os dois leem o
# mesmo /etc/passwd com parsers diferentes, e essa diferenca ja escondeu um
# defeito por horas: um arquivo com buraco de bytes NUL no meio faz o busybox
# pular e a glibc parar. 'id -u distropica' respondia 1000 e 'getent passwd
# 1000' dizia que a conta nao existe — e quem quebrava tres camadas acima era o
# dbus da sessao grafica, com "Looking up user ID 1000: not found".
#
# O buraco nasce de um boot cujas escritas se perderam antes do sync: os dados
# somem, o TAMANHO do inode e journaled e sobrevive, e o proximo '>>' escreve
# depois do vazio. Queda de energia no primeiro boot produz exatamente isso.
#
# Nao ha conserto automatico seguro aqui — reescrever /etc/passwd por conta
# propria e pior que o defeito. O que se pode, e se faz, e NAO deixar passar
# calado.
if command -v getent >/dev/null 2>&1 && ! getent passwd distropica >/dev/null 2>&1; then
    echo "distropica: ATENCAO — a glibc nao resolve a conta 'distropica'." >&2
    echo "            A sessao grafica vai subir como root, e programas que" >&2
    echo "            usam GApplication (o iwgtk e um) nao abrirao." >&2
    # O ESTADO VAI JUNTO COM O AVISO. Sem isto o diagnostico exige um ciclo
    # inteiro de reconstruir, instalar e bootar so para ver o arquivo — foi o
    # que aconteceu, mais de uma vez. O passwd tem quatro linhas; despeja-lo
    # custa nada e responde de primeira se o problema e conteudo (buraco de
    # nulos de um boot interrompido, campo malformado) ou se e o proprio NSS.
    echo "            --- /etc/passwd ($(wc -c < /etc/passwd) bytes) ---" >&2
    od -c /etc/passwd >&2
    echo "            --- getent root: $(getent passwd 0 >/dev/null 2>&1 &&
        echo sim || echo NAO) | nsswitch: $(sed -n 's/^passwd: *//p' \
        /etc/nsswitch.conf 2>/dev/null) ---" >&2
fi
# GRUPOS DE ACESSO A HARDWARE. Sao tres e cada um destrava uma coisa:
#
#   seat   quem pode falar com o seatd, que e quem entrega ao compositor os
#          descritores de /dev/dri e /dev/input. Sem estar neste grupo, a
#          sessao grafica de um usuario comum nao abre — o weston sai com
#          "failed to create compositor backend". O seatd e iniciado com
#          '-g seat' pelo drop-in do desktop.
#   audio  quem pode abrir /dev/snd/*. As regras do mdev deste mesmo pacote
#          dao os nos ao grupo audio; sem isso o usuario ve a placa e nao
#          consegue tocar nada, que e o modo de falha silencioso de sempre.
#   netdev quem pode COMANDAR O IWD. A politica D-Bus que o proprio iwd
#          instala (/usr/share/dbus-1/system.d/iwd-dbus.conf) so autoriza root
#          e os grupos netdev e wheel; para todo o resto o daemon responde
#          "Access denied: User must be a member of either the netdev or wheel
#          group to control iwd". Enquanto a sessao grafica era de root isso
#          nao aparecia — foi a queda de privilegio desta mesma receita que
#          criou o problema, e o sintoma medido em QEMU foi o iwgtk sair com
#          status 0, sem janela e sem erro visivel na tela: a mensagem ia para
#          o stderr do compositor, que so se le abrindo /var/log/weston.log.
#   video  quem pode mudar o BRILHO da tela. A regra de udev que o pacote
#          brightnessctl instala passa o /sys/class/backlight/*/brightness ao
#          grupo video com escrita, e as teclas de brilho do labwc chamam o
#          brightnessctl como o usuario da sessao. Sem o grupo, a tecla nao faz
#          nada e nada diz por que. De quebra, o udevd para de reclamar no boot
#          de "specified group 'video' unknown", que as regras padrao dele usam.
for grupo_hw in seat:101 audio:102 netdev:98 video:103; do
    grep -q "^${grupo_hw%%:*}:" /etc/group 2>/dev/null ||
        echo "${grupo_hw%%:*}:x:${grupo_hw##*:}:distropica" >> /etc/group
done
unset grupo_hw
# Home com dono certo e 0700: o Firefox, o GTK e o weston gravam perfil, cache
# e configuracao aqui. Se ficasse de root, a sessao subiria e todo programa
# falharia ao escrever — cada um a sua maneira, nenhum dizendo o porque.
if [ ! -d /home/distropica ]; then
    mkdir -p /home/distropica
    chown "$distropica_uid:$distropica_uid" /home/distropica 2>/dev/null || true
    chmod 0700 /home/distropica
fi
unset distropica_uid
# O segundo sync cobre /etc/group — os grupos de hardware acima entram pelo
# mesmo '>>' e correm o mesmo risco. Perder a linha do grupo 'seat' custa a
# sessao grafica inteira, e o modo de falha e o mesmo: silencioso.
sync
USUARIODROP
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/04-usuario.sh"

    cat > "$STAGE/etc/mdev.conf" <<'MDEV'
# /etc/mdev.conf — onde o mdev cria cada no de dispositivo.
#
# Existe por um detalhe que so aparece quando alguem tenta usar a placa de
# video: o mdev do BusyBox cria TUDO achatado em /dev, e nao em subdiretorios.
# Sem as regras abaixo, a placa vira /dev/card0 e o teclado vira /dev/event0 —
# enquanto a libdrm procura /dev/dri/card0 e a libinput procura
# /dev/input/event0. Nada falha em voz alta: o compositor sobe, nao acha saida
# de video nem teclado, e morre. O `=dri/` e o `=input/` movem o no para o
# diretorio certo, criando-o se preciso.
#
# Dono root:root em tudo, e isso e deliberado. O mdev do BusyBox resolve o
# nome do grupo com getgrnam e ABORTA se ele nao existir — nao avisa, nao cai
# para um default: para de criar nos de dispositivo. Escrever 'root:video'
# aqui acoplaria ESTE pacote a um grupo que ele nao cria e que so existe no
# overlay de um perfil; quem instalasse o base sem esse overlay ficaria sem
# /dev. Como hoje quem abre a placa e o compositor rodando como root, root:root
# descreve a realidade. Quando houver login grafico de usuario comum, o grupo
# e a mudanca deste modo vem juntos, e nao antes.
#
# Sem placa de video instalada, as linhas do dri nao casam com nada e sao
# inertes.
card[0-9]*      root:root 0660 =dri/
renderD[0-9]*   root:root 0660 =dri/
event[0-9]*     root:root 0640 =input/
mouse[0-9]*     root:root 0640 =input/
mice            root:root 0640 =input/
js[0-9]*        root:root 0640 =input/
# Audio, pelo mesmo motivo do dri e do input: a ALSA procura /dev/snd/pcmC0D0p
# e /dev/snd/controlC0, e o mdev, sem regra, cria tudo achatado em /dev. O
# sintoma seria o de sempre nesta arvore — nada falha em voz alta, a placa
# aparece em /proc/asound e o aplicativo diz que nao ha dispositivo de saida.
#
# Sao quatro familias de no e todas importam: controlC* e o mixer (sem ele nao
# se desmuta nada), pcmC* sao as vias de reproducao e captura, timer e usado
# pela sincronizacao, e seq e a fila MIDI. Sem placa, as linhas ficam inertes.
# root:audio e nao root:root: os nos precisam ser abriveis pela conta que roda
# a sessao grafica, e ela nao e mais root. Com root:root 0660 a placa aparece
# em /proc/asound, o alsamixer lista os controles e NADA toca — o modo de falha
# mais caro desta arvore, porque nao ha erro em lugar nenhum. O grupo audio e o
# 04-usuario.sh que cria, com a conta distropica dentro.
controlC[0-9]*  root:audio 0660 =snd/
pcmC[0-9]*      root:audio 0660 =snd/
midiC[0-9]*     root:root 0660 =snd/
hwC[0-9]*       root:root 0660 =snd/
timer           root:audio 0660 =snd/
seq             root:audio 0660 =snd/
# O resto segue o default do mdev.
.*              root:root 0660
MDEV

    cat > "$STAGE/etc/rc.d/rcS" <<'RCS'
#!/bin/sh
# rcS — inicializacao unica (SPEC-0006 §3): monta o basico, popula /dev,
# configura hostname e tenta rede (IPv4 e IPv6) sem torna-la requisito do login.
BB=/bin/busybox
$BB mount -t proc     proc /proc 2>/dev/null
$BB mount -t sysfs    sys  /sys  2>/dev/null
$BB mount -t devtmpfs dev  /dev  2>/dev/null
# devpts NAO e opcional num sistema com terminal grafico. O emulador chama
# openpty(), que precisa de /dev/ptmx e do sistema de arquivos devpts montado
# em /dev/pts; sem isso a chamada falha e o terminal simplesmente NAO ABRE,
# sem mensagem em lugar nenhum. O console de texto funciona mesmo assim,
# porque tty1 e tty2 sao terminais REAIS do kernel e nao pseudo-terminais —
# e foi por isso que a falta passou despercebida ate alguem clicar no
# lancador do terminal na sessao grafica.
$BB mkdir -p /dev/pts 2>/dev/null
$BB mount -t devpts -o gid=5,mode=620 devpts /dev/pts 2>/dev/null
# /dev/shm E REQUISITO DA SESSAO GRAFICA INTEIRA, nao de um detalhe dela. O
# shm_open() da glibc cria os segmentos ali; o wlroots serializa o keymap por
# ele — "Failed to allocate shm file for keymap" foi o erro que derrubou a
# sessao da 0.13 DEPOIS de renderer e barramento consertados — e todo cliente
# Wayland de renderizador por software compartilha buffers por wl_shm, que e o
# mesmo caminho: sem este mount o compositor nao sobe e nenhum cliente abriria
# janela. O devtmpfs NAO o traz: ele cria nos de dispositivo, e /dev/shm e um
# tmpfs que alguem tem de montar — este alguem e o init. mode=1777 porque quem
# aloca e a sessao de uid 1000, nao o root; nosuid,nodev porque e area de
# dados de usuario, nao lugar de executavel privilegiado nem de no de device.
$BB mkdir -p /dev/shm 2>/dev/null
$BB mount -t tmpfs -o mode=1777,nosuid,nodev shm /dev/shm 2>/dev/null
$BB mount -t tmpfs    tmp  /tmp  2>/dev/null
$BB mount -t tmpfs    run  /run  2>/dev/null
# O grupo audio PRECISA existir antes do mdev. O 04-usuario.sh tambem o cria,
# mas os drop-ins rodam no fim deste arquivo e o mdev resolve `root:audio`
# agora. No primeiro boot ainda havia apenas o grupo root: o mdev encontrava
# um nome desconhecido e interrompia a populacao de /dev exatamente antes dos
# pcmC*/controlC* que o Firefox e o amixer precisam. A conta pode vir depois;
# uma entrada de grupo pode nomear um membro que ainda nao existe. Se o admin
# ja escolheu outro GID para audio, preserva-se a entrada dele e o mdev resolve
# esse GID pelo nome, em vez de congelar 102 no mdev.conf.
if ! $BB grep -q '^audio:' /etc/group 2>/dev/null; then
    if printf '%s\n' 'audio:x:102:distropica' >> /etc/group; then
        $BB sync
        echo "distropica: grupo audio criado antes do mdev"
    else
        echo "distropica: nao foi possivel criar o grupo audio;" >&2
        echo "            os dispositivos de som podem ficar indisponiveis" >&2
    fi
fi
$BB mdev -s 2>/dev/null
[ -f /etc/hostname ] && $BB hostname -F /etc/hostname 2>/dev/null
$BB ip link set lo up 2>/dev/null
# QUEM MANDA NA REDE: se o connman estiver instalado, o rcS NAO configura nada.
#
# O connmand traz cliente DHCP proprio (gdhcp) e assume o cabo e o Wi-Fi. Dois
# clientes DHCP na mesma interface disputam o lease, sobrescrevem o
# /etc/resolv.conf um do outro e produzem uma rede que ora funciona ora nao —
# um defeito intermitente, que e o pior tipo de defeito para diagnosticar.
#
# O teste e a EXISTENCIA do binario, exatamente como o /etc/rc.d/session
# pergunta pelo distropica-desktop antes de decidir entre sessao grafica e
# getty. Instalar o pacote e a unica acao que o administrador tomou, e nao faz
# sentido pedir uma segunda.
#
# O laco abaixo fica, e nao e codigo morto: numa arvore sem connman ele
# continua sendo a unica coisa que da IP a maquina.
if [ -x /usr/sbin/connmand ]; then
    echo "distropica: rede sob o connman; rcS nao configura interface"
else
for network_path in /sys/class/net/*; do
    [ -e "$network_path" ] || continue
    interface=${network_path##*/}
    [ "$interface" != lo ] || continue
    if ! $BB ip link set "$interface" up 2>/dev/null; then
        echo "distropica: rede indisponivel em $interface (nao subi a interface)"
        continue
    fi
    # -t 5 -T 3: cinco tentativas de tres segundos, ate quinze ao todo. Era
    # -t 2 -T 2 — QUATRO SEGUNDOS, uma vez so — e rede real raramente
    # responde nisso: o resultado era bootar sem rede e sem resolv.conf, e o
    # navegador dizer "servidor nao encontrado" sem que nada tivesse falhado
    # em voz alta. PENDENCIA CONHECIDA: com -q o cliente sai apos obter o
    # lease, entao nao ha RENOVACAO; quando o lease expirar a rede cai. O
    # conserto e um udhcpc em daemon, e exige decidir quem o supervisiona.
    if $BB udhcpc -n -q -t 5 -T 3 -i "$interface" \
        -s /etc/udhcpc/default.script >/dev/null 2>&1; then
        echo "distropica: rede configurada em $interface"
    else
        echo "distropica: DHCP indisponivel em $interface; seguindo sem rede"
    fi
    # IPv6. Endereco e rota o kernel obtem sozinho por SLAAC ao receber o
    # Router Advertisement; o que falta e DNS. Duas fontes, nesta ordem, ambas
    # nao-fatais: DHCPv6, e o RDNSS do proprio RA — que o kernel nao expoe e o
    # busybox nao le, dai o rdisc6 (uma execucao, sem daemon).
    $BB udhcpc6 -n -q -t 3 -T 3 -i "$interface" \
        -s /etc/udhcpc/default6.script >/dev/null 2>&1 || true
    if ! $BB grep -q '^nameserver .*:' /etc/resolv.conf 2>/dev/null; then
        rdisc6 -1 -n -w 3000 "$interface" 2>/dev/null |
            $BB sed -n 's/^ *Recursive DNS server *: *//p' |
            while read -r nameserver; do
                case "$nameserver" in
                    ""|*[!0123456789abcdefABCDEF:]*) continue ;;
                    *:*) ;;
                    *) continue ;;
                esac
                $BB grep -q "^nameserver $nameserver\$" /etc/resolv.conf 2>/dev/null && continue
                printf 'nameserver %s\n' "$nameserver" >> /etc/resolv.conf
            done
    fi
done
fi
# Ganchos de inicializacao dos outros pacotes. Existe porque o /etc/inittab e
# este proprio rcS pertencem ao base, e um pacote que precise subir um daemon
# no boot — o seatd do modo grafico e o primeiro — nao pode reescrever arquivo
# de outro pacote sem colidir no manifesto. Sao SOURCED e nao executados, para
# que o drop-in possa exportar variavel e nao precise de bit de execucao.
for dropin in /etc/rc.d/rcS.d/*.sh; do
    [ -e "$dropin" ] || continue
    . "$dropin"
done
echo "distropica: rcS ok (mounts, mdev, hostname)"
RCS
    chmod 755 "$STAGE/etc/rc.d/rcS"
    # A sessao grafica depende deste mount e ja morreu uma vez pela falta dele;
    # a guarda cobra o ARQUIVO PRODUZIDO, com o modo exato — um mount sem o
    # 1777 passa num grep frouxo e falha na alocacao do primeiro usuario comum.
    grep -q 'mount -t tmpfs -o mode=1777,nosuid,nodev shm /dev/shm' \
        "$STAGE/etc/rc.d/rcS" || {
        echo "base: o rcS nao monta /dev/shm; a sessao grafica nao alocaria" \
             "shm nenhum (keymap do wlroots, buffers wl_shm de todo cliente)" >&2
        exit 1
    }

    cat > "$STAGE/etc/rc.d/rcK" <<'RCK'
#!/bin/sh
# rcK — desligamento ordenado (SPEC-0006 §3).
#
# Assim como o rcS, o rcK nao pode conhecer cada pacote que precise persistir
# estado antes de os filesystems fecharem. Os ganchos pertencem aos pacotes
# interessados e sao SOURCED aqui; o primeiro consumidor e o alsa-utils, que
# salva o volume da maquina. Sem o laco, cada novo consumidor teria de tomar
# este arquivo do base ou ficar sem shutdown ordenado.
for dropin in /etc/rc.d/rcK.d/*.sh; do
    [ -e "$dropin" ] || continue
    . "$dropin"
done
/bin/busybox sync
/bin/busybox umount -a -r 2>/dev/null
RCK
    chmod 755 "$STAGE/etc/rc.d/rcK"

    cat > "$STAGE/etc/nsswitch.conf" <<'NSS'
# Onde a glibc procura cada tipo de nome.
#
# Sem este arquivo a glibc nao falha: ela cai num default COMPILADO, que nao
# esta escrito em lugar nenhum do sistema e muda entre versoes. Para uma
# distro cujo lema e que o boot se le de cabo a rabo, depender de um default
# invisivel para resolver nome de maquina e o oposto do que se pretende.
#
# 'files dns' na ordem que importa: /etc/hosts primeiro, para que localhost e
# entradas locais funcionem sem rede nenhuma, e o DNS depois.
passwd:     files
group:      files
shadow:     files
hosts:      files dns
networks:   files
protocols:  files
services:   files
ethers:     files
rpc:        files
NSS

