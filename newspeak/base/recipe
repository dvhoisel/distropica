    cat > "$STAGE/etc/nsswitch.conf" <<'NSS'
# Onde a glibc procura cada tipo de nome.
#
# Sem este arquivo a glibc nao falha: ela cai num default COMPILADO, que nao
# esta escrito em lugar nenhum do sistema e muda entre versoes. Para uma
# distro cujo lema e que o boot se le de cabo a rabo, depender de um default
# invisivel para resolver nome de maquina e o oposto do que se pretende.
#
# 'files dns' na ordem que importa: /etc/hosts primeiro, para que localhost e
# entradas locais funcionem sem rede nenhuma, e o DNS depois.
passwd:     files
group:      files
shadow:     files
hosts:      files dns
networks:   files
protocols:  files
services:   files
ethers:     files
rpc:        files
NSS

