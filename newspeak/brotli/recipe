NAME=brotli
VERSION=1.2.0
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="make gcc-pass2 binutils-glibc cmake ninja busybox"
ABOUT="Compressão de conteúdo da web. É o 'br' do cabeçalho Content-Encoding, que hoje é a codificação preferida por praticamente todo servidor HTTPS: sem ela a libsoup3 negocia gzip e o navegador baixa mais bytes em toda página. A libsoup3 a procura pelo pkg-config e a usa quando presente. Ferramenta de linha de comando desligada — o executável 'brotli' comprime arquivo à mão, e ninguém nesta árvore o chama; o que interessa são as três bibliotecas (common, dec, enc)."
LICENSE=MIT
SRC="https://github.com/google/brotli/archive/refs/tags/v$VERSION.tar.gz"
SHA256="816c96e8e8f193b40151dad7e8ff37b1221d019dbcb9c35cd3fadbfe6477dfec"

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DBROTLI_BUILD_TOOLS=OFF \
        -DBROTLI_DISABLE_TESTS=ON
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    # São TRÊS bibliotecas e conferir uma engana: a libsoup3 liga a de
    # descompressão, e o WOFF2, se um dia entrar, liga as outras duas.
    for lib in libbrotlicommon.so libbrotlidec.so libbrotlienc.so; do
        [ -e "$STAGE/usr/lib/$lib" ] || {
            echo "brotli: $lib não foi produzida" >&2
            ls "$STAGE/usr/lib" >&2
            exit 1
        }
    done
    find "$STAGE" -type d -empty -delete
}
