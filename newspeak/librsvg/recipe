NAME=librsvg
VERSION=2.62.3
KIND=source
TOOLCHAIN=native
DEPS="glibc gcc-pass2 cairo freetype gdk-pixbuf glib harfbuzz libxml2 pango"
# xorgproto: quem roda pkg-config em cairo (ou em x11/xext/xrender) precisa dos
# .pc dos PROTOCOLOS, e eles são do xorgproto. A cadeia é indireta e por isso
# passava despercebida: cairo.pc traz `Requires.private: ... x11, xext, xrender`,
# o x11.pc traz `Requires: xproto kbproto`, e o xrender.pc traz `xproto
# renderproto`. Sem o xorgproto na view, o pkg-config falha ao gerar os cflags do
# cairo e o meson conclui que o cairo NÃO existe — indo tentar baixar um
# subprojeto. Conferido nos .pc instalados, não suposto.
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc rust cargo-c cairo freetype gdk-pixbuf glib harfbuzz libxml2 pango"
ABOUT="Renderizador SVG do GNOME usado pelos ícones vetoriais do GIMP. Compila Rust estritamente offline a partir do Cargo.lock e de 352 crates vendorizadas no snapshot; mantém o loader SVG do GdkPixbuf e gera seu cache determinístico, mas não instala CLI, documentação, GIR, Vala, testes ou AVIF."
LICENSE="LGPL-2.1-or-later AND MIT AND Apache-2.0 AND BSD-3-Clause AND Unicode-3.0 AND (Apache-2.0 WITH LLVM-exception) AND ISC AND MPL-2.0"
SRC="https://download.gnome.org/sources/librsvg/2.62/librsvg-$VERSION.tar.xz \
     https://distropica.com.br/sources/librsvg/librsvg-$VERSION-cargo-vendor.tar.xz"
SHA256="7eb449b2722a768021356f66dfee3202c229b54ed4e6a70ce40c090e97ff16f2 \
        8c37c5df2b4468dce7dd6ce07b1fd53d9fabfa35f7c8dffd856c407d46610690"

build() {
    tar -xJf "$DL" --strip-components=1
    # O vendor é um SRC normal: o Minitrue o confere e o cacheia pelo SHA antes
    # do sandbox. Isso mantém o build sem rede sem carregar 22 MiB em files/.
    tar -xJf "$DL_2"
    install -dm755 .cargo
    install -m644 "$WORK/cargo-config.toml" .cargo/config.toml

    export CARGO_HOME="$WORK/cargo-home"
    export CARGO_NET_OFFLINE=true
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release \
        -Dintrospection=disabled -Dpixbuf=enabled \
        -Drsvg-convert=disabled -Dpixbuf-loader=enabled \
        -Ddocs=disabled -Dvala=disabled -Dtests=false -Davif=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # Meson não escreve caches durante DESTDIR. O SVG é o único loader modular
    # desta árvore; gere o cache a partir do módulo staged e normalize o prefixo
    # temporário, deixando apenas caminhos canônicos /usr.
    moduledir=$(pkgconf --variable=gdk_pixbuf_moduledir gdk-pixbuf-2.0)
    cachefile=$(pkgconf --variable=gdk_pixbuf_cache_file gdk-pixbuf-2.0)
    queryloaders=$(pkgconf --variable=gdk_pixbuf_query_loaders gdk-pixbuf-2.0)
    install -dm755 "$STAGE${cachefile%/*}"
    LD_LIBRARY_PATH="$STAGE/usr/lib:/usr/lib" \
    GDK_PIXBUF_MODULEDIR="$STAGE$moduledir" \
        "$queryloaders" > "$STAGE$cachefile"
    sed -i "s|$STAGE||g" "$STAGE$cachefile"

    install -Dm644 COPYING.LIB "$STAGE/usr/share/licenses/librsvg/COPYING.LIB"
    install -Dm644 "$WORK/VENDOR-INVENTORY" \
        "$STAGE/usr/share/licenses/librsvg/VENDOR-INVENTORY"
    [ -e "$STAGE/usr/lib/pkgconfig/librsvg-2.0.pc" ] || { echo "librsvg: .pc ausente" >&2; exit 1; }
    find "$STAGE$moduledir" -name '*pixbufloader_svg.so' -print -quit | grep -q . || { echo "librsvg: loader SVG ausente" >&2; exit 1; }
    grep -q 'pixbufloader_svg' "$STAGE$cachefile" || { echo "librsvg: loader SVG ausente do cache" >&2; exit 1; }
    ! grep -q "$WORK\|$STAGE" "$STAGE$cachefile" || { echo "librsvg: cache contém caminho de build" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
