NAME=mypaint-brushes
VERSION=2.0.2
KIND=source
TOOLCHAIN=native
DEPS=""
# gawk: o `./configure` desta fonte chama awk para gerar o config.status, e
# declarar só `busybox` NÃO garante awk — o gawk supersede o busybox e leva
# /usr/bin/awk embora. A falta só aparece quando o gawk já foi construído no
# mesmo plano, então a quebra é sensível à ordem. Conferido no próprio
# configure da fonte pinada, não suposto.
BUILD_DEPS="make busybox gawk"
ABOUT="Coleção oficial de pincéis v2 que acompanha a libmypaint. É dado independente de arquitetura e fornece o pacote mypaint-brushes-2.0 procurado de forma obrigatória pelo GIMP; aplica a mesma migração surfacemap→gridmap usada pelo manifesto oficial do GIMP 3.2."
LICENSE=CC0-1.0
SRC="https://github.com/mypaint/mypaint-brushes/releases/download/v$VERSION/mypaint-brushes-$VERSION.tar.xz"
SHA256=7984a74edef94571d872d0629b224abaa956a36f632f5c5516b33d22e49eb566

build() {
    tar -xJf "$DL" --strip-components=1
    # Workaround upstream seguido pelo próprio manifesto Flatpak do GIMP
    # 3.2.4: os pincéis Dieterle migrados usam os nomes gridmap_* esperados
    # pela libmypaint atual. Os sete arquivos sem esses campos são excluídos.
    find brushes/Dieterle -iname '*.myb' \
        ! -name 'arrow#1.myb' ! -name 'Fount-offset#1.myb' \
        ! -name 'Pencil-_Left_Handed.myb' ! -name 'HalfToneCMY#1.myb' \
        ! -name 'Fountain_SF#1.myb' ! -name 'HalfTone#1.myb' \
        ! -name '8B_Pencil#1.myb' \
        -exec sed -i -e 's/surfacemap_x/gridmap_x/g' \
                     -e 's/surfacemap_y/gridmap_y/g' {} \;
    restantes=$(find brushes/Dieterle -iname '*.myb' \
        ! -name 'arrow#1.myb' ! -name 'Fount-offset#1.myb' \
        ! -name 'Pencil-_Left_Handed.myb' ! -name 'HalfToneCMY#1.myb' \
        ! -name 'Fountain_SF#1.myb' ! -name 'HalfTone#1.myb' \
        ! -name '8B_Pencil#1.myb' \
        -exec grep -q 'surfacemap_[xy]' {} \; -print | wc -l)
    [ "$restantes" -eq 0 ] || { echo "mypaint-brushes: migração surfacemap incompleta" >&2; exit 1; }
    ./configure --prefix=/usr
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    install -Dm644 COPYING "$STAGE/usr/share/licenses/mypaint-brushes/COPYING"
    [ -e "$STAGE/usr/share/pkgconfig/mypaint-brushes-2.0.pc" ] || { echo "mypaint-brushes: .pc ausente" >&2; exit 1; }
    [ -d "$STAGE/usr/share/mypaint-data/2.0/brushes" ] || { echo "mypaint-brushes: coleção ausente" >&2; exit 1; }
}
