NAME=libsass
VERSION=3.6.6
KIND=source
TOOLCHAIN=native
# gcc-pass2 e não libstdcxx: nesta árvore libstdc++.so.6 e libgcc_s.so.1
# pertencem ao gcc-pass2, que sobrescreve os do libstdcxx de bootstrap. O icu
# foi construído declarando libstdcxx e a auditoria acusou 44 erros por isso,
# derrubando o fechamento da v42; estas três receitas trazem o mesmo defeito e
# ainda não chegaram a construir.
DEPS="glibc gcc-pass2"
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk busybox"
ABOUT="O compilador de Sass em C++. Existe nesta árvore por uma razão só e indireta: a libadwaita compila o estilo dela de .scss para CSS em tempo de build, e para isso chama o sassc, que é uma casca fina sobre esta biblioteca. Não vai para o alvo — é ferramenta de build, e some do sistema instalado junto com o sassc. O upstream declara o projeto em manutenção, e isso é aceitável para o papel: gerar CSS a partir de um .scss que não muda."
LICENSE=MIT
SRC="https://github.com/sass/libsass/archive/refs/tags/$VERSION.tar.gz"
SHA256="11f0bb3709a4f20285507419d7618f3877a425c0131ea8df40fe6196129df15d"

build() {
    tar -xzf "$DL" --strip-components=1
    # O tarball da tag não traz ./configure gerado; o Makefile próprio do
    # upstream constrói a biblioteca sem autotools.
    #
    # BUILD=shared NÃO é opcional e não é preferência: o Makefile faz
    # `ifneq ($BUILD,shared) → BUILD := static` e `all: $(BUILD)`, de modo que
    # um `make` pelado produz SÓ o libsass.a. Foi o que derrubou a retomada da
    # v46 — a guarda abaixo pegou, mas depois de compilar tudo. O alvo de
    # instalação é `install: install-$(BUILD)`, então a variável tem de ir nas
    # DUAS invocações; passá-la só na primeira instalaria a estática.
    #
    # Consequência que justifica a escolha: com BUILD=static o Makefile também
    # acrescenta -static-libgcc e -static-libstdc++ conforme STATIC_LIBGCC e
    # STATIC_LIBSTDCPP, e uma libstdc++ embutida tornaria FALSA a declaração
    # `gcc-pass2` em DEPS — o audit lê ELF, e o que está embutido ele não vê.
    make -j"$JOBS" BUILD=shared PREFIX=/usr
    make install BUILD=shared PREFIX=/usr DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libsass.so" ] || {
        echo "libsass: a biblioteca compartilhada não foi produzida" >&2
        ls "$STAGE/usr/lib" 2>/dev/null >&2
        exit 1
    }
    # Conferir a existência do arquivo não basta: o que importa é que ele seja
    # objeto compartilhado de verdade e que a libstdc++ tenha ficado FORA dele.
    readelf -d "$STAGE/usr/lib/libsass.so" | grep -q 'SONAME\|NEEDED' || {
        echo "libsass: libsass.so não é objeto dinâmico" >&2
        exit 1
    }
    readelf -d "$STAGE/usr/lib/libsass.so" | grep -q 'libstdc++' || {
        echo "libsass: não ligou libstdc++ — foi embutida, e o DEPS mente" >&2
        readelf -d "$STAGE/usr/lib/libsass.so" | grep NEEDED >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
