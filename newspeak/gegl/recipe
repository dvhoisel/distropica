NAME=gegl
VERSION=0.4.70
KIND=source
TOOLCHAIN=native
DEPS="glibc gcc-pass2 babl glib glib-introspection json-glib libjpeg-turbo libpng gdk-pixbuf gexiv2 cairo pango lcms2 librsvg libtiff poppler"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc babl glib glib-introspection gobject-introspection json-glib libjpeg-turbo libpng gdk-pixbuf gexiv2 cairo pango lcms2 librsvg libtiff poppler"
ABOUT="Motor de processamento de imagens do GIMP. Além da base obrigatória (babl, GLib, JSON-GLib, JPEG e PNG), ficam ligados os importadores e operações cujos provedores já pertencem à closure do editor: GdkPixbuf, metadados Exiv2, Little CMS, SVG, TIFF, Cairo/Pango, PDF e OpenMP. O GIR é obrigatório para os plug-ins Python e para o typelib do próprio GIMP; dependências opcionais ausentes continuam explicitamente desligadas para o resultado não variar conforme o builder."
LICENSE="GPL-3.0-or-later AND LGPL-3.0-or-later AND MIT AND BSD-3-Clause"
SRC="https://download.gimp.org/gegl/0.4/gegl-$VERSION.tar.xz"
SHA256=47f50d9c3aecd375deb48c11ebfead52d162e4fc162a4b3d44618277f1faec02

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    export SETUPTOOLS_USE_DISTUTILS=local
    meson setup build --prefix=/usr --libdir=lib --buildtype=release \
        -Ddocs=false -Dgtk-doc=false -Dgi-docgen=disabled \
        -Dintrospection=true -Dvapigen=disabled -Dworkshop=false \
        -Dgdk-pixbuf=enabled -Dgexiv2=enabled -Dgraphviz=disabled \
        -Djasper=disabled -Dlcms=enabled -Dlensfun=disabled \
        -Dlibav=disabled -Dlibraw=disabled -Dlibrsvg=enabled \
        -Dlibspiro=disabled -Dlibtiff=enabled -Dlibv4l=disabled \
        -Dlibv4l2=disabled -Dlua=disabled -Dmrg=disabled \
        -Dmaxflow=disabled -Dopenexr=disabled -Dopenmp=enabled \
        -Dcairo=enabled -Dpango=enabled -Dpangocairo=enabled \
        -Dpoppler=enabled -Dpygobject=disabled -Dsdl1=disabled \
        -Dsdl2=disabled -Dumfpack=disabled -Dwebp=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -e "$STAGE/usr/lib/pkgconfig/gegl-0.4.pc" ] || { echo "gegl: gegl-0.4.pc ausente" >&2; exit 1; }
    [ -e "$STAGE/usr/lib/girepository-1.0/Gegl-0.4.typelib" ] || { echo "gegl: Gegl-0.4.typelib ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
