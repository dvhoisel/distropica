NAME=wayland
VERSION=1.25.0
KIND=source
TOOLCHAIN=native
DEPS="glibc libffi expat"
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf"
ABOUT="O protocolo e as bibliotecas cliente e servidor. Primeira receita da camada Wayland do E4b, e a decisão de perfil que a governa: esta distro é Wayland-only, sem X11 — não há libX11, libxcb nem servidor Xorg, e não haverá. Traz o wayland-scanner, que gera código C a partir das descrições de protocolo em XML; daí o expat. A libffi entra porque o despacho de mensagem do protocolo monta chamadas em tempo de execução. Sem documentação, que exigiria docbook e graphviz para gerar diagramas que ninguém vai ler num sistema sem navegador — ainda."
LICENSE=MIT
SRC="https://gitlab.freedesktop.org/wayland/wayland/-/releases/$VERSION/downloads/wayland-$VERSION.tar.xz"
SHA256=c065f040afdff3177680600f249727e41a1afc22fccf27222f15f5306faa1f03

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # -Ddtd_validation=false: a validação do XML de protocolo usa libxml2, que
    # esta árvore não tem e que traria HTTP, XPath e XSLT para conferir
    # arquivos que o próprio projeto já publica válidos.
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Ddocumentation=false \
        -Ddtd_validation=false \
        -Dtests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    # Guarda: sem o scanner, nada acima nesta camada gera código de protocolo,
    # e o erro só apareceria ao construir o compositor.
    for peca in usr/bin/wayland-scanner usr/lib/libwayland-client.so usr/lib/libwayland-server.so; do
        ls "$STAGE/$peca"* >/dev/null 2>&1 || {
            echo "FATAL: $peca não foi construído"
            exit 1
        }
    done
    find "$STAGE" -type d -empty -delete
}
