NAME=ruby
VERSION=3.4.10
KIND=source
TOOLCHAIN=native
# busybox: os executáveis das gems embutidas — bundle, irb, rake, erb, rbs,
# rdbg, ri, rdoc — declaram '#!/usr/bin/env ruby', que é a forma portátil e
# correta, e exigem /usr/bin/env. Diferente do andaime removido no build(),
# estes são programas de verdade; a convenção da árvore para script vivo é
# declarar quem fornece o interpretador, e são 37 receitas fazendo isso.
# libyaml: a extensão psych é C e liga esta biblioteca; sem ela o configure do
# Ruby imprime 'yaml.h not found', PULA a extensão e termina com sucesso. O
# preço aparece longe: o build do WebKit roda GenerateSettings.rb, que faz
# require 'yaml', e morre no objeto 2385 de 9375 com 'cannot load such file
# -- psych'. Declarar aqui é o que faz o pulo deixar de ser silencioso.
DEPS="glibc zlib openssl busybox libyaml"
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk busybox bison"
ABOUT="Interpretador Ruby, e existe aqui por um motivo único: o JavaScriptCore do WebKit gera o interpretador de bytecode dele com o offlineasm, que é escrito em Ruby. O CMake do WebKit faz find_package(Ruby 2.5), e sem ele o build do JSC não sai do lugar. É FERRAMENTA DE BUILD e nada mais — não é declarado em DEPS de ninguém, não vai para o alvo, e nenhum programa do sistema instalado o invoca. Compilado sem as extensões que só serviriam a um Ruby de uso geral, e sem os documentos, que são a maior parte do tempo de build."
LICENSE=Ruby
SRC="https://cache.ruby-lang.org/pub/ruby/3.4/ruby-$VERSION.tar.xz"
SHA256="6f32ad662baafc228d12030dbcd284f83b034dd4337b300dc84ac74d11a1eb68"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-install-doc \
        --disable-install-rdoc \
        --disable-install-capi \
        --without-gmp \
        --enable-shared
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -x "$STAGE/usr/bin/ruby" ] || {
        echo "ruby: o interpretador não foi produzido" >&2
        exit 1
    }
    # ANDAIME DE DESENVOLVIMENTO FORA DO PAYLOAD. A auditoria acusou 43 erros
    # aqui, e nenhum deles é do interpretador: 32 pedem /usr/bin/env, 8 pedem
    # /usr/bin/bash e 3 apontam para /usr/local/bin/ruby, um caminho que nesta
    # distro nunca existirá. Todos vêm de arquivos que existem para ajudar quem
    # ESCREVE uma gem, não para rodá-la:
    #
    #   bundler/templates/       gabaritos de `bundle gem` (Executable, newgem)
    #   gems/*/gems/*/bin/       só console e setup, atalhos de desenvolvedor
    #   gems/*/gems/*/sample/    exemplos do bigdecimal — os 3 do /usr/local
    #
    # Este ruby é FERRAMENTA DE BUILD e só: declarado apenas no BUILD_DEPS do
    # webkitgtk, para o offlineasm do JavaScriptCore gerar o interpretador de
    # bytecode. Conferido que nada do que sai daqui é consultado por ele — o
    # offlineasm é do WebKit e não do ruby.
    #
    # A alternativa seria declarar busybox e bash em DEPS por causa de gabarito,
    # e ainda assim sobrariam os três de /usr/local, que não têm dono possível.
    rm -rf "$STAGE"/usr/lib/ruby/*/bundler/templates
    rm -rf "$STAGE"/usr/lib/ruby/gems/*/gems/*/bin
    rm -rf "$STAGE"/usr/lib/ruby/gems/*/gems/*/sample

    # Guarda pela ausência: o payload pode conter script de ruby — ele É um
    # interpretador —, mas não script que peça OUTRO interpretador. Exercitada
    # com o head -c do BusyBox, não com a semântica do hospedeiro.
    intrusos=$(find "$STAGE" -type f -exec sh -c '
        for arquivo in "$@"; do
            if [ "$(head -c 2 "$arquivo")" = "#!" ]; then
                linha=$(head -1 "$arquivo")
                case "$linha" in
                    *"/usr/bin/ruby"*|*"/usr/bin/env ruby"*) ;;
                    *) printf "%s\t%s\n" "$arquivo" "$linha" ;;
                esac
            fi
        done
        exit 0' _ {} +)
    if [ -n "$intrusos" ]; then
        echo "ruby: o payload pede interpretador que não é o próprio ruby:" >&2
        printf "%s\n" "$intrusos" >&2
        exit 1
    fi

    find "$STAGE" -type d -empty -delete
}
