NAME=adwaita-icon-theme
VERSION=51.0
KIND=source
TOOLCHAIN=native
# O librsvg é dependência de EXECUÇÃO: é o carregador SVG do gdk-pixbuf que ele
# instala que desenha os ícones escaláveis e simbólicos deste tema. Sem ele o
# tema abre e cada ícone SVG vira o retângulo de imagem quebrada.
DEPS="hicolor-icon-theme librsvg"
# python-glibc: o meson.build chama tools/find_cursors_win32.py por run_command,
# com shebang de python3. findutils: as conferências abaixo usam find, e o
# applet do BusyBox sai de cena quando o findutils é construído no mesmo plano.
BUILD_DEPS="meson ninja python-glibc findutils"
ABOUT="Os ícones de verdade: o tema padrão do GTK, o que o gtk-icon-theme-name aponta quando ninguém mexe. Sem ele o GTK abre, mas cada ícone da interface vira o retângulo de imagem quebrada. Até a 0.16 a árvore segurava a 40.1.1, de 2021, com um argumento que foi verdade um dia: o Adwaita moderno é em boa parte SVG, renderizar SVG no GTK depende do carregador do librsvg, e o librsvg é Rust. Os dois entraram na árvore com o GIMP — o Rust como Mundo A e o librsvg com o loader do gdk-pixbuf e o cache dele — e o argumento envelheceu sem ninguém notar, porque o conferidor de versões só olhava dentro da série da URL. Agora o tema segue o estável, com o librsvg declarado como dependência de execução. A 51.0 traz 791 SVGs e 975 PNGs. O gtk-update-icon-cache que o meson.build exige encontrar não roda aqui — o índice é estado de máquina, e com DESTDIR o próprio projeto o pula —, então ele é apontado para true num native file, em vez de puxar o GTK para a construção de um pacote que só instala arquivos."
LICENSE="CC-BY-SA-3.0 OR LGPL-3.0-or-later"
SRC="https://download.gnome.org/sources/adwaita-icon-theme/51/adwaita-icon-theme-$VERSION.tar.xz"
SHA256="ba561cf3c96305a47179fa5605856ad695c9238ea07f7093aebd9ba80c4e323b"

build() {
    tar -xJf "$DL" --strip-components=1
    # O meson exige ACHAR o gtk4-update-icon-cache (ou o do GTK 3), mesmo
    # pulando a execução com DESTDIR. Apontá-lo para true é a decisão
    # explícita: o índice do tema é gerado na máquina, não empacotado.
    cat > nativo.ini <<'NATIVO'
[binaries]
gtk4-update-icon-cache = 'true'
gtk-update-icon-cache = 'true'
NATIVO
    meson setup build --prefix=/usr --libdir=lib --buildtype=release \
        --native-file nativo.ini
    DESTDIR="$STAGE" ninja -C build install

    # icon-theme.cache é estado de máquina; o GTK varre o diretório quando ele
    # não existe. Nenhum deve ter sido gerado, e se foi, sai.
    find "$STAGE" -name 'icon-theme.cache' -delete

    [ -e "$STAGE/usr/share/icons/Adwaita/index.theme" ] || {
        echo "adwaita-icon-theme: index.theme não foi instalado" >&2
        exit 1
    }
    # O tema desta versão é o escalável: conferir que os SVGs vieram é
    # conferir que o tema existe.
    n=$(find "$STAGE/usr/share/icons/Adwaita" -name '*.svg' | wc -l)
    [ "$n" -gt 700 ] || {
        echo "adwaita-icon-theme: só $n SVGs instalados" >&2
        exit 1
    }
}
