NAME=adwaita-icon-theme
VERSION=40.1.1
KIND=source
TOOLCHAIN=native
DEPS="hicolor-icon-theme"
# gawk: o `./configure` desta fonte chama awk para gerar o config.status, e
# declarar só `busybox` NÃO garante awk — o gawk supersede o busybox e leva
# /usr/bin/awk embora. A falta só aparece quando o gawk já foi construído no
# mesmo plano, então a quebra é sensível à ordem. Conferido no próprio
# configure da fonte pinada, não suposto.
BUILD_DEPS="make busybox gawk"
ABOUT="Os ícones de verdade: o tema padrão do GTK, o que o gtk-icon-theme-name aponta quando ninguém mexe. Sem ele o GTK abre, mas cada ícone da interface vira o retângulo de imagem quebrada. A versão é 40.1.1 e a escolha não é por conservadorismo — é por evidência. O Adwaita moderno (49.x) é quase inteiramente SVG simbólico, e renderizar SVG no GTK depende do carregador do librsvg, que é escrito em Rust e traria o toolchain inteiro para dentro de uma árvore que decidiu não ter Rust nem para a Mesa. Um Adwaita só de SVG aqui seria um tema de ícones invisíveis. Contei os arquivos antes de decidir: a 40.1.1 traz 2042 PNGs pré-renderizados além de 745 SVGs, então os ícones aparecem sem librsvg nenhum. O preço é ficar numa versão de 2021 e não ter os símbolos novos; a alternativa era Rust, e não paga. Corroborado pelo Alpine 3.15-stable, que é o branch daquela época — as distribuições atuais já não pinam esta versão."
LICENSE="CC-BY-SA-3.0 OR LGPL-3.0-or-later"
SRC="https://download.gnome.org/sources/adwaita-icon-theme/40/adwaita-icon-theme-$VERSION.tar.xz"
SHA256=0b6c436ed6ad9887a88ada1f72a0197b1eb73b020d8d344abab4c7fa7250f8f6

build() {
    tar -xJf "$DL" --strip-components=1
    # As duas ferramentas são PINADAS em false, e não deixadas à sorte do
    # AC_PATH_PROG, porque senão esta receita muda de comportamento conforme o
    # que MAIS está instalado — foi exatamente o que aconteceu: ela construiu
    # quando o GTK3 ainda não existia e passou a falhar depois que ele existiu.
    #
    # gtk-encode-symbolic-svg rasteriza os SVGs simbólicos em seis tamanhos, e
    # rasterizar SVG depende do carregador do librsvg, que é Rust e não está
    # nesta árvore (ver o ABOUT). Sem ele a etapa morre em "Can't load file:
    # Unrecognized image file format". O próprio configure.ac faz esta mesma
    # coisa quando não acha a ferramenta: zera symbolic_encode_sizes. Aqui a
    # decisão é explícita em vez de acidental.
    #
    # gtk-update-icon-cache gera o icon-theme.cache, que é estado de máquina.
    # O Makefile já o pula quando há DESTDIR, mas pinar remove a dúvida.
    # Pina-se a VARIÁVEL DE CACHE do autoconf, não a variável de ambiente. O
    # AC_PATH_PROG só honra um override de ambiente quando o valor PARECE um
    # caminho absoluto (o case é [\\/]* | ?:[\\/]*); passar apenas "false"
    # não casa, e ele vai buscar no PATH de todo jeito — foi o que aconteceu na
    # primeira tentativa deste conserto. A variável de cache é testada antes
    # dessa lógica e vence.
    #
    # O valor tem de ser a string "false" e não /bin/false: o configure.ac
    # compara com "xfalse" para zerar symbolic_encode_sizes. Com um caminho
    # real a comparação não casaria, a lista continuaria cheia e o /bin/false
    # seria EXECUTADO a cada ícone, devolvendo erro.
    ./configure --prefix=/usr --datadir=/usr/share \
        ac_cv_path_GTK_ENCODE_SYMBOLIC_SVG=false \
        ac_cv_path_GTK_UPDATE_ICON_CACHE=false
    make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # icon-theme.cache é gerado por gtk-update-icon-cache e reflete o que está
    # instalado na máquina — estado, não payload. O GTK varre o diretório
    # quando o cache não existe, então removê-lo custa desempenho no primeiro
    # acesso e nada mais.
    find "$STAGE" -name 'icon-theme.cache' -delete

    [ -e "$STAGE/usr/share/icons/Adwaita/index.theme" ] || {
        echo "adwaita-icon-theme: index.theme não foi instalado" >&2
        exit 1
    }
    # A razão de ser desta versão é haver PNG; se um dia sumir, o tema fica
    # invisível sem librsvg e é melhor falhar aqui do que descobrir na tela.
    n=$(find "$STAGE/usr/share/icons/Adwaita" -name '*.png' | wc -l)
    [ "$n" -gt 1000 ] || {
        echo "adwaita-icon-theme: só $n PNGs; sem librsvg o tema ficaria invisível" >&2
        exit 1
    }
}
