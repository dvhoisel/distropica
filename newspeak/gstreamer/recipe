NAME=gstreamer
VERSION=1.28.6
KIND=source
TOOLCHAIN=native
DEPS="glibc glib"
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf busybox python-glibc bison flex"
ABOUT="O núcleo do GStreamer, e SÓ o núcleo. Está aqui por uma razão medida e não por escolha: o meson do Epiphany faz dependency('gstreamer-1.0') sem nenhum 'required:', então é dependência dura do navegador — mesmo com o vídeo do WebKit desligado, que é como esta árvore o constrói. O base e o good ENTRARAM na 0.14, e até a 0.13 não havia nenhum: o núcleo ficava aqui como encanamento sem água, e um navegador que não toca mídia era o que esta distro dizia querer ser. O preço foi cobrado em uso e a decisão mudou. Hoje o base traz o encanamento e o áudio livre da Xiph, o good traz o matroskademux e o vpxdec — WebM e VP9 —, e o bad e o ugly continuam fora com os codecs patenteados que eles carregam. O ptp-helper fica de fora: é um binário setuid para sincronização de relógio em rede, e setuid é a última coisa que uma árvore como esta acrescenta sem necessidade. Sem introspection, sem exemplos, sem testes e sem benchmarks."
LICENSE=LGPL-2.1-or-later
SRC="https://gstreamer.freedesktop.org/src/gstreamer/gstreamer-$VERSION.tar.xz"
SHA256="62b6b9f0ad3147a6dd6420ac64a91180b14e990695bddd353b96041611d052ca"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dptp-helper=disabled \
        -Dintrospection=disabled \
        -Dexamples=disabled \
        -Dtests=disabled \
        -Dbenchmarks=disabled \
        -Dtools=disabled \
        -Dnls=disabled \
        -Ddoc=disabled \
        -Dlibunwind=disabled \
        -Dlibdw=disabled \
        -Dcoretracers=disabled \
        -Dbash-completion=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -e "$STAGE/usr/lib/libgstreamer-1.0.so" ] || {
        echo "gstreamer: a biblioteca compartilhada não foi produzida" >&2
        exit 1
    }

    # O -Ddoc=disabled acima NÃO impede a instalação deste gerador: o upstream o
    # instala incondicionalmente em libexec, e ele declara '#!/usr/bin/env
    # python3'. Medido na v45 — a auditoria acusou os dois requisitos, o env do
    # busybox e o python3, e o gstreamer foi para ABI_PENDING por causa disso.
    #
    # Declarar as duas dependências seria pior que remover o arquivo: colocaria
    # o Python inteiro na closure de RUNTIME de uma biblioteca de mídia, para
    # servir uma ferramenta que gera cache de documentação — exatamente o que a
    # opção já disse que esta árvore não quer. Removê-lo faz o payload
    # corresponder à intenção declarada.
    rm -f "$STAGE/usr/libexec/gstreamer-1.0/gst-plugins-doc-cache-generator"

    # A guarda que impede o retorno silencioso, conferida com o head -c do
    # BusyBox e não com a semântica do hospedeiro (lição do icu em 332ff73):
    # shebang são os dois primeiros BYTES do arquivo.
    scripts=$(find "$STAGE" -type f -exec sh -c '
        for arquivo in "$@"; do
            if [ "$(head -c 2 "$arquivo")" = "#!" ]; then
                printf "%s\n" "$arquivo"
            fi
        done
        exit 0' _ {} +)
    if [ -n "$scripts" ]; then
        echo "gstreamer: o payload contém script, e nenhum interpretador está em DEPS:" >&2
        printf "%s\n" "$scripts" >&2
        exit 1
    fi
    # Nenhum binário setuid pode sair daqui. O ptp-helper é o único candidato, e
    # está desligado; a guarda existe para o dia em que a opção mudar de nome.
    if find "$STAGE" -type f -perm -4000 | grep -q .; then
        echo "gstreamer: binário setuid no payload:" >&2
        find "$STAGE" -type f -perm -4000 >&2
        exit 1
    fi
    find "$STAGE" -type d -empty -delete
}
