NAME=gsettings-desktop-schemas
VERSION=49.1
KIND=source
TOOLCHAIN=native
DEPS="glibc glib"
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf busybox python-glibc gettext"
ABOUT="Os esquemas de configuração compartilhados do desktop GNOME. Não é código: é a declaração, em XML compilado, das chaves que aplicativos GNOME esperam encontrar no GSettings — proxy de rede, fontes de interface, preferências de acessibilidade, tema. O Epiphany o exige por nome no meson, e sem ele o navegador aborta na inicialização ao ler uma chave que não existe. Esta é a mesma classe de dependência invisível que o gschemas.compiled já foi nesta árvore: nenhum ELF aponta para ela, o vínculo é por nome de esquema em tempo de execução. Sem introspection."
LICENSE=LGPL-2.1-or-later
SRC="https://download.gnome.org/sources/gsettings-desktop-schemas/49/gsettings-desktop-schemas-$VERSION.tar.xz"
SHA256="777a7f83d5e5a8076b9bf809cb24101b1b1ba9c230235e3c3de8e13968ed0e63"

build() {
    tar -xJf "$DL" --strip-components=1
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dintrospection=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -e "$STAGE/usr/share/glib-2.0/schemas/org.gnome.desktop.interface.gschema.xml" ] || {
        echo "gsettings-desktop-schemas: os esquemas não foram instalados" >&2
        ls "$STAGE/usr/share/glib-2.0/schemas" 2>/dev/null | head >&2
        exit 1
    }
    # O gschemas.compiled é gerado pelo drop-in 02-gschemas.sh do pacote
    # 'desktop', que recompila a base inteira no boot; deixar uma cópia parcial
    # aqui criaria dois donos para o mesmo caminho.
    rm -f "$STAGE/usr/share/glib-2.0/schemas/gschemas.compiled"
    find "$STAGE" -type d -empty -delete
}
