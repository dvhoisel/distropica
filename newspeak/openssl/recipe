NAME=openssl
VERSION=4.0.1
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib"
BUILD_DEPS="gcc-pass2 binutils-glibc perl make"
ABOUT="Toolkit TLS/cripto: libcrypto + libssl. Mundo B (o openssl é distribuído como fonte). É a base de confiança da Distrópica: a libcrypto destrava os módulos de kernel ASSINADOS (o SYSTEM_TRUSTED_KEYRING que o E3 teve de desligar por falta de openssl — ver newspeak/linux) e a criptografia de attestation/federação (proveniência do minitrue). O Configure é perl, destravado no E3. Edge (P7): 4.0.1, o major mais recente do openssl.org; a linha LTS é a 3.5.x. Licença Apache-2.0 (relicenciada a partir do 3.0, fim do dual OpenSSL/SSLeay)."
LICENSE="Apache-2.0"
SRC="https://github.com/openssl/openssl/releases/download/openssl-$VERSION/openssl-$VERSION.tar.gz"
SHA256=2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09
# Chave extraída de https://www.openssl-library.org/source/pubkeys.asc;
# signer observado e primária BA5473A2B0587B07FB27CF2D216094DFD0CB81EF.
SIG_1="https://github.com/openssl/openssl/releases/download/openssl-4.0.1/openssl-4.0.1.tar.gz.asc"
SIG_EPOCH_1=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=BA5473A2B0587B07FB27CF2D216094DFD0CB81EF

build() {
    tar -xzf "$DL" --strip-components=1
    # openssl tem Configure próprio (perl — destravado no E3), não autotools.
    #   linux-x86_64 : alvo explícito, sem a adivinhação do wrapper ./config
    #   --libdir=lib : usr-merge, nada de lib64 (consistente com a distro)
    #   --openssldir : /etc/ssl guarda os certs e o openssl.cnf (FHS)
    #   shared       : gera libcrypto.so/libssl.so, não só os .a
    #   zlib         : liga a libz da distro (é DEP; NEEDED explícito)
    #   -rpath-link  : padrão recorrente da toolchain nativa — o ld não resolve
    #                  deps transitivos em /usr/lib sozinho (aqui, a libz)
    ./Configure linux-x86_64 \
        --prefix=/usr --openssldir=/etc/ssl --libdir=lib \
        shared zlib \
        -Wl,-rpath-link,/usr/lib
    make -j"$JOBS"
    # install_sw + install_ssldirs: libs/bin/headers + os diretórios de config,
    # SEM as man pages (install_docs é lento e não é superfície da distro hoje).
    make install_sw install_ssldirs DESTDIR="$STAGE"
    # O install_ssldirs deixa em /etc/ssl/misc dois scripts perl — CA.pl e
    # tsget.pl — que exigem /usr/bin/perl e /usr/bin/env sem que a receita os
    # declare. É a mesma espécie de erro que o glibc cometia com ldd e
    # tzselect, e a resposta é a mesma: são utilitários de mantenedor, não
    # ABI. Declarar perl em DEPS arrastaria o interpretador inteiro para a
    # closure de RUNTIME de todo alvo que tenha openssl — e o openssl está na
    # closure por causa do nmap e do tcpdump. O tsget é link para o tsget.pl:
    # deixá-lo seria publicar um link pendente.
    rm -f "$STAGE/etc/ssl/misc/CA.pl" \
          "$STAGE/etc/ssl/misc/tsget.pl" \
          "$STAGE/etc/ssl/misc/tsget"
    rmdir "$STAGE/etc/ssl/misc" 2>/dev/null || true
}
