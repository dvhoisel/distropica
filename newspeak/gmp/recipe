NAME=gmp
VERSION=6.3.0
KIND=source
BUILD_DEPS="m4 binutils"
ABOUT="aritmética de inteiros/racionais de precisão arbitrária; dependência de build do gcc (usada in-tree pelo gcc, mas verificável como pacote isolado). Precisa de m4 (asm) e do nm do binutils (configure)"
LICENSE="LGPL-3.0-or-later OR GPL-2.0-or-later"
SRC="https://ftp.gnu.org/gnu/gmp/gmp-$VERSION.tar.xz"
SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898

build() {
    tar -xJf "$DL" --strip-components=1
    # zig cc é clang: a detecção de CPU->asm da gmp costuma casar, mas se o
    # assembler embutido reclamar, --host=none-linux-gnu força o fallback C.
    ./configure --prefix=/usr --enable-cxx --disable-dependency-tracking
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
