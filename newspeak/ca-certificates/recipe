NAME=ca-certificates
VERSION=2026-06-30
KIND=source
TOOLCHAIN=none
DEPS="openssl"
ABOUT="A loja de certificados raiz, e ela NÃO é um acréscimo: é o conserto de um defeito medido. O /etc/ssl desta árvore não tinha bundle nenhum, e o openssl foi configurado com --openssldir=/etc/ssl esperando encontrar um. Sem loja, toda verificação de TLS do sistema instalado falha — o comando openssl s_client, o curl, o git, e qualquer cliente que se acrescente depois. NÃO o wget do BusyBox, e essa correção importa porque a primeira versão deste texto o citava: o busybox desta árvore é estático, não referencia libcrypto nenhuma e não contém uma única ocorrência de /etc/ssl; o applet ssl_client dele fala TLS com implementação própria e não consulta loja de raízes — conferido com readelf e strings no binário instalado. Por que o defeito não apareceu antes: o minitrue carrega as próprias raízes DENTRO do binário (webpki-roots, no Cargo.lock), então o gerenciador de pacotes funciona e só o resto do sistema é que não tem TLS verificável. Essa assimetria o escondeu. O payload é o bundle que a Mozilla mantém no NSS, publicado pelo projeto curl em formato PEM — a mesma origem que praticamente toda distro usa, pinada por sha256 como qualquer outro artefato desta árvore. É DADO e não programa: não há o que compilar. O openssl em DEPS não é para linkar nada: é porque o /etc/ssl é dele, e sem ele instalado este pacote depositaria arquivo em diretório de ninguém. O ARQUIVO É UM SÓ e mora em /etc/ssl/cert.pem — ver o build() para por que não existe aqui o /etc/ssl/certs/ca-certificates.crt que a maioria das distros usa."
LICENSE="MPL-2.0"
SRC="https://curl.se/ca/cacert.pem"
SHA256=3ff344e30b9b1ed2971044eabb438a08f2e2245ddb5f8ab1a3ad8b63ab4eaf91

build() {
    # UM arquivo, em /etc/ssl/cert.pem, e essa escolha merece a explicação
    # inteira porque contraria o hábito de Debian, Alpine e Arch.
    #
    # A libcrypto desta árvore traz DOIS caminhos compilados dentro dela, e são
    # coisas diferentes — conferido com strings na libcrypto.so instalada:
    #
    #   /etc/ssl/cert.pem  é o CAfile default, o BUNDLE: um arquivo com todas
    #                      as raízes concatenadas. É o que este pacote entrega.
    #   /etc/ssl/certs     é o CApath default, o DIRETÓRIO DE HASH. Nele o
    #                      administrador deposita certificados avulsos e roda
    #                      c_rehash; a libcrypto procura por nome de hash.
    #
    # O /etc/ssl/certs é entregue VAZIO pelo openssl, que o cria no
    # install_ssldirs, e é dele a claim 'd:' no manifesto. Depositar o bundle lá
    # dentro é doublethink pela SPEC-0003 §7 — a instalação para, e foi
    # exatamente isso que a primeira versão desta receita provocou. As duas
    # saídas eram: tirar o diretório do openssl, ou deixá-lo com o dono que já
    # tem.
    #
    # Foi a segunda, e não por ser a barata (a primeira refaria 67 pacotes,
    # incluindo firefox, gtk4, mesa e python). É a que descreve a realidade: o
    # CApath vazio pertence mesmo ao openssl, é parte do openssldir e serve ao
    # administrador; o bundle pertence a quem distribui as raízes. Cada um com
    # o seu. E o cert.pem não é caminho inventado para escapar da colisão — é o
    # default NATIVO do OpenSSL, o mesmo que OpenBSD e FreeBSD adotam, e o
    # único dos dois que a libcrypto abre sozinha sem ninguém lhe dizer nada.
    #
    # CONSEQUÊNCIA CONHECIDA, e ela é real: não existe
    # /etc/ssl/certs/ca-certificates.crt nesta distro. Programa de terceiro com
    # esse caminho compilado não acha a loja — o conserto é apontá-lo para
    # /etc/ssl/cert.pem ou exportar SSL_CERT_FILE. O curl desta árvore é
    # construído com --with-ca-bundle=/etc/ssl/cert.pem pela mesma razão, e o
    # git vai atrás dele.
    install -d "$STAGE/etc/ssl"
    install -m 0644 "$DL" "$STAGE/etc/ssl/cert.pem"

    # Guarda: o arquivo tem de conter certificado de verdade. Um download que
    # devolveu pagina de erro tambem tem bytes, e um bundle vazio falha
    # exatamente como bundle ausente — com a diferenca de que ninguem procura
    # o defeito, porque o arquivo esta la.
    quantos=$(grep -c '^-----BEGIN CERTIFICATE-----$' \
        "$STAGE/etc/ssl/cert.pem" || echo 0)
    [ "$quantos" -ge 100 ] || {
        echo "ca-certificates: so $quantos certificados no bundle; esperava mais de 100" >&2
        exit 1
    }
    # Guarda: nada foi depositado no CApath do openssl. Se uma edicao futura
    # reintroduzir o caminho por habito, isto derruba o build AQUI, com esta
    # mensagem, em vez de sair a mensagem de doublethink do instalador — que e
    # correta mas nao diz o porque.
    [ ! -e "$STAGE/etc/ssl/certs" ] || {
        echo "ca-certificates: /etc/ssl/certs e do openssl; o bundle vai em cert.pem" >&2
        ls -R "$STAGE/etc/ssl" >&2
        exit 1
    }
    echo "ca-certificates: $quantos raizes instaladas em /etc/ssl/cert.pem"
}
