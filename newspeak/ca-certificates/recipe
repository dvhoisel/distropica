NAME=ca-certificates
VERSION=2026-06-30
KIND=source
TOOLCHAIN=none
DEPS="openssl"
ABOUT="A loja de certificados raiz, e ela NÃO é um acréscimo: é o conserto de um defeito medido. O /etc/ssl/certs desta árvore estava VAZIO, e o openssl foi configurado com --openssldir=/etc/ssl esperando encontrar algo lá. Sem loja, toda verificação de TLS do sistema instalado falha — o wget do BusyBox, o comando openssl s_client, e qualquer cliente que se acrescente depois. Por que ninguém notou: o minitrue carrega as próprias raízes DENTRO do binário (webpki-roots, no Cargo.lock), então o gerenciador de pacotes funciona e só o resto do sistema é que não tem TLS verificável. Essa assimetria escondeu o defeito. O payload é o bundle que a Mozilla mantém no NSS, publicado pelo projeto curl em formato PEM — a mesma origem que praticamente toda distro usa, pinada por sha256 como qualquer outro artefato desta árvore. É DADO e não programa: não há o que compilar, e a receita só o deposita nos dois nomes que os programas procuram. O openssl em DEPS não é para linkar nada: é porque o /etc/ssl é dele, e sem ele instalado este pacote depositaria arquivo em diretório de ninguém."
LICENSE="MPL-2.0"
SRC="https://curl.se/ca/cacert.pem"
SHA256=3ff344e30b9b1ed2971044eabb438a08f2e2245ddb5f8ab1a3ad8b63ab4eaf91

build() {
    install -d "$STAGE/etc/ssl/certs"
    # DOIS nomes, e os dois importam. O ca-certificates.crt e o caminho que a
    # maioria dos programas tem compilado como default; o cert.pem e o que o
    # OpenSSL procura sozinho dentro do openssldir quando ninguem lhe diz onde
    # olhar. Apontar um para o outro custa um link e evita a classe de falha
    # em que o TLS funciona num programa e nao no vizinho.
    install -m 0644 "$DL" "$STAGE/etc/ssl/certs/ca-certificates.crt"
    ln -sf certs/ca-certificates.crt "$STAGE/etc/ssl/cert.pem"

    # Guarda: o arquivo tem de conter certificado de verdade. Um download que
    # devolveu pagina de erro tambem tem bytes, e um bundle vazio falha
    # exatamente como bundle ausente — com a diferenca de que ninguem procura
    # o defeito, porque o arquivo esta la.
    quantos=$(grep -c '^-----BEGIN CERTIFICATE-----$' \
        "$STAGE/etc/ssl/certs/ca-certificates.crt" || echo 0)
    [ "$quantos" -ge 100 ] || {
        echo "ca-certificates: so $quantos certificados no bundle; esperava mais de 100" >&2
        exit 1
    }
    echo "ca-certificates: $quantos raizes instaladas"
}
