NAME=exiv2
VERSION=0.28.8
KIND=source
TOOLCHAIN=native
DEPS="glibc gcc-pass2 expat zlib libpng"
BUILD_DEPS="gcc-pass2 binutils-glibc cmake ninja pkgconf expat zlib libpng"
ABOUT="Biblioteca C++ de metadados Exif, IPTC e XMP usada pelo GIMP via GExiv2. Mantém XMP, PNG, BMFF e vídeo, mas deixa de fora amostras, documentação, testes e backends de rede que o editor não usa."
LICENSE=GPL-2.0-or-later
SRC="https://github.com/Exiv2/exiv2/archive/refs/tags/v$VERSION.tar.gz"
SHA256=ea51b0609f58a9afa063b60daa1539948b62247721e154f4fff0ad3aec9f9756

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
        -DEXIV2_BUILD_SAMPLES=OFF -DEXIV2_BUILD_UNIT_TESTS=OFF \
        -DEXIV2_BUILD_FUZZ_TESTS=OFF -DEXIV2_BUILD_DOC=OFF \
        -DEXIV2_ENABLE_INIH=OFF -DEXIV2_ENABLE_CURL=OFF \
        -DEXIV2_ENABLE_BROTLI=OFF -DEXIV2_ENABLE_NLS=OFF \
        -DEXIV2_ENABLE_XMP=ON -DEXIV2_ENABLE_PNG=ON \
        -DEXIV2_ENABLE_BMFF=ON -DEXIV2_ENABLE_VIDEO=ON
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -e "$STAGE/usr/lib/pkgconfig/exiv2.pc" ] || { echo "exiv2: exiv2.pc ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
