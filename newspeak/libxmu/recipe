NAME=libxmu
VERSION=1.3.1
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxext libxt libsm libice libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto libx11 libxext libxt"
ABOUT="As rotinas utilitárias Xmu. XmuClientWindow e XShapeGetRectangles são verificadas de forma obrigatória pelo configurador do GIMP 3.2 quando o GTK3 tem backend X11. O desktop continua Wayland; esta biblioteca satisfaz a ABI que o próprio GTK expõe."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXmu-$VERSION.tar.xz"
SHA256=81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --disable-docs --disable-unit-tests --without-xmlto --without-fop \
        --without-xsltproc --without-glib
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libXmu.so.6" ] || { echo "libxmu: libXmu.so.6 ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
