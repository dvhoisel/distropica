NAME=jq
VERSION=1.8.2
KIND=binary
ABOUT="processador JSON de linha de comando; binário Linux x86_64 estático publicado pelo upstream. Pacote de prova do Mundo A: começa ausente e pode ser instalado offline pelo minitrue a partir do cache da mídia; o bundle estático ainda requer SBOM antes de uma release oficial"
# O executável oficial agrega jq, oniguruma, decNumber, libc e runtimes; até o
# SBOM arquivo/componente, rotulá-lo apenas com a licença MIT do jq seria falso.
LICENSE=NOASSERTION
SRC="https://github.com/jqlang/jq/releases/download/jq-$VERSION/jq-linux-amd64"
SHA256=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
LINKS="jq=bin/jq"

install_pkg() {
    mkdir -p "$PREFIX/bin"
    cp "$DL" "$PREFIX/bin/jq"
    chmod 755 "$PREFIX/bin/jq"
}
