NAME=meson
VERSION=1.12.0
KIND=source
TOOLCHAIN=native
DEPS="glibc python ninja busybox python-glibc"
BUILD_DEPS="python"
ABOUT="Sistema de build da pilha gráfica. Do E4b para cima quase tudo o usa: glib, cairo, pango, wayland, libdrm, mesa e GTK. É Python puro — não há o que compilar, e a receita apenas coloca o pacote no lugar. Instalado SEM pip e SEM setuptools, copiando mesonbuild/ para site-packages e o meson.py como /usr/bin/meson: esta distro não tem instalador de pacotes Python, e introduzir um só para uma ferramenta de build seria trazer um segundo gerenciador para dentro de uma distro cuja premissa é não ter nem o primeiro. Declara ninja em DEPS porque sozinho ele não constrói nada: gera arquivos de build que o ninja executa."
LICENSE=Apache-2.0
SRC="https://github.com/mesonbuild/meson/releases/download/$VERSION/meson-$VERSION.tar.gz"
SHA256="88afe0c20e52030218924ac37d0c81c59b4b5f3ae3752c8c6d7470c7d365886c"

build() {
    tar -xzf "$DL" --strip-components=1
    # O caminho de site-packages é derivado do próprio interpretador, não
    # fixado: quando o python subir de versão, a receita acompanha em vez de
    # instalar num diretório que ninguém importa.
    sitedir=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
    install -dm755 "$STAGE$sitedir"
    cp -a mesonbuild "$STAGE$sitedir/"
    # __pycache__ guarda o caminho absoluto e o mtime do .py dentro do .pyc:
    # deixá-lo entrar tornaria o artefato dependente de onde foi construído.
    find "$STAGE$sitedir/mesonbuild" -type d -name __pycache__ -exec rm -rf {} +
    # `mesonbuild/scripts/python_info.py` vem com modo 755 e
    # '#!/usr/bin/env python' — comando que esta árvore não instala; ela tem
    # python3.14, e a PEP 394 deixa o nome nu a cargo da distro. O arquivo é
    # MÓDULO: o meson o executa passando o interpretador que ele mesmo
    # escolheu, nunca pelo shebang. Some-se o bit de execução e não a linha,
    # para não divergir dos bytes do upstream. Sem isto a auditoria recusa o
    # payload, e com razão — um executável declara o interpretador que exige.
    #
    # Por padrão e não por nome, para que uma versão futura com outro resquício
    # igual já venha tratada.
    # Sem `awk`: o pipeline anterior usava um, e a view desta receita pode não
    # ter awk nenhum — o busybox está lá, mas já cedeu /usr/bin/awk ao gawk. O
    # awk falhava, o `while read` recebia vazio e saía com 0, então o conserto
    # não acontecia EM SILÊNCIO. `case` do shell resolve sem ferramenta externa.
    find "$STAGE$sitedir/mesonbuild" -type f -name '*.py' -perm -u+x -exec sh -c '
        for arquivo do
            case $(head -1 "$arquivo") in
                "#!"*"/env python")
                    chmod a-x "$arquivo"
                    echo "  bit de execução removido de $arquivo" ;;
            esac
        done
    ' _ {} +
    install -Dm755 meson.py "$STAGE/usr/bin/meson"
    install -Dm644 data/shell-completions/bash/meson \
        "$STAGE/usr/share/bash-completion/completions/meson"
}
