NAME=libepoxy
VERSION=1.5.10
KIND=source
TOOLCHAIN=native
DEPS="glibc mesa"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc findutils"
ABOUT="Despachante de ponteiros de função de OpenGL. Existe por um detalhe feio da história do GL: a biblioteca não expõe as funções modernas como símbolos, e cada programa precisava resolvê-las em tempo de execução, uma a uma, com o código repetido em toda parte. O epoxy faz isso uma vez e apresenta as funções como se fossem símbolos normais. O GTK3 o exige e é através dele que o GTK fala com a Mesa. COM GLX, e isso é uma reversão consciente: a primeira versão desta receita desligava GLX e X11 porque a árvore era Wayland-only, e isso deixou de ser possível quando o backend X11 do GTK3 passou a ser obrigatório para carregar o libxul.so do Firefox — o gdkglcontext-x11.c do GTK inclui epoxy/glx.h e não compila sem ele. Importante para quem for auditar: ligar o GLX aqui NÃO traz a libGL da Mesa, que continua não existindo nesta árvore. O epoxy gera os próprios cabeçalhos de GLX a partir do registro XML que ele mesmo distribui e resolve os símbolos por dlopen em tempo de execução — se alguém tentasse criar um contexto GLX, falharia ali, e ninguém tenta, porque a sessão é Wayland. O que se compila é a capacidade, e o que não existe é o servidor para exercê-la."
LICENSE=MIT
SRC="https://github.com/anholt/libepoxy/archive/refs/tags/$VERSION.tar.gz"
SHA256=a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Ddocs=false \
        -Dglx=no \
        -Degl=yes \
        -Dx11=false \
        -Dtests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # Esta guarda é pela AUSÊNCIA, e o comentário anterior — "o cabeçalho de
    # GLX é o que o GTK3 inclui" — era verdade só enquanto o GTK3 tinha backend
    # X11. Conferido nas fontes pinadas dos três consumidores, e não suposto:
    # no GTK 3.24.52 o epoxy/glx.h aparece exclusivamente em
    # gdk/x11/gdkglcontext-x11.{c,h}; no GTK 4.22.4, em gdk/x11/ e mais nada;
    # no WebKitGTK 2.52.5 não aparece em nenhum dos 25.101 .cpp/.h. Todos são
    # arquivos que só compilam com o backend X11, que esta árvore não tem.
    # Se o cabeçalho REAPARECER é porque -Dglx voltou a 'yes' ou 'auto', e com
    # ele voltariam a ligação a libGL e a dependência de X11 — que é
    # exatamente o que a remoção do X desta árvore proibiu.
    ! [ -e "$STAGE/usr/include/epoxy/glx.h" ] || {
        echo "libepoxy: epoxy/glx.h foi gerado — o caminho GLX voltou" >&2
        exit 1
    }
    [ -e "$STAGE/usr/include/epoxy/egl.h" ] || {
        echo "libepoxy: epoxy/egl.h não foi gerado" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
