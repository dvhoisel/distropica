NAME=libepoxy
VERSION=1.5.10
KIND=source
TOOLCHAIN=native
DEPS="glibc mesa"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc"
ABOUT="Despachante de ponteiros de função de OpenGL. Existe por um detalhe feio da história do GL: a biblioteca não expõe as funções modernas como símbolos, e cada programa precisava resolvê-las em tempo de execução, uma a uma, com o código repetido em toda parte. O epoxy faz isso uma vez e apresenta as funções como se fossem símbolos normais. O GTK3 o exige e é através dele que o GTK fala com a Mesa. Sem GLX, porque não há X11 aqui — só EGL, que é o caminho do Wayland. Resolve as funções por dlopen em tempo de execução, então o link com a Mesa é frouxo; ainda assim ela vai em DEPS, porque sem uma libEGL para abrir o epoxy não serve para nada."
LICENSE=MIT
SRC="https://github.com/anholt/libepoxy/archive/refs/tags/$VERSION.tar.gz"
SHA256=a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Ddocs=false \
        -Dglx=no \
        -Degl=yes \
        -Dx11=false \
        -Dtests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    find "$STAGE" -type d -empty -delete
}
