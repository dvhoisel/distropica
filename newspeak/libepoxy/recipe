NAME=libepoxy
VERSION=1.5.10
KIND=source
TOOLCHAIN=native
DEPS="glibc mesa"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc findutils"
ABOUT="Despachante de ponteiros de função de OpenGL. Existe por um detalhe feio da história do GL: a biblioteca não expõe as funções modernas como símbolos, e cada programa precisava resolvê-las em tempo de execução, uma a uma, com o código repetido em toda parte. O epoxy faz isso uma vez e apresenta as funções como se fossem símbolos normais. O GTK3, o GTK4, o WebKitGTK e o Inkscape o exigem, e é através dele que falam com a Mesa. SEM GLX e sem X11 (-Dglx=no, -Dx11=false): a sessão é Wayland e a Mesa desta árvore não traz libGL. O GLX esteve ligado enquanto o Firefox exigia o backend X11 do GTK3 — o gdkglcontext-x11.c inclui epoxy/glx.h — e saiu junto com ele; a receita recusa o cabeçalho se ele reaparecer."
LICENSE=MIT
SRC="https://github.com/anholt/libepoxy/archive/refs/tags/$VERSION.tar.gz"
SHA256=a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Ddocs=false \
        -Dglx=no \
        -Degl=yes \
        -Dx11=false \
        -Dtests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # Esta guarda é pela AUSÊNCIA, e o comentário anterior — "o cabeçalho de
    # GLX é o que o GTK3 inclui" — era verdade só enquanto o GTK3 tinha backend
    # X11. Conferido nas fontes pinadas dos três consumidores, e não suposto:
    # no GTK 3.24.52 o epoxy/glx.h aparece exclusivamente em
    # gdk/x11/gdkglcontext-x11.{c,h}; no GTK 4.22.4, em gdk/x11/ e mais nada;
    # no WebKitGTK 2.52.5 não aparece em nenhum dos 25.101 .cpp/.h. Todos são
    # arquivos que só compilam com o backend X11, que esta árvore não tem.
    # Se o cabeçalho REAPARECER é porque -Dglx voltou a 'yes' ou 'auto', e com
    # ele voltariam a ligação a libGL e a dependência de X11 — que é
    # exatamente o que a remoção do X desta árvore proibiu.
    ! [ -e "$STAGE/usr/include/epoxy/glx.h" ] || {
        echo "libepoxy: epoxy/glx.h foi gerado — o caminho GLX voltou" >&2
        exit 1
    }
    [ -e "$STAGE/usr/include/epoxy/egl.h" ] || {
        echo "libepoxy: epoxy/egl.h não foi gerado" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
