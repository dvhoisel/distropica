NAME=binutils-glibc
VERSION=2.47
KIND=source
TOOLCHAIN=cross
RETRIES=20
SUPERSEDES="busybox binutils binutils-cross"
DEPS="glibc zlib"
BUILD_DEPS="gcc binutils-cross make busybox"
ABOUT="binutils $VERSION reconstruído como GLIBC (dinâmico), não musl-estático. Passo do E2 descoberto na passada 2 (SPEC-0005 §4): o ld/ar da semente são estáticos musl e NÃO fazem dlopen do liblto_plugin.so ('dynamic loading not supported'), travando o link das target-libs do pass-2 — nem --disable-lto resolve, pois o ar é configurado com --plugin. Reconstruído glibc (interpreter /lib64/ld-linux-x86-64.so.2), o ld/ar passam a carregar plugins. SUPERSEDE o binutils-semente nos mesmos /usr/bin (as/ld/ar/nm) — colisão = dívida de 'fingerprint de build' (§4). --enable-plugins liga o suporte a plugin; -std=gnu17 p/ o código pré-C23."
LICENSE="GPL-2.0-or-later AND GPL-3.0-or-later AND GFDL-1.3-invariants-or-later AND GFDL-1.3-no-invariants-or-later"
SRC="https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.xz"
SHA256="154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff"
# Chave extraída do keyring oficial https://ftp.gnu.org/gnu/gnu-keyring.gpg;
# signer observado e primária 3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F.
SIG_1="https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.xz.sig"
SIG_EPOCH_1=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F

build() {
    mkdir -p "$WORK/.tc"
    cat > "$WORK/.tc/x86_64-distropica-linux-gnu-gcc" <<'SHIM'
#!/bin/sh
exec /usr/bin/x86_64-distropica-linux-gnu-gcc -isystem /usr/include -B/usr/lib -L/usr/lib -std=gnu17 "$@"
SHIM
    chmod +x "$WORK/.tc"/*
    export PATH="$WORK/.tc:$PATH"
    # A identidade final não pode depender de ferramentas/bibliotecas que
    # acaso já existam no root reutilizado. LEX=: usa os scanners gerados do
    # tarball e evita um DT_NEEDED acidental em libfl; zlib é uma dependência
    # explícita, construída antes por cross toolchain.
    export CC=x86_64-distropica-linux-gnu-gcc AR=ar RANLIB=ranlib LEX=: LEXLIB=

    tar -xJf "$DL" --strip-components=1
    mkdir -p build && cd build
    # Mesmas flags do binutils-semente, agora glibc + --enable-plugins (o que
    # habilita o dlopen do liblto_plugin.so). MAKEINFO=true: sem texinfo.
    ../configure --prefix=/usr --disable-nls --disable-werror --disable-gprofng \
        --enable-default-hash-style=gnu --enable-deterministic-archives \
        --with-system-zlib \
        --enable-plugins --disable-dependency-tracking
    retry make -j"$JOBS" MAKEINFO=true
    # Evita transportar centenas de MiB de DWARF na ISO mínima. As ferramentas
    # completas permanecem; somente os símbolos de debug saem do payload final.
    make install-strip MAKEINFO=true DESTDIR="$STAGE"

    # Veja newspeak/binutils: o aplicador mundo-B ainda não preserva grupos de
    # hardlinks, portanto o payload precisa selar cada alias como arquivo
    # regular independente. Um nome por execução evita que a alteração de
    # nlink durante a travessia deixe o último alias escapar de um lote.
    find "$STAGE" -type f -links +1 -exec sh -ec '
        for path do
            copy=$path.minitrue-copy
            if [ -e "$copy" ] || [ -L "$copy" ]; then
                exit 1
            fi
            cp -p "$path" "$copy"
            mv -f "$copy" "$path"
        done
    ' sh {} \;
}
