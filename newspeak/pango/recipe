NAME=pango
VERSION=1.57.1
KIND=source
TOOLCHAIN=native
DEPS="glibc glib harfbuzz fribidi cairo fontconfig freetype"
# xorgproto: quem roda pkg-config em cairo (ou em x11/xext/xrender) precisa dos
# .pc dos PROTOCOLOS, e eles são do xorgproto. A cadeia é indireta e por isso
# passava despercebida: cairo.pc traz `Requires.private: ... x11, xext, xrender`,
# o x11.pc traz `Requires: xproto kbproto`, e o xrender.pc traz `xproto
# renderproto`. Sem o xorgproto na view, o pkg-config falha ao gerar os cflags do
# cairo e o meson conclui que o cairo NÃO existe — indo tentar baixar um
# subprojeto. Conferido nos .pc instalados, não suposto.
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc xorgproto"
ABOUT="Camada de layout de texto: recebe um parágrafo, escolhe as fontes, chama o harfbuzz para moldar cada trecho, resolve a ordem bidirecional com o fribidi, quebra as linhas e manda o cairo desenhar. É o que está entre 'uma string' e 'texto na tela', e o GTK3 não desenha uma letra sem ele. Amarra quase toda a camada de tipografia desta árvore de uma vez — fontconfig para achar as fontes, freetype para lê-las, harfbuzz para moldar, fribidi para ordenar, cairo para pintar. Sem xft, que é o caminho do X11; sem libthai, que é quebra de linha específica do tailandês e uma dependência a mais por um idioma que ninguém aqui pediu; sem sysprof, que é instrumentação de perfil."
LICENSE=LGPL-2.0-or-later
SRC="https://download.gnome.org/sources/pango/1.57/pango-$VERSION.tar.xz"
SHA256=e65d6d117080dc3aeeb7d8b4b3b518f7383aa2e6cfce23117c623cd624764c2f

build() {
    tar -xJf "$DL" --strip-components=1
    # O segundo -rpath-link aponta para o diretório de BUILD, não para o
    # instalado, e é obrigatório aqui. O libpangocairo depende do libpangoft2,
    # que este mesmo build acabou de produzir em build/pango; ao linkar os
    # utilitários, o ld precisa resolver essa dependência e não tem onde
    # procurar: /usr/lib ainda não tem pango nenhum, e o -rpath que o meson
    # passa usa $ORIGIN, que não é expandido em tempo de link.
    #
    # Nas outras distros isso passa despercebido porque elas compilam pango
    # com um pango ANTIGO já instalado, e o ld acha o libpangoft2 velho. Esta
    # árvore constrói pango pela primeira vez, sem versão anterior para
    # mascarar — o mesmo motivo pelo qual o build do kernel só revelou a falta
    # do find -printf depois que a muleta do hospedeiro saiu.
    export LDFLAGS="-Wl,-rpath-link,/usr/lib -Wl,-rpath-link,$PWD/build/pango"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dfontconfig=enabled \
        -Dfreetype=enabled \
        -Dcairo=enabled \
        -Dxft=disabled \
        -Dlibthai=disabled \
        -Dsysprof=disabled \
        -Dintrospection=disabled \
        -Ddocumentation=false \
        -Dgtk_doc=false \
        -Dman-pages=false \
        -Dbuild-testsuite=false \
        -Dbuild-examples=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # O GTK3 pede pangocairo e pangoft2 por nome, não só pango; se o cairo ou
    # o freetype não tivessem sido achados o build passaria em silêncio e só o
    # GTK reprovaria, três passos adiante — foi assim com o mtr e o curses.
    for pc in pango.pc pangocairo.pc pangoft2.pc; do
        [ -e "$STAGE/usr/lib/pkgconfig/$pc" ] || {
            echo "pango: $pc não foi produzido" >&2
            exit 1
        }
    done
    find "$STAGE" -type d -empty -delete
}
