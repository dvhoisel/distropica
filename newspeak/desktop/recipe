NAME=desktop
VERSION=0.1
KIND=source
TOOLCHAIN=none
DEPS="labwc seatd eudev dbus epiphany foot dejavu-fonts adwaita-icon-theme hicolor-icon-theme mesa locales busybox alsa-utils miniluv"
ABOUT="A COLA. Tudo o que faz a pilha grafica virar uma tela em vez de um monte de bibliotecas instaladas: quem sobe o compositor, onde ele acha a configuracao, e o que o botao direito oferece. Receita de montagem, sem SRC — so gera arquivos legiveis. Tres pecas. (1) /usr/bin/distropica-desktop, o lancador: cria o XDG_RUNTIME_DIR, que o protocolo Wayland exige e sem o qual o compositor sai com uma linha de erro e nada mais; sobe o seatd se ninguem o subiu; e exec no labwc dentro de um barramento de sessao. (2) quatro drop-ins em /etc/rc.d/rcS.d, que e como um pacote acrescenta trabalho de inicializacao sem ser dono do /etc/inittab, que e do base: 01-machine-id.sh, 02-gschemas.sh, 05-udevd.sh e 10-seatd.sh, nesta ordem. O 02-gschemas.sh e o menos evidente e o que custou mais caro: ele compila a base de esquemas do GSettings, e sem ela o backend Wayland do GTK abandona a propria inicializacao antes de chegar ao update_xft_settings, que e o unico lugar que define a resolucao da tela — ela fica em -1, todo tamanho de fonte em pontos passa a ser negativo, e o navegador abre sem UMA LETRA no proprio chrome enquanto a pagina ao lado renderiza normalmente. O udevd NAO e redundante com o mdev, e essa foi a causa da primeira tela preta: o mdev cria os NOS de dispositivo, mas quem enumera dispositivo de entrada e a libinput, e ela pergunta a libudev — cujo udev_enumerate_scan_devices filtra tudo que nao tem entrada na base em /run/udev. (3) a configuracao do labwc em /etc/xdg/labwc: rc.xml, menu.xml, themerc, environment e autostart. O COMPOSITOR MUDOU, e com ele o modelo: o weston tinha painel, relogio e lancadores, e UM modificador global para todos os atalhos — mover o Alt+Tab movia tudo junto, e o Alt+K matava a aplicacao em foco sem confirmacao. O labwc nao tem painel nem relogio, e em troca cada atalho e declarado um a um no rc.xml, o tema e um themerc compativel com Openbox 3.6, e o menu do botao direito substitui os lancadores. O renderizador continua sendo por SOFTWARE: o wlroots foi construido com -Drenderers=[] e compoe no buffer dumb do KMS, sem EGL e sem GBM, pelo mesmo motivo de antes — numa arvore com Mesa softpipe o GL nao acelera nada e ainda depende de o gbm achar driver. O TERMINAL e o foot, e ele entrou junto com esta troca: o unico emulador anterior era o weston-terminal, que saiu com o weston, e uma sessao grafica sem forma de rodar um comando nao e uma sessao. O foot e cliente Wayland nativo sem toolkit — nao usa GTK nem Qt —, e custa tres receitas pequenas de C."
LICENSE="GPL-3.0-or-later"

build() {
    install -d "$STAGE/usr/bin" "$STAGE/etc/rc.d/rcS.d" "$STAGE/etc/xdg/labwc"

    cat > "$STAGE/usr/bin/distropica-desktop" <<'LAUNCHER'
#!/bin/sh
# distropica-desktop — sobe o modo gráfico. Legível de cabo a rabo, como o
# resto do boot desta distro: nada aqui é mágico e nada roda escondido.
set -eu

# O Wayland EXIGE XDG_RUNTIME_DIR: é onde o socket do compositor é criado.
# Sem ele o labwc recusa a subir com uma linha só de erro. Não há systemd
# aqui para criá-lo, então é este script quem cria. Modo 0700 é requisito do
# protocolo, não zelo: o compositor avisa e segue se for mais permissivo, mas
# qualquer cliente pode então falar com o compositor.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# O seatd entrega ao compositor os descritores de /dev/dri e /dev/input. O
# rcS.d já deveria tê-lo subido; se não subiu — boot manual, ou o gancho não
# existe neste sistema — sobe agora. Se nem isso der, a libseat cai no backend
# 'builtin', que faz a mesma coisa dentro do processo quando ele é root; por
# isso a falha aqui não é fatal.
if [ ! -S /run/seatd.sock ]; then
    seatd >/dev/null 2>&1 &
    n=0
    while [ ! -S /run/seatd.sock ] && [ "$n" -lt 30 ]; do
        n=$((n + 1))
        sleep 0.1 2>/dev/null || sleep 1
    done
fi

# O idioma da sessão. O locales instala pt_BR.UTF-8; se ele não estiver
# presente a variável aponta para um locale inexistente e as bibliotecas caem
# em C sozinhas, sem quebrar nada.
: "${LANG:=pt_BR.UTF-8}"
export LANG

# O BARRAMENTO DE SESSAO ENVOLVE A SESSAO INTEIRA, e sem ele metade dos
# aplicativos graficos nao abre — literalmente nao abre, sem mensagem.
#
# Esta distro tinha so o barramento de SISTEMA (o do 06-dbus.sh, que serve ao
# iwd). Nao e a mesma coisa: o de sistema e unico na maquina e serve daemons; o
# de sessao e por usuario logado e e onde toda aplicacao GTK moderna registra a
# si mesma. O iwgtk e uma GtkApplication — chama g_application_run, que chama
# g_application_register, que tenta pegar o nome dele NO BARRAMENTO DE SESSAO.
# Sem barramento, o registro falha e o programa termina sem abrir janela.
#
# O sintoma medido em QEMU foi exatamente esse: iwd no ar, politica D-Bus
# correta, o icone do painel destacando ao receber o clique — e nada acontecer.
# O Firefox, que era o navegador desta arvore, nao sofria disso e por isso a
# falta passou despercebida: ele nao usava GApplication. O Epiphany usa.
#
# dbus-run-session sobe um barramento, exporta DBUS_SESSION_BUS_ADDRESS e roda
# o comando; quando o compositor sai, o barramento morre junto. Como tudo o que
# o menu raiz lanca e filho do labwc, todos herdam o endereco.
# O labwc nao tem opcao de arquivo de log: ele escreve em stderr. Redirecionar
# aqui e o equivalente ao --log do weston, e vale pelo mesmo motivo — na tty1,
# stderr aparece por um instante, o compositor toma a tela, morre, e nao sobra
# nada. Diagnosticar a primeira falha desta pilha exigiu injetar um script na
# imagem do disco e ler o ext4 com debugfs.
#
# QUEM CRIA O ARQUIVO E O DESPACHANTE DA TTY1, na receita 'base', ainda como
# root: /var/log e de root modo 0755 e esta sessao roda como usuario comum. O
# nome e do PAPEL e nao do compositor — ja foi weston.log, e quando o
# compositor virou labwc esta linha mudou e a de la nao, o redirecionamento
# falhou com "Permission denied" e o `exec` levou a sessao junto. A tela virou
# console.
# DISTROPICA-SESSAO-LOG-BEGIN
SESSAO_LOG=/var/log/distropica-sessao.log

# E MESMO ASSIM NAO SE MORRE POR CAUSA DE UM LOG. A linha acima combina com a
# do 'base', mas duas receitas continuam tendo de concordar, e ja se viu o que
# acontece quando param de concordar. Entao aqui o destino e TESTADO, e a
# alternativa e o diretorio de runtime da sessao, que e do usuario por
# construcao. Perde-se o log no reboot seguinte; nao se perde a sessao. E a
# divergencia sai dita na tela, em vez de virar uma tty1 sem explicacao.
#
# O TESTE E O PROPRIO APPEND, dentro de um SUBSHELL, e as duas escolhas sao
# obrigatorias. Nao e `[ -w ]` porque bit de permissao e inferencia: mount
# somente-leitura, ACL e sistema cheio passam por ele e falham na hora da
# escrita. E o subshell existe porque redirecionamento que falha sobre um
# special builtin — `:` e um — encerra o SHELL, nao o comando: escrito sem os
# parenteses, este `if` matava o lancador exatamente nos casos que ele foi
# escrito para tratar, e o `2>/dev/null` nem esconderia a mensagem, porque quem
# a escreve e o shell. Medido nos quatro casos antes de entrar aqui.
if ! ( : >> "$SESSAO_LOG" ) 2>/dev/null; then
    SESSAO_LOG=${XDG_RUNTIME_DIR:-/tmp}/distropica-sessao.log
    echo "distropica: /var/log/distropica-sessao.log nao e gravavel;" \
         "log da sessao em $SESSAO_LOG" >&2
fi
# DISTROPICA-SESSAO-LOG-END

[ -x /usr/bin/dbus-run-session ] || {
    echo "distropica: dbus-run-session ausente; aplicativos GTK nao abrirao" >&2
    exec labwc "$@" >>"$SESSAO_LOG" 2>&1
}
exec dbus-run-session -- labwc "$@" >>"$SESSAO_LOG" 2>&1
LAUNCHER
    chmod 0755 "$STAGE/usr/bin/distropica-desktop"

    cat > "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh" <<'MACHINEID'
# Drop-in de inicializacao: o identificador da maquina.
#
# O D-Bus recusa iniciar um barramento sem /etc/machine-id, e o Firefox tenta
# falar com o barramento de acessibilidade na partida. Sem o arquivo ele
# imprime, em toda execucao:
#   Cannot spawn a message bus without a machine-id: Unable to load
#   /var/lib/dbus/machine-id or /etc/machine-id
# Nao e fatal — o navegador abre e funciona — mas e ruido em cada partida e
# quebraria qualquer coisa que dependesse do D-Bus de verdade.
#
# Gerado no PRIMEIRO boot e nao no pacote, e isso e requisito e nao preguica:
# o machine-id tem que ser UNICO por instalacao. Se viesse no payload, todas
# as maquinas instaladas da mesma midia teriam o mesmo identificador — que e
# exatamente o que a especificacao proibe.
if [ ! -s /etc/machine-id ] && [ -x /usr/bin/dbus-uuidgen ]; then
    /usr/bin/dbus-uuidgen > /etc/machine-id 2>/dev/null
    mkdir -p /var/lib/dbus
    cp /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null
    echo "distropica: machine-id gerado"
fi
MACHINEID
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh" <<'GSCHEMAS'
# Drop-in de inicializacao: a base compilada de esquemas do GSettings.
#
# ISTO NAO E SOBRE GSETTINGS. E o que faz o TEXTO DO NAVEGADOR APARECER, e a
# ligacao entre uma coisa e a outra e tudo menos obvia — por isso esta escrita
# por extenso.
#
# O gdkscreen-wayland.c do GTK3 inicializa os settings assim:
#
#     source = g_settings_schema_source_get_default ();
#     if (source == NULL)
#       return;                            <-- sai AQUI
#     ... percorre os esquemas ...
#     update_xft_settings (screen, FALSE);
#
# Sem NENHUM esquema compilado no sistema, g_settings_schema_source_get_default()
# devolve NULL, a funcao retorna cedo, e o update_xft_settings() — unico lugar
# do backend Wayland que chama _gdk_screen_set_resolution() — nunca roda. A
# resolucao da tela fica no valor com que nasce em gdkscreen.c:
# 'screen->resolution = -1.'.
#
# Dali em diante TODO tamanho de fonte em pontos vira negativo, porque o GTK
# computa pontos x dpi / 72. O Firefox le esse numero para 'font: message-box',
# que e a fonte de todo o chrome dele. Medido, com uma pagina que reporta o
# valor computado: -0.152778px, que e 11pt x (-1)/72. Texto com tamanho
# negativo nao desenha glifo nenhum.
#
# O sintoma engana porque e ASSIMETRICO, e foi por isso que custou tanto: os
# icones do chrome aparecem (sao SVG em px), o conteudo da pagina aparece (px
# das prefs do Firefox), os campos de formulario aparecem, e ate o relogio do
# painel do weston aparecia — ele nao usava GTK. So o texto do navegador
# some: aba sem titulo, barra de endereco vazia enquanto se digita nela. Com o
# labwc nao ha painel, e a barra de titulo dele tambem nao usa GTK: o sintoma
# continua sendo exatamente este.
#
# NAO e preciso o esquema org.gnome.desktop.interface, que esta arvore nao
# tem: o get_dpi_from_gsettings() devolve 96.0 * 1.0 quando ele falta. Basta a
# base EXISTIR, e os org.gtk.Settings.* que o proprio GTK instala bastam.
#
# Ha ainda um segundo motivo, independente deste: sem a base o g_settings_new()
# nao degrada — a GLib emite G_LOG_LEVEL_ERROR e ABORTA o processo. O GTK abre
# org.gtk.Settings.FileChooser ao montar um dialogo de arquivo, de modo que
# "salvar como" no navegador nao falharia: mataria o navegador.
#
# Gerado no boot e nao no pacote porque o arquivo e funcao do conjunto de
# TODOS os pacotes instalados e portanto nao pode pertencer a nenhum — mesmo
# argumento do hwdb.bin do eudev e do loaders.cache do gdk-pixbuf. Refaz
# quando falta ou quando alguma .gschema.xml e mais nova que ele, que e
# exatamente o caso depois de instalar um pacote novo.
if [ -x /usr/bin/glib-compile-schemas ] && [ -d /usr/share/glib-2.0/schemas ]; then
    gschemas_refazer=nao
    if [ ! -s /usr/share/glib-2.0/schemas/gschemas.compiled ]; then
        gschemas_refazer=sim
    else
        for gschemas_xml in /usr/share/glib-2.0/schemas/*.gschema.xml; do
            [ -e "$gschemas_xml" ] || break
            if [ "$gschemas_xml" -nt /usr/share/glib-2.0/schemas/gschemas.compiled ]; then
                gschemas_refazer=sim
                break
            fi
        done
    fi
    if [ "$gschemas_refazer" = sim ]; then
        if /usr/bin/glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1; then
            echo "distropica: esquemas do GSettings compilados"
        else
            echo "distropica: FALHA ao compilar os esquemas do GSettings;" \
                 "o texto do navegador vai sumir" >&2
        fi
    fi
    unset gschemas_refazer gschemas_xml
fi
GSCHEMAS
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/05-udevd.sh" <<'UDEVD'
# Drop-in de inicializacao: o udevd. Sourced pelo rcS do base, ANTES do seatd.
#
# ISTO NAO E REDUNDANCIA COM O mdev. O mdev do BusyBox cria os NOS de
# dispositivo e resolve /dev; o que ele nao faz e popular a BASE DO UDEV em
# /run/udev. E a libinput nao enumera dispositivo lendo /dev — ela pergunta a
# libudev, e o udev_enumerate_scan_devices FILTRA dispositivos que nao foram
# "inicializados", isto e, que nao tem entrada nessa base. Sem udevd, a lista
# volta vazia mesmo com /dev/input/event0 ali, legivel, na frente.
#
# O sintoma, medido e nao suposto na epoca do weston: o compositor sobe,
# encontra a placa, carrega o renderizador, e morre com
#   "no input devices on entering Weston" -> "failed to create input devices"
#   -> "fatal: failed to create compositor backend"
# e a tela fica preta. Nada falha no boot, nada falha no build. O labwc morre
# do mesmo jeito e pelo mesmo motivo: quem enumera entrada e a libinput, e ela
# pergunta a libudev nos dois casos.
#
# O 'settle' e obrigatorio: o trigger e assincrono, e sem esperar a fila o
# o compositor pode subir antes de os dispositivos estarem na base — a mesma
# falha, de forma intermitente, que e pior.
if [ -x /usr/bin/udevd ] && [ ! -d /run/udev/data ]; then
    /usr/bin/udevd --daemon >/dev/null 2>&1
    /usr/bin/udevadm trigger --action=add >/dev/null 2>&1
    /usr/bin/udevadm settle --timeout=10 >/dev/null 2>&1
    echo "distropica: udevd iniciado"
fi
UDEVD
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/05-udevd.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/10-seatd.sh" <<'SEATD'
# Drop-in de inicialização: o daemon de assentos. Sourced pelo rcS do base.
#
# '-g seat' AGORA EXISTE, e o comentario anterior aqui previa exatamente este
# dia: dizia que sem -g o socket ficava so para o root, "que e exatamente quem
# roda o compositor hoje", e que o grupo entraria "junto com o login grafico de
# usuario comum, quando ele existir". Ele existe — a conta distropica, criada
# pelo 04-usuario.sh do base, que tambem cria o grupo 'seat' com ela dentro.
#
# O seatd e quem abre /dev/dri/card0 e /dev/input/event* como root e entrega os
# descritores ao compositor. E por causa dele que os nos podem continuar
# root:root 0660 no mdev.conf e ainda assim uma sessao de usuario comum
# funcionar: ninguem alem do seatd precisa abri-los.
#
# O -g e resolvido com getgrnam e o seatd SAI COM ERRO se o grupo nao existir —
# daí a conferencia antes. Cair para o modo sem grupo e melhor que nao subir:
# numa arvore onde o 04-usuario.sh tenha falhado, a sessao ainda sobe como root
# pelo mesmo caminho de recuo que o /etc/rc.d/session usa.
if [ -x /usr/bin/seatd ] && [ ! -S /run/seatd.sock ]; then
    if grep -q '^seat:' /etc/group 2>/dev/null; then
        /usr/bin/seatd -g seat >/dev/null 2>&1 &
        echo "distropica: seatd iniciado (grupo seat)"
    else
        /usr/bin/seatd >/dev/null 2>&1 &
        echo "distropica: seatd iniciado sem grupo; sessao grafica so como root" >&2
    fi
fi
SEATD
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/10-seatd.sh"

    install -d "$STAGE/etc/gtk-3.0"
    cat > "$STAGE/etc/gtk-3.0/settings.ini" <<'GTKINI'
# Configuracao do GTK3 para uma sessao SEM gerenciador de configuracao.
#
# Num desktop comum quem responde "qual e a fonte da interface?" e o
# XSettings ou o dconf; aqui nao ha nem um nem outro, e o GTK cai no default
# compilado. O sintoma medido: o Firefox abre, a PAGINA renderiza texto
# normalmente, e o texto do proprio navegador — barra de endereco, abas,
# menus — nao aparece. Conteudo e chrome usam caminhos de fonte diferentes: o
# conteudo resolve pelo fontconfig, o chrome pergunta ao GTK.
#
# A fonte e nomeada explicitamente e nao por alias generico, porque esta
# arvore tem UMA familia instalada e mentir sobre isso nao ajuda ninguem: se
# um dia houver outra, muda-se aqui.
[Settings]
gtk-font-name = DejaVu Sans 11
gtk-theme-name = Adwaita
gtk-icon-theme-name = Adwaita
gtk-cursor-theme-name = Adwaita
gtk-application-prefer-dark-theme = false
gtk-enable-animations = true
# NAO HA gtk-xft-dpi AQUI, e a ausencia e deliberada. Ela custou caro e por
# isso esta escrita: a tentacao de acrescenta-lo e forte e ele NAO funciona.
#
# O sintoma: o texto do chrome do Firefox sai com tamanho NEGATIVO. Medido,
# nao suposto — uma pagina com 'font: message-box' reporta -0.152778px, que e
# exatamente 11pt x (-1)/72. Esse -1 e o valor inicial de
# gdk_screen_get_resolution(), em gdkscreen.c: 'screen->resolution = -1.'.
#
# Declarar gtk-xft-dpi neste arquivo nao conserta. O settings_update_resolution()
# do gtksettings.c so propaga o valor para a tela quando a FONTE dele e
# GTK_SETTINGS_SOURCE_APPLICATION (um aplicativo chamando g_object_set) — os
# demais casos, diz o comentario do proprio GTK, sao tratados no
# xsettings-client.c, que e X11. Um valor vindo daqui nao e nem um nem outro:
# ele entra no GtkSettings, o gtk-query-settings o exibe certinho, e a tela
# continua em -1. Foi testado com 98304 no lugar e o texto continuou invisivel.
#
# Numa sessao Wayland quem define a resolucao e o update_xft_settings() do
# gdkscreen-wayland.c, e ele so e alcancado se existir uma base de esquemas
# GSettings compilada. Essa e a causa de verdade, e o conserto esta no
# 02-gschemas.sh — nao aqui.
#
# Os gtk-xft-* abaixo, ao contrario, NAO sao inertes: o
# settings_update_font_options() os le do GtkSettings e monta as opcoes de
# fonte do cairo com eles. Sao o que o XSettings forneceria e aqui ninguem
# fornece.
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = hintslight
gtk-xft-rgba = none
GTKINI
    chmod 0644 "$STAGE/etc/gtk-3.0/settings.ini"

    # --- configuracao do labwc ---------------------------------------------
    # O upstream NAO instala configuracao: ele deixa gabaritos em
    # /usr/share/doc/labwc. Quem escreve /etc/xdg e esta receita, do mesmo jeito
    # que escrevia o weston.ini — o compositor entrega o programa, a cola
    # entrega a politica. O usuario sobrepoe em ~/.config/labwc, que e o mesmo
    # padrao XDG de antes.
    cat > "$STAGE/etc/xdg/labwc/rc.xml" <<'RCXML'
<?xml version="1.0"?>
<!--
  rc.xml - configuracao do labwc. Ver o ABOUT da receita 'desktop'.

  A DIFERENCA CENTRAL PARA O WESTON esta aqui: la havia UM modificador global
  para todos os atalhos, e escolher Alt para o Alt+Tab levava junto o Alt+K, que
  matava a aplicacao em foco sem confirmacao e sem a aplicacao nunca ver a
  tecla. Aqui cada atalho e declarado, um a um, e nada e capturado alem do que
  esta escrito neste arquivo.
-->
<labwc_config>
  <core>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
  </core>

  <theme>
    <name></name>
    <cornerRadius>0</cornerRadius>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>11</size>
    </font>
  </theme>

  <keyboard>
    <!-- Alt+Tab e memoria muscular, e aqui ele custa apenas ele mesmo. -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-space">
      <action name="ShowMenu" menu="client-menu"/>
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="epiphany"/>
    </keybind>
    <keybind key="W-t">
      <action name="Execute" command="foot"/>
    </keybind>
    <keybind key="W-n">
      <action name="Execute" command="miniluv"/>
    </keybind>
    <!-- Recarrega a configuracao viva. O weston exigia reiniciar a sessao. -->
    <keybind key="W-r">
      <action name="Reconfigure"/>
    </keybind>
    <keybind key="A-F5">
      <action name="ToggleMaximize"/>
    </keybind>
    <!--
      NAO HA atalho de Kill aqui, e a ausencia e deliberada: era o Alt+K do
      weston, que o compositor capturava e a aplicacao nunca via. Fechar janela
      e A-F4, que a aplicacao PODE tratar.
    -->
  </keyboard>

  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu"/>
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="touchpad">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
    </device>
  </libinput>
</labwc_config>
RCXML
    chmod 0644 "$STAGE/etc/xdg/labwc/rc.xml"

    cat > "$STAGE/etc/xdg/labwc/menu.xml" <<'MENUXML'
<?xml version="1.0"?>
<!--
  menu.xml - o menu do botao direito, que SUBSTITUI o painel do weston.
  Os lancadores que estavam la viraram entradas aqui, sem custar pacote novo e
  sem depender de PNG de 32 pixels em caminho literal.
-->
<openbox_menu>
  <menu id="root-menu" label="Distropica">
    <item label="Navegador">
      <action name="Execute" command="epiphany"/>
    </item>
    <item label="Terminal">
      <action name="Execute" command="foot"/>
    </item>
    <item label="Rede">
      <action name="Execute" command="miniluv"/>
    </item>
    <separator/>
    <item label="Recarregar configuracao">
      <action name="Reconfigure"/>
    </item>
    <item label="Encerrar sessao">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
MENUXML
    chmod 0644 "$STAGE/etc/xdg/labwc/menu.xml"

    cat > "$STAGE/etc/xdg/labwc/environment" <<'ENVIRONMENT'
# environment - lido pelo labwc antes de subir.
#
# O LAYOUT DE TECLADO vive aqui e nao no rc.xml: o labwc configura o XKB pelas
# variaveis de ambiente do xkbcommon. O 'br' e o mesmo que o weston.ini pedia,
# e os dados vem do xkeyboard-config — sem ele a montagem do mapa falha e o
# compositor morre antes de desenhar.
XKB_DEFAULT_LAYOUT=br
ENVIRONMENT
    chmod 0644 "$STAGE/etc/xdg/labwc/environment"

    cat > "$STAGE/etc/xdg/labwc/autostart" <<'AUTOSTART'
# autostart - executado pelo labwc ao subir.
#
# Vazio de proposito. O weston subia painel e relogio como clientes proprios;
# aqui nao ha nem um nem outro, e acrescentar um daemon so para ter relogio
# seria trocar 'no bling' por bling com outro nome. Fica como ponto de extensao
# para quem quiser: o arquivo existe e e do usuario sobrepor em ~/.config/labwc.
AUTOSTART
    chmod 0644 "$STAGE/etc/xdg/labwc/autostart"

    cat > "$STAGE/etc/xdg/labwc/themerc" <<'THEMERC'
# themerc - tema no formato Openbox 3.6, que o labwc le nativamente.
#
# Cores sobrias e nenhuma decoracao supérflua. O fundo e o mesmo cinza que o
# weston.ini usava em background-color, para que a troca de compositor nao
# mude a cara da coisa sem motivo.
window.active.title.bg.color: #2a2a2a
window.inactive.title.bg.color: #1a1a1a
window.active.label.text.color: #e0e0e0
window.inactive.label.text.color: #808080
window.active.border.color: #3a3a3a
window.inactive.border.color: #2a2a2a
border.width: 1
padding.height: 4
menu.items.bg.color: #1a1a1a
menu.items.text.color: #e0e0e0
menu.items.active.bg.color: #3a5a8a
menu.items.active.text.color: #ffffff
THEMERC
    chmod 0644 "$STAGE/etc/xdg/labwc/themerc"

    # --- guardas -----------------------------------------------------------
    # CADA ENTRADA DO MENU PRECISA DO SEU DAEMON DE PE, e esta guarda existe
    # porque a falta dela deixou a 0.10 sair com um botao de Wi-Fi que nao fazia
    # NADA ao ser clicado. O painel virou menu, o defeito continuaria igual.
    #
    # A conferencia e contra a arvore instalada, e nao contra o STAGE, porque os
    # drop-ins pertencem aos pacotes dbus e connman. E ABORTA em vez de avisar:
    # publicar uma entrada de menu que nao faz nada e publicar funcionalidade
    # que nao existe.
    #
    # O CAMINHO E O DE FABRICA, e nao /etc. Esta guarda nasceu procurando
    # /etc/rc.d/rcS.d/06-dbus.sh e NUNCA PODERIA TER PASSADO: dbus, connman,
    # alsa-utils, iwd e o proprio base entregam seus drop-ins como
    # /usr/share/factory/etc/rc.d/rcS.d/<nome>, conferido nos manifests dos
    # cinco, e a materializacao em /etc acontece na INSTALACAO, nao na view de
    # build. Dentro da view so existe o caminho de fabrica. Nao apareceu antes
    # porque nenhuma cadeia desde b0e35be tinha chegado ate aqui.
    for exigencia in \
        "miniluv:/usr/share/factory/etc/rc.d/rcS.d/06-dbus.sh:sem barramento D-Bus do sistema o miniluv nao acha o connman" \
        "miniluv:/usr/share/factory/etc/rc.d/rcS.d/09-connman.sh:sem o daemon connman o miniluv abre e nao lista rede nenhuma"; do
        lancador=${exigencia%%:*}
        resto=${exigencia#*:}
        arquivo=${resto%%:*}
        motivo=${resto#*:}
        grep -q "command=\"$lancador\"" "$STAGE/etc/xdg/labwc/menu.xml" || continue
        [ -e "$arquivo" ] || {
            echo "desktop: o menu oferece $lancador, mas falta $arquivo —" >&2
            echo "         $motivo" >&2
            exit 1
        }
    done
    unset exigencia lancador resto arquivo motivo

    # Todo comando do menu e do rc.xml tem de EXISTIR na arvore instalada. Era
    # o que faltava quando os icones do painel apontavam para PNG inexistente:
    # o arquivo dizia uma coisa e o sistema tinha outra, e ninguem sabia por que.
    for comando in $(grep -oE 'command="[a-z0-9-]+"' \
                       "$STAGE/etc/xdg/labwc/menu.xml" \
                       "$STAGE/etc/xdg/labwc/rc.xml" \
                     | sed 's/.*command="//; s/"//' | sort -u); do
        [ -x "/usr/bin/$comando" ] || {
            echo "desktop: o menu chama '$comando', que nao esta em /usr/bin" >&2
            exit 1
        }
    done
    unset comando

    # O texto do chrome do navegador depende da base de esquemas do GSettings —
    # e de nada dentro do settings.ini. Guarda, e nao comentario.
    [ -e "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh" ] || {
        echo "desktop: falta o drop-in dos esquemas do GSettings; sem ele a" \
             "resolucao da tela fica em -1 e o chrome do navegador fica sem texto" >&2
        exit 1
    }
    # E a guarda contra o conserto ERRADO, que ja foi tentado e mediu-se que
    # nao funciona: gtk-xft-dpi no settings.ini e inerte.
    ! grep -q "^gtk-xft-dpi" "$STAGE/etc/gtk-3.0/settings.ini" || {
        echo "desktop: gtk-xft-dpi no settings.ini e inerte; quem define a" \
             "resolucao e o 02-gschemas.sh (ver o comentario do settings.ini)" >&2
        exit 1
    }
    # A fonte nomeada tem de EXISTIR. Um nome errado devolve o mesmo sintoma
    # que a ausencia do arquivo: chrome sem texto.
    fc_familia=$(grep -oE 'gtk-font-name = [^0-9]+' "$STAGE/etc/gtk-3.0/settings.ini" | sed 's/gtk-font-name = //; s/ *$//')
    find /usr/share/fonts -iname "*$(echo "$fc_familia" | tr -d ' ')*" 2>/dev/null | grep -q . || {
        echo "desktop: a fonte '$fc_familia' do settings.ini nao esta instalada" >&2
        exit 1
    }
    # A MESMA fonte e nomeada no rc.xml para o titulo de janela, e pelo mesmo
    # motivo: o labwc desenha o titulo com pango, e um nome que o fontconfig
    # nao resolve devolve barra de titulo em branco.
    grep -q "<name>$fc_familia</name>" "$STAGE/etc/xdg/labwc/rc.xml" || {
        echo "desktop: o rc.xml nao nomeia a fonte '$fc_familia' do settings.ini" >&2
        exit 1
    }
    unset fc_familia

    [ -x "$STAGE/usr/bin/distropica-desktop" ] || {
        echo "desktop: o lançador não foi instalado" >&2
        exit 1
    }
    # O layout de teclado nao esta no rc.xml e sim no environment; se sumir, a
    # montagem do mapa XKB falha e o compositor morre antes de desenhar.
    grep -q "^XKB_DEFAULT_LAYOUT=" "$STAGE/etc/xdg/labwc/environment" || {
        echo "desktop: environment sem XKB_DEFAULT_LAYOUT" >&2
        exit 1
    }
    [ -e "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh" ] || {
        echo "desktop: falta o drop-in do machine-id" >&2
        exit 1
    }
    # O udevd tem que estar no drop-in ANTES do seatd: a libinput enumera
    # dispositivo pela libudev, que só enxerga o que está na base do udev.
    [ -e "$STAGE/etc/rc.d/rcS.d/05-udevd.sh" ] || {
        echo "desktop: falta o drop-in do udevd" >&2
        exit 1
    }
}
