    cat > "$STAGE/etc/xdg/labwc/autostart" <<'AUTOSTART'
# autostart - executado pelo labwc ao subir, via `sh <este arquivo>` — medido
# no session_run_script do labwc 0.20.1, que monta "sh %s" e faz spawn. Nao
# precisa de bit de execucao, e e shell de verdade. Se o usuario tiver um
# autostart em ~/.config/labwc, e o DELE que roda, no lugar deste.
#
# Este arquivo ja foi vazio de proposito, com a nota de que subir um daemon so
# para ter relogio seria trocar 'no bling' por bling com outro nome. A barra
# nao entrou pelo relogio: sem ela, janela MINIMIZADA some sem deixar rastro —
# nao ha lista de janelas em canto nenhum da tela, e o unico caminho de volta
# e saber de cor que Alt+Tab existe. Relogio e rede vem na mesma peca, e a
# peca custou uma receita: o yambar e do mesmo autor do foot e desenha com o
# fcft que a arvore ja paga.
#
# O -c NAO E ZELO, E REQUISITO: o yambar procura configuracao apenas em
# $XDG_CONFIG_HOME/yambar e ~/.config/yambar — medido no get_config_path() do
# main.c dele; XDG_CONFIG_DIRS nao participa da busca. Sem o -c, o
# /etc/xdg/yambar/config.yml desta arvore e letra morta e a barra morre no
# nascimento com "could not find a configuration". A escolha abaixo poe a
# sobreposicao do usuario na frente, que e o que o -c tirou dele.
#
# O '&' e o contrato: um cliente em primeiro plano seguraria o sh deste
# script vivo a sessao inteira a troco de nada. E ninguem precisa derrubar a
# barra na saida — ela e cliente Wayland, e quando o compositor morre o
# socket fecha e ela sai sozinha.
# A PAREDE PRIMEIRO: o wbg toma a camada de fundo (wlr-layer-shell,
# background) e fica de pe segurando a superficie; morre com o compositor
# como todo cliente. A imagem e desta receita — a logo sobre o cinza do
# tema — e a guarda do build cobra que o caminho aqui e o arquivo instalado
# sejam o mesmo fato.
wbg /usr/share/distropica/parede.png &

# O DAEMON DE NOTIFICACOES sobe explicito, e nao pela ativacao D-Bus, de
# proposito: visivel aqui, ambiente herdado direto (WAYLAND_DISPLAY ja
# existe neste ponto; no ambiente de ativacao do barramento ele so existe
