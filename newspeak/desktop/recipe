NAME=desktop
VERSION=0.1
KIND=source
TOOLCHAIN=none
DEPS="weston seatd eudev dbus firefox dejavu-fonts adwaita-icon-theme hicolor-icon-theme gtk3 mesa locales busybox alsa-utils iwgtk"
ABOUT="A COLA. Tudo o que faz a pilha gráfica virar uma tela em vez de um monte de bibliotecas instaladas: quem sobe o compositor, onde ele acha a configuração, e o que aparece na barra. Receita de montagem, sem SRC — só gera arquivos legíveis. Três peças. (1) /usr/bin/distropica-desktop, o lançador: cria o XDG_RUNTIME_DIR, que o protocolo Wayland exige e sem o qual o weston sai com 'XDG_RUNTIME_DIR not set' e nada mais; sobe o seatd se ninguém o subiu; e exec no weston. (2) quatro drop-ins em /etc/rc.d/rcS.d, que é como um pacote acrescenta trabalho de inicialização sem ser dono do /etc/inittab, que é do base: 01-machine-id.sh, 02-gschemas.sh, 05-udevd.sh e 10-seatd.sh, nesta ordem. O 02-gschemas.sh é o menos evidente e o que custou mais caro: ele compila a base de esquemas do GSettings, e sem ela o backend Wayland do GTK abandona a própria inicialização antes de chegar ao update_xft_settings, que é o único lugar que define a resolução da tela — ela fica em -1, todo tamanho de fonte em pontos passa a ser negativo, e o Firefox abre sem UMA LETRA no próprio chrome enquanto a página ao lado renderiza normalmente. O udevd NÃO é redundante com o mdev, e essa foi a causa da primeira tela preta: o mdev cria os NÓS de dispositivo, mas quem enumera dispositivo de entrada é a libinput, e ela pergunta à libudev — cujo udev_enumerate_scan_devices filtra tudo que não tem entrada na base em /run/udev. Sem udevd, a lista volta vazia com /dev/input/event0 legível ali na frente, e o weston morre com 'no input devices on entering Weston'. (3) /etc/xdg/weston/weston.ini, a configuração do compositor, com o painel e os dois lançadores. O renderizador é o PIXMAN e não o GL, e essa é a decisão que merece explicação: o renderizador GL exige EGL sobre GBM, o que numa árvore com Mesa softpipe significa rasterizar por software e ainda assim depender do gbm achar um driver para a placa — em bochs-drm, virtio ou qualquer máquina sem driver 3D, isso é uma superfície de falha grande em troca de nada, porque o softpipe já é software. O pixman compõe direto no buffer dumb do KMS, sem EGL, sem GBM, e funciona onde o KMS funciona. A Mesa continua instalada e útil: é dela que o GTK e o Firefox tiram GL quando pedem. O terminal é o weston-terminal, único emulador desta árvore."
LICENSE="GPL-3.0-or-later"

build() {
    install -d "$STAGE/usr/bin" "$STAGE/etc/rc.d/rcS.d" "$STAGE/etc/xdg/weston"

    cat > "$STAGE/usr/bin/distropica-desktop" <<'LAUNCHER'
#!/bin/sh
# distropica-desktop — sobe o modo gráfico. Legível de cabo a rabo, como o
# resto do boot desta distro: nada aqui é mágico e nada roda escondido.
set -eu

# O Wayland EXIGE XDG_RUNTIME_DIR: é onde o socket do compositor é criado.
# Sem ele o weston recusa a subir com uma linha só de erro. Não há systemd
# aqui para criá-lo, então é este script quem cria. Modo 0700 é requisito do
# protocolo, não zelo: o weston avisa e segue se for mais permissivo, mas
# qualquer cliente pode então falar com o compositor.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# O seatd entrega ao compositor os descritores de /dev/dri e /dev/input. O
# rcS.d já deveria tê-lo subido; se não subiu — boot manual, ou o gancho não
# existe neste sistema — sobe agora. Se nem isso der, a libseat cai no backend
# 'builtin', que faz a mesma coisa dentro do processo quando ele é root; por
# isso a falha aqui não é fatal.
if [ ! -S /run/seatd.sock ]; then
    seatd >/dev/null 2>&1 &
    n=0
    while [ ! -S /run/seatd.sock ] && [ "$n" -lt 30 ]; do
        n=$((n + 1))
        sleep 0.1 2>/dev/null || sleep 1
    done
fi

# O idioma da sessão. O locales instala pt_BR.UTF-8; se ele não estiver
# presente a variável aponta para um locale inexistente e as bibliotecas caem
# em C sozinhas, sem quebrar nada.
: "${LANG:=pt_BR.UTF-8}"
export LANG

# --log e o que torna a proxima falha diagnosticavel. Sem ele o weston escreve
# em stderr, que na tty1 significa: a mensagem aparece por um instante, o
# compositor toma a tela, morre, e nao sobra nada. Diagnosticar a primeira
# falha desta pilha exigiu injetar um script na imagem do disco e ler o ext4
# com debugfs; com o log em arquivo, basta abrir /var/log/weston.log.
exec weston --log=/var/log/weston.log "$@"
LAUNCHER
    chmod 0755 "$STAGE/usr/bin/distropica-desktop"

    cat > "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh" <<'MACHINEID'
# Drop-in de inicializacao: o identificador da maquina.
#
# O D-Bus recusa iniciar um barramento sem /etc/machine-id, e o Firefox tenta
# falar com o barramento de acessibilidade na partida. Sem o arquivo ele
# imprime, em toda execucao:
#   Cannot spawn a message bus without a machine-id: Unable to load
#   /var/lib/dbus/machine-id or /etc/machine-id
# Nao e fatal — o navegador abre e funciona — mas e ruido em cada partida e
# quebraria qualquer coisa que dependesse do D-Bus de verdade.
#
# Gerado no PRIMEIRO boot e nao no pacote, e isso e requisito e nao preguica:
# o machine-id tem que ser UNICO por instalacao. Se viesse no payload, todas
# as maquinas instaladas da mesma midia teriam o mesmo identificador — que e
# exatamente o que a especificacao proibe.
if [ ! -s /etc/machine-id ] && [ -x /usr/bin/dbus-uuidgen ]; then
    /usr/bin/dbus-uuidgen > /etc/machine-id 2>/dev/null
    mkdir -p /var/lib/dbus
    cp /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null
    echo "distropica: machine-id gerado"
fi
MACHINEID
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh" <<'GSCHEMAS'
# Drop-in de inicializacao: a base compilada de esquemas do GSettings.
#
# ISTO NAO E SOBRE GSETTINGS. E o que faz o TEXTO DO NAVEGADOR APARECER, e a
# ligacao entre uma coisa e a outra e tudo menos obvia — por isso esta escrita
# por extenso.
#
# O gdkscreen-wayland.c do GTK3 inicializa os settings assim:
#
#     source = g_settings_schema_source_get_default ();
#     if (source == NULL)
#       return;                            <-- sai AQUI
#     ... percorre os esquemas ...
#     update_xft_settings (screen, FALSE);
#
# Sem NENHUM esquema compilado no sistema, g_settings_schema_source_get_default()
# devolve NULL, a funcao retorna cedo, e o update_xft_settings() — unico lugar
# do backend Wayland que chama _gdk_screen_set_resolution() — nunca roda. A
# resolucao da tela fica no valor com que nasce em gdkscreen.c:
# 'screen->resolution = -1.'.
#
# Dali em diante TODO tamanho de fonte em pontos vira negativo, porque o GTK
# computa pontos x dpi / 72. O Firefox le esse numero para 'font: message-box',
# que e a fonte de todo o chrome dele. Medido, com uma pagina que reporta o
# valor computado: -0.152778px, que e 11pt x (-1)/72. Texto com tamanho
# negativo nao desenha glifo nenhum.
#
# O sintoma engana porque e ASSIMETRICO, e foi por isso que custou tanto: os
# icones do chrome aparecem (sao SVG em px), o conteudo da pagina aparece (px
# das prefs do Firefox), os campos de formulario aparecem, e ate o relogio do
# painel do weston aparece — o weston nao usa GTK. So o texto do navegador
# some: aba sem titulo, barra de endereco vazia enquanto se digita nela.
#
# NAO e preciso o esquema org.gnome.desktop.interface, que esta arvore nao
# tem: o get_dpi_from_gsettings() devolve 96.0 * 1.0 quando ele falta. Basta a
# base EXISTIR, e os org.gtk.Settings.* que o proprio GTK instala bastam.
#
# Ha ainda um segundo motivo, independente deste: sem a base o g_settings_new()
# nao degrada — a GLib emite G_LOG_LEVEL_ERROR e ABORTA o processo. O GTK abre
# org.gtk.Settings.FileChooser ao montar um dialogo de arquivo, de modo que
# "salvar como" no navegador nao falharia: mataria o navegador.
#
# Gerado no boot e nao no pacote porque o arquivo e funcao do conjunto de
# TODOS os pacotes instalados e portanto nao pode pertencer a nenhum — mesmo
# argumento do hwdb.bin do eudev e do loaders.cache do gdk-pixbuf. Refaz
# quando falta ou quando alguma .gschema.xml e mais nova que ele, que e
# exatamente o caso depois de instalar um pacote novo.
if [ -x /usr/bin/glib-compile-schemas ] && [ -d /usr/share/glib-2.0/schemas ]; then
    gschemas_refazer=nao
    if [ ! -s /usr/share/glib-2.0/schemas/gschemas.compiled ]; then
        gschemas_refazer=sim
    else
        for gschemas_xml in /usr/share/glib-2.0/schemas/*.gschema.xml; do
            [ -e "$gschemas_xml" ] || break
            if [ "$gschemas_xml" -nt /usr/share/glib-2.0/schemas/gschemas.compiled ]; then
                gschemas_refazer=sim
                break
            fi
        done
    fi
    if [ "$gschemas_refazer" = sim ]; then
        if /usr/bin/glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1; then
            echo "distropica: esquemas do GSettings compilados"
        else
            echo "distropica: FALHA ao compilar os esquemas do GSettings;" \
                 "o texto do navegador vai sumir" >&2
        fi
    fi
    unset gschemas_refazer gschemas_xml
fi
GSCHEMAS
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/05-udevd.sh" <<'UDEVD'
# Drop-in de inicializacao: o udevd. Sourced pelo rcS do base, ANTES do seatd.
#
# ISTO NAO E REDUNDANCIA COM O mdev. O mdev do BusyBox cria os NOS de
# dispositivo e resolve /dev; o que ele nao faz e popular a BASE DO UDEV em
# /run/udev. E a libinput nao enumera dispositivo lendo /dev — ela pergunta a
# libudev, e o udev_enumerate_scan_devices FILTRA dispositivos que nao foram
# "inicializados", isto e, que nao tem entrada nessa base. Sem udevd, a lista
# volta vazia mesmo com /dev/input/event0 ali, legivel, na frente.
#
# O sintoma, medido e nao suposto: o weston sobe, encontra a placa, carrega o
# renderizador, e morre com
#   "no input devices on entering Weston" -> "failed to create input devices"
#   -> "fatal: failed to create compositor backend"
# e a tela fica preta. Nada falha no boot, nada falha no build.
#
# O 'settle' e obrigatorio: o trigger e assincrono, e sem esperar a fila o
# weston pode subir antes de os dispositivos estarem na base — a mesma falha,
# de forma intermitente, que e pior.
if [ -x /usr/bin/udevd ] && [ ! -d /run/udev/data ]; then
    /usr/bin/udevd --daemon >/dev/null 2>&1
    /usr/bin/udevadm trigger --action=add >/dev/null 2>&1
    /usr/bin/udevadm settle --timeout=10 >/dev/null 2>&1
    echo "distropica: udevd iniciado"
fi
UDEVD
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/05-udevd.sh"

    cat > "$STAGE/etc/rc.d/rcS.d/10-seatd.sh" <<'SEATD'
# Drop-in de inicialização: o daemon de assentos. Sourced pelo rcS do base.
# Sem -g: o seatd resolve o grupo com getgrnam e SAI COM ERRO se ele nao
# existir, e esta arvore so tem o grupo root — as contas sao estado do admin e
# o base nao as gerencia. Sem -g o socket fica so para o root, que e
# exatamente quem roda o compositor hoje. O grupo entra junto com o login
# grafico de usuario comum, quando ele existir.
if [ -x /usr/bin/seatd ] && [ ! -S /run/seatd.sock ]; then
    /usr/bin/seatd >/dev/null 2>&1 &
    echo "distropica: seatd iniciado"
fi
SEATD
    chmod 0644 "$STAGE/etc/rc.d/rcS.d/10-seatd.sh"

    install -d "$STAGE/etc/gtk-3.0"
    cat > "$STAGE/etc/gtk-3.0/settings.ini" <<'GTKINI'
# Configuracao do GTK3 para uma sessao SEM gerenciador de configuracao.
#
# Num desktop comum quem responde "qual e a fonte da interface?" e o
# XSettings ou o dconf; aqui nao ha nem um nem outro, e o GTK cai no default
# compilado. O sintoma medido: o Firefox abre, a PAGINA renderiza texto
# normalmente, e o texto do proprio navegador — barra de endereco, abas,
# menus — nao aparece. Conteudo e chrome usam caminhos de fonte diferentes: o
# conteudo resolve pelo fontconfig, o chrome pergunta ao GTK.
#
# A fonte e nomeada explicitamente e nao por alias generico, porque esta
# arvore tem UMA familia instalada e mentir sobre isso nao ajuda ninguem: se
# um dia houver outra, muda-se aqui.
[Settings]
gtk-font-name = DejaVu Sans 11
gtk-theme-name = Adwaita
gtk-icon-theme-name = Adwaita
gtk-cursor-theme-name = Adwaita
gtk-application-prefer-dark-theme = false
gtk-enable-animations = true
# NAO HA gtk-xft-dpi AQUI, e a ausencia e deliberada. Ela custou caro e por
# isso esta escrita: a tentacao de acrescenta-lo e forte e ele NAO funciona.
#
# O sintoma: o texto do chrome do Firefox sai com tamanho NEGATIVO. Medido,
# nao suposto — uma pagina com 'font: message-box' reporta -0.152778px, que e
# exatamente 11pt x (-1)/72. Esse -1 e o valor inicial de
# gdk_screen_get_resolution(), em gdkscreen.c: 'screen->resolution = -1.'.
#
# Declarar gtk-xft-dpi neste arquivo nao conserta. O settings_update_resolution()
# do gtksettings.c so propaga o valor para a tela quando a FONTE dele e
# GTK_SETTINGS_SOURCE_APPLICATION (um aplicativo chamando g_object_set) — os
# demais casos, diz o comentario do proprio GTK, sao tratados no
# xsettings-client.c, que e X11. Um valor vindo daqui nao e nem um nem outro:
# ele entra no GtkSettings, o gtk-query-settings o exibe certinho, e a tela
# continua em -1. Foi testado com 98304 no lugar e o texto continuou invisivel.
#
# Numa sessao Wayland quem define a resolucao e o update_xft_settings() do
# gdkscreen-wayland.c, e ele so e alcancado se existir uma base de esquemas
# GSettings compilada. Essa e a causa de verdade, e o conserto esta no
# 02-gschemas.sh — nao aqui.
#
# Os gtk-xft-* abaixo, ao contrario, NAO sao inertes: o
# settings_update_font_options() os le do GtkSettings e monta as opcoes de
# fonte do cairo com eles. Sao o que o XSettings forneceria e aqui ninguem
# fornece.
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = hintslight
gtk-xft-rgba = none
GTKINI
    chmod 0644 "$STAGE/etc/gtk-3.0/settings.ini"

    cat > "$STAGE/etc/xdg/weston/weston.ini" <<'WESTONINI'
# weston.ini — configuração do compositor. Ver o ABOUT da receita 'desktop'
# para o porquê de cada escolha.

[core]
# Pixman e não GL: compõe direto no buffer do KMS, sem EGL e sem GBM. Numa
# árvore com Mesa softpipe o GL não aceleraria nada e acrescentaria a
# possibilidade de o gbm não achar driver para a placa.
renderer=pixman
idle-time=0
xwayland=false

[shell]
# Sem papel de parede em arquivo: o decodificador de imagem do weston
# precisaria de libjpeg, que esta árvore não tem (o libjpeg-turbo 3.x só
# constrói com cmake). Cor sólida resolve e não mente sobre o motivo.
background-color=0xff1a1a1a
panel-position=top
locking=false
animation=zoom

# O MODIFICADOR DOS ATALHOS, e ele é ALT porque Alt+Tab é memória muscular.
# O default do weston é 'super' (shared/config-parser.c, linha do
# binding-modifier), e com ele o trocador de janelas fica em Super+Tab — que
# ninguém tenta.
#
# Isto é uma ESCOLHA COM PREÇO, e o preço está escrito aqui porque não dá para
# pagá-lo pela metade: o weston tem UM modificador global para TODOS os
# atalhos, não um por atalho. O parser aceita exatamente super, alt, ctrl,
# shift ou none — não há combinação. Então mover o Tab move tudo junto.
#
# O que se ganha, e é convencional no Linux:
#   Alt+Tab           troca de janela
#   Alt+arrastar      move a janela
#   Alt+botão-direito redimensiona
#   Alt+Shift+F       tela cheia
#
# O QUE SE PERDE, e é o motivo de este comentário existir:
#   Alt+K             MATA a aplicação focada, sem confirmação
#
# Esse é o force_kill_binding do desktop-shell/shell.c, que emite kill_signal
# para o cliente em foco. E o weston CAPTURA a combinação: a aplicação nunca
# recebe o Alt+K, então nem um navegador que quisesse tratá-lo poderia. Em
# aplicação com menu, Alt+letra é mnemônico — a tecla existe e agora tem outro
# dono. Registrado, e não escondido: quem trocar isto de volta para 'super'
# recupera o Alt inteiro para as aplicações e perde o Alt+Tab.
binding-modifier=alt

# O painel do weston lê CAMINHO LITERAL de arquivo PNG; ele não sabe procurar
# num tema de ícones nem renderizar SVG. Por isso os dois caminhos abaixo são
# absolutos e foram conferidos contra o que os pacotes realmente instalam — o
# do Firefox vem do próprio /opt, e o do terminal vem do subdiretório 'legacy'
# do Adwaita, que é onde os PNG rasterizados sobreviveram quando o tema migrou
# para SVG simbólico.
#
# COMENTÁRIO AQUI É '#', NUNCA ';'. O parser do weston (shared/config-parser.c)
# só reconhece '#'; uma linha com ';' não é ignorada, é MALFORMADA — e o weston
# então descarta o ARQUIVO INTEIRO e sobe com "Starting with no config file".
# Isso já aconteceu: o compositor subiu com o renderizador GL em vez do pixman,
# sem painel e sem lançadores, e a única pista era uma linha de aviso perdida
# no meio do log.
#
# TRINTA E DOIS PIXELS, e não quarenta e oito. O painel do weston tem altura
# FIXA de 32 — 'height = 32;' literal no clients/desktop-shell.c, sem opção
# no weston.ini que mude isso — e o panel_launcher_redraw_handler CENTRALIZA
# o ícone na alocação do lançador:
#     allocation.x += allocation.width / 2 - largura_do_icone / 2;
# Com ícone de 48 numa alocação de 32 isso dá x -= 8, o que joga o primeiro
# lançador para fora da borda esquerda da superfície e o CORTA. O segundo não
# aparenta defeito porque o transbordo dele cai sobre o vizinho em vez de cair
# fora — ou seja, o sintoma visível é só do primeiro ícone, e a causa é dos
# dois.

[launcher]
icon=/opt/firefox/current/browser/chrome/icons/default/default32.png
path=/usr/bin/firefox

[launcher]
icon=/usr/share/icons/Adwaita/32x32/legacy/utilities-terminal.png
path=/usr/bin/weston-terminal

# Wi-Fi. O iwgtk conversa com o iwd pelo D-Bus; sem lancador ele ficaria
# instalado e inalcancavel, que e o mesmo que nao existir para quem so tem a
# tela. O icone vem do Adwaita e nao do proprio iwgtk: ele instala apenas SVG
# simbolico, e o painel do weston le caminho literal de PNG — nao renderiza
# SVG nem procura em tema de icones.
[launcher]
icon=/usr/share/icons/Adwaita/32x32/legacy/network-wireless.png
path=/usr/bin/iwgtk

[keyboard]
keymap_layout=br

[libinput]
enable-tap=true
WESTONINI
    chmod 0644 "$STAGE/etc/xdg/weston/weston.ini"

    # Os ícones do painel são conferidos AQUI, contra a árvore instalada, e
    # não contra o STAGE: eles pertencem a outros pacotes (firefox e
    # adwaita-icon-theme, ambos em DEPS). A primeira versão desta receita
    # apontava para /usr/share/icons/hicolor/24x24/apps/firefox.png e
    # .../utilities-terminal.png — NENHUM dos dois existe nesta árvore. O
    # weston teria desenhado dois quadrados vazios e ninguém saberia por quê.
    # A falha é cosmética, e por isso a guarda avisa em vez de abortar: um
    # lançador sem ícone continua clicável, e derrubar o build do modo gráfico
    # por um PNG seria desproporcional.
    #
    # E a guarda confere a DIMENSÃO, não só a existência, porque o defeito que
    # de fato apareceu não foi um ícone faltando: foram dois PNG de 48 num
    # painel de 32, e o primeiro lançador saiu cortado na tela. Existir não
    # era o bastante. Largura e altura ficam nos bytes 16..23 do PNG, em
    # big-endian; lidos com `od` byte a byte porque na árvore de build não há
    # ferramenta de imagem alguma, e porque `od -tu4` usaria a ordem de bytes
    # do hospedeiro e leria o número trocado.
    for icone in /opt/firefox/current/browser/chrome/icons/default/default32.png \
                 /usr/share/icons/Adwaita/32x32/legacy/utilities-terminal.png; do
        [ -e "$icone" ] || {
            echo "desktop: aviso — ícone ausente: $icone" >&2
            continue
        }
        set -- $(od -An -tu1 -j16 -N8 "$icone" 2>/dev/null)
        [ "$#" -eq 8 ] || {
            echo "desktop: aviso — não li o cabeçalho de $icone" >&2
            continue
        }
        icone_largura=$(($1 * 16777216 + $2 * 65536 + $3 * 256 + $4))
        icone_altura=$(($5 * 16777216 + $6 * 65536 + $7 * 256 + $8))
        [ "$icone_largura" = 32 ] && [ "$icone_altura" = 32 ] || {
            echo "desktop: aviso — $icone é ${icone_largura}x${icone_altura};" \
                 "o painel do weston tem 32 e corta o que passar disso" >&2
        }
    done
    unset icone icone_largura icone_altura

    # O texto do chrome do Firefox depende da base de esquemas do GSettings —
    # e de nada dentro do settings.ini. Guarda, e nao comentario.
    [ -e "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh" ] || {
        echo "desktop: falta o drop-in dos esquemas do GSettings; sem ele a" \
             "resolucao da tela fica em -1 e o chrome do Firefox fica sem texto" >&2
        exit 1
    }
    # E a guarda contra o conserto ERRADO, que ja foi tentado e mediu-se que
    # nao funciona: gtk-xft-dpi neste arquivo e inerte, porque o GTK so o
    # propaga para a resolucao da tela quando vem do XSETTINGS ou de um
    # g_object_set. Quem o acrescentar vai achar que consertou alguma coisa.
    ! grep -q "^gtk-xft-dpi" "$STAGE/etc/gtk-3.0/settings.ini" || {
        echo "desktop: gtk-xft-dpi no settings.ini e inerte; quem define a" \
             "resolucao e o 02-gschemas.sh (ver o comentario do settings.ini)" >&2
        exit 1
    }
    # A fonte nomeada no settings.ini tem de EXISTIR. Um nome errado aqui
    # devolve o mesmo sintoma que a ausencia do arquivo: chrome sem texto.
    fc_familia=$(grep -oE 'gtk-font-name = [^0-9]+' "$STAGE/etc/gtk-3.0/settings.ini" | sed 's/gtk-font-name = //; s/ *$//')
    find /usr/share/fonts -iname "*$(echo "$fc_familia" | tr -d ' ')*" 2>/dev/null | grep -q . || {
        echo "desktop: a fonte '$fc_familia' do settings.ini nao esta instalada" >&2
        exit 1
    }

    [ -x "$STAGE/usr/bin/distropica-desktop" ] || {
        echo "desktop: o lançador não foi instalado" >&2
        exit 1
    }
    # O weston.ini sem a seção [core] faria o compositor subir com o
    # renderizador GL por default, que é justamente o que esta receita evita.
    grep -q "^renderer=pixman" "$STAGE/etc/xdg/weston/weston.ini" || {
        echo "desktop: weston.ini sem renderer=pixman" >&2
        exit 1
    }
    # O binding-modifier não é validado pelo weston: o parser compara o texto
    # com super/alt/ctrl/shift/none numa cadeia de else-if e, se NENHUM casar,
    # simplesmente mantém o default — que é 'super'. Um 'Alt' com maiúscula ou
    # um 'meta' não dão erro, não dão aviso: o atalho só não é o que o arquivo
    # diz que é. A guarda não fixa QUAL modificador (isso é escolha revisável),
    # fixa que ele seja um dos que o parser conhece.
    # Captura QUALQUER coisa depois do '=', e não só minúsculas: um
    # 'binding-modifier=Alt' é exatamente o erro a pegar, e um padrão [a-z]+
    # não casaria com ele — a guarda leria vazio e deixaria passar. Foi o que
    # a primeira versão desta linha fazia.
    #
    # E APARA os espaços em volta, porque o weston apara: o config-parser dele
    # avança sobre isspace() depois do '=' e recorta o rabo antes de comparar.
    # Uma guarda mais estrita que o parser recusaria configuração válida, que é
    # tão ruim quanto deixar passar a inválida.
    modificador=$(grep -oE '^binding-modifier=.*' \
        "$STAGE/etc/xdg/weston/weston.ini" | cut -d= -f2- \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true)
    if [ -n "$modificador" ]; then
        case "$modificador" in
            super|alt|ctrl|shift|none) ;;
            *)
                echo "desktop: binding-modifier='$modificador' não é um dos que o" \
                     "weston conhece; ele cairia em 'super' sem avisar" >&2
                exit 1
                ;;
        esac
    fi
    unset modificador
    # O parser do weston trata linha iniciada por ';' como MALFORMADA e
    # descarta o arquivo inteiro, subindo com "Starting with no config file".
    # Um comentário no estilo errado apaga toda a configuração em silêncio.
    ! grep -q "^[[:space:]]*;" "$STAGE/etc/xdg/weston/weston.ini" || {
        echo "desktop: weston.ini tem comentário com ';'; use '#'" >&2
        exit 1
    }
    [ -e "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh" ] || {
        echo "desktop: falta o drop-in do machine-id" >&2
        exit 1
    }
    # O udevd tem que estar no drop-in ANTES do seatd: a libinput enumera
    # dispositivo pela libudev, que só enxerga o que está na base do udev.
    [ -e "$STAGE/etc/rc.d/rcS.d/05-udevd.sh" ] || {
        echo "desktop: falta o drop-in do udevd" >&2
        exit 1
    }
}
