    # --- o menu do botao direito lista o que ESTA INSTALADO -----------------
    # O menu raiz era uma lista escrita a mao, e por isso um pacote instalado
    # depois — o GIMP, no primeiro teste de campo — nao aparecia nele. Quem
    # clica com o botao direito na area de trabalho espera ver os programas
    # da maquina, nao os quatro que a receita decorou.
    #
    # O labwc resolve isso com PIPEMENU: <menu execute="COMANDO"/> roda o
    # comando na primeira vez que o item e selecionado e usa a saida XML como
    # submenu (labwc-menu.5). Este script e esse comando: le os .desktop
    # instalados e emite um item por aplicativo.
    #
    # Escrito em sh do BusyBox, porque e o que a maquina instalada tem
    # garantido; sem awk, que pertence ao gawk nesta arvore e ja derrubou uma
    # guarda antes.
    mkdir -p "$STAGE/usr/libexec"
    cat > "$STAGE/usr/libexec/distropica-menu-aplicativos" <<'PIPEMENU'
#!/bin/sh
# Emite, para o labwc, um submenu com os aplicativos instalados. Ver o
# comentario da receita 'desktop' que o instala.
#
# Contrato do pipemenu: TODA saida vai dentro de <openbox_pipe_menu>, e ela
# precisa sair MESMO se nada for encontrado — um pipemenu que imprime nada
# vira submenu quebrado em vez de submenu vazio.
set -u
printf '<openbox_pipe_menu>\n'

# A cadeia XDG, com o default da especificacao quando a variavel nao existe.
dirs=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
dirs=${XDG_DATA_HOME:-$HOME/.local/share}:$dirs

# Um .desktop pode aparecer em mais de um diretorio; o primeiro vence, que e
# a regra do XDG. 'visto' guarda os ids ja emitidos.
visto=
saida=
IFS=:
for dir in $dirs; do
    unset IFS
    [ -d "$dir/applications" ] || { IFS=:; continue; }
    for arquivo in "$dir"/applications/*.desktop; do
        [ -f "$arquivo" ] || continue
        id=${arquivo##*/}
        case " $visto " in *" $id "*) continue ;; esac
        visto="$visto $id"

        # Somente o grupo [Desktop Entry]: as secoes [Desktop Action ...] tem
        # Name e Exec proprios, e emiti-las misturaria acoes com aplicativos.
        cabecalho=$(sed -n '/^\[Desktop Entry\]/,/^\[/p' "$arquivo")

        case $cabecalho in
            *"NoDisplay=true"*|*"Hidden=true"*) continue ;;
        esac
        case $cabecalho in
            *"Type=Application"*) ;;
            *) continue ;;
        esac

        # O nome no idioma da sessao quando existir; senao o generico. O
        # locale sai de LANG (pt_BR.UTF-8 -> pt_BR -> pt).
        idioma=${LANG%%.*}
        curto=${idioma%%_*}
        nome=
        for chave in "Name[$idioma]" "Name[$curto]" "Name"; do
            nome=$(printf '%s\n' "$cabecalho" | sed -n "s/^$(printf '%s' "$chave" | sed 's/[][]/\\&/g')=//p" | head -1)
            [ -n "$nome" ] && break
        done
        [ -n "$nome" ] || continue

        comando=$(printf '%s\n' "$cabecalho" | sed -n 's/^Exec=//p' | head -1)
        [ -n "$comando" ] || continue
        # Codigos de campo do XDG (%f %F %u %U %i %c %k) nao valem como
        # argumento literal; %% e um % de verdade.
        comando=$(printf '%s\n' "$comando" | sed 's/%%/\x01/g; s/%[fFuUickdDnNvm]//g; s/\x01/%/g; s/  */ /g; s/ *$//')

        # Terminal=true precisa de um terminal, e o desta arvore e o foot.
        case $cabecalho in
            *"Terminal=true"*) comando="foot -e $comando" ;;
        esac

        # XML nao aceita & < > crus, e ha .desktop com E comercial no nome. O
        # & vem primeiro, senao as entidades seguintes seriam re-escapadas.
        escapa() {
            printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
        }
        # O NOME POPULAR ENTRA QUANDO O UPSTREAM NAO O DIZ. O Name do GIMP e
        # "GNU Image Manipulation Program" — em pt_BR, "Programa de
        # manipulacao de imagem do GNU" —, e quem instalou 'gimp' nao acha
        # isso numa lista. Reescrever o Name do upstream nao cabe a esta
        # distro; dizer TAMBEM o comando cabe, e e a mesma honestidade do
        # resto da arvore: a linha mostra o que o item vai executar. So
        # quando o nome ainda nao contem o comando, senao viraria "Foot
        # (foot)".
        rotulo=$nome
        base=${comando%% *}
        base=${base##*/}
        nome_minusculo=$(printf '%s' "$nome" | tr '[:upper:]' '[:lower:]')
        base_minusculo=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
        case $nome_minusculo in
            *"$base_minusculo"*) ;;
            # O COMANDO VEM NA FRENTE, e a ordem foi medida na tela: com ele
            # no fim, "Programa de manipulacao de imagem do GNU (gimp-3.2)"
            # era cortado pela largura do menu e o que sumia era exatamente o
            # "(gimp-3.2)" — o pedaco que existe para a pessoa reconhecer o
            # programa. Na frente, o nome curto sobrevive a qualquer corte.
            *) rotulo="$base — $nome" ;;
        esac

        # CADA APLICATIVO E UMA LINHA SO ate a ordenacao terminar. O item tem
        # tres linhas de XML, e ordenar com elas soltas embaralha os itens uns
        # dentro dos outros — medido, com o menu saindo em pedacos trocados.
        # O \001 e a quebra de linha disfarcada, desfeita no fim.
        chave=$(printf '%s' "$rotulo" | tr -d '\t')
        saida="$saida$(printf '%s\t  <item label="%s">\001    <action name="Execute" command="%s"/>\001  </item>' \
            "$chave" "$(escapa "$rotulo")" "$(escapa "$comando")")
"
    done
    IFS=:
done
unset IFS

# Ordem alfabetica pelo nome exibido, e nao pela ordem do diretorio. A chave
# viaja na frente separada por TAB — que e justamente o separador default do
# `cut`, e por isso ele desfaz o par sem depender de regex com \t, que o sed
# do BusyBox nao promete.
printf '%s' "$saida" | sort -f | cut -f2- | tr '\001' '\n'
printf '</openbox_pipe_menu>\n'
PIPEMENU
