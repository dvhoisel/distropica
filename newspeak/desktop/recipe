# instala fica de rede de seguranca: fnott morto renasce na primeira
# notificacao.
fnott &

barra=${XDG_CONFIG_HOME:-$HOME/.config}/yambar/config.yml
[ -e "$barra" ] || barra=/etc/xdg/yambar/config.yml
yambar -c "$barra" &
AUTOSTART
    chmod 0644 "$STAGE/etc/xdg/labwc/autostart"

    # --- o papel de parede --------------------------------------------------
    # A imagem vem do snapshot de files/ desta receita (a logo da distro
    # composta sobre o cinza 1a1a1a do themerc, 1920x1200 — mesma proporcao
    # 1.6:1 do 1280x800 das VMs, entao o wbg escala sem distorcer). Entra no
    # fingerprint como tudo em files/: trocar a parede reconstroi o pacote.
    # O snapshot materializa em $WORK, e o cwd do build nao e o $WORK — o
    # librsvg consome o cargo-config.toml dele exatamente assim.
    install -d "$STAGE/usr/share/distropica"
    install -m 0644 "$WORK/parede.png" "$STAGE/usr/share/distropica/parede.png"

    # --- a barra de tarefas -------------------------------------------------
    # A configuracao mora AQUI e nao na receita yambar, pelo mesmo motivo do
    # rc.xml nao morar na do labwc: o compositor e a barra entregam programa,
    # a cola entrega politica. E um arquivo de /etc/xdg como os outros — o
    # usuario sobrepoe em ~/.config/yambar, que o autostart prefere.
    # --- o lancador procura pelo nome QUE A PESSOA SABE ---------------------
    # O fuzzel exibe o campo Name do .desktop, e o do GIMP e "GNU Image
    # Manipulation Program": quem instalou o gimp e abriu o lancador nao acha
    # "GIMP" na lista, e por padrao o fuzzel casa a digitacao so contra
    # filename, name e generic. Acrescentar keywords e comment resolve pela
    # raiz e para todo aplicativo: o proprio .desktop do GIMP declara
    # Keywords=GIMP;graphic;design;..., o do Epiphany declara "navegador",
    # e passam a ser encontrados pelo nome popular e pelo que fazem — sem
    # reescrever o Name do upstream, que e dele e nao nosso.
    #
    # Ao contrario do yambar, o fuzzel LE /etc/xdg: sem XDG_CONFIG_DIRS ele
    # usa "/etc/xdg" como default (config.c:209), entao a politica mora aqui
    # e o usuario sobrepoe em ~/.config/fuzzel/fuzzel.ini.
    install -d "$STAGE/etc/xdg/fuzzel"
    cat > "$STAGE/etc/xdg/fuzzel/fuzzel.ini" <<'FUZZELINI'
# fuzzel.ini - o lancador da sessao (W-d). Ver o ABOUT da receita 'desktop'.
font=DejaVu Sans:size=12
fields=filename,name,generic,keywords,comment
terminal=foot -e
lines=12
width=40

[colors]
background=1a1a1aee
text=e0e0e0ff
match=3a5a8aff
selection=3a5a8aff
selection-text=ffffffff
border=3a3a3aff

[border]
width=1
radius=0
FUZZELINI
    chmod 0644 "$STAGE/etc/xdg/fuzzel/fuzzel.ini"

    install -d "$STAGE/etc/xdg/yambar"
    cat > "$STAGE/etc/xdg/yambar/config.yml" <<'YAMBARCONF'
# config.yml - a barra de tarefas da sessao grafica (yambar).
#
# TRES CAMPOS, e por que estes: a lista de janelas (foreign-toplevel) e a
# razao de a barra existir — janela minimizada nao tem outro lugar onde
# aparecer; a rede diz se ha endereco antes de o navegador dizer "sem
# internet"; e o relogio e o relogio. Nada de cpu, memoria ou disco: monitor
# de sistema e programa que se abre, nao mobilia pendurada na tela.
#
# As cores repetem o themerc do labwc de proposito — mesma faixa de cinzas,
# mesmo azul de "ativo". Quem mudar la, muda aqui, e a barra continua
# parecendo parte do resto em vez de enfeite colado.
bar:
  height: 28
  location: bottom
  background: 1a1a1aff
  foreground: e0e0e0ff
  font: DejaVu Sans:size=11

  left:
    # Uma entrada por janela aberta, minimizada inclusive — e essa a funcao.
    # A ativa leva o azul do tema por baixo; as demais ficam em cinza. O max
    # corta titulo de navegador, que nao tem limite natural de tamanho.
    #
    # O CLIQUE E UM TOGGLE, via wlrctl: o yambar so desenha, e mexer em
    # janela e conversa do protocolo wlr-foreign-toplevel-management, que o
    # wlrctl fala. Os dois ramos do map dao os dois sentidos do clique de
    # barra classico — na entrada INATIVA, focar (traz, foca e desminimiza);
    # na ATIVA, minimizar. O filtro e app_id e nao title, porque titulo tem
    # espaco e o on-click separa por palavras SEM shell — um titulo de
    # navegador viraria seis argumentos. No focus, duas janelas do MESMO
    # programa: o wlrctl ativa a primeira que casa e para (toplevel.c:297);
    # desempate fino continua no Alt+Tab. No minimize nao ha empate nenhum:
    # o state:active reduz o alvo a janela ativa, que e uma so por definicao
    # — sem ele, minimizar a ativa levaria junto TODAS as irmas de app_id
    # (o minimize do wlrctl nao para na primeira, medido no toplevel.c:291).
    - foreign-toplevel:
        content:
          map:
            conditions:
              activated:
                string:
                  text: "{title}"
                  max: 48
                  margin: 10
                  foreground: ffffffff
                  deco: {underline: {size: 2, color: 3a5a8aff}}
                  on-click: /usr/bin/wlrctl toplevel minimize app_id:{app-id} state:active
              ~activated:
                string:
                  text: "{title}"
                  max: 48
                  margin: 10
                  foreground: 808080ff
                  on-click: /usr/bin/wlrctl toplevel focus app_id:{app-id}

  right:
    # So interface de verdade, de pe e com endereco: o lo fica de fora, e
    # interface sem IPv4 ainda nao e noticia. NAO ha nome de interface fixo
    # aqui, de proposito: com o 80-net-name-slot.rules do eudev os nomes
    # variam por maquina (enp0s3 no VirtualBox, outro no QEMU, outro em
    # maquina real), e o modulo instancia o conteudo para CADA interface que
    # o netlink reportar — o filtro escolhe, nao o nome.
    #
    # O clique abre o applet de rede. Caminho ABSOLUTO porque o on-click do
    # yambar nao passa por shell (doc dele: "not executed in a shell") e
    # PATH nao e garantia de nada fora de um. Clicar de novo nao abre outro:
    # o miniluv e GApplication, e a segunda ativacao foca a instancia viva.
    - network:
        content:
          map:
            default: {empty: {}}
            conditions:
              name != "lo" && state == "up" && ipv4 != "":
                string:
                  text: "{name} {ipv4}"
                  margin: 10
                  on-click: /usr/bin/miniluv
    # %a e %b saem no idioma da sessao: o LANG=pt_BR.UTF-8 do lancador chega
    # aqui por heranca, labwc -> sh do autostart -> yambar.
    - clock:
        date-format: "%a %d %b"
        time-format: "%H:%M"
        content:
          string:
            text: "{date}  {time}"
            margin: 10
YAMBARCONF
    chmod 0644 "$STAGE/etc/xdg/yambar/config.yml"

    cat > "$STAGE/etc/xdg/labwc/themerc" <<'THEMERC'
# themerc - tema no formato Openbox 3.6, que o labwc le nativamente.
#
# Cores sobrias e nenhuma decoracao supérflua. O fundo e o mesmo cinza que o
# weston.ini usava em background-color, para que a troca de compositor nao
# mude a cara da coisa sem motivo.
window.active.title.bg.color: #2a2a2a
window.inactive.title.bg.color: #1a1a1a
window.active.label.text.color: #e0e0e0
window.inactive.label.text.color: #808080
window.active.border.color: #3a3a3a
window.inactive.border.color: #2a2a2a
border.width: 1
padding.height: 4
# O menu de aplicativos lista nomes de upstream, e alguns sao longos: o
# "Programa de manipulacao de imagem do GNU" do GIMP nao cabe nos 200 pixels
# do default e sai cortado — medido na tela, com o sufixo do comando, que
# existe justamente para dar reconhecimento, sendo a primeira coisa a sumir.
menu.width.min: 180
menu.width.max: 460
menu.items.bg.color: #1a1a1a
menu.items.text.color: #e0e0e0
menu.items.active.bg.color: #3a5a8a
menu.items.active.text.color: #ffffff
THEMERC
    chmod 0644 "$STAGE/etc/xdg/labwc/themerc"

    # --- guardas -----------------------------------------------------------
    # CADA ENTRADA DO MENU PRECISA DO SEU DAEMON DE PE, e esta guarda existe
    # porque a falta dela deixou a 0.10 sair com um botao de Wi-Fi que nao fazia
    # NADA ao ser clicado. O painel virou menu, o defeito continuaria igual.
    #
    # A conferencia e contra a arvore instalada, e nao contra o STAGE, porque os
    # drop-ins pertencem aos pacotes dbus e connman. E ABORTA em vez de avisar:
    # publicar uma entrada de menu que nao faz nada e publicar funcionalidade
    # que nao existe.
    #
    # O CAMINHO E O DE FABRICA, e nao /etc. Esta guarda nasceu procurando
    # /etc/rc.d/rcS.d/06-dbus.sh e NUNCA PODERIA TER PASSADO: dbus, connman,
    # alsa-utils, iwd e o proprio base entregam seus drop-ins como
    # /usr/share/factory/etc/rc.d/rcS.d/<nome>, conferido nos manifests dos
    # cinco, e a materializacao em /etc acontece na INSTALACAO, nao na view de
    # build. Dentro da view so existe o caminho de fabrica. Nao apareceu antes
    # porque nenhuma cadeia desde b0e35be tinha chegado ate aqui.
    for exigencia in \
        "miniluv:/usr/share/factory/etc/rc.d/rcS.d/06-dbus.sh:sem barramento D-Bus do sistema o miniluv nao acha o connman" \
        "miniluv:/usr/share/factory/etc/rc.d/rcS.d/09-connman.sh:sem o daemon connman o miniluv abre e nao lista rede nenhuma"; do
        lancador=${exigencia%%:*}
        resto=${exigencia#*:}
        arquivo=${resto%%:*}
        motivo=${resto#*:}
        grep -q "command=\"$lancador\"" "$STAGE/etc/xdg/labwc/menu.xml" || continue
        [ -e "$arquivo" ] || {
            echo "desktop: o menu oferece $lancador, mas falta $arquivo —" >&2
            echo "         $motivo" >&2
            exit 1
        }
    done
    unset exigencia lancador resto arquivo motivo

    # Todo comando do menu e do rc.xml tem de EXISTIR na arvore instalada. Era
    # o que faltava quando os icones do painel apontavam para PNG inexistente:
    # o arquivo dizia uma coisa e o sistema tinha outra, e ninguem sabia por que.
    for comando in $(grep -oE 'command="[a-z0-9-]+"' \
                       "$STAGE/etc/xdg/labwc/menu.xml" \
                       "$STAGE/etc/xdg/labwc/rc.xml" \
                     | sed 's/.*command="//; s/"//' | sort -u); do
        [ -x "/usr/bin/$comando" ] || {
            echo "desktop: o menu chama '$comando', que nao esta em /usr/bin" >&2
            exit 1
        }
    done
    unset comando

    # O BARRAMENTO DE SESSAO SOBE COM ENDERECO DECLARADO. Sao duas metades e
    # nenhuma vale sozinha: o lancador tem de CHAMAR o invólucro, e o invólucro
    # tem de DECLARAR o endereco. Se o lancador voltar a chamar o
    # `dbus-run-session` pelado, ele herda o <listen> que o session.conf trouxe
    # do TMPDIR de quem compilou o dbus, e a sessao morre calada — que foi
    # exatamente o defeito da 0.13.
    inv=$STAGE/usr/libexec/distropica-dbus-daemon
    [ -x "$inv" ] || {
        echo "desktop: o invólucro do dbus-daemon nao foi instalado" >&2
        exit 1
    }
    grep -q -- '--address=unix:tmpdir=/tmp' "$inv" || {
        echo "desktop: o invólucro do dbus-daemon nao declara o endereco" >&2
        exit 1
    }
    grep -q -- "--dbus-daemon=/usr/libexec/distropica-dbus-daemon" \
        "$STAGE/usr/bin/distropica-desktop" || {
        echo "desktop: o lancador nao usa o invólucro do dbus-daemon" >&2
        exit 1
    }
    ! grep -qE '^[[:space:]]*exec dbus-run-session[[:space:]]+--[[:space:]]' \
        "$STAGE/usr/bin/distropica-desktop" || {
        echo "desktop: o lancador ainda chama dbus-run-session sem o invólucro" >&2
        exit 1
    }
    unset inv

    # O RENDERIZADOR TEM DE ESTAR NOMEADO. Sem isto o wlroots escolhe pelo
    # automatico, que so cai no pixman quando o backend NAO tem render node —
    # e qualquer maquina com /dev/dri/renderD128 tem. Como -Drenderers=[] tirou
    # GLES2 e Vulkan de proposito, o automatico nao acha nenhum e o labwc morre
    # com "Could not initialize renderer". A guarda cobra o ARQUIVO, porque foi
    # a ausencia silenciosa dele que derrubou a sessao da 0.13.
    # Dentro de <mouse>, o <default/> e o que preserva arrastar/maximizar/
    # fechar; declarar so o bind do menu descarta os defaults (zero-check no
    # post_processing do labwc) e as janelas ficam imoveis.
    # COMENTARIO SAI ANTES DE OLHAR — o comentario do proprio <mouse> cita o
    # elemento para explica-lo, e a primeira versao desta guarda passava por
    # causa DELE, com o elemento real ausente. Mesma licao da guarda do <name>.
    sed '/<!--/,/-->/d' "$STAGE/etc/xdg/labwc/rc.xml" | \
        sed -n '/<mouse>/,/<\/mouse>/p' | \
        grep -q '<default */>' || {
        echo "desktop: o <mouse> do rc.xml nao tem <default/>; declarar um" \
             "bind descarta os defaults do labwc e a janela nao se move" >&2
        exit 1
    }
    grep -q '^WLR_NO_HARDWARE_CURSORS=1$' "$STAGE/etc/xdg/labwc/environment" || {
        echo "desktop: o environment nao desliga o cursor de hardware; no" \
             "VMSVGA do VirtualBox o labwc trava programando o cursor do" \
             "vmwgfx e a sessao congela a tela inteira" >&2
        exit 1
    }
    grep -q '^WLR_RENDERER=pixman$' "$STAGE/etc/xdg/labwc/environment" || {
        echo "desktop: o environment nao nomeia o renderizador pixman; o" \
             "automatico nao acha nenhum numa maquina com render node" >&2
        exit 1
    }
    grep -q '^GSK_RENDERER=cairo$' "$STAGE/etc/xdg/labwc/environment" || {
        echo "desktop: o environment nao poe o GTK4 no cairo; com a Mesa em" \
             "softpipe a interface inteira desenha por GL interpretado na CPU" >&2
        exit 1
    }

    # <name> VAZIO NAO E <name> AUSENTE. O labwc recusa string vazia com
    # "Empty string is not allowed for name.theme" e ignora a diretiva; a forma
    # de dizer "use o themerc daqui" e omitir o elemento.
    #
    # OS COMENTARIOS SAO REMOVIDOS ANTES DE OLHAR, e isso nao e zelo: a primeira
    # versao desta guarda reprovou o proprio arquivo correto, porque o
    # comentario que explica a ausencia do elemento CITA a forma vazia dele. Uma
    # guarda que le comentario como conteudo acusa a documentacao de ser o
    # defeito que ela descreve.
    #
    # SED E NAO AWK: dentro da view confinada as ferramentas sao as do BusyBox
    # mais o que a receita DECLARA, e `awk` de verdade vem do gawk, que o
    # desktop nao declara — o build morreu com "awk: not found". O intervalo
    # /<!--/,/-->/ do sed faz o mesmo e existe no BusyBox.
    conteudo_rcxml=$(sed '/<!--/,/-->/d' "$STAGE/etc/xdg/labwc/rc.xml")
    ! printf '%s\n' "$conteudo_rcxml" | grep -qE '<name>[[:space:]]*</name>' || {
        echo "desktop: o rc.xml tem <name> vazio, que o labwc recusa" >&2
        exit 1
    }
    unset conteudo_rcxml

    # O texto do chrome do navegador depende da base de esquemas do GSettings —
    # e de nada dentro do settings.ini. Guarda, e nao comentario.
    [ -e "$STAGE/etc/rc.d/rcS.d/02-gschemas.sh" ] || {
        echo "desktop: falta o drop-in dos esquemas do GSettings; sem ele a" \
             "resolucao da tela fica em -1 e o chrome do navegador fica sem texto" >&2
        exit 1
    }
    # E a guarda contra o conserto ERRADO, que ja foi tentado e mediu-se que
    # nao funciona: gtk-xft-dpi no settings.ini e inerte.
    ! grep -q "^gtk-xft-dpi" "$STAGE/etc/gtk-3.0/settings.ini" || {
        echo "desktop: gtk-xft-dpi no settings.ini e inerte; quem define a" \
             "resolucao e o 02-gschemas.sh (ver o comentario do settings.ini)" >&2
        exit 1
    }
    # A fonte nomeada tem de EXISTIR. Um nome errado devolve o mesmo sintoma
    # que a ausencia do arquivo: chrome sem texto.
    fc_familia=$(grep -oE 'gtk-font-name = [^0-9]+' "$STAGE/etc/gtk-3.0/settings.ini" | sed 's/gtk-font-name = //; s/ *$//')
    # A BUSCA E CONFERIDA COMO BUSCA antes de o resultado dela ser lido. Sem
    # isto, qualquer falha em EXECUTAR o find se disfarcava de fonte ausente:
    # medido nesta arvore, com a dejavu instalada e o payload correto, a
    # guarda acusou "a fonte 'DejaVu Sans' nao esta instalada" porque o
    # findutils tomou /usr/bin/find do busybox e esta receita nao o
    # declarava. E a mesma licao da soma sha256 do kernel: erro de
    # ferramenta que se veste de erro de conteudo custa o dobro para achar.
    fc_achados=$(find /usr/share/fonts -iname "*$(echo "$fc_familia" | tr -d ' ')*") || {
        echo "desktop: nao consegui procurar a fonte — o find falhou" >&2
        exit 1
    }
    [ -n "$fc_achados" ] || {
        echo "desktop: a fonte '$fc_familia' do settings.ini nao esta instalada" >&2
        exit 1
    }
    # A MESMA fonte e nomeada no rc.xml para o titulo de janela, e pelo mesmo
    # motivo: o labwc desenha o titulo com pango, e um nome que o fontconfig
    # nao resolve devolve barra de titulo em branco.
    grep -q "<name>$fc_familia</name>" "$STAGE/etc/xdg/labwc/rc.xml" || {
        echo "desktop: o rc.xml nao nomeia a fonte '$fc_familia' do settings.ini" >&2
        exit 1
    }
    # E a barra desenha com fcft, que resolve pelo mesmo fontconfig: a familia
    # e uma so na arvore inteira, ou alguem fica com retangulo no lugar de letra.
    grep -q "^  font: $fc_familia:size=" "$STAGE/etc/xdg/yambar/config.yml" || {
        echo "desktop: a barra nao usa a fonte '$fc_familia' do settings.ini" >&2
        exit 1
    }
    unset fc_familia

    [ -x "$STAGE/usr/bin/distropica-desktop" ] || {
        echo "desktop: o lançador não foi instalado" >&2
        exit 1
    }
    # O layout de teclado nao esta no rc.xml e sim no environment; se sumir, a
    # montagem do mapa XKB falha e o compositor morre antes de desenhar.
    grep -q "^XKB_DEFAULT_LAYOUT=" "$STAGE/etc/xdg/labwc/environment" || {
        echo "desktop: environment sem XKB_DEFAULT_LAYOUT" >&2
        exit 1
    }
    [ -e "$STAGE/etc/rc.d/rcS.d/01-machine-id.sh" ] || {
        echo "desktop: falta o drop-in do machine-id" >&2
        exit 1
    }
    # O udevd tem que estar no drop-in ANTES do seatd: a libinput enumera
    # dispositivo pela libudev, que só enxerga o que está na base do udev.
    [ -e "$STAGE/etc/rc.d/rcS.d/05-udevd.sh" ] || {
        echo "desktop: falta o drop-in do udevd" >&2
        exit 1
    }

    # --- guardas da barra ---------------------------------------------------
    # A barra e arquivos CONCORDANDO, e concordancia entre arquivos ja matou
    # esta sessao duas vezes (o log, o barramento). (a) o autostart sobe a
    # barra e o binario existe na arvore instalada — mesma cobranca que o
    # menu.xml paga pelos comandos dele.
    grep -q '^yambar -c "\$barra" &$' "$STAGE/etc/xdg/labwc/autostart" || {
        echo "desktop: o autostart nao sobe a barra de tarefas" >&2
        exit 1
    }
    [ -x /usr/bin/yambar ] || {
        echo "desktop: o autostart chama yambar, que nao esta em /usr/bin" >&2
        exit 1
    }
    # (b) o recuo do -c aponta para um arquivo que ESTA receita instala. E o
    # par log-da-sessao de novo: dois pontos do mesmo caminho, so que aqui os
    # dois saem do mesmo heredoc — a guarda existe para quando deixarem de sair.
    barra_recuo=$(sed -n 's/^\[ -e "\$barra" \] || barra=\(\/etc\/[^ ]*\)$/\1/p' \
        "$STAGE/etc/xdg/labwc/autostart")
    [ -n "$barra_recuo" ] || {
        echo "desktop: o autostart nao declara recuo de configuracao em /etc" >&2
        exit 1
    }
    [ -e "$STAGE$barra_recuo" ] || {
        echo "desktop: o autostart aponta $barra_recuo, que esta receita nao instala" >&2
        exit 1
    }
    # (c) a config PASSA NO PARSER QUE VAI LE-LA: yambar --validate carrega o
    # arquivo inteiro — yml, gramatica do map, particles, cores, a fonte via
    # fcft/fontconfig da view — e sai antes de tocar em qualquer socket. Com
    # backend-x11 desligado no build, o AUTO cai no vtable Wayland sem
    # consultar WAYLAND_DISPLAY (bar_new, ramo !ENABLE_X11 && ENABLE_WAYLAND),
    # e a conexao so aconteceria no run(), que o -C nunca chama — medido no
    # main.c antes de entrar aqui. Isto tambem cobre modulo por modulo: um
    # nome que o yambar da arvore nao compilou reprova aqui, pela boca do
    # proprio registro de plugins. Erro nesta config nao tem outra guarda: em
    # runtime a barra morre SEM derrubar a sessao, e a unica testemunha seria
    # a foto sem barra.
    /usr/bin/yambar -C -c "$STAGE$barra_recuo" -s 2>./barra-validate.err || {
        echo "desktop: a config da barra nao passa no yambar --validate:" >&2
        cat ./barra-validate.err >&2
        exit 1
    }
    rm -f ./barra-validate.err
    unset barra_recuo
    # (d) todo on-click da barra aponta para executavel INSTALADO. O clique
    # nao passa por shell nem por PATH; um caminho errado e um clique que
    # morre em silencio, o mesmo defeito do menu com PNG inexistente. So o
    # PRIMEIRO campo e o executavel — o resto da linha e argumento.
    for barra_clique in $(sed -n 's|^[[:space:]]*on-click: \(/[^ ]*\).*$|\1|p' \
                              "$STAGE/etc/xdg/yambar/config.yml" | sort -u); do
        [ -x "$barra_clique" ] || {
            echo "desktop: a barra clica em $barra_clique, que nao existe na arvore" >&2
            exit 1
        }
    done
    unset barra_clique

    # --- guardas do navegador padrao --------------------------------------
    # TRES ARQUIVOS NOMEIAM O MESMO NAVEGADOR: o mimeapps.list (padrao XDG),
    # o windowRule do rc.xml (maximizar) e o proprio .desktop instalado. Um
    # rename no Epiphany quebraria os tres de formas diferentes e caladas;
    # aqui os tres sao amarrados um no outro.
    nav_id=$(sed -n 's|^x-scheme-handler/https=\(.*\)\.desktop$|\1|p' \
        "$STAGE/etc/xdg/mimeapps.list")
    [ -n "$nav_id" ] || {
        echo "desktop: mimeapps.list sem navegador para https" >&2
        exit 1
    }
    [ -e "/usr/share/applications/$nav_id.desktop" ] || {
        echo "desktop: mimeapps aponta $nav_id.desktop, que nao esta instalado" >&2
        exit 1
    }
    grep -q "windowRule identifier=\"$nav_id\"" "$STAGE/etc/xdg/labwc/rc.xml" || {
        echo "desktop: o rc.xml nao maximiza o navegador do mimeapps ($nav_id)" >&2
        exit 1
    }
    unset nav_id
    # E O OVERRIDE DE SCHEMA PASSA NO COMPILADOR, contra os schemas REAIS da
    # arvore e em modo estrito. Sem --strict o glib-compile-schemas apenas
    # AVISA e ignora um override com chave errada — a home morreria calada, e
    # so a foto contaria. Com ele, um Epiphany futuro que renomeie
    # homepage-url derruba este build com a mensagem certa.
    mkdir -p ./schemas-teste
    cp /usr/share/glib-2.0/schemas/*.gschema.xml ./schemas-teste/
    # Os enums moram em *.enums.xml (org.gnome.desktop.enums.xml, do
    # gsettings-desktop-schemas) e o --strict recusa schema com enum de fora;
    # sem eles esta guarda reprovava a arvore correta — medido na simulacao.
    for gschemas_enums in /usr/share/glib-2.0/schemas/*.enums.xml; do
        [ -e "$gschemas_enums" ] || break
        cp "$gschemas_enums" ./schemas-teste/
    done
    unset gschemas_enums
    cp "$STAGE/usr/share/glib-2.0/schemas/90_distropica.gschema.override" ./schemas-teste/
    /usr/bin/glib-compile-schemas --strict --dry-run ./schemas-teste 2>./override-erro || {
        echo "desktop: o override de schema nao casa com os schemas da arvore:" >&2
        cat ./override-erro >&2
        exit 1
    }
    rm -rf ./schemas-teste ./override-erro

    # --- guarda do menu de aplicativos --------------------------------------
    # O pipemenu e um contrato entre TRES coisas: o menu.xml que o invoca, o
    # script instalado, e a saida dele. As tres sao cobradas aqui, e a
    # ultima RODANDO o script de verdade — dentro da view, com o BusyBox que
    # a maquina instalada tem —, porque um pipemenu que emite lixo nao
    # derruba a sessao: ele so faz o submenu nao abrir, em silencio.
    menu_pipe=$(sed -n 's|.*execute="\(/usr/libexec/[a-z-]*\)".*|\1|p' \
        "$STAGE/etc/xdg/labwc/menu.xml")
    [ -n "$menu_pipe" ] || {
        echo "desktop: o menu raiz nao tem submenu de aplicativos" >&2
        exit 1
    }
    [ -x "$STAGE$menu_pipe" ] || {
        echo "desktop: o menu aponta $menu_pipe, que esta receita nao instala" >&2
        exit 1
    }
    sh -n "$STAGE$menu_pipe" || {
        echo "desktop: o gerador do menu de aplicativos nao e shell valido" >&2
        exit 1
    }
    LANG=pt_BR.UTF-8 sh "$STAGE$menu_pipe" > ./menu-aplicativos.xml 2>./menu-erro || {
        echo "desktop: o gerador do menu de aplicativos falhou:" >&2
        cat ./menu-erro >&2
        exit 1
    }
    [ "$(head -1 ./menu-aplicativos.xml)" = "<openbox_pipe_menu>" ] &&
        [ "$(tail -1 ./menu-aplicativos.xml)" = "</openbox_pipe_menu>" ] || {
        echo "desktop: a saida do menu de aplicativos nao esta dentro de" \
             "<openbox_pipe_menu>; o labwc descarta o submenu inteiro" >&2
        head -3 ./menu-aplicativos.xml >&2
        exit 1
    }
    # Um item por linha e ACAO por item: foi a ordenacao linha a linha que
    # embaralhou os itens uns dentro dos outros na primeira versao, e o
    # sintoma era XML que ainda abria e fechava direito.
    menu_itens=$(grep -c '<item label=' ./menu-aplicativos.xml || true)
    menu_acoes=$(grep -c '<action name="Execute"' ./menu-aplicativos.xml || true)
    [ "$menu_itens" -ge 1 ] && [ "$menu_itens" = "$menu_acoes" ] || {
        echo "desktop: o menu de aplicativos saiu com $menu_itens item(ns) e" \
             "$menu_acoes acao(oes); a ordenacao embaralhou os registros" >&2
        exit 1
    }
    rm -f ./menu-aplicativos.xml ./menu-erro
    unset menu_pipe menu_itens menu_acoes

    # --- guarda do lancador -------------------------------------------------
    # O proprio fuzzel valida a config, e e ele quem vai le-la: --check-config
    # carrega o arquivo e sai. Sem isto, uma chave errada viraria lancador com
    # padroes silenciosos — o mesmo tipo de falha muda que o --validate do
    # yambar fecha do outro lado. E a busca por palavra-chave e cobrada por
    # nome: e ela que faz "gimp" achar um .desktop cujo Name e "GNU Image
    # Manipulation Program".
    grep -q '^fields=.*keywords' "$STAGE/etc/xdg/fuzzel/fuzzel.ini" || {
        echo "desktop: o fuzzel nao casa por keywords; aplicativo com Name" \
             "diferente do nome popular fica inacessivel pela digitacao" >&2
        exit 1
    }
    /usr/bin/fuzzel --check-config --config "$STAGE/etc/xdg/fuzzel/fuzzel.ini" \
        2>./fuzzel-check.err || {
        echo "desktop: a config do lancador nao passa no fuzzel --check-config:" >&2
        cat ./fuzzel-check.err >&2
        exit 1
    }
    rm -f ./fuzzel-check.err

    # --- guardas da parede e dos daemons de sessao -------------------------
    # (a) o autostart e esta receita apontam para a MESMA parede, e ela e um
    # PNG de verdade — o wbg desta arvore so decodifica PNG, de proposito.
    # Dois pontos do mesmo caminho, ainda que no mesmo pacote: ja se viu o
    # que acontece quando pontos combinados param de combinar.
    parede=$(sed -n 's|^wbg \(/usr/[^ ]*\) &$|\1|p' "$STAGE/etc/xdg/labwc/autostart")
    [ -n "$parede" ] || {
        echo "desktop: o autostart nao sobe a parede" >&2
        exit 1
    }
    [ -s "$STAGE$parede" ] || {
        echo "desktop: o autostart aponta $parede, que esta receita nao instala" >&2
        exit 1
    }
    [ "$(head -c 4 "$STAGE$parede" | tail -c 3)" = "PNG" ] || {
        echo "desktop: $parede nao tem assinatura de PNG" >&2
        exit 1
    }
    unset parede
    # (b) todo daemon que o autostart sobe existe na arvore instalada — a
    # mesma cobranca que o menu paga pelos comandos dele.
    for sessao_daemon in wbg fnott; do
        grep -q "^$sessao_daemon " "$STAGE/etc/xdg/labwc/autostart" || {
            echo "desktop: o autostart nao sobe o $sessao_daemon" >&2
            exit 1
        }
        [ -x "/usr/bin/$sessao_daemon" ] || {
            echo "desktop: o autostart chama $sessao_daemon, que nao esta em /usr/bin" >&2
            exit 1
        }
    done
    unset sessao_daemon
}
