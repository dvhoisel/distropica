NAME=libsm
VERSION=1.2.6
KIND=source
TOOLCHAIN=native
DEPS="glibc libice"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto libice"
ABOUT="Gerenciamento de sessões do X.Org, dependência direta da libXt. É parte da pequena cadeia X11 que o GIMP herda do GTK3 já existente; libuuid é desligada porque identificadores locais bastam e evitam uma dependência sem outro consumidor."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libSM-$VERSION.tar.xz"
SHA256=be7c0abdb15cbfd29ac62573c1c82e877f9d4047ad15321e7ea97d1e43d835be

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --disable-docs --without-libuuid --without-xmlto --without-fop \
        --without-xsltproc
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libSM.so.6" ] || { echo "libsm: libSM.so.6 ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
