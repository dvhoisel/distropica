NAME=libxkbcommon
VERSION=1.13.2
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf bison"
ABOUT="Tradução de código de tecla em símbolo, com layout, modificador e compose. No Wayland o compositor manda o teclado como um keymap XKB e o cliente o interpreta com esta biblioteca — sem ela o GTK recebe tecla e não sabe que letra é. Substitui a parte do X11 que fazia isso, e é uma das poucas peças do mundo X que sobrevive num sistema Wayland-only. Sem o backend X11 e sem as ferramentas de linha de comando, que servem para depurar layout à mão. É o tarball de tag do GitHub, que é o que o Alpine pina: o site xkbcommon.org responde HTML para o caminho de download desta versão."
LICENSE=MIT
SRC="https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$VERSION.tar.gz"
SHA256=acc4d5f7c3cbba5f9f8d08d8bdbeede84ecede46792f47929aa9321873385528

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # -Denable-x11=false é a decisão de perfil desta distro, não economia:
    # Wayland-only significa que o backend X11 não teria com o que falar.
    # -Denable-xkbregistry=false: o registro serve para LISTAR os layouts
    # disponíveis numa interface de configuração, e exige libxml2. Interpretar
    # o keymap — que é o que GTK e Firefox precisam — não passa por ele.
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Denable-x11=false \
        -Denable-xkbregistry=false \
        -Denable-wayland=true \
        -Denable-docs=false \
        -Denable-tools=false \
        -Denable-bash-completion=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    find "$STAGE" -type d -empty -delete
}
