NAME=gst-plugins-bad
VERSION=1.28.6
KIND=source
TOOLCHAIN=native
DEPS="glibc glib gstreamer gst-plugins-base opus"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf busybox python-glibc findutils"
ABOUT="DOIS PLUGINS, e dois só: o opusparse e os parsers de vídeo (videoparsersbad, de onde o WebKit tira o vp9parse). O nome do pacote engana e por isso vale dizer — 'bad' no vocabulário do GStreamer não é licença nem patente, é maturidade de código; quem carrega problema de licenciamento é o 'ugly', que esta árvore não traz. O que trouxe este pacote foi uma medição: o YouTube abriu com o player montado e recusou tocar, e a causa estava no GStreamerRegistryScanner.cpp:531 do WebKit — em modo Media Source, o Opus só é registrado como codec se existir um PARSER para audio/x-opus, e não basta o decodificador. O opusdec vem do gst-plugins-base; o opusparse mora aqui, em ext/opus, e em lugar nenhum mais das três coleções. Sem ele o navegador anuncia audio/webm e nega o codec opus, que é exatamente o que o YouTube pergunta antes de tocar. O vp9parse entrou pela mesma porta um release depois: em MSE o vídeo VP9 também exige parser registrado, e a watch page do YouTube morria com 'GStreamer element vp9parse not found' no stderr — o plugin de parsers é um .so único (h264parse e h265parse vêm juntos, sem como fatiar por elemento), e isso não move a fronteira de licenciamento: parser analisa bitstream, não decodifica; quem infringiria patente é o DECODIFICADOR, que continua fora. O build usa --auto-features=disabled: as quase duzentas features deste pacote ficam TODAS desligadas por construção, e só opus e videoparsers são ligados explicitamente — o payload não varia com o que estiver instalado na raiz, e nada de H.264, HEVC ou os wrappers de codec proprietário entra pela porta dos fundos."
LICENSE="LGPL-2.1-or-later"
SRC="https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-$VERSION.tar.xz"
SHA256="6636f2c2289ceda52c4aba971338c81e2b5780d3381bd3673c1c116ec87587c3"

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        --auto-features=disabled \
        -Dopus=enabled \
        -Dvideoparsers=enabled \
        -Dgpl=disabled \
        -Dintrospection=disabled \
        -Dexamples=disabled \
        -Dtests=disabled \
        -Dnls=disabled \
        -Ddoc=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # SÓ O PLUGIN FICA. O --auto-features=disabled desliga os PLUGINS, mas as
    # bibliotecas públicas deste pacote são construídas incondicionalmente:
    # medido, 180 arquivos entraram — CUDA, WebRTC, mpegts, os parsers de
    # H.264/H.265/H.266, câmera, analytics, transcoder. Nada disso tem
    # consumidor nesta árvore, e a auditoria de ABI foi quem denunciou, ao
    # cobrar libstdc++ para uma libgstcuda que ninguém pediu. O opusparse não
    # liga nenhuma delas — conferido no NEEDED: só núcleo, base e opus.
    #
    # Payload sem consumidor é dívida de auditoria, e aqui seria dívida com
    # superfície: cabeçalhos e .pc de codecs que esta distro recusou.
    rm -rf "$STAGE/usr/include" "$STAGE/usr/lib/pkgconfig" \
           "$STAGE/usr/share/gstreamer-1.0" "$STAGE/usr/share/locale"
    # A codecparsers FICA: o videoparsersbad liga nela (NEEDED
    # libgstcodecparsers-1.0.so.0 — a auditoria de ABI recusou o payload sem
    # ela, "sem provedor na closure"). E o parser de bitstream compartilhado
    # que os elementos usam; LGPL como o resto. So o SONAME e o real ficam —
    # o symlink de desenvolvimento .so vai embora com os demais.
    find "$STAGE/usr/lib" -maxdepth 1 -name 'libgst*' \
        ! -name 'libgstcodecparsers-1.0.so.0*' -delete

    [ -e "$STAGE/usr/lib/gstreamer-1.0/libgstopusparse.so" ] || {
        echo "gst-plugins-bad: o opusparse não foi produzido — é o único motivo deste pacote" >&2
        ls "$STAGE/usr/lib/gstreamer-1.0" 2>/dev/null >&2
        exit 1
    }
    # O elemento tem de existir com esse nome: é por ele que o WebKit procura
    # um parser de audio/x-opus, e é a ausência dele que fazia o YouTube
    # recusar o codec com o player já montado.
    strings -a "$STAGE/usr/lib/gstreamer-1.0/libgstopusparse.so" | grep -qx 'opusparse' || {
        echo "gst-plugins-bad: o plugin não registra o elemento opusparse" >&2
        exit 1
    }
    # O SEGUNDO PLUGIN É O DOS PARSERS DE VÍDEO, e ele entrou pelo mesmo
    # buraco que o primeiro: o MSE do WebKit exige um parser registrado para
    # o fluxo — audio/x-opus pedia o opusparse, e video/x-vp9 pede o
    # vp9parse. Medido na watch page do YouTube com o stderr do navegador em
    # arquivo: "GStreamer element vp9parse not found. Please install it", e o
    # vídeo não toca. O plugin é um .so único com os parsers todos
    # (h264parse, h265parse... vêm juntos, não há como fatiar por elemento),
    # e isso NÃO muda a fronteira de licenciamento: parser analisa bitstream
    # e não decodifica — quem infringiria patente é o DECODIFICADOR, que
    # continua fora. O LICENSING.md diz isso com todas as letras.
    [ -e "$STAGE/usr/lib/gstreamer-1.0/libgstvideoparsersbad.so" ] || {
        echo "gst-plugins-bad: o videoparsersbad não foi produzido; sem o" \
             "vp9parse o vídeo MSE do YouTube não toca" >&2
        ls "$STAGE/usr/lib/gstreamer-1.0" 2>/dev/null >&2
        exit 1
    }
    strings -a "$STAGE/usr/lib/gstreamer-1.0/libgstvideoparsersbad.so" | grep -qx 'vp9parse' || {
        echo "gst-plugins-bad: o plugin de parsers não registra o vp9parse" >&2
        exit 1
    }
    # DOIS PLUGINS E MAIS NENHUM. O --auto-features=disabled é o que garante
    # isso, e esta guarda é quem cobra a garantia: qualquer plugin a mais
    # significa que uma feature voltou a ligar sozinha.
    # A guarda conta o PAYLOAD INTEIRO e não só o diretório de plugins: a
    # primeira versão contava plugins, viu "1" e deixou passar as 180
    # bibliotecas ao lado. Dois arquivos é o número certo.
    quantos=$(find "$STAGE" -type f -o -type l | wc -l)
    [ "$quantos" -eq 4 ] || {
        echo "gst-plugins-bad: $quantos arquivos no payload; era para ser" \
             "opusparse + videoparsersbad + codecparsers (real e SONAME)" >&2
        find "$STAGE" -type f -o -type l | head -20 >&2
        exit 1
    }
    unset quantos
    find "$STAGE" -type d -empty -delete
}
