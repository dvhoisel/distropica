NAME=zlib
VERSION=1.3.2
KIND=source
TOOLCHAIN=cross
DEPS="glibc"
BUILD_DEPS="gcc binutils-cross make busybox"
ABOUT="compressão DEFLATE $VERSION reconstruída cedo contra glibc pelo cross GCC; dependência explícita de binutils-glibc e gcc-pass2, sem capturar uma libz casual do root."
LICENSE="Zlib"
SRC="https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz"
SHA256="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"
SIG_UNSAFE_WAIVER="files/assinatura-insegura"

build() {
    mkdir -p "$WORK/.tc"
    cat > "$WORK/.tc/x86_64-distropica-linux-gnu-gcc" <<'SHIM'
#!/bin/sh
exec /usr/bin/x86_64-distropica-linux-gnu-gcc -isystem /usr/include -B/usr/lib -L/usr/lib "$@"
SHIM
    chmod +x "$WORK/.tc"/*
    export PATH="$WORK/.tc:$PATH"
    export CC=x86_64-distropica-linux-gnu-gcc AR=ar RANLIB=ranlib

    tar -xzf "$DL" --strip-components=1
    # zlib tem configure próprio (não autotools).
    ./configure --prefix=/usr
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
