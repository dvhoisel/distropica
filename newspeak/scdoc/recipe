NAME=scdoc
VERSION=1.11.5
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="gcc-pass2 binutils-glibc make file findutils"
ABOUT="Gerador de páginas de manual: lê um formato de marcação de uma linha só e escreve roff. Está nesta árvore por UMA razão e nenhuma outra — o iwgtk, a ferramenta gráfica de Wi-Fi, chama find_program('scdoc') no meson.build dele sem 'required: false' e sem opção de desligar; conferido no fonte do 0.9, que não tem meson_options.txt nem meson.options. Ou seja: não há como construir o iwgtk sem isto, e por isso o scdoc é BUILD_DEPS dele e de mais nada. NÃO ENTRA NO FECHAMENTO DE EXECUÇÃO, e é essa a diferença que importa para o tamanho da mídia: quem depende dele depende em tempo de construção, o binário fica no rootfs de build e não na ISO. O upstream mora no sr.ht do Drew DeVault e não publica tarball de release — o que existe é o arquivo gerado pela forja a partir da tag, que é o mesmo que Alpine e Arch consomem; foi baixado duas vezes aqui e deu o mesmo sha256, então a geração é determinística o bastante para ser fixada. Construído DINÂMICO, contrariando o Makefile: ver o comentário no build()."
LICENSE="MIT"
SRC="https://git.sr.ht/~sircmpwn/scdoc/archive/$VERSION.tar.gz"
SHA256="98780bbdf16c1bce89ef3a8c0f537ac6e4ea77087b609e7698857614488a2a62"

build() {
    tar -xzf "$DL" --strip-components=1

    # LDFLAGS="" ANULA O -static DO UPSTREAM, e isto é deliberado. O Makefile
    # traz 'LDFLAGS+=-static'; como make dá precedência à variável passada na
    # linha de comando e ignora o += do arquivo sobre ela, definir LDFLAGS vazio
    # aqui derruba o -static. A árvore TEM libc.a, então o estático até linkaria
    # — o motivo não é falta, é coerência: todo binário desta árvore se explica
    # por 'readelf -d', e um estático seria o único cuja ligação com a glibc não
    # aparece em lugar nenhum. A guarda no fim depende exatamente disso.
    #
    # CFLAGS: o Makefile usa '?=' e traz só '-g'. Otimizar um gerador que roda
    # centenas de vezes num build de manual é barato; o -g sem otimização não é
    # nem uma coisa nem outra.
    make -j"$JOBS" \
        PREFIX=/usr \
        LDFLAGS="" \
        CFLAGS="-O2"
    make install \
        PREFIX=/usr \
        DESTDIR="$STAGE"

    # Guarda 1: o binário. Sem ele o pacote é um diretório de manuais.
    [ -x "$STAGE/usr/bin/scdoc" ] || {
        echo "scdoc: o binário não foi produzido" >&2
        ls -R "$STAGE" 2>/dev/null | head -30 >&2
        exit 1
    }
    # Guarda 2: dinâmico de verdade. Se um dia o upstream mudar a forma de
    # aplicar o -static — ou se o LDFLAGS="" deixar de vencer o += — o build
    # continuaria passando e o pacote viraria a exceção silenciosa da árvore.
    readelf -dW "$STAGE/usr/bin/scdoc" 2>/dev/null |
        grep -q 'NEEDED.*libc\.so' || {
        echo "scdoc: o binário não é dinâmico contra a libc" >&2
        readelf -dW "$STAGE/usr/bin/scdoc" 2>/dev/null | head -10 >&2
        file "$STAGE/usr/bin/scdoc" >&2 2>/dev/null || true
        exit 1
    }
    # Guarda 3: ele PROCESSA. Um scdoc que existe e aborta no primeiro .scd
    # derrubaria o iwgtk lá na frente, com a mensagem de erro do meson e não a
    # daqui. O próprio Makefile já roda isto ao gerar scdoc.1 a partir de
    # scdoc.1.scd; a conferência é sobre o resultado, que tem de ser roff.
    #
    # É '.TH em qualquer linha' e NÃO na primeira. A primeira versão desta
    # guarda exigia a primeira linha e derrubou o build com o pacote inteiro
    # construído e instalado: a saída do scdoc abre com um preâmbulo fixo de
    # roff — '.\" Generated by scdoc', a definição de \*(Aq, '.nh', '.ad l' —
    # e só então vem o .TH que o parser emite ao ler o cabeçalho do .scd. O que
    # prova que ele parseou o documento é o .TH existir, não onde ele está.
    grep -q '^\.TH' "$STAGE/usr/share/man/man1/scdoc.1" 2>/dev/null || {
        echo "scdoc: a página gerada não tem linha .TH — não é roff" >&2
        head -8 "$STAGE/usr/share/man/man1/scdoc.1" 2>/dev/null >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
