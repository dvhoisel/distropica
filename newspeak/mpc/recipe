NAME=mpc
VERSION=1.4.1
KIND=source
# Semente musl: cede /usr/lib/libmpc* ao rebuild glibc (mathlibs-glibc).
PROVISIONAL=1
DEPS="gmp mpfr"
BUILD_DEPS="binutils make busybox"
ABOUT="aritmética complexa de precisão arbitrária; a terceira biblioteca matemática que o gcc exige"
LICENSE=LGPL-3.0-or-later
# .tar.xz e não .tar.gz: o GNU trocou o formato a partir do 1.4.0, e o 1.3.1
# só existe em .gz. Descoberto pelo `sobe-versao`, que recusou subir porque a
# URL derivada dava 404 — em vez de gravar versão nova com o hash da velha.
SRC="https://ftp.gnu.org/gnu/mpc/mpc-$VERSION.tar.xz"
SHA256="91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931"
# O upstream usa DSA p=2048/q=256 + SHA-256 nos dados: fora da StandardPolicy
# e recusado pelo motor normal. O waiver v3 não relaxa essa política; confina
# uma prova matemática da assinatura à primária exata, cujo fingerprint e
# publicação da release estão presos em duas páginas oficiais versionadas.
SIG_UNSAFE_WAIVER="files/assinatura-insegura"

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --disable-nls --disable-dependency-tracking \
        --with-gmp="$ROOT/usr" --with-mpfr="$ROOT/usr"
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
