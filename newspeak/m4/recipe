NAME=m4
VERSION=1.4.21
KIND=source
# gawk: o `./configure` desta fonte chama awk, e declarar só `busybox` NÃO
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora.
# Esta receita já construiu sem declarar, mas só porque calhava de vir ANTES
# do gawk na resolução; ordem não é contrato, e bastou outra receita declarar
# gawk para ele subir na ordem e esta quebrar. Quem está na closure do próprio
# gawk (binutils, make, busybox, zig) é garantido vir antes dele e por isso não
# declara; todo o resto precisa.
BUILD_DEPS="make busybox gawk"
ABOUT="processador de macros GNU; o gmp não configura sem ele (gera o assembly das mpn)"
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/m4/m4-$VERSION.tar.xz"
SHA256=f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66
# Chave extraída do keyring oficial https://ftp.gnu.org/gnu/gnu-keyring.gpg;
# signer observado e primária 71C2CC22B1C4602927D2F3AAA7A16B4A2527436A.
SIG_1="https://ftp.gnu.org/gnu/m4/m4-1.4.21.tar.xz.sig"
SIG_EPOCH_1=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=71C2CC22B1C4602927D2F3AAA7A16B4A2527436A
# reprocorr: o hash reprodutível canônico — sha256 do pack(STAGE) (SPEC-0010 §4).
# É a raiz de confiança da corroboração (SPEC-0009 §6): o build DEVE reproduzi-lo
# (crimestop se divergir), e uma attestation de builder o assina. m4 é provado
# byte-idêntico (SPEC-0010); esta é a 1ª receita a pinar REPROCORR.
#
# O VALOR MUDOU, e o motivo é declarado e não descoberto: o runner passou a
# declarar CFLAGS/CXXFLAGS="-O2 -g0" no contrato de build, então o payload é
# legitimamente outro. O anterior era
# de4710b70e7acc1267cf106b285f80e4a384ce6923fb4ed2b3bf4181bb29946e, construído
# quando o autoconf ainda preenchia CFLAGS com o seu default "-g -O2".
#
# O crimestop funcionou: foi ele que parou a reconstrução da árvore em vez de
# deixar passar um artefato que a receita não descrevia mais. O valor novo foi
# MEDIDO — e o crimestop é quem valida: com o pin no lugar, uma segunda
# construção que divergisse falharia. A mensagem de erro passou a imprimir os
# hashes inteiros, então já não é preciso tirar o pin para ler o valor novo.
#
# REPINADO em 2026-08-12. O m4 continua 1.4.21; o que mudou foi a toolchain sob
# ele — GCC, binutils e glibc subiram na mesma leva. REPROCORR prende "esta
# árvore, com esta toolchain, produz estes bytes", então subir a toolchain
# envelhece o pino por construção. O valor anterior era
# 3609991d1e8a84964e8ed758bda67134dfe5242ba03eeb4b58592418d454a502.
#
# Duas construções independentes produziram este hash antes de ele ser pinado,
# o que prova determinismo ENTRE RODADAS nesta máquina. Reprodução entre
# ambientes limpos distintos continua sendo gate aberto da SPEC-0005.
REPROCORR=bd9ee572820e5db01a1e626d16e26f16b5db8833323efab7073b74f3ceac52c0

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --disable-nls --disable-dependency-tracking
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
