NAME=libgpg-error
VERSION=1.61
KIND=source
TOOLCHAIN=native
# busybox: o payload traz /usr/bin/gpgrt-config, script de shell. É a convenção desta
# árvore para scripts vivos — ncurses, curl, libpng, libxml2 e pcre2 declaram
# busybox pelo mesmo motivo. Sem a declaração o pacote vai para ABI_PENDING e
# derruba o fechamento inteiro da cadeia, e não só a si mesmo.
DEPS="glibc busybox"
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk busybox"
ABOUT="A base da pilha do GnuPG: códigos de erro e alguns utilitários comuns (gpgrt) que a libgcrypt exige antes de compilar qualquer linha. Não faz criptografia — existe para que erro tenha o mesmo número e o mesmo nome em todas as bibliotecas da família. Entra na árvore por um caminho só: o WebKitGTK exige LibGcrypt 1.7.0 ou maior, e a libgcrypt não constrói sem esta. Sem doc, sem testes e SEM as ligações de linguagem (--disable-languages), que instalariam arquivos .m4 e wrappers para Common Lisp e Python que ninguém aqui usa; sem nls, porque a distro não traduz mensagem de biblioteca."
LICENSE=LGPL-2.1-or-later
SRC="https://gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-$VERSION.tar.bz2"
SHA256="7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93"

build() {
    tar -xjf "$DL" --strip-components=1
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static \
        --disable-doc \
        --disable-tests \
        --disable-languages \
        --disable-nls
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    # A libgcrypt procura este script para descobrir cflags e libs; sem ele o
    # configure dela responde "não achei" e o WebKit perde o LibGcrypt REQUIRED.
    [ -x "$STAGE/usr/bin/gpg-error-config" ] || [ -e "$STAGE/usr/lib/pkgconfig/gpg-error.pc" ] || {
        echo "libgpg-error: nem gpg-error-config nem gpg-error.pc foram produzidos" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
