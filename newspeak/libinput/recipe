NAME=libinput
VERSION=1.32.0
KIND=source
TOOLCHAIN=native
DEPS="glibc libevdev eudev mtdev mathlibs-glibc busybox python-glibc"
BUILD_DEPS="make gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc findutils"
ABOUT="A camada que transforma evento cru em gesto: aceleração de ponteiro, toque duplo, rolagem por dois dedos, palm rejection. É o que todo compositor Wayland usa para entrada — no X11 esse papel era do servidor, e no Wayland ele saiu do compositor para uma biblioteca comum. Descobre os dispositivos pelo udev, daí o eudev. Exige mtdev, e recusa configurar sem ela mesmo num sistema que só tem mouse. Sem libwacom, que serve a mesa digitalizadora e traria uma base de dados de modelos; sem a GUI de depuração, que precisaria de GTK — e o GTK ainda não existe nesta árvore."
LICENSE=MIT
SRC="https://gitlab.freedesktop.org/libinput/libinput/-/archive/$VERSION/libinput-$VERSION.tar.gz"
SHA256="7dd6c1ca964c86eb6810ccd6639cda634e68bdca43bf3afec39e94e942fac8d4"

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dlibwacom=false \
        -Ddebug-gui=false \
        -Dtests=false \
        -Ddocumentation=false \
        -Dinstall-tests=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    find "$STAGE" -type d -empty -delete
}
