NAME=libxmlb
VERSION=0.3.29
KIND=source
TOOLCHAIN=native
DEPS="glibc glib xz"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc glib xz"
ABOUT="Banco binário de metadados XML usado pela AppStream. Mantém compressão xz, mas não instala CLI, documentação, GIR, testes, stemmer ou zstd; o GIMP consome a biblioteca pela AppStream."
LICENSE=LGPL-2.1-or-later
SRC="https://github.com/hughsie/libxmlb/releases/download/$VERSION/libxmlb-$VERSION.tar.xz"
SHA256=448294be33bfae62f00fa66e506f1cae80237ce71b7ab6530aefa75005eeb08a

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release \
        -Dgtkdoc=false -Dintrospection=false -Dtests=false \
        -Dstemmer=false -Dcli=false -Dlzma=enabled -Dzstd=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install
    [ -e "$STAGE/usr/lib/pkgconfig/xmlb.pc" ] || { echo "libxmlb: xmlb.pc ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
