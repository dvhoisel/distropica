NAME=locales
VERSION=2.44
KIND=source
TOOLCHAIN=native
DEPS="glibc"
# gawk: o `./configure` desta fonte chama awk, e nenhuma dependência declarada
# garante awk — o gawk supersede o busybox e leva /usr/bin/awk embora assim que
# entra no mesmo plano. Antes disso o applet servia, então a receita parecia
# correta e a quebra ficava escondida atrás da ORDEM de construção. Só quem
# está na closure do próprio gawk (binutils, make, busybox, zig) é garantido
# vir antes dele e dispensa a declaração.
BUILD_DEPS="glibc gettext gawk"
SRC="https://ftp.gnu.org/gnu/glibc/glibc-$VERSION.tar.xz"
SHA256="37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667"
ABOUT="Tudo o que é derivado do glibc e depende do gettext. São duas coisas, e a segunda existe por uma restrição de bootstrap: o glibc NÃO PODE depender do gettext, porque o gettext precisa do gcc-pass2, que precisa do glibc — declarar seria ciclo. Mas o build do glibc não é hermético, e procura msgfmt no ambiente: no dia em que o gettext entrou na árvore por causa do GTK, o glibc começou a compilar 39 catálogos libc.mo que nunca compilava antes, mudando o payload sem mudar a receita nem o fingerprint. A resposta foi pinar MSGFMT=: no glibc, fixando o estado que sempre valeu, e passar os catálogos para cá — este pacote já depende do glibc e pode declarar o gettext sem ciclo nenhum. Compila só o catálogo pt_BR, e não os 39: a árvore gera dois locales, não 369, e entregar tradução de idioma que ninguém pediu seria incoerente. Baixa o tarball do glibc porque agora precisa do po/ dele; a versão continua acompanhando a do glibc porque é dele que vem toda a entrada. Antes disso a árvore tinha as 369 definições de locale e o localedef, mas nenhum locale COMPILADO — /usr/lib/locale estava vazio, e por isso nem o comando locale rodava; qualquer programa que chamasse setlocale caía silenciosamente para o C. Gera dois: pt_BR.UTF-8, que é o pedido, e C.UTF-8, que é o C de sempre mas capaz de UTF-8 — sem ele, um programa em ambiente neutro trunca acento. Usa --no-archive de propósito: o padrão do localedef é acumular tudo num único /usr/lib/locale/locale-archive, arquivo mutável e compartilhado que dois pacotes escreveriam por cima um do outro e que nenhum manifesto consegue reivindicar honestamente. Em diretórios separados, cada arquivo tem dono e hash. A saída é determinística: duas execuções dão bytes idênticos, verificado antes de escrever esta receita."
LICENSE="LGPL-2.1-or-later"

build() {
    tar -xJf "$DL" --strip-components=1

    # Os catálogos de mensagem do glibc, que ele mesmo não pode compilar por não
    # poder depender do gettext. É o libc.mo que traduz strerror() e perror():
    # sem ele, "No such file or directory" fica em inglês num sistema pt_BR.
    install -dm755 "$STAGE/usr/share/locale/pt_BR/LC_MESSAGES"
    msgfmt -o "$STAGE/usr/share/locale/pt_BR/LC_MESSAGES/libc.mo" po/pt_BR.po
    [ -s "$STAGE/usr/share/locale/pt_BR/LC_MESSAGES/libc.mo" ] || {
        echo "locales: libc.mo saiu vazio" >&2
        exit 1
    }

    install -dm755 "$STAGE/usr/lib/locale"
    for spec in "pt_BR UTF-8 pt_BR.UTF-8" "C UTF-8 C.UTF-8"; do
        # shellcheck disable=SC2086
        set -- $spec
        # O aviso "failed to set locale" é o próprio localedef não achando um
        # locale para si mesmo, o que é esperado quando ainda não há nenhum.
        localedef --prefix="$STAGE" --no-archive -i "$1" -f "$2" "$3" 2>&1 \
            | grep -v 'failed to set locale' || true
    done

    # O localedef liga por HARDLINK o que sai idêntico entre locales — aqui o
    # LC_CTYPE, que é o mesmo para C.UTF-8 e pt_BR.UTF-8 porque a classificação
    # de caracteres UTF-8 não muda com o idioma, mais os minúsculos
    # LC_MEASUREMENT e LC_PAPER. O manifesto do mundo B não representa grupo de
    # hardlink, e o rectify recusa. Ao contrário do e2fsprogs, que virou os
    # dele em symlink por serem apelidos de comando, estes são DADOS: quebra-se
    # em cópias independentes, e custa 359 KB.
    find "$STAGE" -type f -links +1 -exec sh -c '
        for f; do cp -a "$f" "$f.unlink" && mv -f "$f.unlink" "$f"; done
    ' _ {} +

    for l in pt_BR.utf8 C.utf8; do
        [ -e "$STAGE/usr/lib/locale/$l/LC_CTYPE" ] || {
            echo "locales: $l não foi compilado" >&2
            exit 1
        }
    done
    # locale-archive é justamente o que --no-archive evita; se aparecer, a
    # premissa da receita caiu.
    if [ -e "$STAGE/usr/lib/locale/locale-archive" ]; then
        echo "locales: locale-archive foi gerado apesar de --no-archive" >&2
        exit 1
    fi
    # Guarda, no espírito da do e2fsprogs: se uma versão futura do localedef
    # ligar outro arquivo, falha AQUI com o caminho na mão, em vez de o rectify
    # falhar depois com a mesma causa e menos contexto — que foi exatamente
    # como este problema apareceu.
    remaining=$(find "$STAGE" -type f -links +1 2>/dev/null || true)
    if [ -n "$remaining" ]; then
        echo "FATAL: restou hardlink no STAGE do locales:" >&2
        echo "$remaining" >&2
        exit 1
    fi
    find "$STAGE" -type d -empty -delete
}
