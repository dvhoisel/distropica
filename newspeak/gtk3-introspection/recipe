NAME=gtk3-introspection
VERSION=3.24.52
KIND=source
TOOLCHAIN=native
DEPS="gtk3 glib-introspection gobject-introspection harfbuzz-introspection pango-introspection gdk-pixbuf-introspection at-spi2-core-introspection"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf python-glibc setuptools gettext wayland-protocols glib glib-introspection gobject-introspection harfbuzz harfbuzz-introspection pango pango-introspection gdk-pixbuf gdk-pixbuf-introspection at-spi2-core at-spi2-core-introspection cairo libepoxy fribidi libxkbcommon mesa fontconfig freetype"
ABOUT="Overlay de canal com Gdk-3.0, GdkX11-3.0 e Gtk-3.0. Encadeia explicitamente todos os overlays que seus includes exigem — GLib, HarfBuzz/Pango, GdkPixbuf e Atk — e mantém os mesmos backends Wayland/X11 da receita-base; o stage fechado contém apenas seis arquivos GIR/typelib."
LICENSE=LGPL-2.0-or-later
SRC="https://download.gnome.org/sources/gtk/3.24/gtk-$VERSION.tar.xz"
SHA256=80931fa472a77b9a164f6740e3c0b444fac6770054632d35a7ff9d679e5e7b9f

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    export SETUPTOOLS_USE_DISTUTILS=local
    meson setup build --prefix=/usr --libdir=lib --buildtype=release \
        -Dwayland_backend=true -Dx11_backend=false \
        -Dbroadway_backend=false -Dwin32_backend=false \
        -Dquartz_backend=false -Dxinerama=no -Dcolord=no \
        -Dcloudproviders=false -Dtracker3=false -Dprofiler=false \
        -Dprint_backends=file -Dintrospection=true -Dgtk_doc=false \
        -Dman=false -Ddemos=false -Dexamples=false -Dtests=false \
        -Dinstalled_tests=false
    ninja -C build -j"$JOBS" \
        gdk/Gdk-3.0.typelib \
        gdk/GdkX11-3.0.typelib \
        gtk/Gtk-3.0.typelib

    install -dm755 "$STAGE/usr/share/gir-1.0" \
                   "$STAGE/usr/lib/girepository-1.0"
    for item in gdk/Gdk-3.0 gdk/GdkX11-3.0 gtk/Gtk-3.0; do
        namespace=${item##*/}
        subdir=${item%/*}
        install -m644 "build/$subdir/$namespace.gir" "$STAGE/usr/share/gir-1.0/"
        install -m644 "build/$subdir/$namespace.typelib" "$STAGE/usr/lib/girepository-1.0/"
    done

    [ "$(find "$STAGE" -type f | wc -l)" -eq 6 ] || {
        echo "gtk3-introspection: stage não contém exatamente 6 arquivos" >&2
        find "$STAGE" -mindepth 1 >&2
        exit 1
    }
    [ -z "$(find "$STAGE" -type l -print -quit)" ] || {
        echo "gtk3-introspection: symlink fora da allowlist" >&2
        exit 1
    }
    ! grep -R -a -F "$WORK" "$STAGE" >/dev/null || {
        echo "gtk3-introspection: caminho do build vazou no payload" >&2
        exit 1
    }
}
