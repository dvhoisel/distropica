NAME=fuzzel
VERSION=1.14.1
KIND=source
TOOLCHAIN=native
DEPS="glibc fcft fontconfig pixman wayland libxkbcommon libpng"
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf busybox tllist wayland-protocols"
ABOUT="O LANÇADOR DE APLICATIVOS. W-d abre uma caixa, três letras filtram, Enter executa — o caminho de teclado que faltava entre 'menu do botão direito' e 'decorar atalho por programa'. Da mesma família e da mesma matéria que o foot e o yambar: C sem toolkit, fcft e pixman já pagos, wlr-layer-shell para a sobreposição. Ele lê os .desktop de /usr/share/applications — os mesmos que o Epiphany, o foot e o miniluv já instalam — e por isso não ganha configuração nesta árvore: a lista É o sistema. Ícones em PNG saem da libpng, que já estava aqui; os SVG saem do nanosvg EMBUTIDO no tarball do upstream — código vendorizado pelo autor e coberto pelo pino do SRC, que não é o mesmo que um subproject baixado na hora (o wrap-mode continua nofallback). O backend librsvg fica fora com o cairo junto: arrastaria Rust e cargo-c para dentro da closure por causa de miniaturas. Man pages fora, na linha da árvore — e como o corte do doc/ leva a LICENSE junto, a receita a instala à mão: evidência de licença não é documentação, é obrigação."
LICENSE=MIT
SRC="https://codeberg.org/dnkl/fuzzel/releases/download/$VERSION/fuzzel-$VERSION.tar.gz"
SHA256="a3af48d00d5cb7cb5526ab86bd632c62dbea5901693fdd746a2e7bb5bd64cf04"

build() {
    tar -xzf "$DL" --strip-components=1
    # O doc/meson.build exige scdoc sem 'required: false' e o meson.build o
    # inclui incondicionalmente (linha 268) — mesmo arranjo do yambar, mesmo
    # corte guardado dos dois lados.
    grep -qx "subdir('doc')" meson.build || {
        echo "fuzzel: meson.build mudou; o corte do doc/ precisa ser revisto" >&2
        exit 1
    }
    sed -i "/^subdir('doc')$/d" meson.build
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # werror=false pela política medida no yambar: aviso de toolchain mais
    # novo não é defeito do pacote. nofallback porque o tarball traz os wraps
    # de fcft e tllist, e as do sistema é que valem.
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dwerror=false \
        -Denable-cairo=disabled \
        -Dpng-backend=libpng \
        -Dsvg-backend=nanosvg \
        -Dsystem-nanosvg=disabled
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    [ -x "$STAGE/usr/bin/fuzzel" ] || {
        echo "fuzzel: o binário não foi produzido" >&2
        exit 1
    }
    # A licença sai junto com o doc/ cortado; volta à mão. Evidência, não doc.
    install -d "$STAGE/usr/share/doc/fuzzel"
    install -m 0644 LICENSE "$STAGE/usr/share/doc/fuzzel/LICENSE"
    [ -s "$STAGE/usr/share/doc/fuzzel/LICENSE" ] || {
        echo "fuzzel: LICENSE não instalada" >&2
        exit 1
    }
    # Completions pedem frameworks (bash-completion, zsh, fish) que a árvore
    # não tem; payload sem consumidor é dívida de auditoria.
    rm -rf "$STAGE/usr/share/bash-completion" "$STAGE/usr/share/zsh" \
           "$STAGE/usr/share/fish"

    # O GABARITO DO UPSTREAM VIRA DOCUMENTAÇÃO, e não configuração viva. O
    # meson dele instala fuzzel.ini em $sysconfdir/xdg/fuzzel (meson.build:260),
    # e nesta árvore /etc de pacote é materializado a partir de
    # /usr/share/factory/etc — de modo que o arquivo passaria a ser propriedade
    # DESTE pacote. Mas quem escreve /etc/xdg/fuzzel é a receita 'desktop', do
    # mesmo jeito que escreve o rc.xml do labwc e o config.yml do yambar: o
    # pacote entrega o programa, a cola entrega a política. Duas receitas
    # reivindicando o mesmo caminho é doublethink, e foi exatamente assim que o
    # minitrue recusou — "donos incompatíveis: fuzzel" — quando a config de
    # sessão entrou. O exemplo continua legível em /usr/share/doc, que é onde o
    # labwc também deixa os dele.
    gabarito=$(find "$STAGE" -path '*/xdg/fuzzel/fuzzel.ini' -type f | head -1)
    [ -n "$gabarito" ] || {
        echo "fuzzel: o gabarito fuzzel.ini não foi encontrado; o upstream mudou" >&2
        exit 1
    }
    install -d "$STAGE/usr/share/doc/fuzzel"
    mv "$gabarito" "$STAGE/usr/share/doc/fuzzel/fuzzel.ini.exemplo"
    unset gabarito
    if find "$STAGE" -path '*/xdg/fuzzel/*' -type f | grep -q .; then
        echo "fuzzel: ainda há configuração de sessão no payload; ela é da receita desktop" >&2
        find "$STAGE" -path '*/xdg/fuzzel/*' >&2
        exit 1
    fi

    # cairo/librsvg fora de verdade, e nada de X11 num cliente Wayland puro.
    if readelf -d "$STAGE/usr/bin/fuzzel" | grep -qE 'libcairo|librsvg|libX11|libxcb'; then
        echo "fuzzel: ligou cairo/librsvg/X11, que deveriam estar fora" >&2
        readelf -d "$STAGE/usr/bin/fuzzel" | grep NEEDED >&2
        exit 1
    fi
    if readelf -d "$STAGE/usr/bin/fuzzel" | grep -qE 'RPATH|RUNPATH'; then
        echo "fuzzel: o binário saiu com RPATH; a auditoria vai recusar" >&2
        exit 1
    fi
    find "$STAGE" -type d -empty -delete
}
