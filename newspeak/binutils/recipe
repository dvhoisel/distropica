NAME=binutils
VERSION=2.47
KIND=source
BUILD_DEPS="make busybox"
# Semente musl-estático: cede /usr/bin/{as,ld,ar,nm,…} ao rebuild glibc
# (binutils-glibc), que faz dlopen do plugin LTO — SPEC-0003 §3, SPEC-0005 §4.
PROVISIONAL=1
# Toma os applets homônimos do busybox (ar, nm, strings) — SPEC-0003 §7.
SUPERSEDES="busybox"
ABOUT="as, ld, ar, nm, objdump — o assembler e o linker que o gcc invoca em runtime. GNU só publica fonte; primeiro grande elo do Estágio 2"
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/binutils/binutils-$VERSION.tar.xz"
SHA256="154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff"
# Chave extraída do keyring oficial https://ftp.gnu.org/gnu/gnu-keyring.gpg;
# signer observado e primária 3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F.
SIG_1="https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.xz.sig"
SIG_EPOCH_1=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F

build() {
    tar -xJf "$DL" --strip-components=1
    mkdir -p build && cd build
    # MAKEINFO=true: sem texinfo no mundo musl inicial, pula a geração de docs.
    # --disable-werror: clang (zig cc) emite warnings que o -Werror do binutils barra.
    # --disable-gprofng: o profiler assume glibc (dlvsym/GLIBC_2.17), quebra no musl.
    # --enable-deterministic-archives: o ar zera os timestamps/uid/gid dos
    # membros, senão os .a embutem os mtimes dos .o e o build não reproduz.
    ../configure --prefix=/usr --disable-nls --disable-werror --disable-gprofng \
        --enable-default-hash-style=gnu --enable-deterministic-archives \
        --disable-dependency-tracking
    make -j"$JOBS" MAKEINFO=true
    make install MAKEINFO=true DESTDIR="$STAGE"

    # O install do binutils cria aliases de ld como hardlinks. O manifesto
    # mundo-B autentica conteúdo e tipo, mas ainda não representa grupos de
    # hardlinks; normalize-os para arquivos regulares independentes antes de
    # selar o STAGE, que é também a topologia produzida pelo aplicador atual.
    # Um nome por execução evita perder aliases quando nlink muda na travessia.
    find "$STAGE" -type f -links +1 -exec sh -ec '
        for path do
            copy=$path.minitrue-copy
            if [ -e "$copy" ] || [ -L "$copy" ]; then
                exit 1
            fi
            cp -p "$path" "$copy"
            mv -f "$copy" "$path"
        done
    ' sh {} \;
}
