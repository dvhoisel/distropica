NAME=libogg
VERSION=1.3.6
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="gcc-pass2 binutils-glibc make busybox gawk"
ABOUT="O contêiner Ogg da Xiph, e a base de que o Vorbis depende. Entra na árvore junto com o áudio livre: o plugin ogg do gst-plugins-base o exige, e sem ele um .ogg ou .opus solto na web não abre. Biblioteca minúscula em C — algumas centenas de linhas de empacotamento de páginas — e sem dependência alguma além da libc."
LICENSE="BSD-3-Clause"
SRC="https://downloads.xiph.org/releases/ogg/libogg-$VERSION.tar.xz"
SHA256="5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061"

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install
    [ -e "$STAGE/usr/lib/libogg.so" ] || {
        echo "libogg: a biblioteca não foi produzida" >&2
        exit 1
    }
    rm -rf "$STAGE/usr/share/doc"
    find "$STAGE" -type d -empty -delete
}
