NAME=bison
VERSION=3.8.2
KIND=source
DEPS="m4 busybox"
BUILD_DEPS="binutils make"
ABOUT="gerador de parsers LALR; a glibc precisa dele no build. Invoca m4 em runtime"
LICENSE=GPL-3.0-or-later
SRC="https://ftp.gnu.org/gnu/bison/bison-$VERSION.tar.xz"
SHA256="9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2"
# A única assinatura upstream é DSA-1024/SHA-1 sobre os dados e é recusada;
# files/assinatura-insegura prende assinatura, FP, keyring oficial e extração.
SIG_UNSAFE_WAIVER="files/assinatura-insegura"

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --disable-nls --disable-dependency-tracking
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
