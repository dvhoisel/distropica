NAME=libxdamage
VERSION=1.1.7
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxfixes libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto glibc libx11 libxfixes"
ABOUT="A extensão Damage: avisa quais retângulos da tela mudaram, para o compositor não redesenhar tudo. O equivalente Wayland é o wl_surface.damage, que o cliente envia direto. Entra pelo NEEDED do libxul.so."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXdamage-$VERSION.tar.xz"
SHA256=127067f521d3ee467b97bcb145aeba1078e2454d448e8748eb984d5b397bde24

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXdamage.so.1" ] || {
        echo "libxdamage: libXdamage.so.1 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
