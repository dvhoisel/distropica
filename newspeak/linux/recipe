NAME=linux
VERSION=7.1.8
KIND=source
TOOLCHAIN=native
# gawk: o KERNEL precisa de awk, e não a receita. São duas coisas diferentes que
# se confundiram numa noite só. A guarda do certificado usava awk e foi reescrita
# sem ele (expansão de parâmetro), porque guarda não deve depender de ferramenta;
# mas o build do 7.1.8 invoca awk por conta própria em dois pontos do caminho
# obrigatório do x86_64 — arch/x86/Makefile:274, gerando
# arch/x86/include/generated/asm/cpufeaturemasks.h, e scripts/orc_hash.sh:9, que
# entra com o unwinder ORC. Ambos morreram com Error 127.
#
# É `gawk` e não `busybox` porque /usr/bin/awk é symlink do gawk nesta árvore, e o
# busybox não reivindica esse caminho — dentro da view sem gawk o symlink pendura.
# Cinco receitas já declaravam gawk pelo mesmo motivo: alsa-utils, glibc,
# libevent, python e python-glibc.
#
# Varridas as outras ferramentas que o kernel invoca, contra a raiz e contra a
# config desta receita: bc vem do busybox; python3, sed, gzip, xz, tar, cpio,
# objcopy, readelf e nm estão presentes; rsync, pahole, zstd e lz4 NÃO existem na
# árvore e não fazem falta, porque a config não liga DEBUG_INFO_BTF nem compressão
# zstd/lz4. Conferido antes de acrescentar, para não descobrir uma por hora.
BUILD_DEPS="gcc-pass2 binutils-glibc flex bison elfutils perl openssl make gawk findutils"
ABOUT="O kernel. Mundo B por necessidade: o kernel.org só publica FONTE — não há binário oficial (um kernel é sempre específico de um .config), e binários de distro são inelegíveis (SPEC-0001 §2, SPEC-0007). Edge (P7): acompanha o stable mais recente do kernel.org, não um LTS congelado. Compilado com o gcc NATIVO do E2. MÓDULOS ASSINADOS REPRODUTÍVEIS: MODULE_SIG_FORCE confia em certificado público fixo; o build produz .ko unsigned determinístico, confere hash/cobertura e reaplica com sign-file -s um CMS público pinado por módulo. Nenhuma chave privada entra no worktree, rootfs ou build. HOSTLDFLAGS -rpath-link permite a extract-cert/sign-file/objtool resolver libcrypto/libelf e libz transitiva."
LICENSE="GPL-2.0-only"
SRC="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$VERSION.tar.xz"
SHA256="ff01dcb449279d5b4cfccdb01fee639cf5ff1803f1749a77844dd33915422c49"
# Certificado obtido do WKD oficial kernel.org:
# https://kernel.org/.well-known/openpgpkey/hu/ew8uiogxwri7d3fuioqgt7u1d5sngorx?l=autosigner
# signer observado e primária B8868C80BA62A1FFFAF5FDA9632D3A06589DA6B1.
SIGSUMS="https://cdn.kernel.org/pub/linux/kernel/v7.x/sha256sums.asc"
SIGSUMS_EPOCH=1786460504
SIGKEY_1="files/upstream-release.asc"
SIGKEY_FP_1=B8868C80BA62A1FFFAF5FDA9632D3A06589DA6B1

build() {
    tar -xJf "$DL" --strip-components=1
    # O Kbuild não deriva o banner de SOURCE_DATE_EPOCH sozinho. Fixar também
    # identidade e sequência evita vazar usuário/hostname do builder na imagem.
    # usr/gen_initramfs.sh reconverte este texto com `date -d` antes de passar
    # o epoch a gen_init_cpio. O builder usa o date do BusyBox: ele aceita a
    # forma ISO abaixo, mas nao "Mon Jan ... UTC ..."; ao rejeitar a forma
    # longa, o script upstream silencia a falha e o CPIO recebe time(NULL).
    KBUILD_BUILD_TIMESTAMP=$(date -u -d "@$SOURCE_DATE_EPOCH" '+%Y-%m-%d %H:%M:%S')
    KBUILD_BUILD_USER=distropica
    KBUILD_BUILD_HOST=builder
    KBUILD_BUILD_VERSION=1
    export KBUILD_BUILD_TIMESTAMP KBUILD_BUILD_USER KBUILD_BUILD_HOST \
        KBUILD_BUILD_VERSION
    parsed_build_epoch=$(date -d "$KBUILD_BUILD_TIMESTAMP" +%s 2>/dev/null) || {
        echo 'FATAL: date do builder nao parseia KBUILD_BUILD_TIMESTAMP'
        exit 1
    }
    [ "$parsed_build_epoch" = "$SOURCE_DATE_EPOCH" ] || {
        echo 'FATAL: KBUILD_BUILD_TIMESTAMP nao volta ao SOURCE_DATE_EPOCH'
        exit 1
    }
    # Autoridade PUBLICA e bundle detached produzidos offline. Esses dois hashes
    # sao pinos explicitos alem do fingerprint de files/: o certificado entra no
    # kernel antes de os .ko existirem, e o manifesto prende hash unsigned + CMS
    # de cada modulo. A chave RSA usada uma vez para gerar o bundle foi criada
    # fora do worktree/rootfs e destruida antes da publicacao destes arquivos.
    module_cert_sha256=935d49c7e9012fc92c13f19ca99862dd118589afd27cdbc19e6ca82c3e2834ed
    module_manifest_sha256=30742e62dbb3ed046b65ffb600afb7c06876936011f31848e6222ee484fbb52c
    module_bundle=../module-signing/bundle
    module_apply=../module-signing/apply-signatures
    # SEM `awk`, e pelo mesmo motivo que o dbus e o meson já registraram: a view
    # desta receita pode nao ter awk nenhum. O busybox cedeu /usr/bin/awk ao
    # gawk, o gawk nao esta nos BUILD_DEPS daqui, e o symlink pendura — o `awk`
    # some e a substituicao de comando devolve VAZIO. A comparacao entao falha
    # anunciando "certificado diverge" com o certificado intacto: o log inteiro
    # do room101 tinha duas linhas, o FATAL e um `/bin/sh: awk: not found`.
    # Expansao de parametro nao depende de programa nenhum.
    #
    # E a soma e conferida como SOMA antes de ser comparada. Sem isso, qualquer
    # falha em produzi-la volta a se disfarcar de divergencia — que e a mesma
    # mentira, so que com outra causa.
    for par in "certificate.pem:$module_cert_sha256:certificado" \
               "manifest:$module_manifest_sha256:manifesto"; do
        arquivo=${par%%:*}; resto=${par#*:}
        esperado=${resto%%:*}; rotulo=${resto#*:}
        soma=$(sha256sum "$module_bundle/$arquivo")
        soma=${soma%% *}
        case "$soma" in
            [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
            *)
                echo "FATAL: nao consegui somar $arquivo (obtive '$soma')" >&2
                exit 1
                ;;
        esac
        [ "$soma" = "$esperado" ] || {
            echo "FATAL: $rotulo publico de modulos diverge" >&2
            echo "       esperado $esperado" >&2
            echo "       obtido   $soma" >&2
            exit 1
        }
    done
    unset par arquivo resto esperado rotulo soma
    install -m644 "$module_bundle/certificate.pem" \
        certs/distropica-module-signing.pem
    # Config base x86_64 (EFI_STUB + virtio + 9p/ext4 builtin → o boot 9p do E3
    # segue). O defconfig JÁ traz SYSTEM_TRUSTED_KEYRING=y (via CFG80211/REGDB).
    # MODULE_SIG_ALL fica desligado de proposito: assinar automaticamente faria
    # o Kbuild exigir uma chave privada durante toda reproducao. O caminho
    # customizado abaixo e somente o PEM publico; por isso certs/Makefile nao
    # aciona a regra especial que gera certs/signing_key.pem.
    make defconfig
    # Dois olddefconfig: MODULE_SIG primeiro destrava as subopcoes; depois
    # fixamos FORCE, SHA-512, assinatura automatica desligada e a autoridade
    # publica. (sed, nao scripts/config: este e #!/bin/bash e o rootfs so tem sh.)
    sed -i 's/^# CONFIG_MODULE_SIG is not set/CONFIG_MODULE_SIG=y/' .config
    make olddefconfig
    sed -i \
        -e 's/^# CONFIG_MODULE_SIG_FORCE is not set/CONFIG_MODULE_SIG_FORCE=y/' \
        -e 's/^CONFIG_MODULE_SIG_ALL=y/# CONFIG_MODULE_SIG_ALL is not set/' \
        -e 's|^CONFIG_MODULE_SIG_KEY=.*|CONFIG_MODULE_SIG_KEY="certs/distropica-module-signing.pem"|' \
        -e 's|^CONFIG_SYSTEM_TRUSTED_KEYS=.*|CONFIG_SYSTEM_TRUSTED_KEYS=""|' \
        -e 's|^CONFIG_SYSTEM_REVOCATION_KEYS=.*|CONFIG_SYSTEM_REVOCATION_KEYS=""|' \
        .config
    make olddefconfig
    # Perfil de rede e confinamento do alvo. Anexar e reconciliar é mais
    # robusto que sed sobre "# CONFIG_X is not set": símbolo cuja dependência
    # ainda não estava satisfeita sequer aparece nessa forma no defconfig.
    #
    # USER_NS: sem namespace de usuário o sandbox de conteúdo do navegador
    #   degrada, e o Chromium passa a exigir auxiliar SUID — exatamente o que
    #   esta distro evita.
    # WIREGUARD: o datapath é o kernel; ele seleciona sozinho Curve25519 e
    #   ChaCha20Poly1305, então não há criptografia a ligar à mão.
    # NF_TABLES e companhia: sem netfilter não existe filtro de pacote nenhum,
    #   e o `wg-quick` com Table=auto depende de regra por marca (fib+ct).
    cat >> .config <<'KCONFIG'
CONFIG_USER_NS=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
# Tabelas multiplas de politica em IPv6: e delas que o wg-quick com
# Table=auto depende para instalar a regra por marca no lado v6.
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# --- Variaveis UEFI --------------------------------------------------------
# EFIVAR_FS BUILTIN, e nao modulo como o defconfig deixa. E por ele que o
# instalador registra a entrada de arranque na NVRAM do firmware; sem a
# entrada, firmware de disco fixo nao e obrigado a procurar o caminho de
# reserva EFI/BOOT/BOOTX64.EFI, e nao procura — medido em maquina real, que
# instalou bem e caiu na ROM de PXE legada no reboot.
#
# Modulo nao serve AQUI: quem registra a entrada e o init da midia viva, que
# roda antes de qualquer troca de raiz e nunca carregou modulo nenhum. Como
# modulo o gancho simplesmente nao encontra o efivarfs e cai no aviso.
CONFIG_EFIVAR_FS=y
# --- Wi-Fi -----------------------------------------------------------------
# Pilha 802.11 e o interruptor de radio. O iwd le rfkill diretamente.
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
# Cripto que o iwd consome pelo AF_ALG. A lista NAO foi adivinhada: sai dos
# nomes de algoritmo literais no fonte dele (ell/ e src/), que pede
# cbc/ctr/ecb(aes), cmac(aes), hmac de md4 ate sha3-512, md4 e md5. Sem
# CRYPTO_USER_API_HASH e _SKCIPHER o socket AF_ALG nem abre, e o daemon falha
# na primeira associacao em vez de no boot.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SHA3=y
# CRYPTO_DES ja estava aqui e esta certo — o registro fica porque a falta
# dele NO KERNEL DO LIVE derrubou o iwd: 'DES support not found' e o daemon
# sai na partida, com o sintoma final sendo o botao de Wi-Fi nao abrir
# nada. O iwd testa os algoritmos por AF_ALG ao subir e exige des3_ede
# para MSCHAPv2. Esta receita nao e o kernel que boota; o do build-efi e,
# e la o simbolo faltava. Divergir dele foi o que escondeu o defeito.
CONFIG_CRYPTO_DES=y
# WPA3/SAE faz Diffie-Hellman pelo keyring do kernel (ell/key.c); EAP-TLS
# precisa dos parsers de certificado.
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
# Drivers como MODULO, nao builtin: cada um exige firmware proprio, e modulo
# nao carregado nao ocupa memoria em maquina que nao tem aquele radio.
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
# --- Console de video -------------------------------------------------------
# ISTO NAO E ENFEITE: sem FRAMEBUFFER_CONSOLE o kernel escreve num terminal
# virtual que NAO TEM lastro visivel numa maquina com KMS. O sintoma medido: a
# midia interativa boota, o instalador imprime a lista de discos e espera o
# usuario digitar — e a tela fica no logo do firmware, preta. Os gettys da
# tty1 e da tty2 do sistema instalado tem o mesmo destino. A sessao grafica
# funciona mesmo assim, porque o weston fala DRM direto e nao passa por
# console; e por isso que o defeito passou despercebido enquanto so se
# testava o modo grafico e o serial.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# O framebuffer que a UEFI ja deixou ligado, usado ANTES de qualquer driver
# nativo assumir — e o unico numa maquina cujo driver DRM nao esta embutido
# aqui. Sem ele nao ha o que o fbcon pinte nos primeiros segundos de boot.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# A VGA padrao do QEMU. Entra porque a maioria de quem testar esta distro vai
# faze-lo numa VM, e sem este driver o -vga std nao produz /dev/dri/card0: o
# /etc/rc.d/session cai no getty de proposito, e a pessoa conclui que o modo
# grafico nao existe. Custa um driver pequeno e evita uma conclusao falsa.
CONFIG_DRM_BOCHS=y
# As DUAS placas do VirtualBox. Sem elas o convidado cai no simpledrm, que e o
# framebuffer que a UEFI deixou: desenha, mas nao faz modesetting, nao muda de
# resolucao e nao acompanha o redimensionamento da janela. O VMSVGA e o
# controlador PADRAO do VirtualBox 7, entao esta e a placa que a maioria de
# quem testar vai ter. O vboxvideo cobre o VBoxSVGA/VBoxVGA legado.
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y
# Audio, espelhando o build-efi pelo mesmo motivo do bloco de video: quem
# boota o sistema instalado e o kernel do live, e este aqui so passa a valer
# quando essa divergencia acabar. Tres controladoras porque tres e o que se
# encontra — HDA em maquina real e no QEMU, AC97 e Ensoniq em VM —, e os
# codecs porque HDA sem codec enumera a placa e nao produz som.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_GENERIC=y
# Os guarda-chuvas Realtek/HDMI/Cirrus habilitam os modelos que escondem sob
# `menuconfig`. Os demais codecs HDA sao `config` independentes e PRECISAM ser
# pedidos um a um: depender apenas do parser generic deixa de aplicar quirks de
# pinos/amp em maquinas Analog Devices, IDT/Sigmatel, VIA e Conexant — a placa
# enumera, mas a saida analogica pode continuar muda.
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CS8409=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SENARYTECH=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_CM9825=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_ENS1371=y
CONFIG_SND_USB_AUDIO=y
KCONFIG
    make olddefconfig
    # Guarda: o Ministerio EXIGE assinatura, mas proibe chave privada no build.
    # Aborta aqui se FORCE/certificado cair ou a assinatura automatica voltar.
    for s in MODULE_SIG MODULE_SIG_FORCE MODULE_SIG_SHA512 SYSTEM_TRUSTED_KEYRING \
        USER_NS TUN WIREGUARD NETFILTER NF_TABLES NF_TABLES_INET NFT_CT \
        NFT_FIB_INET NF_CONNTRACK IPV6 IPV6_MULTIPLE_TABLES \
        WLAN CFG80211 MAC80211 RFKILL \
        CRYPTO_USER_API_HASH CRYPTO_USER_API_SKCIPHER CRYPTO_CMAC \
        CRYPTO_CTR CRYPTO_MD5 CRYPTO_SHA512 KEY_DH_OPERATIONS \
        CRYPTO_DES CRYPTO_CBC CRYPTO_ECB \
        FRAMEBUFFER_CONSOLE SYSFB_SIMPLEFB DRM_SIMPLEDRM DRM_BOCHS \
        DRM_VMWGFX DRM_VBOXVIDEO \
        SOUND SND SND_PCM SND_HDA SND_HDA_INTEL SND_HDA_GENERIC \
        SND_HDA_CODEC_REALTEK SND_HDA_CODEC_HDMI SND_HDA_CODEC_CIRRUS \
        SND_HDA_CODEC_CS8409 SND_HDA_CODEC_ANALOG SND_HDA_CODEC_SIGMATEL \
        SND_HDA_CODEC_VIA SND_HDA_CODEC_CONEXANT SND_HDA_CODEC_SENARYTECH \
        SND_HDA_CODEC_CA0110 SND_HDA_CODEC_CMEDIA SND_HDA_CODEC_CM9825 \
        SND_INTEL8X0 SND_ENS1371 SND_USB_AUDIO; do
        grep -q "^CONFIG_$s=y\$" .config || {
            echo "FATAL: falta CONFIG_$s=y no .config"
            grep -E 'MODULE_SIG|TRUSTED_KEYRING' .config
            exit 1
        }
    done
    grep -q '^# CONFIG_MODULE_SIG_ALL is not set$' .config || {
        echo 'FATAL: CONFIG_MODULE_SIG_ALL precisa permanecer desligado'
        exit 1
    }
    grep -q '^CONFIG_MODULE_SIG_HASH="sha512"$' .config || {
        echo 'FATAL: hash de assinatura de modulo nao e sha512'
        exit 1
    }
    grep -q '^CONFIG_MODULE_SIG_KEY="certs/distropica-module-signing.pem"$' \
        .config || {
        echo 'FATAL: kernel nao fixou o certificado publico de modulos'
        exit 1
    }
    # Os drivers sao =m e nao =y, entao a guarda acima nao os pega. Sem pelo
    # menos um deles nao ha radio nenhum, e o sintoma aparece so na maquina do
    # usuario: o iwgtk abre e nao lista rede.
    for s in IWLWIFI ATH9K ATH10K RTW88; do
        grep -q "^CONFIG_$s=m\$" .config || {
            echo "FATAL: driver CONFIG_$s nao ficou como modulo"
            grep -E "^(# )?CONFIG_$s\b" .config
            exit 1
        }
    done
    # bzImage + modulos UNSIGNED. extract-cert embute somente o certificado
    # publico; sign-file e construido para a reaplicacao posterior de CMS.
    make -j"$JOBS" HOSTLDFLAGS="-Wl,-rpath-link,/usr/lib" bzImage modules
    [ ! -e certs/signing_key.pem ] || {
        echo 'FATAL: Kbuild gerou/recebeu chave privada inesperada'
        exit 1
    }
    install -Dm644 arch/x86/boot/bzImage "$STAGE/boot/vmlinuz-$VERSION"
    install -Dm644 System.map "$STAGE/boot/System.map-$VERSION"
    install -Dm644 .config "$STAGE/boot/config-$VERSION"
    # Instala unsigned; MODULE_SIG_ALL=n impede o Kbuild de pedir segredo. O
    # depmod do busybox roda dentro de modules_install antes de anexarmos CMS.
    # O alvo usa /usr unificado. Estagiar diretamente em usr/lib mantém o tar
    # original lexicalmente idêntico ao manifesto canônico; isso permite ao
    # `channel emit` reconstruir e conferir o artefato sem ambiguidade lib/.
    make -j"$JOBS" INSTALL_MOD_PATH="$STAGE/usr" modules_install
    "$module_apply" "$STAGE/usr/lib/modules/$VERSION" "$module_bundle" \
        "$module_cert_sha256" "$module_manifest_sha256" \
        scripts/sign-file scripts/extract-module-sig.pl
    # build/source apontam p/ a árvore de build efêmera (/tmp/minitrue-build-*) →
    # removidos p/ não deixar symlink pendente no alvo.
    rm -f "$STAGE"/usr/lib/modules/*/build "$STAGE"/usr/lib/modules/*/source
}
