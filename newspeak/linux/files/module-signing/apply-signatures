#!/bin/sh
# Reaplica assinaturas CMS publicas a uma arvore de modulos deterministica.
# Nao recebe chave privada: certificado, manifesto e .p7s sao os unicos
# insumos criptograficos admitidos.
set -eu

LC_ALL=C
export LC_ALL
umask 077

fail() {
    echo "assinatura de modulo: $*" >&2
    exit 1
}

[ "$#" -eq 6 ] || fail \
    'uso: apply-signatures MODULOS BUNDLE CERT_SHA256 MANIFEST_SHA256 SIGN_FILE EXTRACT_SIG'

modules_root=$1
bundle=$2
expected_cert_hash=$3
expected_manifest_hash=$4
sign_file=$5
extract_sig=$6
certificate=$bundle/certificate.pem
manifest=$bundle/manifest
signatures=$bundle/signatures

canonical_hash() {
    [ "${#1}" -eq 64 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

canonical_hash "$expected_cert_hash" || fail 'hash esperado do certificado invalido'
canonical_hash "$expected_manifest_hash" || fail 'hash esperado do manifesto invalido'
[ -d "$modules_root" ] && [ ! -L "$modules_root" ] || \
    fail "raiz de modulos nao e diretorio real: $modules_root"
[ -d "$bundle" ] && [ ! -L "$bundle" ] || \
    fail "bundle nao e diretorio real: $bundle"
[ -d "$signatures" ] && [ ! -L "$signatures" ] || \
    fail 'diretorio signatures ausente'
[ -f "$certificate" ] && [ ! -L "$certificate" ] || \
    fail 'certificate.pem ausente ou nao regular'
[ -f "$manifest" ] && [ ! -L "$manifest" ] || \
    fail 'manifest ausente ou nao regular'
[ -f "$sign_file" ] && [ ! -L "$sign_file" ] || fail 'sign-file ausente'
[ -f "$extract_sig" ] && [ ! -L "$extract_sig" ] || \
    fail 'extract-module-sig.pl ausente'

[ "$(hash_file "$certificate")" = "$expected_cert_hash" ] || \
    fail 'hash do certificado publico diverge'
[ "$(hash_file "$manifest")" = "$expected_manifest_hash" ] || \
    fail 'hash do manifesto de assinaturas diverge'
if grep -a -E -q 'BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY' "$certificate"; then
    fail 'certificate.pem contem chave privada'
fi
openssl x509 -in "$certificate" -noout >/dev/null 2>&1 || \
    fail 'certificate.pem nao e certificado X.509 valido'

tmp=$(mktemp -d "${TMPDIR:-/tmp}/module-signing-apply.XXXXXXXX")
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM

find "$bundle" -type l -print > "$tmp/symlinks"
[ ! -s "$tmp/symlinks" ] || fail 'bundle contem link simbolico'
find "$bundle" -mindepth 1 ! -type d ! -type f -print > "$tmp/special"
[ ! -s "$tmp/special" ] || fail 'bundle contem entrada especial'

# Formato: sha256-do-modulo-sem-assinatura<TAB>sha256-do-p7s<TAB>caminho.
# O caminho e deliberadamente estreito: a instalacao do kernel coloca todos os
# .ko sob kernel/, e nenhum nome valido desta arvore precisa de whitespace.
awk -F '\t' '
    NF != 3 { exit 1 }
    length($1) != 64 || $1 ~ /[^0-9a-f]/ { exit 1 }
    length($2) != 64 || $2 ~ /[^0-9a-f]/ { exit 1 }
    $3 !~ /^kernel\/[A-Za-z0-9_.+\/-]+[.]ko$/ { exit 1 }
    index($3, "//") { exit 1 }
    {
        n = split($3, component, "/")
        for (i = 1; i <= n; i++)
            if (component[i] == "." || component[i] == "..") exit 1
        count++
    }
    END { if (count == 0) exit 1 }
' "$manifest" || fail 'manifesto nao e canonico'

tab=$(printf '\t')
sort -t "$tab" -k3,3 "$manifest" > "$tmp/manifest.sorted"
cmp -s "$manifest" "$tmp/manifest.sorted" || \
    fail 'manifesto nao esta ordenado por caminho'
awk -F '\t' '{print $3}' "$manifest" > "$tmp/expected-modules"
uniq -d "$tmp/expected-modules" > "$tmp/duplicates"
[ ! -s "$tmp/duplicates" ] || fail 'manifesto repete modulo'

find "$modules_root" -name '*.ko' ! -type f -print > "$tmp/nonregular-modules"
[ ! -s "$tmp/nonregular-modules" ] || fail 'arvore contem .ko nao regular'
(
    cd "$modules_root"
    find . -type f -name '*.ko' -print | sed 's|^\./||' | sort
) > "$tmp/actual-modules"
cmp -s "$tmp/expected-modules" "$tmp/actual-modules" || \
    fail 'cobertura incompleta: conjunto de modulos difere do manifesto'

{
    echo certificate.pem
    echo manifest
    awk -F '\t' '{print "signatures/" $3 ".p7s"}' "$manifest"
} | sort > "$tmp/expected-bundle-files"
(
    cd "$bundle"
    find . -type f -print | sed 's|^\./||' | sort
) > "$tmp/actual-bundle-files"
cmp -s "$tmp/expected-bundle-files" "$tmp/actual-bundle-files" || \
    fail 'bundle tem assinatura ausente ou arquivo extra'

count=0
while IFS="$tab" read -r unsigned_hash signature_hash path; do
    module=$modules_root/$path
    signature=$signatures/$path.p7s
    [ -f "$module" ] && [ ! -L "$module" ] || fail "modulo ausente: $path"
    [ -f "$signature" ] && [ ! -L "$signature" ] || \
        fail "assinatura ausente: $path.p7s"
    [ "$(hash_file "$module")" = "$unsigned_hash" ] || \
        fail "hash unsigned diverge: $path"
    [ "$(hash_file "$signature")" = "$signature_hash" ] || \
        fail "hash do CMS diverge: $path.p7s"
    marker=$(tail -c 28 "$module" 2>/dev/null || true)
    [ "$marker" != '~Module signature appended~' ] || \
        fail "modulo ja chegou assinado: $path"

    # -nointern obriga o signer a ser encontrado no certificado publico
    # pinado, mesmo que um CMS tente carregar outro certificado por dentro.
    openssl cms -verify -verify_retcode -binary -inform DER \
        -in "$signature" -content "$module" -certfile "$certificate" \
        -nointern -noverify -out /dev/null 2>/dev/null || \
        fail "CMS nao valida contra certificado/modulo: $path"

    "$sign_file" -s "$signature" sha512 "$certificate" "$module" || \
        fail "sign-file -s falhou: $path"
    perl "$extract_sig" -0 "$module" > "$tmp/unsigned" 2>/dev/null || \
        fail "nao consegui extrair corpo assinado: $path"
    [ "$(hash_file "$tmp/unsigned")" = "$unsigned_hash" ] || \
        fail "sign-file alterou corpo do modulo: $path"
    perl "$extract_sig" -s "$module" > "$tmp/signature" 2>/dev/null || \
        fail "nao consegui extrair CMS reaplicado: $path"
    cmp -s "$signature" "$tmp/signature" || \
        fail "CMS reaplicado diverge do bundle: $path"
    descriptor=$(perl "$extract_sig" -d "$module" 2>/dev/null) || \
        fail "descritor de assinatura invalido: $path"
    signature_size=$(wc -c < "$signature" | tr -d ' ')
    [ "$descriptor" = "0 0 2 0 0 $signature_size" ] || \
        fail "descritor de assinatura inesperado: $path"
    count=$((count + 1))
done < "$manifest"

echo "assinatura de modulo: $count CMS validados e reaplicados sem chave privada"
