NAME=linux-firmware-wifi
VERSION=20260810
KIND=source
TOOLCHAIN=native
DEPS=""
BUILD_DEPS=busybox
ABOUT="Firmware de Wi-Fi para Intel, Atheros e Realtek. ESTE PACOTE É A EXCEÇÃO DECLARADA da árvore, e a exceção precisa estar escrita onde ela mora, não só no LICENSING.md: é o único payload da Distrópica do qual NÃO temos a fonte correspondente. São blobs binários, redistribuíveis sob as licenças dos fabricantes descritas no arquivo WHENCE, mas sem código-fonte publicado por ninguém. Entra porque sem ele a placa não inicializa: o driver carrega, não encontra o firmware e o rádio simplesmente não existe para o sistema — a ferramenta gráfica abriria e não listaria rede nenhuma. É subconjunto e não o linux-firmware inteiro: só as três famílias comuns em laptop amd64, porque o pacote completo passa de 1 GB descompactado e inviabilizaria a ISO. O tarball baixado é o completo, de 609 MB, e a receita extrai apenas o necessário; o SRC não pode ser um subconjunto porque subconjunto não tem hash upstream. A conferência aqui é o sha256sums.asc que o kernel.org publica ASSINADO pelos mantenedores — para blob binário isso é a melhor fonte que existe. O Alpine pina a mesma data de release, mas do gitlab e em .tar.gz, então corrobora a VERSÃO e não o mesmo arquivo; registrado assim em vez de fingir duas fontes idênticas."
LICENSE="linux-firmware (ver WHENCE; blobs proprietários redistribuíveis)"
SRC="https://mirrors.edge.kernel.org/pub/linux/kernel/firmware/linux-firmware-$VERSION.tar.xz"
SHA256="ac17c34fe73756926a961fbafadf8d8f07a3bd2dd2f4ea31a0fb5d50c714a49a"

build() {
    tar -xJf "$DL" --strip-components=1
    dst="$STAGE/usr/lib/firmware"
    install -dm755 "$dst"

    # A Intel vive em intel/iwlwifi/ no repositório, mas o driver a pede na
    # RAIZ de /lib/firmware — o iwl-drv.c monta o nome com
    # snprintf("%s-" FW_API_FMT ".ucode", fw_name_pre, ...), e fw_name_pre é
    # "iwlwifi-sc-a0-gf-a0" e afins, sem diretório nenhum. Confirmado lendo o
    # fonte do kernel desta árvore; o único lugar que prefixa "intel/" é o
    # IWL_FSEQ_FILE, que é outro tipo de arquivo. Por isso se ACHATA aqui, em
    # vez de copiar a árvore: copiar intel/iwlwifi/ preservando o caminho daria
    # 191 arquivos que o driver nunca encontraria.
    # Guarda as DUAS versões de API mais altas de cada dispositivo, e não todas.
    # O upstream entrega até 13 versões do mesmo firmware
    # (iwlwifi-ty-a0-gf-a0-77 até -90) e isso são 266 MB só de Intel, o que faz
    # o `minipax media build` recusar a mídia com "árvore excede o limite de
    # desenvolvimento de 384 MiB" — o streaming ainda é gate de release.
    #
    # Duas e não uma: o upstream publica firmware À FRENTE do kernel. O
    # gl-c0-fm-c0 vem em API 101 e o UCODE_API_MAX deste kernel é 100; o driver
    # tenta da SUA máxima para baixo e nunca pediria a 101, então guardar só a
    # mais alta deixaria o dispositivo sem firmware carregável com o arquivo
    # ali. Duas cobrem o kernel estar uma geração atrás, que é o normal.
    #
    # A seleção é por `sort -V` sobre o nome inteiro, e não por extrair o
    # número com sed: a API nem sempre é numérica — existe
    # iwlwifi-sc-a0-wh-b0-c103.ucode, e um sed de [0-9]* devolvia o caminho
    # inteiro e montava um nome inexistente.
    for dev in $(ls intel/iwlwifi/*.ucode 2>/dev/null \
                 | sed 's|.*/iwlwifi-||; s|-[^-]*\.ucode$||' | sort -u); do
        ls intel/iwlwifi/iwlwifi-"$dev"-*.ucode 2>/dev/null | sort -V | tail -2 \
        | while IFS= read -r f; do
            install -m644 "$f" "$dst/"
        done
    done
    # As demais famílias o driver pede COM o diretório (ath10k/QCA988X/...),
    # então essas se copiam preservando a estrutura.
    #
    # SEM ath11k e SEM rtw89, e isto é restrição de MÍDIA, não decisão sobre
    # hardware: juntas somam 96 MB e fazem o `minipax media build` recusar a
    # árvore com "excede o limite de desenvolvimento de 384 MiB". O limite é do
    # minipax materializar tudo em memória, e o streaming ainda é gate de
    # release — quando ele existir, estas duas voltam. Os drivers continuam no
    # kernel; o que falta é o firmware, então essas placas são reconhecidas e
    # não inicializam. Cobertas: Intel (a maioria dos laptops), Atheros até
    # ath10k, e Realtek até rtw88.
    for d in ath9k_htc ath10k rtw88 rtlwifi; do
        [ -d "$d" ] && cp -a "$d" "$dst/"
    done

    # A base regulatória (regulatory.db) NÃO vem daqui, e a busca por ela neste
    # tarball é o primeiro reflexo errado de quem vê o "Direct firmware load for
    # regulatory.db failed with error -2" no boot: ela é do projeto
    # wireless-regdb, publicado à parte no kernel.org. Existe agora a receita
    # `wireless-regdb`, que a traz junto com a assinatura sem a qual este kernel
    # a recusa. Este comentário fica porque o sintoma continua apontando para
    # cá, e o próximo a investigar merece ser mandado ao lugar certo.

    # WHENCE é o índice de proveniência e licença de CADA arquivo: é o
    # documento que torna a redistribuição defensável, e sem ele o pacote seria
    # um monte de bytes sem origem declarada. As LICENCE.* das famílias que
    # entram vão junto.
    install -Dm644 WHENCE "$STAGE/usr/share/licenses/linux-firmware-wifi/WHENCE"
    # As licenças migraram para LICENSES/ no upstream; copiar as das famílias
    # que entram. O laço é por nome porque a pasta tem centenas de arquivos de
    # fabricantes que não embarcamos.
    for l in LICENCE.iwlwifi_firmware LICENSE.QualcommAtheros_ath10k \
             LICENCE.atheros_firmware LICENCE.rtlwifi_firmware.txt \
             LICENCE.QualcommAtheros_ar3k GPL-2; do
        [ -e "LICENSES/$l" ] && install -m644 "LICENSES/$l" \
            "$STAGE/usr/share/licenses/linux-firmware-wifi/"
    done

    # Guarda POR FAMÍLIA, e não por contagem total. A primeira versão desta
    # receita conferia só "mais de 100 arquivos" e passou com 199 — sem UM
    # arquivo da Intel, porque o upstream tinha movido tudo para intel/iwlwifi/
    # e o glob da raiz não achava nada. Contagem agregada não pega família
    # inteira faltando; o sintoma seria a placa mais comum de laptop não
    # inicializar, na máquina do usuário, sem nada ter falhado aqui.
    for fam in "iwlwifi-*.ucode" "ath10k" "ath9k_htc" "rtw88" "rtlwifi"; do
        # shellcheck disable=SC2086
        n=$(find "$dst" -path "$dst/$fam*" 2>/dev/null | wc -l)
        [ "$n" -gt 0 ] || {
            echo "linux-firmware-wifi: família '$fam' ficou VAZIA — layout do upstream mudou" >&2
            exit 1
        }
    done
    n=$(find "$dst" -type f | wc -l)
    # A segunda existe porque o motivo de o pacote ser subconjunto é caber na
    # mídia, e o minipax recusa árvore acima de 384 MiB. O teto é 260 MB e não
    # 384 porque o firmware divide o orçamento com o resto do perfil — kernel,
    # toolchain e ferramentas de rede. Se passar disso, é decisão a retomar.
    mb=$(du -sm "$dst" | cut -f1)
    [ "$mb" -lt 260 ] || {
        echo "linux-firmware-wifi: subconjunto cresceu para ${mb} MB; revisar o escopo" >&2
        exit 1
    }
    echo "linux-firmware-wifi: $n arquivos, ${mb} MB"
    find "$STAGE" -type d -empty -delete
}
