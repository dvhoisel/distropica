NAME=mathlibs-glibc
VERSION=6.3.0
KIND=source
TOOLCHAIN=cross
RETRIES=20
DEPS="glibc"
BUILD_DEPS="gcc binutils-cross"
ABOUT="gmp 6.3.0 + mpfr 4.2.2 + mpc 1.3.1 reconstruídos como GLIBC (não musl). Passo do E2 descoberto na passada 2 (SPEC-0005 §4): os mathlibs-semente são build musl do zig (NEEDED libc.so); um cc1 glibc (pass-2) não os carrega ('invalid ELF header' ao resolver o linker-script /usr/lib/libc.so). Reconstruídos pelo gcc da passada 1 (cross) com a glibc presente, passam a ter NEEDED libc.so.6. SUPERSEDE os mathlibs-semente nos mesmos caminhos /usr/lib — a colisão com gmp/mpfr/mpc (seed) é a dívida de 'fingerprint de build' (rebuild-in-place com mesma versão, toolchain diferente), ver §4. -std=gnu17: o código é pré-C23, e o gcc 15 rejeita () = zero args."
LICENSE="LGPL-3.0-or-later"
SRC="https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz"
SHA256="a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898 b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01 ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8"

build() {
    # Shim do cross gcc (pass-1) que injeta os paths /usr (o pass-1 é
    # --without-headers: não conhece a glibc) e -std=gnu17 (código pré-C23).
    mkdir -p "$WORK/.tc"
    cat > "$WORK/.tc/x86_64-distropica-linux-gnu-gcc" <<'SHIM'
#!/bin/sh
exec /usr/bin/x86_64-distropica-linux-gnu-gcc -isystem /usr/include -B/usr/lib -L/usr/lib -std=gnu17 "$@"
SHIM
    chmod +x "$WORK/.tc"/*
    export PATH="$WORK/.tc:$PATH"
    export CC=x86_64-distropica-linux-gnu-gcc AR=ar RANLIB=ranlib
    # mpfr/mpc acham o gmp recém-feito DENTRO do stage (sem escrever na raiz
    # viva — respeita o contrato "só STAGE", SPEC-0004 §3.2); LD_LIBRARY_PATH
    # p/ os testes de configure que rodam binários linkados ao gmp staged.
    export LD_LIBRARY_PATH="$STAGE/usr/lib"

    # gmp
    mkdir -p "$WORK/gmp"; cd "$WORK/gmp"
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --enable-cxx --disable-dependency-tracking
    retry make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # mpfr (acha o gmp no stage)
    mkdir -p "$WORK/mpfr"; cd "$WORK/mpfr"
    tar -xJf "$DL_2" --strip-components=1
    ./configure --prefix=/usr --disable-nls --with-gmp="$STAGE/usr" --disable-dependency-tracking
    retry make -j"$JOBS"
    make install DESTDIR="$STAGE"

    # mpc (acha gmp+mpfr no stage)
    mkdir -p "$WORK/mpc"; cd "$WORK/mpc"
    tar -xzf "$DL_3" --strip-components=1
    ./configure --prefix=/usr --disable-nls --with-gmp="$STAGE/usr" --with-mpfr="$STAGE/usr" --disable-dependency-tracking
    retry make -j"$JOBS"
    make install DESTDIR="$STAGE"
}
