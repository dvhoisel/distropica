NAME=wlroots
VERSION=0.20.2
KIND=source
TOOLCHAIN=native
DEPS="glibc wayland libxkbcommon pixman libdrm libinput seatd eudev libdisplay-info mesa"
# hwdata-pnp NO LUGAR DE hwdata, e em BUILD_DEPS e não em DEPS. São duas correções
# numa linha, e as duas vieram de ler o meson em vez de confiar no nome.
#
# O backend/drm/meson.build:1 faz dependency('hwdata'), mas quem instala o
# hwdata.pc nesta árvore é o hwdata-pnp — o pacote `hwdata` traz só pci.ids e
# usb.ids, dois arquivos, e nenhum .pc. Declarar `hwdata` punha na view o pacote
# errado: o .pc existia na raiz e mesmo assim faltava aqui, porque a view se monta
# do que a receita DECLARA. O erro saiu como "Run-time dependency hwdata found: NO
# (tried pkg-config)" depois de toda a configuração ter passado.
#
# E é BUILD e não runtime porque a tabela vira CÓDIGO: o meson lê pkgdatadir do
# .pc, passa o pnp.ids pelo gen_pnpids.sh e o pnpids.c resultante entra em
# wlr_files. Depois de compilado, nada do wlroots volta a abrir o arquivo —
# conferido, wlroots não menciona pci.ids nem usb.ids em lugar nenhum. É o mesmo
# uso que a libdisplay-info faz, e está escrito no ABOUT do hwdata-pnp.
#
# O gen_pnpids.sh é sh puro (read, printf, cat), então o busybox já em BUILD_DEPS
# basta — conferido linha a linha, porque script de geração que chama awk foi o
# que derrubou o libyaml.
BUILD_DEPS="gcc-pass2 binutils-glibc meson ninja pkgconf wayland-protocols busybox hwdata-pnp findutils"
ABOUT="O MOTOR do compositor. Não é um compositor: é a biblioteca que implementa backend de KMS/DRM, entrada por libinput, sessão por libseat e a árvore de cenas, e sobre a qual o labwc é escrito. Existe aqui por causa dele, e a faixa é exata — o labwc 0.20 exige >=0.20.1 <0.21, e os dois sobem juntos. COM GLES2 e GBM desde 01/09/2026, revertendo a decisão da primeira escrita pela mesma régua que a criou: medição. O motivo de renderers=[] era 'com Mesa softpipe o GL não acelera nada' — verdadeiro então, falso agora que a Mesa traz r600 (a Radeon do notebook do beta tester) e llvmpipe (JIT multithread). O pixman continua compilado incondicionalmente, e a ESCOLHA fica com o wlr_renderer_autocreate: com render node (r600 na máquina real; llvmpipe atrás de virtio/vgem em VM) o gles2 entra; sem render node (simpledrm puro) o automático cai no pixman — os dois ramos existem no fonte e o environment do desktop deixou de fixar WLR_RENDERER exatamente para esta escolha acontecer por máquina. O allocator gbm entra pelo mesmo ramo do meson que o gles2 exige. XWayland desligado: o wlroots não fala X11 e nenhuma janela X roda sobre ele. Isso NÃO significa closure sem X11 — o libx11/libxcb/libxrender entram assim mesmo, pelo cairo, que esta árvore constrói com os backends X. É a mesma situação do weston, que também depende de cairo e pango; tirar o X11 de vez é decisão do cairo, não desta receita. A sessão é obrigatória e não opcional: o meson recusa 'session=disabled' junto com os backends drm/libinput, e é ela que exige libseat (seatd) e libudev (eudev); o backend DRM ainda exige hwdata e libdisplay-info para ler o EDID. Licença MIT, ~103 mil linhas de C dinâmico, que o audit enxerga inteiro. A fonte não é assinada pelo upstream — o GitLab do freedesktop publica só o tarball —, então o pino é o SHA256, igual ao libinput e ao libdisplay-info, que vêm do mesmo lugar."
LICENSE=MIT
SRC="https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/$VERSION/downloads/wlroots-$VERSION.tar.gz"
SHA256="80c567d2ed4efb2cfa6b077f22c7a710d9c78ba4e185a75e8694001114af0733"

build() {
    tar -xzf "$DL" --strip-components=1
    # Padrão recorrente desta toolchain: o ld nativo não resolve dependência
    # transitiva sozinho, e sem isto os testes de link do meson respondem "não"
    # e a funcionalidade some em silêncio.
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    # Listas EXPLÍCITAS, nunca 'auto' (a não-hermeticidade da SPEC-0013 §5
    # continua valendo): gles2 e gbm entram NOMEADOS porque a Mesa desta
    # árvore agora traz r600 e llvmpipe; o pixman segue incondicional no
    # meson e segue sendo o fallback de quem não tem render node.
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Drenderers=gles2 \
        -Dallocators=gbm \
        -Dbackends=drm,libinput \
        -Dsession=enabled \
        -Dxwayland=disabled \
        -Dxcb-errors=disabled \
        -Dcolor-management=disabled \
        -Dlibliftoff=disabled \
        -Dexamples=false
    ninja -C build -j"$JOBS"
    DESTDIR="$STAGE" ninja -C build install

    # O que faz diferença na tela, não a intenção da opção — lição da Mesa.
    [ -e "$STAGE/usr/lib/libwlroots-0.20.so" ] || {
        echo "wlroots: a biblioteca não foi produzida" >&2
        exit 1
    }
    # gles2 pedido tem de virar link de verdade: EGL no NEEDED é o fato.
    readelf -d "$STAGE/usr/lib/libwlroots-0.20.so" | grep -q 'libEGL' || {
        echo "wlroots: gles2 pedido e libEGL fora do NEEDED — o renderer não entrou" >&2
        exit 1
    }
    # O labwc não consulta a biblioteca: consulta o .pc, e dele lê variáveis.
    # Se o arquivo não sair no lugar, o meson do labwc cai no SUBPROJETO — que
    # esta árvore não tem e não quer, porque seria uma segunda cópia do wlroots
    # embutida estaticamente e invisível para o audit.
    PC=$STAGE/usr/lib/pkgconfig/wlroots-0.20.pc
    [ -e "$PC" ] || {
        echo "wlroots: wlroots-0.20.pc não foi produzido" >&2
        exit 1
    }
    # As três variáveis que o meson do labwc lê por get_variable(). O dicionário
    # de features do wlroots nasce com todas em false, então elas EXISTEM mesmo
    # desligadas — o que importa conferir é que as duas que sustentam a tela
    # estão ligadas de fato.
    for v in have_drm_backend=true have_libinput_backend=true have_xwayland=false; do
        grep -q "^$v\$" "$PC" || {
            echo "wlroots: $v ausente ou divergente em wlroots-0.20.pc" >&2
            grep -E '^have_' "$PC" >&2
            exit 1
        }
    done
    # A guarda que vale por toda a decisão acima: se um dia 'auto' voltar por
    # descuido, a biblioteca passa a ligar EGL/GLES/GBM e a promessa de
    # renderização por software cai sem ninguém perceber. Conferido no ELF, que
    # é onde a verdade está, e não na linha de comando do meson.
    for lib in libEGL libGLESv2 libgbm; do
        if readelf -d "$STAGE/usr/lib/libwlroots-0.20.so" | grep -q "$lib"; then
            echo "wlroots: a biblioteca ligou $lib — o caminho GL voltou" >&2
            exit 1
        fi
    done

    find "$STAGE" -type d -empty -delete
}
