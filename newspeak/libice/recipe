NAME=libice
VERSION=1.1.2
KIND=source
TOOLCHAIN=native
DEPS="glibc"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto xtrans"
ABOUT="A biblioteca ICE do X.Org. Entra somente para fechar a cadeia libXmu exigida pelo GIMP quando o GTK3 anuncia o backend X11; o uso normal da Distrópica continua sendo Wayland. Documentação e biblioteca estática ficam fora."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libICE-$VERSION.tar.xz"
SHA256=974e4ed414225eb3c716985df9709f4da8d22a67a2890066bc6dfc89ad298625

build() {
    tar -xJf "$DL" --strip-components=1
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static \
        --disable-docs --disable-specs --without-xmlto --without-fop \
        --without-xsltproc
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libICE.so.6" ] || { echo "libice: libICE.so.6 ausente" >&2; exit 1; }
    find "$STAGE" -type d -empty -delete
}
