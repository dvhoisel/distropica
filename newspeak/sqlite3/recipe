NAME=sqlite3
VERSION=3.53.4
KIND=source
TOOLCHAIN=native
DEPS="glibc zlib readline ncurses"
BUILD_DEPS="make gcc-pass2 binutils-glibc gawk busybox"
ABOUT="O banco embutido. Não é opcional em lugar nenhum desta empreitada: o WebKitGTK o exige em REQUIRED e o usa para o armazenamento estruturado da Web (IndexedDB, Web SQL, cache de rede), e o Epiphany o exige por conta própria para histórico, favoritos e a base de bloqueio de conteúdo. FTS5 e a coluna gerada entram porque o WebKit os usa; a extensão de carregamento dinâmico fica DESLIGADA, porque um navegador que possa carregar .so arbitrário de dentro de uma consulta SQL é superfície de ataque sem contrapartida numa distro sem gerenciador de pacotes."
LICENSE=blessing
SRC="https://www.sqlite.org/2026/sqlite-autoconf-3530400.tar.gz"
SHA256="0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c"

build() {
    tar -xzf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    export CPPFLAGS="-DSQLITE_ENABLE_FTS5=1 -DSQLITE_ENABLE_COLUMN_METADATA=1 -DSQLITE_ENABLE_UNLOCK_NOTIFY=1 -DSQLITE_SECURE_DELETE=1"
    # --soname=legacy NÃO é cosmético e o padrão do upstream é contra nós: o
    # autosetup define soname 'none' quando a flag não é passada, e o comentário
    # em sqlite-config.tcl diz por quê — "this project has no direct use for
    # soname". Para uma distro, tem: sem DT_SONAME, quem linka grava o CAMINHO
    # ABSOLUTO no DT_NEEDED. Foi o que aconteceu com o libsoup, que saiu com
    # `NEEDED /usr/lib/libsqlite3.so`, e derrubou o fechamento parcial com
    # "DT_NEEDED não é nome ABI canônico" — dois passos depois da causa, e num
    # pacote diferente. É a mesma classe do libsass (930c42f, 5c0bfd3).
    # 'legacy' é o valor histórico, libsqlite3.so.0.
    #
    # E o comentário fica AQUI, antes do comando, e não entre as opções: uma
    # linha de comentário no meio de uma continuação `\` encerra o comando, e o
    # `sh -n` não acusa porque a sintaxe continua válida. Foi assim que a
    # retomada anterior morreu com "/bin/sh: --disable-static: not found".
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static \
        --disable-load-extension \
        --soname=legacy
    make -j"$JOBS"
    make install DESTDIR="$STAGE"
    [ -e "$STAGE/usr/lib/libsqlite3.so" ] || {
        echo "sqlite3: a biblioteca compartilhada não foi produzida" >&2
        exit 1
    }
    # A asserção é a que se quer, e não uma mais fraca que passa junto: exige o
    # SONAME nomeado, não "é objeto dinâmico".
    readelf -d "$STAGE"/usr/lib/libsqlite3.so.* 2>/dev/null | grep -q 'SONAME.*libsqlite3\.so\.0' || {
        echo "sqlite3: saiu sem SONAME — quem linkar grava o caminho absoluto" >&2
        readelf -d "$STAGE"/usr/lib/libsqlite3.so.* 2>/dev/null | head -6 >&2
        exit 1
    }
    [ -e "$STAGE/usr/lib/pkgconfig/sqlite3.pc" ] || {
        echo "sqlite3: sqlite3.pc não foi produzido — o WebKit não vai achá-lo" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
