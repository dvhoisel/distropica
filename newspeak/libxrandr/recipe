NAME=libxrandr
VERSION=1.5.5
KIND=source
TOOLCHAIN=native
DEPS="glibc libx11 libxext libxrender libxcb libxau libxdmcp"
BUILD_DEPS="gcc-pass2 binutils-glibc make pkgconf util-macros xorgproto glibc libx11 libxext libxrender"
ABOUT="A extensão RandR: resolução, rotação e múltiplos monitores em tempo de execução. No Wayland quem faz esse papel é o wl_output do compositor, e o weston o implementa; esta biblioteca não é consultada. Entra pelo NEEDED do libxul.so."
LICENSE=MIT
SRC="https://www.x.org/releases/individual/lib/libXrandr-$VERSION.tar.xz"
SHA256=72b922c2e765434e9e9f0960148070bd4504b288263e2868a4ccce1b7cf2767a

build() {
    tar -xJf "$DL" --strip-components=1
    export LDFLAGS="-Wl,-rpath-link,/usr/lib"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$JOBS"
    make DESTDIR="$STAGE" install

    [ -e "$STAGE/usr/lib/libXrandr.so.2" ] || {
        echo "libxrandr: libXrandr.so.2 não foi produzida" >&2
        exit 1
    }
    find "$STAGE" -type d -empty -delete
}
