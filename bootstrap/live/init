#!/bin/sh
# PID 1 da mídia viva. Só apaga um disco quando o dispositivo veio
# explicitamente de distropica.install= ou foi digitado no console.
set -eu
umask 022

BB=/bin/busybox
PATH=/bin:/usr/bin:/sbin:/usr/sbin
export PATH HOME=/ TERM=linux

# O prefixo e 'distropica-init', e o nome importa: este programa e o PID 1 da
# midia, e ele faz DUAS coisas — boota uma raiz ja instalada, se achar uma, e
# instala uma nova, se nao achar. Chamava-se 'distropica-live' ate 2026-07-30,
# nome herdado de quando o desenho era montar o sistema inteiro em RAM antes de
# tocar no disco. Isso mudou: a instalacao vai direto para o disco, e nao ha
# ambiente vivo para experimentar. Manter 'live' era prometer um live CD que
# esta distro deliberadamente NAO e.
say() {
    message="distropica-init: $*"
    printf '%s\n' "$message"
    # Na mídia interativa, /dev/console aponta para tty0. Espelhe somente os
    # marcadores não secretos no UART para permitir diagnóstico e sincronizar
    # o aceite headless, sem deslocar os prompts de senha do framebuffer.
    if [ -c /dev/ttyS0 ] &&
       ! grep -qw 'distropica.test=1' /proc/cmdline 2>/dev/null; then
        printf '%s\n' "$message" >/dev/ttyS0 2>/dev/null || true
    fi
}

rescue() {
    say "$*"
    say "caindo no shell de resgate; saia para reiniciar"
    setsid cttyhack sh || true
    reboot -f
}

mount_early() {
    mkdir -p /dev /proc /sys /run /tmp /media /target /newroot
    mount -t devtmpfs dev /dev 2>/dev/null || true
    mount -t proc proc /proc 2>/dev/null || true
    mount -t sysfs sys /sys 2>/dev/null || true
    # size= EXPLICITO, e nao o default. O tmpfs sem size fica em 50% da RAM, o
    # que e um default sensato para um sistema comum e ERRADO para este: o
    # instalador monta a arvore inteira em /run ANTES de tocar no disco — e a
    # troca de memoria por garantia fail-before-wipe e deliberada. Com 4 GiB de
    # RAM o teto de 50% da 2 GiB, o sistema instalado tem 2,1 GiB, e a
    # instalacao morria com ENOSPC no pacote 60 de 78, numa mensagem que nao
    # explicava nada.
    #
    # 80% e o que sobra depois do proprio initramfs e do kernel. Os dois tmpfs
    # dividem o mesmo pool de paginas, entao a soma real e limitada pela RAM e
    # nao por 160%: o size= aqui so remove um teto artificial por sistema de
    # arquivos, nao promete memoria que nao existe.
    mount -t tmpfs -o mode=0755,size=80% tmpfs /run 2>/dev/null ||
        mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || true
    mount -t tmpfs -o mode=1777,size=80% tmpfs /tmp 2>/dev/null ||
        mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null || true
    mdev -s 2>/dev/null || true
}

partition_path() {
    case "$1" in
        *[0-9]) echo "${1}p$2" ;;
        *) echo "${1}$2" ;;
    esac
}

whole_disk_name() {
    block_name=${1#/dev/}
    if [ -f "/sys/class/block/$block_name/partition" ]; then
        basename "$(dirname "$(readlink -f "/sys/class/block/$block_name")")"
    else
        echo "$block_name"
    fi
}

find_installed_root() {
    findfs LABEL=DISTROPICA_ROOT 2>/dev/null || true
}

boot_installed() {
    root_device=$1
    say "raiz instalada encontrada em $root_device"
    mount -o rw "$root_device" /newroot || return 1
    install_marker=/newroot/var/lib/minipax/disk-install.complete
    if [ ! -f "$install_marker" ] || [ -L "$install_marker" ] ||
       [ ! -f /newroot/var/lib/minipax/profile.lock ] ||
       [ -L /newroot/var/lib/minipax/profile.lock ] ||
       [ ! -x /newroot/sbin/init ]; then
        umount /newroot
        return 1
    fi
    marker_format=$(sed -n '1p' "$install_marker")
    marker_lock=$(sed -n '2s/^PROFILE_LOCK_SHA256=//p' "$install_marker")
    marker_lines=$(wc -l < "$install_marker" | tr -d ' ')
    actual_lock=$(sha256sum /newroot/var/lib/minipax/profile.lock | awk '{print $1}')
    if [ "$marker_format" != 'DISTROPICA_DISK_INSTALL_FORMAT=1' ] ||
       [ "$marker_lines" != 2 ] || [ -z "$marker_lock" ] ||
       [ "$marker_lock" != "$actual_lock" ]; then
        umount /newroot
        return 1
    fi
    mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
    for mount_path in /dev /proc /sys /run; do
        grep -q " $mount_path " /proc/mounts || {
            umount /newroot
            return 1
        }
    done

    # A função é chamada no lado esquerdo de `||`; por POSIX, `set -e` não
    # protege os comandos internos. Registre cada movimento e reverta os já
    # concluídos caso o próximo falhe. /dev é movido por último para manter os
    # dispositivos disponíveis durante a recuperação.
    moved_mounts=
    for mount_path in /run /sys /proc /dev; do
        if ! mount --move "$mount_path" "/newroot$mount_path"; then
            for moved_path in $moved_mounts; do
                mount --move "/newroot$moved_path" "$moved_path" || reboot -f
            done
            umount /newroot || true
            return 1
        fi
        moved_mounts="$mount_path $moved_mounts"
    done
    exec switch_root /newroot /sbin/init
}

# A VARREDURA INCLUI O DISCO INTEIRO, e nao so as particoes. Isto foi medido, e
# e o segundo defeito que impedia a instalacao por pendrive — independente da
# espera do find_media, e escondido atras dela.
#
# A ISO que o minipax compoe e hibrida: tem GPT com tres particoes (32 KiB de
# descritores, a ESP de 64 MiB, e o payload), e ALEM disso um ISO9660 que comeca
# no offset 0 do arquivo inteiro. Gravada num pendrive com dd, ela vira /dev/sdb
# com sdb1, sdb2 e sdb3 — e o sistema de arquivos que tem o
# distropica/media.meta nao esta em NENHUMA delas: esta no /dev/sdb.
#
# A lista antiga so casava particoes (/dev/sd*[0-9]), entao num pendrive ela
# montava a ESP, nao achava o media.meta, e desistia. Medido em QEMU com a ISO
# ligada como usb-storage:
#
#   2.939  sda: sda1 sda2 sda3
#          distropica-init: payload da mídia não encontrado
#
# O disco estava la, enumerado e visivel, e a busca passou por ele sem olhar.
# Num CD isso nunca aparecia: /dev/sr0 JA e o dispositivo inteiro, e e por ele
# que o aceite em QEMU sempre entrou.
#
# As particoes continuam vindo primeiro: e o caminho provado, e o formato img do
# minipax poe o payload numa delas. O disco inteiro e a segunda tentativa, nao a
# primeira. Montar um disco interno por engano nao acontece — o que decide nao e
# a montagem, e a presenca do media.meta.
varre_media() {
    for device in /dev/sr* /dev/vd*[0-9] /dev/sd*[0-9] /dev/nvme*n*p* \
                  /dev/mmcblk*p* \
                  /dev/vd[a-z] /dev/sd[a-z] /dev/sd[a-z][a-z] \
                  /dev/nvme*n[0-9] /dev/mmcblk[0-9]; do
        [ -b "$device" ] || continue
        umount /media 2>/dev/null || true
        if mount -o ro "$device" /media 2>/dev/null &&
           [ -f /media/distropica/media.meta ] &&
           [ -f /media/distropica/profile.lock ]; then
            echo "$device"
            return 0
        fi
    done
    umount /media 2>/dev/null || true
    return 1
}

# A BUSCA ESPERA, e isto foi medido em máquina de verdade.
#
# Um pendrive USB não está pronto quando o init começa. Numa Positivo com
# controlador OHCI, o log do kernel conta a história inteira:
#
#   2.864  distropica-init: payload da mídia nao encontrado
#          distropica-init: caindo no shell de resgate
#   3.010  scsi 6:0:0:0: Direct-Access  Generic Flash Disk
#   3.051  sdb: sdb1 sdb2
#
# O instalador desistiu 150 ms ANTES de o disco de onde ele bootou existir.
# A varredura única encontrou só a sda5 do disco interno, não achou o payload,
# e caiu no resgate. Em QEMU isso nunca aparece: o virtio-blk está pronto antes
# do primeiro processo, e por isso 39 corridas de aceite passaram sem tocar
# neste defeito.
#
# O `mdev -s` dentro do laço é o que faz diferença: o nó /dev/sdb1 só existe
# depois que alguém o cria, e sem repetir a varredura de nós o dispositivo pode
# estar pronto no kernel e invisível no /dev.
#
# 30 s é teto, e não espera fixa: assim que a mídia aparece a função devolve. O
# preço de errar para mais é meio minuto na pior das hipóteses; o de errar para
# menos é a máquina não instalar, que foi o que aconteceu.
find_media() {
    achado=$(varre_media) && { echo "$achado"; return 0; }
    limite=$(( $(cut -d. -f1 /proc/uptime) + 30 ))
    anunciado=nao
    while [ "$(cut -d. -f1 /proc/uptime)" -lt "$limite" ]; do
        if [ "$anunciado" = nao ]; then
            # O aviso vai para o console porque o silêncio aqui é
            # indistinguível de travamento — e quem está olhando a tela precisa
            # saber que vale esperar em vez de desligar na tomada.
            say "aguardando a midia aparecer (USB leva alguns segundos)" >&2
            anunciado=sim
        fi
        sleep 1
        mdev -s 2>/dev/null || true
        achado=$(varre_media) && { echo "$achado"; return 0; }
    done
    return 1
}

cmdline_value() {
    key=$1
    for token in $(cat /proc/cmdline); do
        case "$token" in
            "$key"=*) echo "${token#*=}"; return 0 ;;
        esac
    done
    return 1
}

# A ESTIMATIVA DA RAIZ virou funcao porque agora tem TRES leitores: o
# particionamento automatico, a triagem de particoes do instalador de texto, e a
# conferencia da raiz escolhida a mao. Tres copias da mesma formula e como se
# descobre tarde que uma delas ficou para tras — foi o mesmo raciocinio que
# tirou o 2048 fixo do calculo do primeiro setor utilizavel.
#
# O fator 4 sai de MEDICAO: cache de 664 MiB produziu uma arvore de 2096 MiB
# (razao 3,16), e o resto e margem. O termo separado do cache existe porque
# durante a instalacao o cache VIVE NO DISCO ALVO ao mesmo tempo que o sistema
# cresce: o pico e a soma dos dois, e nao o maior deles.
raiz_minima_bytes() {
    cache_bytes=$(wc -c < /media/distropica/cache.tar 2>/dev/null || echo 0)
    case "$cache_bytes" in
        ""|*[!0-9]*) return 1 ;;
    esac
    [ "$cache_bytes" -gt 0 ] || return 1
    echo $((cache_bytes * 4 + cache_bytes + 536870912))
}

# A decisao de ONDE e COMO instalar. Preenche as variaveis abaixo e nao escreve
# nada em stdout — de proposito.
#
# A VERSAO ANTERIOR ERA UMA FUNCAO QUE ECOAVA O DISCO, e o chamador a lia com
# `$( )`. Isso nao sobrevive ao instalador de texto por uma razao de shell e nao
# de gosto: `$( )` roda em subshell, e variavel atribuida em subshell morre com
# ele. Como a rota manual precisa devolver quatro coisas (ESP, raiz, troca e se
# formata a ESP), e nao uma, a saida passou a ser variavel global.
ROTA=
INSTALL_DISCO=
INSTALL_ESP=
INSTALL_RAIZ=
INSTALL_TROCA=
FORMATAR_ESP=sim

# O CAMINHO E PARAMETRO, com o de producao como default. Nao e generalidade
# gratuita: e o que permite provar esta funcao contra arquivos de amostra sem
# forjar um /run. O init sempre a chama sem argumento.
le_decisao() {
    arquivo=${1:-/run/distropica-instalacao}
    [ -f "$arquivo" ] && [ ! -L "$arquivo" ] ||
        rescue "o instalador nao gravou a decisao"
    [ "$(sed -n '1p' "$arquivo")" = 'DISTROPICA_INSTALL_FORMAT=1' ] ||
        rescue "decisao de instalacao em formato desconhecido"
    while IFS='=' read -r chave valor; do
        case "$chave" in
            ROTA) ROTA=$valor ;;
            DISCO) INSTALL_DISCO=$valor ;;
            ESP) INSTALL_ESP=$valor ;;
            RAIZ) INSTALL_RAIZ=$valor ;;
            TROCA) INSTALL_TROCA=$valor ;;
            FORMATAR_ESP) FORMATAR_ESP=$valor ;;
        esac
    done < "$arquivo"

    # Conferir aqui o que o Rust ja conferiu NAO e redundancia inutil: o que o
    # init executa e este arquivo, e nao a tela que o produziu. Se um dia algo
    # mais escrever nele, e este bloco que decide se o disco vai ser apagado.
    case "$ROTA" in
        disco-inteiro|manual) ;;
        *) rescue "rota de instalacao desconhecida: $ROTA" ;;
    esac
    case "$INSTALL_DISCO" in
        /dev/?*) ;;
        *) rescue "disco fora de /dev na decisao: $INSTALL_DISCO" ;;
    esac
    [ -b "$INSTALL_DISCO" ] || rescue "$INSTALL_DISCO nao e dispositivo de bloco"
    if [ "$ROTA" = manual ]; then
        for escolhida in "$INSTALL_ESP" "$INSTALL_RAIZ"; do
            case "$escolhida" in
                /dev/?*) ;;
                *) rescue "particao fora de /dev na decisao: $escolhida" ;;
            esac
            [ -b "$escolhida" ] || rescue "$escolhida nao e dispositivo de bloco"
        done
        [ "$INSTALL_ESP" != "$INSTALL_RAIZ" ] ||
            rescue "ESP e raiz sao a mesma particao"
        if [ -n "$INSTALL_TROCA" ]; then
            [ -b "$INSTALL_TROCA" ] ||
                rescue "$INSTALL_TROCA nao e dispositivo de bloco"
            [ "$INSTALL_TROCA" != "$INSTALL_ESP" ] &&
            [ "$INSTALL_TROCA" != "$INSTALL_RAIZ" ] ||
                rescue "a area de troca repete outra particao"
        fi
        case "$FORMATAR_ESP" in
            sim|nao) ;;
            *) rescue "FORMATAR_ESP invalido: $FORMATAR_ESP" ;;
        esac
    fi
}

# O prompt digitado da 0.11, mantido como REDE e nao como caminho principal.
#
# Ele existe porque um defeito no instalador de texto nao pode custar a
# instalacao: sem isto, um erro na TUI derruba a maquina no shell de resgate, e
# quem esta na frente dela ja gravou o pendrive e reiniciou. Com isto, o pior
# caso volta a ser exatamente o que a 0.11 fazia.
prompt_disk_antigo() {
    say "nenhum disco foi autorizado pelo kernel cmdline" >&2
    fdisk -l >&2 2>/dev/null || true
    echo "Digite o dispositivo inteiro a APAGAR (ex.: /dev/vda), ou 'shell':" >&2
    read -r selected
    [ "$selected" != shell ] || rescue "instalação não autorizada"
    ROTA=disco-inteiro
    INSTALL_DISCO=$selected
}

decide_instalacao() {
    selected=$(cmdline_value distropica.install 2>/dev/null || true)
    if [ -n "$selected" ]; then
        ROTA=disco-inteiro
        INSTALL_DISCO=$selected
        return 0
    fi

    # Os dois numeros que o instalador de texto usa para triar particoes. Sao
    # medidos AQUI, na midia, e passados adiante: o Rust nao tem como saber o
    # tamanho deste EFI nem deste cache, e um default no Rust seria um palpite
    # se fingindo de medicao.
    efi_bytes=$(wc -c < /media/EFI/BOOT/BOOTX64.EFI 2>/dev/null || echo 0)
    raiz_minima=$(raiz_minima_bytes) ||
        rescue "nao consegui estimar o tamanho minimo da raiz"

    rm -f -- /run/distropica-instalacao
    # </dev/console >/dev/console: a TUI DESENHA no stdout e LE do stdin, e o
    # console e o unico lugar onde os dois fazem sentido. Sem isto, uma midia
    # cujo /dev/console e a serial deixaria o operador diante de um monitor
    # preto, com a interface indo para um cabo que nao existe.
    #
    # O STATUS E COLHIDO NO `||`, e nao depois de um `if`. Por POSIX, um `if`
    # cujo comando falhou e que nao tem `else` devolve ZERO — o `$?` depois do
    # `fi` seria o do `if`, e nao o do minipax. O codigo 2, que e a desistencia
    # deliberada do operador, nunca chegaria aqui, e desistir viraria "instalador
    # falhou" seguido do prompt antigo que ele acabou de recusar.
    status=0
    /bin/minipax install-disk \
        --saida /run/distropica-instalacao \
        --sysfs /sys/class/block \
        --midia "/dev/$(whole_disk_name "$media_device")" \
        --efi-bytes "$efi_bytes" \
        --esp-mib 64 \
        --raiz-minima-bytes "$raiz_minima" \
        --cfdisk /bin/cfdisk \
        </dev/console >/dev/console 2>&1 || status=$?
    if [ "$status" = 0 ]; then
        le_decisao
        return 0
    fi
    # 2 e desistencia deliberada do operador, e desistir nao e defeito: nao ha
    # o que consertar nem por que insistir num prompt que ele acabou de recusar.
    [ "$status" != 2 ] || rescue "instalacao cancelada pelo operador"
    say "o instalador de texto falhou (codigo $status); voltando ao modo digitado"
    prompt_disk_antigo
}

partition_disk() {
    disk=$1
    [ -b "$disk" ] || rescue "$disk não é dispositivo de bloco"
    [ "$(whole_disk_name "$disk")" != "$(whole_disk_name "$media_device")" ] ||
        rescue "recusei apagar o disco que contém a própria mídia"
    case "$disk" in
        /dev/*) ;;
        *) rescue "dispositivo fora de /dev: $disk" ;;
    esac
    disk_name=${disk#/dev/}
    [ ! -f "/sys/class/block/$disk_name/partition" ] ||
        rescue "escolha o disco inteiro, não uma partição: $disk"
    logical_sector=$(cat "/sys/class/block/$disk_name/queue/logical_block_size" 2>/dev/null || echo 0)
    case "$logical_sector" in
        512|1024|2048|4096) ;;
        *) rescue "tamanho de setor lógico não suportado: $logical_sector" ;;
    esac
    # Mesma regra que o `minipax partition` aplica ao escrever de fato: o
    # primeiro setor utilizável é 1 MiB, em setores lógicos. Fixar 2048 aqui
    # só coincide em disco de 512 bytes; num 4Kn são 256, e a conferência de
    # capacidade passaria a estimar uma geometria que não é a que será
    # escrita. O erro seria conservador, mas duas contas para o mesmo layout
    # divergirem é como se descobre tarde que uma delas estava errada.
    first_usable=$((1048576 / logical_sector))
    esp_sectors=$((67108864 / logical_sector))
    root_start=$((first_usable + esp_sectors))

    disk_sectors=$(cat "/sys/class/block/$disk_name/size" 2>/dev/null || echo 0)
    # O tamanho do sistema e ESTIMADO a partir do cache.tar da midia, e nao
    # medido numa arvore ja montada — porque nao ha mais arvore montada em RAM
    # para medir. O fator 4 sai de MEDICAO: cache de 664 MiB produziu uma
    # arvore de 2096 MiB (razao 3,16), e o resto e margem. Errar para MAIS aqui
    # e barato (recusa um disco pequeno que talvez coubesse); errar para menos
    # seria apagar o disco e encher no meio.
    efi_bytes=$(wc -c < /media/EFI/BOOT/BOOTX64.EFI 2>/dev/null || echo 0)
    for measured_size in "$disk_sectors" "$efi_bytes"; do
        case "$measured_size" in
            ""|*[!0-9]*) rescue "não determinei os tamanhos antes do particionamento" ;;
        esac
    done
    disk_bytes=$((disk_sectors * 512))
    root_capacity=$((disk_bytes - root_start * logical_sector))
    # A formula mora em raiz_minima_bytes(), que tem tres leitores. Ver o
    # comentario la: 512 MiB de reserva para journal e metadados, e o termo do
    # cache separado porque durante a instalacao os dois ocupam o disco ao mesmo
    # tempo.
    required_root=$(raiz_minima_bytes) ||
        rescue "cache.tar da mídia não foi medido"
    [ "$root_capacity" -ge "$required_root" ] ||
        rescue "disco pequeno demais: preciso de ao menos $((required_root / 1048576)) MiB na raiz"
    # A ESP tem 64 MiB; preserve pelo menos 4 MiB para FAT/metadados.
    [ "$efi_bytes" -le 62914560 ] ||
        rescue "BOOTX64.EFI não cabe com segurança na ESP de 64 MiB"

    say "APAGANDO $disk: GPT com ESP FAT32 de 64 MiB + raiz ext4" >&2
    # GPT pelo Minipax, não MBR pelo fdisk do BusyBox — que sequer sabe
    # escrever GPT. Em hardware real o MBR trava acima de 2 TiB e é o esquema
    # que firmware UEFI aceita por tolerância, não por norma. O Minipax já
    # escrevia GPT para compor a IMG; usar o mesmo código aqui mantém o
    # caminho que APAGA DISCO dentro do Rust auditado.
    # QUANTA SWAP, e a resposta vem da MÁQUINA e não de uma constante. Este
    # script roda no computador que vai receber o sistema, então ele sabe
    # quanta RAM existe — coisa que nem a receita nem o compositor da mídia
    # sabem.
    #
    # A regra é o dobro da RAM até 2 GiB, RAM igual entre 2 e 8, e teto de 8
    # GiB acima disso. É a regra que as distros convergiram depois de anos, e a
    # razão de o teto existir: swap serve para folga de alocação e para
    # sobreviver a um pico, não para rodar em disco — uma máquina que precise de
    # 32 GiB de troca precisa é de mais memória.
    #
    # NÃO cobre hibernação, que exigiria swap >= RAM sempre. Esta distro não
    # hiberna: não há suspend-to-disk configurado, e prometer o tamanho sem o
    # resto seria gastar disco por uma função que não existe.
    ram_kb=$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || echo 0)
    ram_mib=$((ram_kb / 1024))
    if [ "$ram_mib" -le 0 ]; then
        swap_mib=0
        say "nao consegui ler a RAM; instalando sem area de troca" >&2
    elif [ "$ram_mib" -le 2048 ]; then
        swap_mib=$((ram_mib * 2))
    elif [ "$ram_mib" -le 8192 ]; then
        swap_mib=$ram_mib
    else
        swap_mib=8192
    fi

    # E AGORA O DISCO TEM VOTO. A regra acima olha so a RAM, e sozinha ela
    # produziu um defeito medido: numa maquina de 2 GiB com disco de 8 GiB ela
    # pediu 3934 MiB de troca, sobrou 4,1 GB para uma raiz que precisa de mais
    # que isso, e a instalacao morreu com "No space left on device" no pacote
    # 85 de 99 — depois de vinte minutos.
    #
    # O required_root ja foi calculado acima com a estimativa do cache e 512
    # MiB de reserva. A troca sai do que SOBRA depois dele, e ainda deixa 20%
    # de folga sobre esse excedente: um sistema instalado com o disco no limite
    # e um sistema que nao aceita nem uma atualizacao.
    # METADE do que sobra depois da raiz necessaria, e nao 80%: o required_root
    # e uma ESTIMATIVA, e uma estimativa que ja errou por baixo uma vez. Deixar
    # metade do excedente livre e o que separa "instalou apertado" de "instalou
    # e ainda aceita a proxima atualizacao".
    #
    # Em disco grande este teto nao morde: numa maquina de 8 GiB de RAM com 500
    # GB de disco, metade do excedente sao centenas de gigabytes e quem manda
    # volta a ser a regra da RAM, com seu teto de 8 GiB.
    excedente=$((root_capacity - required_root))
    if [ "$excedente" -gt 0 ]; then
        teto_mib=$(( (excedente / 1048576) / 2 ))
    else
        teto_mib=0
    fi
    if [ "$swap_mib" -gt "$teto_mib" ]; then
        say "area de troca de ${swap_mib} MiB nao cabe; limitando a ${teto_mib} MiB pelo disco" >&2
        swap_mib=$teto_mib
    fi
    # Abaixo de 128 MiB a troca nao ajuda e ainda tira espaco da raiz.
    [ "$swap_mib" -ge 128 ] || swap_mib=0
    # >&2 OBRIGATÓRIO, e não estilo: o stdout DESTA FUNÇÃO é o valor de retorno
    # dela — ela termina com `echo "$esp $root"` e o chamador lê os caminhos
    # dali. O `say` escreve em stdout. Sem o redirecionamento, esta linha vira
    # parte do retorno, e o instalador tenta montar
    # 'RAM de 1967 MiB; area de troca de 3934 MiB' como se fosse dispositivo.
    # Medido: foi exatamente isso que aconteceu na primeira tentativa.
    say "RAM de ${ram_mib} MiB; area de troca de ${swap_mib} MiB" >&2

    /bin/minipax partition --disk "$disk" --esp-mib 64 --swap-mib "$swap_mib" \
        --logical-sector "$logical_sector" >&2 ||
        rescue "minipax partition falhou em $disk"
    partprobe "$disk" 2>/dev/null || true
    blockdev --rereadpt "$disk" 2>/dev/null || true
    mdev -s 2>/dev/null || true

    esp=$(partition_path "$disk" 1)
    root=$(partition_path "$disk" 2)
    attempts=0
    while { [ ! -b "$esp" ] || [ ! -b "$root" ]; } && [ "$attempts" -lt 50 ]; do
        sleep 1
        mdev -s 2>/dev/null || true
        attempts=$((attempts + 1))
    done
    [ -b "$esp" ] && [ -b "$root" ] || rescue "partições não apareceram"
    root_name=${root#/dev/}
    root_sectors=$(cat "/sys/class/block/$root_name/size" 2>/dev/null || echo 0)
    # sysfs expõe `size` sempre em setores de 512 bytes, inclusive em 4Kn.
    [ $((root_sectors * 512)) -gt 67108864 ] ||
        rescue "partição raiz ficou menor que 64 MiB"

    mkfs.vfat -n DISTROPICA_ESP "$esp" >&2 || rescue "mkfs.vfat falhou"
    # ext4, não ext2: sem journal, um desligamento sujo em hardware real vira
    # verificação completa em vez de replay. O mke2fs é o estático do
    # initramfs, com seu mke2fs.conf ao lado — o applet do busybox só faz ext2.
    mkfs.ext4 -F -L DISTROPICA_ROOT -m 0 "$root" >&2 || rescue "mkfs.ext4 falhou"

    # A SWAP, quando o minipax a criou. Ela é a partição 3 e pode não existir —
    # disco pequeno, ou --swap-mib 0 —, e a ausência não é erro: o sistema
    # instala e roda sem ela. Formatar com rótulo importa porque é POR ELE que o
    # drop-in de boot a encontra, sem fstab e sem caminho de dispositivo
    # gravado em lugar nenhum.
    swap=$(partition_path "$disk" 3)
    if [ "$swap_mib" -gt 0 ] && [ -b "$swap" ]; then
        mkswap -L DISTROPICA_SWAP "$swap" >&2 ||
            rescue "mkswap falhou em $swap"
        say "area de troca formatada em $swap" >&2
    elif [ "$swap_mib" -gt 0 ]; then
        # Pedimos e não veio: ou o disco nao comportou, ou o no de dispositivo
        # nao apareceu. Nao e motivo para abortar a instalacao, e e motivo para
        # dizer — um sistema que deveria ter swap e nao tem explica sozinho o
        # primeiro travamento por falta de memoria.
        say "area de troca pedida mas ausente em $swap; seguindo sem ela" >&2
    fi
    echo "$esp $root"
}

# A senha e a ULTIMA pergunta, e vem logo antes da primeira escrita destrutiva.
#
# O invariante que importa nunca mudou: nenhum `mkfs` roda enquanto houver algo
# a perguntar. Ele existe por uma falha concreta — numa ordem antiga a senha era
# pedida no fim, ja com o disco apagado, e quem se distraisse e voltasse depois
# encontrava a maquina parada num prompt, com o disco antigo destruido e o
# sistema novo pela metade.
#
# O QUE MUDOU FOI A POSICAO RELATIVA AO INSTALADOR DE TEXTO. Ela vinha antes da
# escolha do disco, e isso funcionava quando a escolha era uma linha digitada;
# com uma tela cheia, o operador era recebido por um "Nova senha de root:" solto,
# sem contexto nenhum, antes de saber sequer se havia disco onde instalar. Agora
# ele escolhe tudo primeiro e a senha fecha a sequencia.
#
# Na rota manual o cfdisk ja gravou uma tabela de particoes quando chegamos
# aqui, mas isso e escrita do operador, dentro de outro programa, e por vontade
# dele — nenhum sistema de arquivos foi formatado ainda.
#
# Colher cedo permite tambem nao CARREGAR a senha em claro pela instalacao
# inteira: ela e cifrada no ato, aqui, e o que atravessa e apenas o hash. O
# cryptpw le da entrada padrao de proposito — passar a senha como argumento a
# deixaria visivel em /proc/<pid>/cmdline para qualquer coisa que olhasse.
senha_root_cifrada=

ask_root_password() {
    if grep -q 'distropica.test=1' /proc/cmdline; then
        say "modo de teste: conta root permanece bloqueada"
        return 0
    fi
    say "solicitando senha de root"
    while :; do
        printf 'Nova senha de root: ' >/dev/console
        stty -echo </dev/console >/dev/console 2>&1 || true
        IFS= read -r first </dev/console
        printf '\nRepita a senha: ' >/dev/console
        IFS= read -r second </dev/console
        stty echo </dev/console >/dev/console 2>&1 || true
        printf '\n' >/dev/console
        if [ -n "$first" ] && [ "$first" = "$second" ]; then
            senha_root_cifrada=$(printf '%s\n' "$first" | cryptpw -m sha512)
            first=
            second=
            [ -n "$senha_root_cifrada" ] ||
                rescue "não consegui cifrar a senha de root"
            say "senha de root recebida"
            return 0
        fi
        first=
        second=
        say "senhas vazias ou diferentes; tente novamente"
    done
}

# Escreve o hash no sistema ja instalado. Nao ha o que perguntar aqui: se o
# modo de teste pulou a coleta, nao ha hash e a conta segue bloqueada, que e
# exatamente o que o modo de teste quer.
apply_root_password() {
    password_root=$1
    [ -n "$senha_root_cifrada" ] || return 0
    printf 'root:%s\n' "$senha_root_cifrada" |
        chpasswd -e -R "$password_root" || return 1
    senha_root_cifrada=
    return 0
}

configure_network() {
    grep -q '^MODE=online$' /media/distropica/media.meta || return 0
    say "mídia online: solicitando configuração DHCP"
    for path in /sys/class/net/*; do
        interface=${path##*/}
        [ "$interface" != lo ] || continue
        ip link set "$interface" up 2>/dev/null || continue
        if udhcpc -n -q -t 5 -T 3 -i "$interface"; then
            say "rede configurada em $interface"
            return 0
        fi
    done
    return 1
}

path_fingerprint() {
    fingerprint_path=$1
    if [ -L "$fingerprint_path" ]; then
        fingerprint_hash=$(readlink "$fingerprint_path" | sha256sum | awk '{print $1}') ||
            return 1
        printf 'l:%s\n' "$fingerprint_hash"
    elif [ -f "$fingerprint_path" ]; then
        fingerprint_mode=$(stat -c '%a' "$fingerprint_path") || return 1
        fingerprint_hash=$(sha256sum "$fingerprint_path" | awk '{print $1}') || return 1
        printf 'f:%s:%s\n' "$fingerprint_mode" "$fingerprint_hash"
    else
        return 1
    fi
}

require_same_prepared_path() {
    installed_path=$1
    expected_fingerprint=$2
    actual_fingerprint=$(path_fingerprint "$installed_path") ||
        rescue "cópia perdeu o caminho crítico $installed_path"
    [ "$actual_fingerprint" = "$expected_fingerprint" ] ||
        rescue "cópia alterou o caminho crítico $installed_path"
}

# Valida a midia por completo, sem escrever nada e sem tocar em disco nenhum.
#
# ISTO ERA OUTRA COISA ate 2026-07-30: chamava-se prepare_system e MONTAVA A
# ARVORE INTEIRA em /run (tmpfs) antes de perguntar o disco. A garantia que
# isso comprava era "nunca apagamos um disco sem ter construido o sistema
# inteiro com sucesso", e ela custava 2,4 GiB de RAM — numa maquina com 4 GiB o
# instalador morria com ENOSPC no pacote 60 de 78.
#
# A garantia era forte demais para o que valia. A integridade do payload ja e
# conferida ANTES por hash e assinatura de cada artefato; o que sobrava de
# risco era disco cheio, erro de I/O e bug. E o valor de "seu disco esta
# intacto" e baixo justamente onde ela agia: o usuario acabou de AUTORIZAR
# apagar aquele disco.
#
# O que se preserva: a midia e validada por inteiro — media.meta, profile.lock,
# os hashes de cada peca, o sha256 do cache.tar e a sanidade estrutural dos
# tres tars — antes de qualquer escrita. Uma midia corrompida continua sendo
# recusada com o disco do usuario intacto. O que se larga: construir o sistema
# em memoria so para descobrir isso. A decisao antiga nasceu quando o payload
# tinha 700 MiB; envelheceu quando ele passou de 2 GiB.
validate_media() {
    say "validando a mídia antes de escolher ou apagar um disco"
    configure_network || rescue "mídia online sem rede funcional"
    /bin/minipax install-media \
        --source /media \
        --target /target \
        --minitrue /bin/minitrue \
        --check \
        --only-binary || rescue "Minipax recusou a mídia antes da escrita em disco"
    say "mídia validada; nenhum disco foi alterado"
}

# TUDO O QUE PODE REPROVAR A ROTA MANUAL, e nada que escreva.
#
# Esta funcao existe separada da que formata por causa de ONDE ela e chamada:
# logo depois da decisao e ANTES da senha. Uma ESP sem FAT, uma raiz pequena
# demais ou uma particao no disco da propria midia sao erros do operador, e
# erro do operador tem de aparecer enquanto ele ainda esta escolhendo — nao
# depois de digitar a senha duas vezes, e muito menos depois do primeiro mkfs.
#
# O teste de montar a ESP preservada e o exemplo que justifica tudo isso: uma
# particao marcada como "EFI System" no cfdisk mas nunca formatada nao tem FAT
# nenhum, e sem este teste o sintoma so apareceria no `mount` da ESP, com a raiz
# ja formatada e o sistema anterior ja destruido.
confere_particoes_escolhidas() {
    [ "$ROTA" = manual ] || return 0

    midia_inteiro=$(whole_disk_name "$media_device")
    for escolhida in "$INSTALL_ESP" "$INSTALL_RAIZ" $INSTALL_TROCA; do
        [ -b "$escolhida" ] || rescue "$escolhida não é dispositivo de bloco"
        [ "$(whole_disk_name "$escolhida")" != "$midia_inteiro" ] ||
            rescue "recusei formatar uma partição do disco que contém a própria mídia"
    done

    # A raiz precisa caber o sistema. O instalador de texto ja recusa uma
    # particao pequena, e esta conferencia continua aqui porque quem executa e
    # este script: se um dia a decisao vier de outro lugar, e este `[ ]` que
    # impede a instalacao de morrer com ENOSPC no pacote 85.
    raiz_nome=${INSTALL_RAIZ#/dev/}
    raiz_setores=$(cat "/sys/class/block/$raiz_nome/size" 2>/dev/null || echo 0)
    case "$raiz_setores" in
        ""|*[!0-9]*) rescue "não medi a partição raiz $INSTALL_RAIZ" ;;
    esac
    preciso=$(raiz_minima_bytes) || rescue "cache.tar da mídia não foi medido"
    # sysfs expõe `size` sempre em setores de 512 bytes, inclusive em 4Kn.
    [ $((raiz_setores * 512)) -ge "$preciso" ] ||
        rescue "a raiz escolhida tem menos que os $((preciso / 1048576)) MiB necessários"

    efi_bytes=$(wc -c < /media/EFI/BOOT/BOOTX64.EFI 2>/dev/null || echo 0)
    esp_nome=${INSTALL_ESP#/dev/}
    esp_setores=$(cat "/sys/class/block/$esp_nome/size" 2>/dev/null || echo 0)
    case "$esp_setores" in
        ""|*[!0-9]*) rescue "não medi a ESP $INSTALL_ESP" ;;
    esac
    [ $((esp_setores * 512)) -ge $((efi_bytes + 4194304)) ] ||
        rescue "a ESP escolhida não comporta o BOOTX64.EFI com folga de FAT"

    if [ "$FORMATAR_ESP" = nao ]; then
        mkdir -p /run/esp-teste
        mount -t vfat -o ro "$INSTALL_ESP" /run/esp-teste 2>/dev/null ||
            rescue "a ESP $INSTALL_ESP não tem FAT montável; refaça escolhendo formatá-la"
        umount /run/esp-teste || rescue "não desmontei a ESP de teste"
        say "ESP $INSTALL_ESP tem FAT montável; será preservada"
    fi
    say "partições escolhidas conferidas; nada foi escrito ainda"
}

# A rota manual: as particoes ja existem, feitas pelo operador no cfdisk, e o
# que falta e formata-las. Toda recusa possivel ja aconteceu em
# confere_particoes_escolhidas; daqui para baixo so ha escrita.
formata_particoes_escolhidas() {
    if [ "$FORMATAR_ESP" = sim ]; then
        mkfs.vfat -n DISTROPICA_ESP "$INSTALL_ESP" >&2 || rescue "mkfs.vfat falhou"
    else
        say "preservando o conteúdo da ESP $INSTALL_ESP"
    fi

    mkfs.ext4 -F -L DISTROPICA_ROOT -m 0 "$INSTALL_RAIZ" >&2 || rescue "mkfs.ext4 falhou"

    if [ -n "$INSTALL_TROCA" ]; then
        mkswap -L DISTROPICA_SWAP "$INSTALL_TROCA" >&2 ||
            rescue "mkswap falhou em $INSTALL_TROCA"
        say "area de troca formatada em $INSTALL_TROCA"
    else
        say "instalando sem area de troca, como escolhido"
    fi
}

install_system() {
    disk=$INSTALL_DISCO
    case "$ROTA" in
        disco-inteiro)
            partitions=$(partition_disk "$disk")
            esp=${partitions%% *}
            root=${partitions#* }
            ;;
        manual)
            formata_particoes_escolhidas
            esp=$INSTALL_ESP
            root=$INSTALL_RAIZ
            ;;
        *) rescue "rota de instalação desconhecida: $ROTA" ;;
    esac
    mount "$root" /target || rescue "não montei $root"

    # A instalacao acontece DIRETO no disco montado, e nao numa copia em RAM.
    # Nao ha TMPDIR a exportar: o minipax cria o proprio espaco de trabalho
    # DENTRO do alvo, que e o unico lugar com disco de verdade neste momento, e
    # o limpa ao terminar. Quem chama nao precisa saber onde.
    #
    # O --export-boot-efi aponta para /run e NAO para dentro do alvo: o minipax
    # reserva esse destino ANTES de instalar (para falhar cedo se o caminho for
    # ruim), e um arquivo dentro do alvo o faria recusar o proprio alvo por nao
    # estar vazio. Sao 17 MiB em tmpfs, o que e irrelevante agora que o payload
    # de verdade vai direto para o disco.
    say "instalando o sistema em $root"
    /bin/minipax install-media \
        --source /media \
        --target /target \
        --minitrue /bin/minitrue \
        --export-boot-efi /run/distropica-BOOTX64.EFI \
        --only-binary || rescue "a instalação no disco falhou"

    apply_root_password /target || rescue "não configurei a senha de root"
    say "senha de root configurada"

    /bin/minitrue --root /target verify ||
        rescue "o sistema instalado não confere com os registros"
    [ -f /target/var/lib/minipax/profile.lock ] &&
        [ ! -L /target/var/lib/minipax/profile.lock ] ||
        rescue "instalação sem profile.lock regular"
    installed_profile_lock_hash=$(sha256sum \
        /target/var/lib/minipax/profile.lock | awk '{print $1}') ||
        rescue "não medi o profile.lock instalado"

    [ -f /run/distropica-BOOTX64.EFI ] && [ ! -L /run/distropica-BOOTX64.EFI ] ||
        rescue "Minipax não exportou um EFI regular"
    mkdir -p /target/boot/efi
    mount "$esp" /target/boot/efi || rescue "não montei a ESP"
    mkdir -p /target/boot/efi/EFI/BOOT
    cp /run/distropica-BOOTX64.EFI /target/boot/efi/EFI/BOOT/BOOTX64.EFI ||
        rescue "não instalei BOOTX64.EFI"
    exported_efi_hash=$(sha256sum /run/distropica-BOOTX64.EFI | awk '{print $1}')
    installed_efi_hash=$(sha256sum \
        /target/boot/efi/EFI/BOOT/BOOTX64.EFI | awk '{print $1}') ||
        rescue "não medi BOOTX64.EFI instalado"
    [ "$installed_efi_hash" = "$exported_efi_hash" ] ||
        rescue "BOOTX64.EFI instalado diverge do exportado pelo Minipax"
    rm -f -- /run/distropica-BOOTX64.EFI

    sync || rescue "sync falhou antes de publicar a instalação"
    marker=/target/var/lib/minipax/disk-install.complete
    marker_tmp=/target/var/lib/minipax/.disk-install.complete.tmp
    [ ! -e "$marker" ] && [ ! -L "$marker" ] &&
        [ ! -e "$marker_tmp" ] && [ ! -L "$marker_tmp" ] ||
        rescue "marcador de instalação já existe"
    # O marcador e a ULTIMA coisa a ser escrita, e continua sendo: e ele que o
    # boot procura para decidir se a raiz esta completa. Uma instalacao
    # interrompida no meio deixa disco escrito e SEM marcador — que e
    # exatamente como o find_installed_root a rejeita e volta a procurar midia.
    (set -C; printf '%s\nPROFILE_LOCK_SHA256=%s\n' \
        'DISTROPICA_DISK_INSTALL_FORMAT=1' "$installed_profile_lock_hash" > "$marker_tmp") ||
        rescue "não criei o marcador temporário da instalação"
    chmod 644 "$marker_tmp"
    ln "$marker_tmp" "$marker" || rescue "não publiquei o marcador da instalação"
    rm -f -- "$marker_tmp"
    sync || rescue "sync falhou depois de publicar a instalação"
    umount /target/boot/efi || rescue "não desmontei a ESP com segurança"
    umount /target || rescue "não desmontei a raiz com segurança"
    say "INSTALLATION COMPLETE em $disk; reiniciando"
    reboot -f
}

mount_early
say "kernel vivo iniciado"

installed_root=$(find_installed_root)
if [ -n "$installed_root" ]; then
    boot_installed "$installed_root" ||
        say "raiz sem marcador completo; procurando mídia para reinstalação"
fi

media_device=$(find_media) || rescue "payload da mídia não encontrado"
say "payload encontrado em $media_device"
validate_media
decide_instalacao
confere_particoes_escolhidas
ask_root_password
install_system
rescue "o instalador retornou inesperadamente"
