#!/bin/sh
# Fotografa a tela de um sistema Distrópica já instalado, bootando o disco no
# QEMU e pedindo um screendump pelo monitor.
#
# Existe porque o accept-qemu prova o boot lendo o SERIAL, e modo gráfico não
# aparece no serial: a sessão roda na tty1, o compositor desenha no KMS, e um
# `distropica login:` na ttyS0 não diz absolutamente nada sobre haver ou não
# uma janela na tela. A única evidência honesta de que o compositor subiu é a
# imagem.
#
# O dispositivo de vídeo é virtio-gpu e não a VGA padrão: o kernel desta distro
# tem CONFIG_DRM_VIRTIO_GPU=y e NÃO tem bochs, simpledrm nem cirrus. Com a VGA
# padrão não existe /dev/dri/card0, o /etc/rc.d/session cai no getty de
# propósito, e a foto mostraria um console — sem nada ter quebrado.
set -eu
umask 022
LC_ALL=C
export LC_ALL

DISK=
OUTPUT=
LOG_DIR=
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd
QEMU=qemu-system-x86_64
MEMORY_MIB=4096
SETTLE=90
ACCEL=kvm
CLICK=
SETTLE_AFTER=60
NIC=none

usage() {
    cat <<'EOF'
uso: bootstrap/live/screenshot-qemu --disk INSTALADO.raw --output TELA.ppm \
       --log-dir NOVO-DIR [opções]

  --disk ARQ         disco raw JÁ instalado (não é modificado: snapshot)
  --output ARQ       arquivo .ppm a criar; não é sobrescrito
  --log-dir DIR      diretório novo para serial, OVMF_VARS e o socket
  --settle N         segundos de espera antes da foto (default: 90)
  --click X,Y        clica nessa coordenada antes de fotografar, movendo o
                     ponteiro pelo monitor do QEMU. Serve para provar que um
                     aplicativo ABRE, e não só que o compositor subiu: sem
                     isso a foto mostra a área de trabalho vazia, que é
                     compatível tanto com um Firefox instalado quanto com um
                     Firefox que não roda.
  --settle-after N   segundos entre o clique e a foto (default: 60). O
                     Firefox sobre softpipe leva bem mais que um segundo.
  --nic ESPEC        placa de rede a apresentar (default: none). Use
                     'user,model=virtio-net-pci' para dar cabo a VM — sem isso
                     o convidado nao tem interface alguma, e um gerenciador de
                     rede corretamente lista ZERO servicos. Lista vazia sem
                     placa nao e defeito; e o arnes.
  --memory-mib N     default: 4096
  --accel tcg|kvm    default: kvm
  --ovmf-code ARQ / --ovmf-vars ARQ / --qemu ARQ

O disco é aberto em modo snapshot: o boot não escreve nele.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --disk) DISK=${2:?}; shift 2 ;;
        --output) OUTPUT=${2:?}; shift 2 ;;
        --log-dir) LOG_DIR=${2:?}; shift 2 ;;
        --settle) SETTLE=${2:?}; shift 2 ;;
        --click) CLICK=${2:?}; shift 2 ;;
        --settle-after) SETTLE_AFTER=${2:?}; shift 2 ;;
        --nic) NIC=${2:?}; shift 2 ;;
        --memory-mib) MEMORY_MIB=${2:?}; shift 2 ;;
        --accel) ACCEL=${2:?}; shift 2 ;;
        --ovmf-code) OVMF_CODE=${2:?}; shift 2 ;;
        --ovmf-vars) OVMF_VARS=${2:?}; shift 2 ;;
        --qemu) QEMU=${2:?}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "erro: opção desconhecida: $1" >&2; usage >&2; exit 1 ;;
    esac
done

[ -n "$DISK" ] || { echo "erro: --disk é obrigatório" >&2; exit 1; }
[ -n "$OUTPUT" ] || { echo "erro: --output é obrigatório" >&2; exit 1; }
[ -n "$LOG_DIR" ] || { echo "erro: --log-dir é obrigatório" >&2; exit 1; }
[ -f "$DISK" ] || { echo "erro: disco não existe: $DISK" >&2; exit 1; }
[ ! -e "$OUTPUT" ] || { echo "erro: saída já existe: $OUTPUT" >&2; exit 1; }
[ ! -e "$LOG_DIR" ] || { echo "erro: log-dir já existe: $LOG_DIR" >&2; exit 1; }
case "$ACCEL" in tcg|kvm) ;; *) echo "erro: --accel inválido" >&2; exit 1 ;; esac
[ "$ACCEL" != kvm ] || [ -r /dev/kvm ] || {
    echo "erro: --accel kvm exige /dev/kvm legível" >&2; exit 1;
}

mkdir -p "$LOG_DIR"
LOG_DIR=$(CDPATH= cd -- "$LOG_DIR" && pwd -P)
cp "$OVMF_VARS" "$LOG_DIR/OVMF_VARS.fd"
chmod u+w "$LOG_DIR/OVMF_VARS.fd"
MONITOR=$LOG_DIR/monitor.sock
QMP=$LOG_DIR/qmp.sock
SERIAL=$LOG_DIR/serial.log
SHOT=$LOG_DIR/tela.ppm

# snapshot=on: o boot não persiste nada no disco, então fotografar não estraga
# a evidência do aceite nem impede repetir.
"$QEMU" \
    -machine "q35,accel=$ACCEL" \
    -m "$MEMORY_MIB" \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$LOG_DIR/OVMF_VARS.fd" \
    -drive "file=$DISK,format=raw,if=none,id=target,snapshot=on" \
    -device virtio-blk-pci,drive=target,bootindex=1 \
    -device virtio-gpu-pci \
    -device virtio-tablet-pci,id=tablet \
    -nic "$NIC" \
    -display none \
    -serial "file:$SERIAL" \
    -monitor "unix:$MONITOR,server,nowait" \
    -qmp "unix:$QMP,server,nowait" \
    -no-reboot &
QEMU_PID=$!

# Mata o QEMU em qualquer saída, inclusive erro — um emulador órfão segurando
# /dev/kvm atrapalha a próxima execução.
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT INT TERM

n=0
while [ ! -S "$MONITOR" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.1
done
[ -S "$MONITOR" ] || { echo "erro: monitor do QEMU não apareceu" >&2; exit 1; }

echo "esperando ${SETTLE}s pelo boot e pela sessão gráfica"
sleep "$SETTLE"

# O socat é a forma de falar com o monitor sem terminal interativo.
command -v socat >/dev/null 2>&1 || {
    echo "erro: socat é necessário para falar com o monitor do QEMU" >&2
    exit 1
}
if [ -n "$CLICK" ]; then
    x=${CLICK%,*}
    y=${CLICK#*,}
    case "$x$y" in *[!0-9]*) echo "erro: --click precisa ser X,Y numérico" >&2; exit 1 ;; esac
    # UM TABLET ABSOLUTO E O QMP. Aqui houve, antes, uma malha fechada que
    # fotografava a tela a cada passo, procurava o cursor pelo brilho e emitia
    # correções relativas. Ela era engenhosa e NUNCA ATIVOU UM LANÇADOR — o
    # experimento de controle, clicar no terminal, também não abria nada. Vale
    # registrar por que, porque o defeito não estava onde a complexidade estava:
    #
    #   1. Esta máquina não tinha dispositivo apontador NENHUM declarado. O
    #      convidado via só o mouse PS/2 que o q35 emula por padrão, e o PS/2
    #      reporta movimento RELATIVO — daí a malha, daí a aceleração
    #      imprevisível do weston (81 px viravam ~20; 80 px viravam 148).
    #   2. Os comandos `mouse_move`/`mouse_button` do monitor HMP são legado e
    #      agem sobre o "mouse selecionado", que com mais de um dispositivo não
    #      é necessariamente o que tem o ponteiro. O botão ia para um lugar e a
    #      posição para outro. Foi isso que produziu o sintoma mais confuso de
    #      todos: o ícone REALÇAVA sob o cursor e o clique não fazia nada.
    #
    # O conserto remove a causa em vez de compensá-la: `-device
    # virtio-tablet-pci` dá um dispositivo ABSOLUTO, que o convidado enxerga
    # porque este kernel tem CONFIG_VIRTIO_INPUT=y (conferido, não suposto), e
    # o `input-send-event` do QMP entrega posição e botão pelo mesmo caminho,
    # em lotes atômicos. Sem aceleração para adivinhar, sem saturação de delta,
    # sem ambiguidade de quem recebe o clique: com um único apontador absoluto
    # declarado, o roteamento por tipo de evento não tem para onde errar.
    #
    # O eixo absoluto do virtio-input vai de 0 a 32767, independente da
    # resolução; a conversão é linear e a guarda de resolução lá embaixo
    # continua sendo o que impede o clique de cair no lugar errado em silêncio.
    command -v python3 >/dev/null 2>&1 || {
        echo "erro: python3 é necessário para falar QMP" >&2; exit 1; }
    n=0
    while [ ! -S "$QMP" ] && [ "$n" -lt 100 ]; do n=$((n + 1)); sleep 0.1; done
    [ -S "$QMP" ] || { echo "erro: socket QMP não apareceu" >&2; exit 1; }
    python3 - "$QMP" "$x" "$y" <<'QMPCLICK' || exit 1
import json
import socket
import sys
import time

caminho, x, y = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
LARGURA, ALTURA = 1280, 800

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(caminho)
f = s.makefile("rw", encoding="utf-8", newline="\n")


def comando(cmd, **args):
    f.write(json.dumps({"execute": cmd, "arguments": args} if args
                       else {"execute": cmd}) + "\n")
    f.flush()
    # O QMP intercala eventos assíncronos com respostas; a resposta é a
    # primeira linha que traga "return" ou "error".
    while True:
        linha = f.readline()
        if not linha:
            raise SystemExit("QMP fechou a conexão")
        msg = json.loads(linha)
        if "error" in msg:
            raise SystemExit(f"QMP recusou {cmd}: {msg['error']}")
        if "return" in msg:
            return msg["return"]


f.readline()          # saudação
comando("qmp_capabilities")

ax = min(32767, max(0, round(x * 32767 / (LARGURA - 1))))
ay = min(32767, max(0, round(y * 32767 / (ALTURA - 1))))


def enviar(eventos):
    # SEM o parametro `device`, e isto e uma armadilha de nome. Em
    # `input-send-event` o `device` NAO e o dispositivo de entrada: e o
    # console de VIDEO para onde rotear o evento. Passar "tablet" ali com
    # `-display none` faz o QEMU procurar a propriedade `device` no
    # qemu-fixed-text-console, nao achar, e ABORTAR — o processo morre com
    # SIGABRT e o cliente ve apenas "Connection reset by peer", sem uma
    # palavra sobre a causa. Medido aqui.
    #
    # Omitido, o QEMU roteia por TIPO de evento: `abs` vai para um
    # dispositivo que suporte eixo absoluto, que e exatamente o tablet.
    comando("input-send-event", events=eventos)


# Posicionar e clicar sao lotes SEPARADOS, e de proposito: o compositor precisa
# processar o movimento e decidir o foco antes do botao chegar. Num unico lote
# o weston ve os dois no mesmo quadro e o realce acontece sem a ativacao.
enviar([{"type": "abs", "data": {"axis": "x", "value": ax}},
        {"type": "abs", "data": {"axis": "y", "value": ay}}])
time.sleep(1.0)
enviar([{"type": "btn", "data": {"down": True, "button": "left"}}])
time.sleep(0.15)
enviar([{"type": "btn", "data": {"down": False, "button": "left"}}])
print(f"  clique absoluto em ({x},{y}) -> eixo ({ax},{ay})")
QMPCLICK
    echo "clicou em ($x,$y); esperando ${SETTLE_AFTER}s pelo aplicativo"
    sleep "$SETTLE_AFTER"
fi

printf 'screendump %s\nquit\n' "$SHOT" | socat - "UNIX-CONNECT:$MONITOR" >/dev/null 2>&1 || true

n=0
while [ ! -s "$SHOT" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.2
done
wait "$QEMU_PID" 2>/dev/null || true
trap - EXIT INT TERM

[ -s "$SHOT" ] || { echo "erro: o screendump saiu vazio" >&2; exit 1; }
# Guarda da resolução assumida na conversão do --click. O PPM começa com
# "P6\n<largura> <altura>\n255\n"; se a tela deixar de ser 1280x800, o clique
# passa a cair no lugar errado SEM ERRO NENHUM — a foto sai, mostra o desktop
# intacto, e nada distingue isso de um aplicativo que não abriu. Já custou duas
# rodadas de dez minutos cada.
if [ -n "$CLICK" ]; then
    lida=$(head -c 32 "$SHOT" | tr '\n' ' ' | cut -d' ' -f2,3)
    [ "$lida" = "1280 800" ] || {
        echo "erro: a tela é '$lida', mas a conversão do --click assume 1280 800;" >&2
        echo "      ajuste TELA_LARGURA/TELA_ALTURA neste script" >&2
        exit 1
    }
fi
cp "$SHOT" "$OUTPUT"
echo "tela: $OUTPUT ($(wc -c < "$OUTPUT") bytes)"
echo "serial: $SERIAL"
