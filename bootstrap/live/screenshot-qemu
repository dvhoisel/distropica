#!/bin/sh
# Fotografa a tela de um sistema Distrópica já instalado, bootando o disco no
# QEMU e pedindo um screendump pelo monitor.
#
# Existe porque o accept-qemu prova o boot lendo o SERIAL, e modo gráfico não
# aparece no serial: a sessão roda na tty1, o compositor desenha no KMS, e um
# `distropica login:` na ttyS0 não diz absolutamente nada sobre haver ou não
# uma janela na tela. A única evidência honesta de que o compositor subiu é a
# imagem.
#
# O dispositivo de vídeo é virtio-gpu e não a VGA padrão: o kernel desta distro
# tem CONFIG_DRM_VIRTIO_GPU=y e NÃO tem bochs, simpledrm nem cirrus. Com a VGA
# padrão não existe /dev/dri/card0, o /etc/rc.d/session cai no getty de
# propósito, e a foto mostraria um console — sem nada ter quebrado.
set -eu
umask 022
LC_ALL=C
export LC_ALL

DISK=
OUTPUT=
LOG_DIR=
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd
QEMU=qemu-system-x86_64
MEMORY_MIB=4096
SETTLE=90
ACCEL=kvm
CLICK=
SETTLE_AFTER=60

usage() {
    cat <<'EOF'
uso: bootstrap/live/screenshot-qemu --disk INSTALADO.raw --output TELA.ppm \
       --log-dir NOVO-DIR [opções]

  --disk ARQ         disco raw JÁ instalado (não é modificado: snapshot)
  --output ARQ       arquivo .ppm a criar; não é sobrescrito
  --log-dir DIR      diretório novo para serial, OVMF_VARS e o socket
  --settle N         segundos de espera antes da foto (default: 90)
  --click X,Y        clica nessa coordenada antes de fotografar, movendo o
                     ponteiro pelo monitor do QEMU. Serve para provar que um
                     aplicativo ABRE, e não só que o compositor subiu: sem
                     isso a foto mostra a área de trabalho vazia, que é
                     compatível tanto com um Firefox instalado quanto com um
                     Firefox que não roda.
  --settle-after N   segundos entre o clique e a foto (default: 60). O
                     Firefox sobre softpipe leva bem mais que um segundo.
  --memory-mib N     default: 4096
  --accel tcg|kvm    default: kvm
  --ovmf-code ARQ / --ovmf-vars ARQ / --qemu ARQ

O disco é aberto em modo snapshot: o boot não escreve nele.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --disk) DISK=${2:?}; shift 2 ;;
        --output) OUTPUT=${2:?}; shift 2 ;;
        --log-dir) LOG_DIR=${2:?}; shift 2 ;;
        --settle) SETTLE=${2:?}; shift 2 ;;
        --click) CLICK=${2:?}; shift 2 ;;
        --settle-after) SETTLE_AFTER=${2:?}; shift 2 ;;
        --memory-mib) MEMORY_MIB=${2:?}; shift 2 ;;
        --accel) ACCEL=${2:?}; shift 2 ;;
        --ovmf-code) OVMF_CODE=${2:?}; shift 2 ;;
        --ovmf-vars) OVMF_VARS=${2:?}; shift 2 ;;
        --qemu) QEMU=${2:?}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "erro: opção desconhecida: $1" >&2; usage >&2; exit 1 ;;
    esac
done

[ -n "$DISK" ] || { echo "erro: --disk é obrigatório" >&2; exit 1; }
[ -n "$OUTPUT" ] || { echo "erro: --output é obrigatório" >&2; exit 1; }
[ -n "$LOG_DIR" ] || { echo "erro: --log-dir é obrigatório" >&2; exit 1; }
[ -f "$DISK" ] || { echo "erro: disco não existe: $DISK" >&2; exit 1; }
[ ! -e "$OUTPUT" ] || { echo "erro: saída já existe: $OUTPUT" >&2; exit 1; }
[ ! -e "$LOG_DIR" ] || { echo "erro: log-dir já existe: $LOG_DIR" >&2; exit 1; }
case "$ACCEL" in tcg|kvm) ;; *) echo "erro: --accel inválido" >&2; exit 1 ;; esac
[ "$ACCEL" != kvm ] || [ -r /dev/kvm ] || {
    echo "erro: --accel kvm exige /dev/kvm legível" >&2; exit 1;
}

mkdir -p "$LOG_DIR"
LOG_DIR=$(CDPATH= cd -- "$LOG_DIR" && pwd -P)
cp "$OVMF_VARS" "$LOG_DIR/OVMF_VARS.fd"
chmod u+w "$LOG_DIR/OVMF_VARS.fd"
MONITOR=$LOG_DIR/monitor.sock
SERIAL=$LOG_DIR/serial.log
SHOT=$LOG_DIR/tela.ppm

# snapshot=on: o boot não persiste nada no disco, então fotografar não estraga
# a evidência do aceite nem impede repetir.
"$QEMU" \
    -machine "q35,accel=$ACCEL" \
    -m "$MEMORY_MIB" \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$LOG_DIR/OVMF_VARS.fd" \
    -drive "file=$DISK,format=raw,if=none,id=target,snapshot=on" \
    -device virtio-blk-pci,drive=target,bootindex=1 \
    -device virtio-gpu-pci \
    -nic none \
    -display none \
    -serial "file:$SERIAL" \
    -monitor "unix:$MONITOR,server,nowait" \
    -no-reboot &
QEMU_PID=$!

# Mata o QEMU em qualquer saída, inclusive erro — um emulador órfão segurando
# /dev/kvm atrapalha a próxima execução.
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT INT TERM

n=0
while [ ! -S "$MONITOR" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.1
done
[ -S "$MONITOR" ] || { echo "erro: monitor do QEMU não apareceu" >&2; exit 1; }

echo "esperando ${SETTLE}s pelo boot e pela sessão gráfica"
sleep "$SETTLE"

# O socat é a forma de falar com o monitor sem terminal interativo.
command -v socat >/dev/null 2>&1 || {
    echo "erro: socat é necessário para falar com o monitor do QEMU" >&2
    exit 1
}
if [ -n "$CLICK" ]; then
    x=${CLICK%,*}
    y=${CLICK#*,}
    case "$x$y" in *[!0-9]*) echo "erro: --click precisa ser X,Y numérico" >&2; exit 1 ;; esac
    # MALHA FECHADA: mover, fotografar, achar o cursor, corrigir. Nao ha como
    # mirar em malha aberta com este ponteiro, e a tentativa custou caro.
    #
    # O mouse do QEMU e PS/2 e reporta movimento RELATIVO. Dois obstaculos se
    # somam. O protocolo trunca deslocamento fora de -256..255, daí o
    # estacionamento no canto ir em muitos passos pequenos. E o weston aplica
    # aceleracao de ponteiro cuja curva NAO E PREVISIVEL de fora: medido aqui,
    # pedir 81 px levou o ponteiro a ~20 (encolheu) e pedir 80 px levou a 148
    # (amplificou). Qualquer fator fixo erra.
    #
    # O usb-tablet, que reporta posicao absoluta, resolveria a mira — e nao
    # serve: com ele o ponteiro CHEGA ao alvo, o icone ate realca, e o botao nao
    # ativa lancador nenhum. Verificado com o experimento de controle que este
    # bloco agora torna obrigatorio: clicar no TERMINAL, que obviamente
    # funciona. Nao abria.
    #
    # Entao: PS/2 para o botao, malha fechada para a mira. Cada iteracao
    # fotografa a tela, localiza o cursor pelo brilho (a seta e clara sobre um
    # fundo escuro) e emite a correcao relativa. Converge em poucas voltas e nao
    # depende de nenhuma constante da curva.
    monitor() { socat - "UNIX-CONNECT:$MONITOR" >/dev/null 2>&1 || true; }
    {
        i=0
        while [ "$i" -lt 20 ]; do
            printf 'mouse_move -100 -100\n'
            i=$((i + 1))
        done
    } | monitor
    sleep 1
    # Sai do painel antes de comecar: o estacionamento deixa o cursor em (0,0),
    # que esta DENTRO do painel — e a busca por brilho ignora essa faixa, para
    # nao confundir a seta com os icones. Sem este empurrao a primeira iteracao
    # nao acha nada e a malha desiste antes de comecar.
    printf 'mouse_move 60 200\n' | monitor
    sleep 1
    # O ALVO DA MALHA E ABAIXO DO PAINEL, e o painel e alcancado depois.
    # Motivo: o cursor e localizado por brilho, e dentro do painel os proprios
    # icones sao claros — a busca acharia um icone em vez da seta. Entao a malha
    # converge para (x, 60), em area vazia e escura, e so entao um unico
    # movimento grande para cima leva o ponteiro ao topo. Ele GRUDA em y=0
    # porque o compositor limita o ponteiro a tela, e y=0 esta dentro do painel
    # (32 px de altura) — a imprecisao vertical deixa de importar.
    alvo_y=60
    mira=0
    while [ "$mira" -lt 8 ]; do
        mira=$((mira + 1))
        rm -f "$LOG_DIR/mira.ppm"
        printf 'screendump %s\n' "$LOG_DIR/mira.ppm" | monitor
        n=0
        while [ ! -s "$LOG_DIR/mira.ppm" ] && [ "$n" -lt 50 ]; do
            n=$((n + 1)); sleep 0.1
        done
        posicao=$(python3 - "$LOG_DIR/mira.ppm" <<'ACHACURSOR'
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert("L")
w, h = im.size
px = im.load()
# A seta do cursor e o unico grupo de pixels claros fora do painel (y>=34) e
# fora de qualquer janela; procura-se o pixel mais claro dessa regiao.
melhor, mx, my = -1, -1, -1
for y in range(34, h, 2):
    for x in range(0, w, 2):
        v = px[x, y]
        if v > melhor:
            melhor, mx, my = v, x, y
print(mx, my, melhor)
ACHACURSOR
)
        set -- $posicao
        cx=$1; cy=$2; brilho=$3
        [ "$brilho" -gt 120 ] || { echo "  mira $mira: cursor nao localizado" >&2; break; }
        dx=$(( x - cx )); dy=$(( alvo_y - cy ))
        adx=${dx#-}; ady=${dy#-}
        echo "  mira $mira: cursor em ($cx,$cy); falta ($dx,$dy)"
        [ "$adx" -le 4 ] && [ "$ady" -le 4 ] && break
        # Meio passo por vez: a curva amplifica, e passo inteiro oscila.
        printf 'mouse_move %s %s\n' "$(( dx / 2 ))" "$(( dy / 2 ))" | monitor
        sleep 1
    done
    rm -f "$LOG_DIR/mira.ppm"
    # Sobe ao painel: dx=0 preserva a coluna que a malha acertou, e o -400
    # garante o encosto no topo por maior que seja a aceleracao.
    printf 'mouse_move 0 -400\n' | monitor
    sleep 1
    printf 'mouse_button 1\n' | monitor
    sleep 1
    printf 'mouse_button 0\n' | monitor
    echo "clicou em ($x,$y); esperando ${SETTLE_AFTER}s pelo aplicativo"
    sleep "$SETTLE_AFTER"
fi

printf 'screendump %s\nquit\n' "$SHOT" | socat - "UNIX-CONNECT:$MONITOR" >/dev/null 2>&1 || true

n=0
while [ ! -s "$SHOT" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.2
done
wait "$QEMU_PID" 2>/dev/null || true
trap - EXIT INT TERM

[ -s "$SHOT" ] || { echo "erro: o screendump saiu vazio" >&2; exit 1; }
# Guarda da resolução assumida na conversão do --click. O PPM começa com
# "P6\n<largura> <altura>\n255\n"; se a tela deixar de ser 1280x800, o clique
# passa a cair no lugar errado SEM ERRO NENHUM — a foto sai, mostra o desktop
# intacto, e nada distingue isso de um aplicativo que não abriu. Já custou duas
# rodadas de dez minutos cada.
if [ -n "$CLICK" ]; then
    lida=$(head -c 32 "$SHOT" | tr '\n' ' ' | cut -d' ' -f2,3)
    [ "$lida" = "1280 800" ] || {
        echo "erro: a tela é '$lida', mas a conversão do --click assume 1280 800;" >&2
        echo "      ajuste TELA_LARGURA/TELA_ALTURA neste script" >&2
        exit 1
    }
fi
cp "$SHOT" "$OUTPUT"
echo "tela: $OUTPUT ($(wc -c < "$OUTPUT") bytes)"
echo "serial: $SERIAL"
