#!/bin/sh
# Fotografa a tela de um sistema Distrópica já instalado, bootando o disco no
# QEMU e pedindo um screendump pelo monitor.
#
# Existe porque o accept-qemu prova o boot lendo o SERIAL, e modo gráfico não
# aparece no serial: a sessão roda na tty1, o compositor desenha no KMS, e um
# `distropica login:` na ttyS0 não diz absolutamente nada sobre haver ou não
# uma janela na tela. A única evidência honesta de que o compositor subiu é a
# imagem.
#
# O dispositivo de vídeo é virtio-gpu e não a VGA padrão: o kernel desta distro
# tem CONFIG_DRM_VIRTIO_GPU=y e NÃO tem bochs, simpledrm nem cirrus. Com a VGA
# padrão não existe /dev/dri/card0, o /etc/profile.d não sobe a sessão, e a
# foto mostraria um console — sem nada ter quebrado.
#
# DESDE A 0.17 A TTY1 PEDE LOGIN, e a sessão gráfica só sobe depois dele. Sem
# --login a foto de um sistema 0.17 mostra o prompt, e está certa. Com ele, o
# script faz o que uma pessoa faz: espera o getty, digita o usuário e a senha
# no teclado, e só então conta o --settle.
set -eu
umask 022
LC_ALL=C
export LC_ALL

DISK=
OUTPUT=
LOG_DIR=
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd
QEMU=qemu-system-x86_64
MEMORY_MIB=4096
SETTLE=90
ACCEL=kvm
CLICKS=
SETTLE_AFTER=60
SETTLE_BETWEEN=60
NIC=none
LOGIN=
BOOT_TIMEOUT=600

usage() {
    cat <<'EOF'
uso: bootstrap/live/screenshot-qemu --disk INSTALADO.raw --output TELA.ppm \
       --log-dir NOVO-DIR [opções]

  --disk ARQ         disco raw JÁ instalado (não é modificado: snapshot)
  --output ARQ       arquivo .ppm a criar; não é sobrescrito
  --log-dir DIR      diretório novo para serial, OVMF_VARS e o socket
  --settle N         segundos de espera antes da foto (default: 90); com
                     --login, contados DEPOIS do login
  --login USUARIO    faz login na tty1 antes da foto: espera o getty aparecer
                     no serial (a ttyS0 e a tty1 sobem juntas pelo inittab),
                     digita o usuário e a senha pelo teclado PS/2 do q35, e
                     só então conta o --settle. A senha vem da variável
                     ACCEPT_TUI_SENHA — a mesma com que o accept-tui a digitou
                     no instalador, e com o mesmo default dele —, nunca da
                     linha de comando, que o ps mostra
  --boot-timeout N   com --login: teto em segundos para o getty (default: 600).
                     Só é gasto inteiro quando o boot NÃO chega: a espera acaba
                     no getty. Com o hospedeiro carregado (uma cadeia com -j6 ao
                     lado), um primeiro boot já passou de 180s sem nada no serial
  --click X,Y        clica nessa coordenada antes de fotografar, movendo o
                     ponteiro pelo monitor do QEMU. Serve para provar que um
                     aplicativo ABRE, e não só que o compositor subiu: sem
                     isso a foto mostra a área de trabalho vazia, que é
                     compatível tanto com um Firefox instalado quanto com um
                     Firefox que não roda.
                     REPETÍVEL, na ordem dada: o primeiro clique abre o
                     aplicativo pelo lançador e o segundo aperta um botão
                     DENTRO dele. Sem isso não há como fotografar um diálogo —
                     e um diálogo que ninguém abriu é indistinguível de um
                     diálogo que não existe.
  --settle-after N   segundos entre o ÚLTIMO clique e a foto (default: 60). O
                     Firefox sobre softpipe leva bem mais que um segundo.
  --settle-between N segundos entre um clique e o seguinte (default: 60).
                     Precisa cobrir a abertura da janela do clique anterior:
                     clicar onde o botão ESTARÁ, antes de ele estar lá, acerta
                     o fundo da tela e a foto sai idêntica à de um botão que
                     não funciona.
  --nic ESPEC        placa de rede a apresentar (default: none). Use
                     'user,model=virtio-net-pci' para dar cabo a VM — sem isso
                     o convidado nao tem interface alguma, e um gerenciador de
                     rede corretamente lista ZERO servicos. Lista vazia sem
                     placa nao e defeito; e o arnes.
  --memory-mib N     default: 4096
  --accel tcg|kvm    default: kvm
  --ovmf-code ARQ / --ovmf-vars ARQ / --qemu ARQ

O disco é aberto em modo snapshot: o boot não escreve nele.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --disk) DISK=${2:?}; shift 2 ;;
        --output) OUTPUT=${2:?}; shift 2 ;;
        --log-dir) LOG_DIR=${2:?}; shift 2 ;;
        --settle) SETTLE=${2:?}; shift 2 ;;
        --click) CLICKS="$CLICKS ${2:?}"; shift 2 ;;
        --settle-after) SETTLE_AFTER=${2:?}; shift 2 ;;
        --settle-between) SETTLE_BETWEEN=${2:?}; shift 2 ;;
        --nic) NIC=${2:?}; shift 2 ;;
        --login) LOGIN=${2:?}; shift 2 ;;
        --boot-timeout) BOOT_TIMEOUT=${2:?}; shift 2 ;;
        --memory-mib) MEMORY_MIB=${2:?}; shift 2 ;;
        --accel) ACCEL=${2:?}; shift 2 ;;
        --ovmf-code) OVMF_CODE=${2:?}; shift 2 ;;
        --ovmf-vars) OVMF_VARS=${2:?}; shift 2 ;;
        --qemu) QEMU=${2:?}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "erro: opção desconhecida: $1" >&2; usage >&2; exit 1 ;;
    esac
done

[ -n "$DISK" ] || { echo "erro: --disk é obrigatório" >&2; exit 1; }
[ -n "$OUTPUT" ] || { echo "erro: --output é obrigatório" >&2; exit 1; }
[ -n "$LOG_DIR" ] || { echo "erro: --log-dir é obrigatório" >&2; exit 1; }
[ -f "$DISK" ] || { echo "erro: disco não existe: $DISK" >&2; exit 1; }
[ ! -e "$OUTPUT" ] || { echo "erro: saída já existe: $OUTPUT" >&2; exit 1; }
[ ! -e "$LOG_DIR" ] || { echo "erro: log-dir já existe: $LOG_DIR" >&2; exit 1; }
case "$ACCEL" in tcg|kvm) ;; *) echo "erro: --accel inválido" >&2; exit 1 ;; esac
[ "$ACCEL" != kvm ] || [ -r /dev/kvm ] || {
    echo "erro: --accel kvm exige /dev/kvm legível" >&2; exit 1;
}
case "$BOOT_TIMEOUT" in ''|*[!0-9]*) echo "erro: --boot-timeout precisa ser numérico" >&2; exit 1 ;; esac
# As ferramentas são conferidas ANTES do boot: descobrir a falta de uma depois
# de minutos de espera jogaria a espera fora. O socat fala com o monitor; o
# python3 fala QMP, que é por onde passam o clique e o teclado.
command -v socat >/dev/null 2>&1 || {
    echo "erro: socat é necessário para falar com o monitor do QEMU" >&2
    exit 1
}
[ -z "$CLICKS$LOGIN" ] || command -v python3 >/dev/null 2>&1 || {
    echo "erro: python3 é necessário para falar QMP (--click e --login)" >&2; exit 1; }

mkdir -p "$LOG_DIR"
LOG_DIR=$(CDPATH= cd -- "$LOG_DIR" && pwd -P)
cp "$OVMF_VARS" "$LOG_DIR/OVMF_VARS.fd"
chmod u+w "$LOG_DIR/OVMF_VARS.fd"
MONITOR=$LOG_DIR/monitor.sock
QMP=$LOG_DIR/qmp.sock
SERIAL=$LOG_DIR/serial.log
SHOT=$LOG_DIR/tela.ppm

# Fala QMP. `qmp clique X Y` posiciona o tablet e clica; `qmp digita TEXTO` e
# `qmp digita-senha` digitam no teclado e terminam com Enter.
qmp() {
    n=0
    while [ ! -S "$QMP" ] && [ "$n" -lt 100 ]; do n=$((n + 1)); sleep 0.1; done
    [ -S "$QMP" ] || { echo "erro: socket QMP não apareceu" >&2; exit 1; }
    python3 - "$QMP" "$@" <<'QMPPY' || exit 1
import json
import os
import socket
import string
import sys
import time

caminho, modo, args = sys.argv[1], sys.argv[2], sys.argv[3:]
LARGURA, ALTURA = 1280, 800

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(caminho)
f = s.makefile("rw", encoding="utf-8", newline="\n")


def comando(cmd, **args):
    f.write(json.dumps({"execute": cmd, "arguments": args} if args
                       else {"execute": cmd}) + "\n")
    f.flush()
    # O QMP intercala eventos assíncronos com respostas; a resposta é a
    # primeira linha que traga "return" ou "error".
    while True:
        linha = f.readline()
        if not linha:
            raise SystemExit("QMP fechou a conexão")
        msg = json.loads(linha)
        if "error" in msg:
            raise SystemExit(f"QMP recusou {cmd}: {msg['error']}")
        if "return" in msg:
            return msg["return"]


f.readline()          # saudação
comando("qmp_capabilities")

def enviar(eventos):
    # SEM o parametro `device`, e isto e uma armadilha de nome. Em
    # `input-send-event` o `device` NAO e o dispositivo de entrada: e o
    # console de VIDEO para onde rotear o evento. Passar "tablet" ali com
    # `-display none` faz o QEMU procurar a propriedade `device` no
    # qemu-fixed-text-console, nao achar, e ABORTAR — o processo morre com
    # SIGABRT e o cliente ve apenas "Connection reset by peer", sem uma
    # palavra sobre a causa. Medido aqui.
    #
    # Omitido, o QEMU roteia por TIPO de evento: `abs` vai para um
    # dispositivo que suporte eixo absoluto, que e exatamente o tablet.
    comando("input-send-event", events=eventos)


def clique(x, y):
    ax = min(32767, max(0, round(x * 32767 / (LARGURA - 1))))
    ay = min(32767, max(0, round(y * 32767 / (ALTURA - 1))))
    # Posicionar e clicar sao lotes SEPARADOS, e de proposito: o compositor
    # precisa processar o movimento e decidir o foco antes do botao chegar.
    # Num unico lote o weston ve os dois no mesmo quadro e o realce acontece
    # sem a ativacao.
    enviar([{"type": "abs", "data": {"axis": "x", "value": ax}},
            {"type": "abs", "data": {"axis": "y", "value": ay}}])
    time.sleep(1.0)
    enviar([{"type": "btn", "data": {"down": True, "button": "left"}}])
    time.sleep(0.15)
    enviar([{"type": "btn", "data": {"down": False, "button": "left"}}])
    print(f"  clique absoluto em ({x},{y}) -> eixo ({ax},{ay})")


# O TECLADO e o PS/2 que o q35 emula — o kernel desta arvore tem
# KEYBOARD_ATKBD e SERIO_I8042 —, e o console usa o mapa padrao do kernel, o
# US. Cada caractere vira o qcode da tecla que o produz nesse mapa; o que nao
# tem tecla mapeada aqui e recusado ANTES da primeira tecla, para nunca
# digitar meia senha.
ESPECIAIS = {"-": ["minus"], "_": ["shift", "minus"], ".": ["dot"],
             " ": ["spc"]}


def teclas(texto):
    combos = []
    for c in texto:
        if c in string.ascii_lowercase or c in string.digits:
            combos.append([c])
        elif c in string.ascii_uppercase:
            combos.append(["shift", c.lower()])
        elif c in ESPECIAIS:
            combos.append(ESPECIAIS[c])
        else:
            raise SystemExit("texto com caractere sem tecla mapeada no "
                             "teclado US deste script")
    return combos + [["ret"]]


def digita(texto):
    for combo in teclas(texto):
        comando("send-key",
                keys=[{"type": "qcode", "data": k} for k in combo])
        time.sleep(0.08)


if modo == "clique":
    clique(int(args[0]), int(args[1]))
elif modo == "digita":
    digita(args[0])
elif modo == "digita-senha":
    # Pelo ambiente e nunca por argv, que o ps mostra. O default e o do
    # accept-tui, que digitou esta mesma senha no instalador.
    digita(os.environ.get("ACCEPT_TUI_SENHA", "aceite-da-tui"))
else:
    raise SystemExit(f"modo QMP desconhecido: {modo}")
QMPPY
}

# snapshot=on: o boot não persiste nada no disco, então fotografar não estraga
# a evidência do aceite nem impede repetir.
"$QEMU" \
    -machine "q35,accel=$ACCEL" \
    -m "$MEMORY_MIB" \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$LOG_DIR/OVMF_VARS.fd" \
    -drive "file=$DISK,format=raw,if=none,id=target,snapshot=on" \
    -device virtio-blk-pci,drive=target,bootindex=1 \
    -device virtio-gpu-pci \
    -device virtio-tablet-pci,id=tablet \
    -nic "$NIC" \
    -display none \
    -serial "file:$SERIAL" \
    -monitor "unix:$MONITOR,server,nowait" \
    -qmp "unix:$QMP,server,nowait" \
    -no-reboot &
QEMU_PID=$!

# Mata o QEMU em qualquer saída, inclusive erro — um emulador órfão segurando
# /dev/kvm atrapalha a próxima execução.
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT INT TERM

n=0
while [ ! -S "$MONITOR" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.1
done
[ -S "$MONITOR" ] || { echo "erro: monitor do QEMU não apareceu" >&2; exit 1; }

if [ -n "$LOGIN" ]; then
    # O getty da ttyS0 no serial é o sinal de que o init chegou ao inittab; o
    # da tty1 sobe na mesma volta, depois que o /etc/rc.d/session prepara o
    # runtime da sessão. Digitar antes de o getty abrir a tty1 perderia as
    # teclas: ao abrir, ele descarta a entrada pendente.
    echo "esperando o getty (até ${BOOT_TIMEOUT}s)"
    n=0
    until grep -Fq 'distropica login:' "$SERIAL" 2>/dev/null; do
        kill -0 "$QEMU_PID" 2>/dev/null || {
            echo "erro: o QEMU saiu antes do getty (serial: $SERIAL)" >&2; exit 1; }
        [ "$n" -lt "$BOOT_TIMEOUT" ] || {
            echo "erro: nenhum getty em ${BOOT_TIMEOUT}s (serial: $SERIAL)" >&2; exit 1; }
        n=$((n + 1))
        sleep 1
    done
    sleep 5
    qmp digita "$LOGIN"
    # O login pede a senha depois de ler o usuário; digitá-la antes do prompt
    # a entregaria ao terminal ainda em eco, e o login a descartaria.
    sleep 3
    qmp digita-senha
    echo "login de $LOGIN digitado na tty1; esperando ${SETTLE}s pela sessão gráfica"
else
    echo "esperando ${SETTLE}s pelo boot e pela sessão gráfica"
fi
sleep "$SETTLE"

if [ -n "$CLICKS" ]; then
    # Valida TODAS as coordenadas antes de clicar em qualquer uma. Descobrir no
    # segundo clique que ele estava malformado significaria jogar fora os
    # minutos que o primeiro custou.
    for par in $CLICKS; do
        case "${par%,*}${par#*,}" in
            *[!0-9]*) echo "erro: --click precisa ser X,Y numérico: '$par'" >&2; exit 1 ;;
        esac
        case "$par" in *,*) ;; *) echo "erro: --click sem vírgula: '$par'" >&2; exit 1 ;; esac
    done
    # UM TABLET ABSOLUTO E O QMP. Aqui houve, antes, uma malha fechada que
    # fotografava a tela a cada passo, procurava o cursor pelo brilho e emitia
    # correções relativas. Ela era engenhosa e NUNCA ATIVOU UM LANÇADOR — o
    # experimento de controle, clicar no terminal, também não abria nada. Vale
    # registrar por que, porque o defeito não estava onde a complexidade estava:
    #
    #   1. Esta máquina não tinha dispositivo apontador NENHUM declarado. O
    #      convidado via só o mouse PS/2 que o q35 emula por padrão, e o PS/2
    #      reporta movimento RELATIVO — daí a malha, daí a aceleração
    #      imprevisível do weston (81 px viravam ~20; 80 px viravam 148).
    #   2. Os comandos `mouse_move`/`mouse_button` do monitor HMP são legado e
    #      agem sobre o "mouse selecionado", que com mais de um dispositivo não
    #      é necessariamente o que tem o ponteiro. O botão ia para um lugar e a
    #      posição para outro. Foi isso que produziu o sintoma mais confuso de
    #      todos: o ícone REALÇAVA sob o cursor e o clique não fazia nada.
    #
    # O conserto remove a causa em vez de compensá-la: `-device
    # virtio-tablet-pci` dá um dispositivo ABSOLUTO, que o convidado enxerga
    # porque este kernel tem CONFIG_VIRTIO_INPUT=y (conferido, não suposto), e
    # o `input-send-event` do QMP entrega posição e botão pelo mesmo caminho,
    # em lotes atômicos. Sem aceleração para adivinhar, sem saturação de delta,
    # sem ambiguidade de quem recebe o clique: com um único apontador absoluto
    # declarado, o roteamento por tipo de evento não tem para onde errar.
    #
    # O eixo absoluto do virtio-input vai de 0 a 32767, independente da
    # resolução; a conversão é linear e a guarda de resolução lá embaixo
    # continua sendo o que impede o clique de cair no lugar errado em silêncio.
    primeiro=sim
    for par in $CLICKS; do
        [ "$primeiro" = sim ] || {
            echo "esperando ${SETTLE_BETWEEN}s até o próximo clique"
            sleep "$SETTLE_BETWEEN"
        }
        primeiro=nao
        qmp clique "${par%,*}" "${par#*,}"
    done
    echo "esperando ${SETTLE_AFTER}s pelo aplicativo"
    sleep "$SETTLE_AFTER"
fi

printf 'screendump %s\nquit\n' "$SHOT" | socat - "UNIX-CONNECT:$MONITOR" >/dev/null 2>&1 || true

n=0
while [ ! -s "$SHOT" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.2
done
wait "$QEMU_PID" 2>/dev/null || true
trap - EXIT INT TERM

[ -s "$SHOT" ] || { echo "erro: o screendump saiu vazio" >&2; exit 1; }
# Guarda da resolução assumida na conversão do --click. O PPM começa com
# "P6\n<largura> <altura>\n255\n"; se a tela deixar de ser 1280x800, o clique
# passa a cair no lugar errado SEM ERRO NENHUM — a foto sai, mostra o desktop
# intacto, e nada distingue isso de um aplicativo que não abriu. Já custou duas
# rodadas de dez minutos cada.
if [ -n "$CLICKS" ]; then
    lida=$(head -c 32 "$SHOT" | tr '\n' ' ' | cut -d' ' -f2,3)
    [ "$lida" = "1280 800" ] || {
        echo "erro: a tela é '$lida', mas a conversão do --click assume 1280 800;" >&2
        echo "      ajuste LARGURA/ALTURA no QMP deste script" >&2
        exit 1
    }
fi
cp "$SHOT" "$OUTPUT"
echo "tela: $OUTPUT ($(wc -c < "$OUTPUT") bytes)"
echo "serial: $SERIAL"
# COM --login A FOTO TEM DE SER A SESSÃO, e não o console. O console é o fbcon
# do virtio-gpu, fundo preto puro; a sessão é a parede do desktop, a logo
# sobre o cinza 1a1a1a do tema, com a barra no mesmo cinza — a foto da 0.16
# mediu 0,0% de preto puro e 96,8% desse cinza. Metade da tela em (0,0,0) é o
# console: o login não entrou, ou a sessão caiu de volta no getty. A foto fica
# gravada mesmo assim, porque é ela que mostra qual dos dois.
if [ -n "$LOGIN" ]; then
    preto=$(python3 - "$OUTPUT" <<'PRETO'
import sys

d = open(sys.argv[1], "rb").read()
# Cabeçalho PPM lido token a token: um split ingênuo engoliria os primeiros
# bytes de pixel que por acaso fossem brancos.
campos, i = [], 0
while len(campos) < 4:
    while d[i:i + 1].isspace():
        i += 1
    if d[i:i + 1] == b"#":
        while d[i:i + 1] not in (b"\n", b""):
            i += 1
        continue
    j = i
    while j < len(d) and not d[j:j + 1].isspace():
        j += 1
    campos.append(d[i:j])
    i = j
if campos[0] != b"P6" or campos[3] != b"255":
    raise SystemExit("screendump não é um PPM P6 de 8 bits")
largura, altura = int(campos[1]), int(campos[2])
px = d[i + 1:]
total = largura * altura
if len(px) < 3 * total:
    raise SystemExit("screendump truncado")
preto = sum(1 for k in range(0, 3 * total, 3) if px[k:k + 3] == b"\0\0\0")
print(preto * 100 // total)
PRETO
) || { echo "erro: não consegui medir a foto" >&2; exit 1; }
    [ "$preto" -lt 50 ] || {
        echo "erro: a foto depois do login é o console (${preto}% de preto puro):" >&2
        echo "      a sessão gráfica não subiu; veja $OUTPUT" >&2
        exit 1
    }
    echo "sessão gráfica na foto (${preto}% de preto puro)"
fi
