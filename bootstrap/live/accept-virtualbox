#!/bin/sh
# Aceite funcional da mídia interativa sob VirtualBox/EFI.
#
# Cria um registro VirtualBox isolado, um VDI novo e uma VM efêmera. A senha
# usada no ensaio só existe em memória. A ISO é ejetada antes da autorização
# de /dev/sda, de modo que o reboot do instalador já prove o boot pelo VDI.
# A instalação e o segundo boot ocorrem com o cabo virtual desconectado. Só
# depois do aceite offline a VM faz um terceiro boot com NAT para provar a
# configuração de rede da base instalada. Em seguida desliga o link e compila
# GNU Make do cache para provar a continuação offline do sistema.
set -eu
umask 022
LC_ALL=C
export LC_ALL

ISO=
RUN_DIR=
VBOX=${VBOXMANAGE:-}
DISK_SIZE_MIB=2048
MEMORY_MIB=2048
PREPARE_TIMEOUT=600
INSTALL_TIMEOUT=600
BOOT_TIMEOUT=180
NETWORK_TIMEOUT=120
SOURCE_BUILD_TIMEOUT=900
VERIFY_TIMEOUT=300
VM_CREATED=no
DISK_REGISTERED=no
VM_UUID=
VM_NAME=
META=
SERIAL=
ONLINE_SERIAL=
VBOX_LOG=
SCREEN_INDEX=0

usage() {
    cat <<'EOF'
uso: bootstrap/live/accept-virtualbox --iso ARQ --run-dir NOVO-DIR [opções]

Obrigatórios:
  --iso ARQ              ISO interativa offline já construída
  --run-dir NOVO-DIR     diretório novo para VDI, VM, logs e screenshots

Opções:
  --vboxmanage ARQ       default: VBoxManage do PATH
  --disk-size-mib N      default: 2048 (mínimo: 256)
  --memory-mib N         default: 2048 (mínimo: 512)
  --prepare-timeout N    segundos até validar a closure (default: 600)
  --install-timeout N    segundos para instalar/reiniciar (default: 600)
  --boot-timeout N       segundos até o login pelo VDI (default: 180)
  --network-timeout N    segundos até DHCP/rota no terceiro boot (default: 120)
  --source-build-timeout N
                         segundos para compilar GNU Make offline (default: 900)
  --verify-timeout N     segundos para `minitrue verify` (default: 300)

O script recusa preventivamente uma ISO que contenha `distropica.install=` ou
`distropica.test=1`: essas opções pertencem somente ao aceite automatizado e
destrutivo do QEMU. A VM usa EFI64, VMSVGA, teclado PS/2, SATA/AHCI e uma NIC
VirtIO NAT inicialmente sem cabo. O VDI aparece como /dev/sda. Depois da
instalação offline e do segundo boot, o runner liga o cabo e faz um terceiro
boot para provar DHCP, DNS local via NAT, rota e gateway.
O segundo boot já exige ripgrep 15.2.0 e prova que Zig e GNU Make ainda estão
ausentes. Depois das provas de rede, o runner desconecta novamente o cabo,
compila GNU Make 4.4.1 por `minitrue --offline --no-binary` e exige que o Zig
0.16.0 seja materializado automaticamente apenas como dependência de build. A
senha efêmera não é salva nos artefatos.
EOF
}

fail() {
    echo "accept-virtualbox: erro: $*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --iso) ISO=${2:?}; shift 2 ;;
        --run-dir) RUN_DIR=${2:?}; shift 2 ;;
        --vboxmanage) VBOX=${2:?}; shift 2 ;;
        --disk-size-mib) DISK_SIZE_MIB=${2:?}; shift 2 ;;
        --memory-mib) MEMORY_MIB=${2:?}; shift 2 ;;
        --prepare-timeout) PREPARE_TIMEOUT=${2:?}; shift 2 ;;
        --install-timeout) INSTALL_TIMEOUT=${2:?}; shift 2 ;;
        --boot-timeout) BOOT_TIMEOUT=${2:?}; shift 2 ;;
        --network-timeout) NETWORK_TIMEOUT=${2:?}; shift 2 ;;
        --source-build-timeout) SOURCE_BUILD_TIMEOUT=${2:?}; shift 2 ;;
        --verify-timeout) VERIFY_TIMEOUT=${2:?}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) fail "opção desconhecida: $1" ;;
    esac
done

[ -n "$ISO" ] || fail "--iso é obrigatório"
[ -n "$RUN_DIR" ] || fail "--run-dir é obrigatório"

decimal() {
    case "$2" in
        0) ;;
        [1-9]*)
            case "$2" in *[!0-9]*) fail "$1 precisa ser inteiro decimal não negativo" ;; esac
            ;;
        *) fail "$1 precisa ser inteiro decimal não negativo" ;;
    esac
}

for pair in \
    "--disk-size-mib:$DISK_SIZE_MIB" \
    "--memory-mib:$MEMORY_MIB" \
    "--prepare-timeout:$PREPARE_TIMEOUT" \
    "--install-timeout:$INSTALL_TIMEOUT" \
    "--boot-timeout:$BOOT_TIMEOUT" \
    "--network-timeout:$NETWORK_TIMEOUT" \
    "--source-build-timeout:$SOURCE_BUILD_TIMEOUT" \
    "--verify-timeout:$VERIFY_TIMEOUT"; do
    decimal "${pair%%:*}" "${pair#*:}"
done
[ "$DISK_SIZE_MIB" -ge 256 ] && [ "$DISK_SIZE_MIB" -le 1048576 ] ||
    fail "--disk-size-mib precisa estar entre 256 e 1048576"
[ "$MEMORY_MIB" -ge 512 ] && [ "$MEMORY_MIB" -le 131072 ] ||
    fail "--memory-mib precisa estar entre 512 e 131072"
for timeout_value in "$PREPARE_TIMEOUT" "$INSTALL_TIMEOUT" "$BOOT_TIMEOUT" \
    "$NETWORK_TIMEOUT" "$SOURCE_BUILD_TIMEOUT" "$VERIFY_TIMEOUT"; do
    [ "$timeout_value" -ge 1 ] && [ "$timeout_value" -le 86400 ] ||
        fail "timeouts precisam estar entre 1 e 86400"
done

for command in awk basename chmod cp date dirname grep id mkdir od pgrep readlink \
    sed sha256sum sleep strings tesseract tr uuidgen wc xorriso; do
    command -v "$command" >/dev/null 2>&1 || fail "dependência ausente: $command"
done
if [ -z "$VBOX" ]; then
    VBOX=$(command -v VBoxManage 2>/dev/null || true)
fi
[ -n "$VBOX" ] || fail "VBoxManage ausente (use --vboxmanage)"

canonical_file() {
    input=$1
    label=$2
    [ -f "$input" ] || fail "$label ausente/não regular: $input"
    resolved=$(readlink -f -- "$input")
    [ -n "$resolved" ] && [ -f "$resolved" ] ||
        fail "$label não pôde ser resolvido: $input"
    printf '%s\n' "$resolved"
}

canonical_new_dir() {
    input=$1
    parent=$(dirname -- "$input")
    leaf=$(basename -- "$input")
    case "$leaf" in ""|.|..) fail "--run-dir não tem nome final seguro: $input" ;; esac
    [ -d "$parent" ] || fail "diretório pai de --run-dir não existe: $parent"
    parent=$(CDPATH= cd -- "$parent" && pwd -P)
    resolved=$parent/$leaf
    [ ! -e "$resolved" ] && [ ! -L "$resolved" ] ||
        fail "--run-dir já existe; nada será sobrescrito: $resolved"
    printf '%s\n' "$resolved"
}

absolute_executable() {
    input=$1
    parent=$(dirname -- "$input")
    leaf=$(basename -- "$input")
    [ -d "$parent" ] || fail "diretório de VBoxManage ausente: $parent"
    parent=$(CDPATH= cd -- "$parent" && pwd -P)
    resolved=$parent/$leaf
    [ -f "$resolved" ] && [ -x "$resolved" ] ||
        fail "VBoxManage ausente/não executável: $resolved"
    # Preserve o basename VBoxManage: em algumas instalações ele é um link
    # para VBox.sh, que decide qual programa iniciar a partir de argv[0].
    printf '%s\n' "$resolved"
}

ISO=$(canonical_file "$ISO" ISO)
VBOX=$(absolute_executable "$VBOX")
[ -r /dev/urandom ] || fail "/dev/urandom não está legível"
if pgrep -u "$(id -u)" -x VBoxSVC >/dev/null 2>&1; then
    fail "já existe um VBoxSVC deste usuário; feche VirtualBox/VMs antes do aceite isolado"
fi
RUN_DIR=$(canonical_new_dir "$RUN_DIR")
mkdir -- "$RUN_DIR"
chmod 755 "$RUN_DIR"
mkdir "$RUN_DIR/evidence" "$RUN_DIR/machines" "$RUN_DIR/vbox-home"
chmod 700 "$RUN_DIR/vbox-home"

export VBOX_USER_HOME=$RUN_DIR/vbox-home
META=$RUN_DIR/evidence/acceptance.meta
SERIAL=$RUN_DIR/evidence/console.serial
ONLINE_SERIAL=$RUN_DIR/evidence/console-online.serial
VBOX_LOG=$RUN_DIR/evidence/vboxmanage.log
EFI=$RUN_DIR/evidence/BOOTX64.EFI
DISK=$RUN_DIR/disk.vdi

iso_sha=$(sha256sum "$ISO" | awk '{print $1}')
vbox_launcher_sha=$(sha256sum "$VBOX" | awk '{print $1}')
vbox_binary=$(readlink -f -- "$VBOX")
if [ "$(basename -- "$vbox_binary")" = VBox.sh ]; then
    case "$vbox_binary" in
        */share/virtualbox/VBox.sh)
            vbox_prefix=${vbox_binary%/share/virtualbox/VBox.sh}
            vbox_candidate=$vbox_prefix/lib/virtualbox/VBoxManage
            if [ -f "$vbox_candidate" ] && [ -x "$vbox_candidate" ]; then
                vbox_binary=$vbox_candidate
            fi
            ;;
    esac
fi
vbox_binary_sha=$(sha256sum "$vbox_binary" | awk '{print $1}')
vbox_version=$("$VBOX" --version)
printf '%s\n' \
    'ACCEPTANCE_FORMAT=2' \
    'RUN_STARTED=preflight' \
    "ISO=$ISO" \
    "ISO_SHA256=$iso_sha" \
    "RUN_DIR=$RUN_DIR" \
    "VBOXMANAGE_LAUNCHER=$VBOX" \
    "VBOXMANAGE_LAUNCHER_SHA256=$vbox_launcher_sha" \
    "VBOXMANAGE_BINARY=$vbox_binary" \
    "VBOXMANAGE_BINARY_SHA256=$vbox_binary_sha" \
    "VBOX_VERSION=$vbox_version" \
    "DISK=$DISK" \
    "DISK_SIZE_MIB=$DISK_SIZE_MIB" \
    "MEMORY_MIB=$MEMORY_MIB" \
    "NETWORK_TIMEOUT=$NETWORK_TIMEOUT" \
    "SOURCE_BUILD_TIMEOUT=$SOURCE_BUILD_TIMEOUT" \
    "VERIFY_TIMEOUT=$VERIFY_TIMEOUT" \
    'FIRMWARE=efi64' \
    'GRAPHICS=vmsvga' \
    'STORAGE=IntelAhci' \
    'GUEST_DISK=/dev/sda' \
    'NIC_TYPE=virtio' \
    'INSTALL_NETWORK=nat-cable-disconnected' \
    'THIRD_BOOT_NETWORK=nat-cable-connected' \
    'DNS_PROBE=localhost-via-vbox-nat-host-resolver' \
    'SECURE_BOOT=off' > "$META"

xorriso -osirrox on -indev "$ISO" \
    -extract /EFI/BOOT/BOOTX64.EFI "$EFI" >"$RUN_DIR/evidence/xorriso.log" 2>&1 ||
    fail "não extraí /EFI/BOOT/BOOTX64.EFI da ISO"
[ -s "$EFI" ] || fail "BOOTX64.EFI extraído está vazio"
if strings -a "$EFI" | grep -Fq 'distropica.install='; then
    fail "ISO contém distropica.install=; recusei a variante destrutiva"
fi
if strings -a "$EFI" | grep -Fq 'distropica.test=1'; then
    fail "ISO contém distropica.test=1; recusei a variante automatizada"
fi
interactive_cmdline='console=ttyS0,115200 console=tty0 panic=-1 rdinit=/init'
strings -a "$EFI" | grep -Fqx "$interactive_cmdline" ||
    fail "BOOTX64.EFI não contém a cmdline interativa esperada"
efi_sha=$(sha256sum "$EFI" | awk '{print $1}')
printf 'BOOT_EFI_SHA256=%s\nCMDLINE=%s\n' "$efi_sha" "$interactive_cmdline" >> "$META"

VM_UUID=$(uuidgen | tr '[:upper:]' '[:lower:]')
VM_NAME=distropica-accept-$VM_UUID
ephemeral_password=dtp$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')9a

vbox() {
    "$VBOX" "$@" >>"$VBOX_LOG" 2>&1
}

vm_info() {
    "$VBOX" showvminfo "$VM_UUID" --machinereadable 2>>"$VBOX_LOG"
}

vm_state() {
    vm_info | sed -n 's/^VMState="\([^"]*\)"$/\1/p'
}

safe_vm_config() {
    config=$(vm_info | sed -n 's/^CfgFile="\(.*\)"$/\1/p')
    case "$config" in
        "$RUN_DIR"/machines/*) return 0 ;;
        *) return 1 ;;
    esac
}

cleanup() {
    status=$?
    cleanup_error=no
    trap - 0 HUP INT TERM
    if [ "$VM_CREATED" = yes ]; then
        vm_info >"$RUN_DIR/evidence/final-vm-info.txt" 2>>"$VBOX_LOG" || true
        if safe_vm_config; then
            state=$(vm_state 2>/dev/null || true)
            case "$state" in
                running|paused|stuck|starting|saving|restoring)
                    if ! "$VBOX" controlvm "$VM_UUID" poweroff >>"$VBOX_LOG" 2>&1; then
                        cleanup_error=yes
                    fi
                    ;;
            esac
            cleanup_deadline=$(($(date +%s) + 30))
            while :; do
                state=$(vm_state 2>/dev/null || true)
                case "$state" in poweroff|aborted|saved|"") break ;; esac
                if [ "$(date +%s)" -ge "$cleanup_deadline" ]; then
                    cleanup_error=yes
                    break
                fi
                sleep 1
            done
            if [ "$DISK_REGISTERED" = yes ]; then
                "$VBOX" storageattach "$VM_UUID" --storagectl=SATA \
                    --port=0 --device=0 --type=hdd --medium=none \
                    >>"$VBOX_LOG" 2>&1 || cleanup_error=yes
            fi
            if "$VBOX" unregistervm "$VM_UUID" >>"$VBOX_LOG" 2>&1; then
                VM_CREATED=no
            else
                cleanup_error=yes
            fi
        else
            echo "accept-virtualbox: configuração inesperada; VM não foi alterada no cleanup" >&2
            cleanup_error=yes
        fi
    fi
    if [ "$DISK_REGISTERED" = yes ]; then
        if "$VBOX" closemedium disk "$DISK" >>"$VBOX_LOG" 2>&1; then
            DISK_REGISTERED=no
        else
            cleanup_error=yes
        fi
    fi
    if [ "$cleanup_error" = yes ] && [ "$status" -eq 0 ]; then
        echo "accept-virtualbox: erro: cleanup isolado não foi concluído" >&2
        status=1
    fi
    if [ -n "$META" ] && [ -f "$META" ]; then
        if [ "$status" -eq 0 ]; then result=passed; else result=failed; fi
        printf 'FINAL_RESULT=%s\nFINISHED_UTC=%s\n' \
            "$result" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$META"
    fi
    exit "$status"
}
trap cleanup 0
trap 'exit 130' HUP INT TERM

echo "accept-virtualbox: fase 1/5: criando VM EFI/SATA isolada"
vbox createvm --name="$VM_NAME" --platform-architecture=x86 \
    --ostype=Linux_64 --basefolder="$RUN_DIR/machines" \
    --uuid="$VM_UUID" --register
VM_CREATED=yes
safe_vm_config || fail "CfgFile da VM saiu do diretório isolado"
vbox modifyvm "$VM_UUID" --memory="$MEMORY_MIB" --cpus=2 \
    --firmware=efi64 --tpm-type=none --chipset=piix3 --ioapic=on \
    --x86-long-mode=on --graphicscontroller=vmsvga --vram=32 \
    --accelerate-3d=off --boot1=dvd --boot2=disk --boot3=none --boot4=none \
    --nic1=nat --nic-type1=virtio --cable-connected1=off \
    --nat-dns-host-resolver1=on --audio-enabled=off --clipboard-mode=disabled \
    --drag-and-drop=disabled --usb-ohci=off --usb-ehci=off --usb-xhci=off \
    --mouse=ps2 --keyboard=ps2 --uart1 0x3f8 4 --uart-type1 16550A \
    --uart-mode1 file "$SERIAL"
vbox createmedium disk --filename="$DISK" --size="$DISK_SIZE_MIB" \
    --format=VDI --variant=Standard
DISK_REGISTERED=yes
vbox storagectl "$VM_UUID" --name=SATA --add=sata --controller=IntelAhci \
    --portcount=2 --bootable=on
vbox storageattach "$VM_UUID" --storagectl=SATA --port=0 --device=0 \
    --type=hdd --medium="$DISK" --mtype=normal
vbox storageattach "$VM_UUID" --storagectl=SATA --port=1 --device=0 \
    --type=dvddrive --medium="$ISO" --mtype=readonly
vm_info > "$RUN_DIR/evidence/initial-vm-info.txt"
grep -Fq 'nic1="nat"' "$RUN_DIR/evidence/initial-vm-info.txt" ||
    fail "VirtualBox não confirmou a NIC NAT"
grep -Fq 'nictype1="virtio"' "$RUN_DIR/evidence/initial-vm-info.txt" ||
    fail "VirtualBox não confirmou a NIC VirtIO"
grep -Fq 'cableconnected1="off"' "$RUN_DIR/evidence/initial-vm-info.txt" ||
    fail "VirtualBox não confirmou o cabo desconectado durante a instalação"

wait_for_log() {
    needle=$1
    wanted=$2
    timeout_seconds=$3
    deadline=$(($(date +%s) + timeout_seconds))
    while :; do
        count=0
        if [ -f "$SERIAL" ]; then
            count=$(grep -F -c -- "$needle" "$SERIAL" 2>/dev/null || true)
        fi
        [ "$count" -ge "$wanted" ] && return 0
        state=$(vm_state 2>/dev/null || true)
        case "$state" in running|starting) ;; *) fail "VM ficou em estado $state esperando: $needle" ;; esac
        [ "$(date +%s)" -lt "$deadline" ] ||
            fail "timeout esperando no serial: $needle"
        sleep 1
    done
}

wait_for_log_or_fail() {
    success_needle=$1
    failure_needle=$2
    timeout_seconds=$3
    deadline=$(($(date +%s) + timeout_seconds))
    while :; do
        if [ -f "$SERIAL" ]; then
            grep -Fq -- "$failure_needle" "$SERIAL" 2>/dev/null &&
                fail "guest reportou falha: $failure_needle"
            grep -Fq -- "$success_needle" "$SERIAL" 2>/dev/null && return 0
        fi
        state=$(vm_state 2>/dev/null || true)
        case "$state" in running|starting) ;; *) fail "VM ficou em estado $state esperando: $success_needle" ;; esac
        [ "$(date +%s)" -lt "$deadline" ] ||
            fail "timeout esperando no serial: $success_needle"
        sleep 1
    done
}

wait_for_state() {
    wanted_state=$1
    timeout_seconds=$2
    deadline=$(($(date +%s) + timeout_seconds))
    while :; do
        state=$(vm_state 2>/dev/null || true)
        [ "$state" = "$wanted_state" ] && return 0
        [ "$(date +%s)" -lt "$deadline" ] ||
            fail "timeout esperando estado $wanted_state (atual: $state)"
        sleep 1
    done
}

screenshot() {
    shot_label=$1
    SCREEN_INDEX=$((SCREEN_INDEX + 1))
    number=$(printf '%02d' "$SCREEN_INDEX")
    png=$RUN_DIR/evidence/$number-$shot_label.png
    vbox controlvm "$VM_UUID" screenshotpng "$png" 0
    SCREEN_TEXT=${png%.png}.txt
    tesseract "$png" "${png%.png}" >>"$VBOX_LOG" 2>&1 ||
        fail "OCR falhou para $png"
}

require_screen_text() {
    screen_needle=$1
    screen_label=$2
    screen_timeout=$3
    screen_deadline=$(($(date +%s) + screen_timeout))
    screen_attempt=0
    while :; do
        screen_attempt=$((screen_attempt + 1))
        screenshot "$screen_label-$screen_attempt"
        if grep -Fiq -- "$screen_needle" "$SCREEN_TEXT"; then
            return 0
        fi
        state=$(vm_state 2>/dev/null || true)
        case "$state" in running) ;; *) fail "VM ficou em estado $state esperando texto gráfico: $screen_needle" ;; esac
        [ "$(date +%s)" -lt "$screen_deadline" ] ||
            fail "OCR não encontrou no framebuffer: $screen_needle"
        sleep 1
    done
}

type_text() {
    "$VBOX" controlvm "$VM_UUID" keyboardputstring "$1" >/dev/null 2>>"$VBOX_LOG"
}

press_enter() {
    "$VBOX" controlvm "$VM_UUID" keyboardputscancode 1c 9c >/dev/null 2>>"$VBOX_LOG"
}

guest_command_and_wait() {
    guest_line=$1
    guest_token=$2
    guest_timeout=$3
    type_text "$guest_line"
    press_enter
    wait_for_log "$guest_token" 1 "$guest_timeout"
}

guest_command_and_wait_or_fail() {
    guest_line=$1
    guest_success_token=$2
    guest_failure_token=$3
    guest_timeout=$4
    type_text "$guest_line"
    press_enter
    wait_for_log_or_fail "$guest_success_token" "$guest_failure_token" "$guest_timeout"
}

echo "accept-virtualbox: fase 2/5: exercitando prompts gráficos offline"
vbox startvm "$VM_UUID" --type=headless
wait_for_log 'distropica-live: solicitando senha de root no console gráfico' 1 "$PREPARE_TIMEOUT"
sleep 2
require_screen_text 'Nova senha de root' nova-senha 30
type_text "$ephemeral_password"
press_enter
sleep 2
require_screen_text 'Repita a sen' repetir-senha 30
type_text "$ephemeral_password"
press_enter
wait_for_log 'distropica-live: senha de root configurada' 1 60
wait_for_log 'distropica-live: payload e closure validados; nenhum disco foi alterado' 1 60
sleep 2
require_screen_text 'dispositivo inteiro a APAGAR' autorizar-disco 30

# O payload e o EFI já estão em /run. Remover a mídia antes do wipe faz do
# reboot emitido pelo próprio instalador uma prova de boot sem CD-ROM.
vbox storageattach "$VM_UUID" --storagectl=SATA --port=1 --device=0 \
    --type=dvddrive --medium=emptydrive --forceunmount
vm_info > "$RUN_DIR/evidence/after-eject-vm-info.txt"
grep -Fq '"SATA-1-0"="emptydrive"' "$RUN_DIR/evidence/after-eject-vm-info.txt" ||
    fail "VirtualBox não confirmou a ejeção da ISO"
type_text /dev/sda
press_enter
wait_for_log 'distropica-live: APAGANDO /dev/sda:' 1 120

echo "accept-virtualbox: fase 3/5: reboot real pelo VDI sem ISO e sem link"
wait_for_log 'distropica-live: INSTALLATION COMPLETE em /dev/sda; reiniciando' 1 "$INSTALL_TIMEOUT"
wait_for_log 'distropica-live: kernel vivo iniciado' 2 "$BOOT_TIMEOUT"
wait_for_log 'distropica-live: raiz instalada encontrada em /dev/sda2' 1 "$BOOT_TIMEOUT"
wait_for_log 'distropica login:' 1 "$BOOT_TIMEOUT"
sleep 3
require_screen_text 'distropica login' login-sem-iso 30

echo "accept-virtualbox: fase 4/5: login root offline e prova pelo UART"
type_text root
press_enter
sleep 2
type_text "$ephemeral_password"
press_enter
sleep 3
type_text 'echo VBOX_ROOT_UID_$(id -u) >/dev/ttyS0'
press_enter
wait_for_log 'VBOX_ROOT_UID_0' 1 30

# O target oficial já traz ripgrep. A primeira sessão do sistema instalado,
# ainda sem link, deve encontrá-lo registrado, explícito no world e executável.
guest_command_and_wait_or_fail \
    'if command -v rg >/dev/null 2>&1 && [ -d /var/lib/minitrue/records/ripgrep ] && grep -Fqx ripgrep /etc/minitrue/world 2>/dev/null && rg --version >/tmp/vbox-rg-version 2>&1 && grep -Eq "^ripgrep 15[.]2[.]0([[:space:]]|$)" /tmp/vbox-rg-version; then cat /tmp/vbox-rg-version >/dev/ttyS0; echo VBOX_RIPGREP_DEFAULT_PRESENT_OK >/dev/ttyS0; else echo VBOX_RIPGREP_DEFAULT_PRESENT_FAILED >/dev/ttyS0; fi' \
    'VBOX_RIPGREP_DEFAULT_PRESENT_OK' 'VBOX_RIPGREP_DEFAULT_PRESENT_FAILED' 30

# Zig é cache/toolchain de build, e GNU Make é a próxima intenção explícita.
# Nenhum dos dois pode ter vazado para a instalação mínima antes da prova.
guest_command_and_wait_or_fail \
    'if command -v zig >/dev/null 2>&1 || [ -e /usr/bin/zig ] || [ -L /usr/bin/zig ] || [ -e /opt/zig/current ] || [ -L /opt/zig/current ] || [ -e /var/lib/minitrue/records/zig ] || grep -Fqx zig /etc/minitrue/world 2>/dev/null; then echo VBOX_ZIG_INITIAL_UNEXPECTED >/dev/ttyS0; else echo VBOX_ZIG_INITIAL_ABSENT_OK >/dev/ttyS0; fi' \
    'VBOX_ZIG_INITIAL_ABSENT_OK' 'VBOX_ZIG_INITIAL_UNEXPECTED' 30
guest_command_and_wait_or_fail \
    'if command -v make >/dev/null 2>&1 || [ -e /usr/bin/make ] || [ -L /usr/bin/make ] || [ -e /var/lib/minitrue/records/make ] || grep -Fqx make /etc/minitrue/world 2>/dev/null; then echo VBOX_MAKE_INITIAL_UNEXPECTED >/dev/ttyS0; else echo VBOX_MAKE_INITIAL_ABSENT_OK >/dev/ttyS0; fi' \
    'VBOX_MAKE_INITIAL_ABSENT_OK' 'VBOX_MAKE_INITIAL_UNEXPECTED' 30

type_text 'clear; echo VBOX_ROOT_SCREEN_OK; id; cat /etc/os-release; rg --version; findfs LABEL=DISTROPICA_ROOT'
press_enter
sleep 3
require_screen_text 'ROOT_SCREEN_OK' root-shell 30
type_text 'sync; echo VBOX_SYNC_OK >/dev/ttyS0'
press_enter
wait_for_log 'VBOX_SYNC_OK' 1 30

vm_info > "$RUN_DIR/evidence/offline-running-passed-vm-info.txt"
grep -Fq 'cableconnected1="off"' \
    "$RUN_DIR/evidence/offline-running-passed-vm-info.txt" ||
    fail "o cabo virtual foi conectado antes de terminar o aceite offline"
type_text 'sync; echo VBOX_OFFLINE_POWEROFF_OK >/dev/ttyS0; /bin/busybox poweroff -f'
press_enter
wait_for_log 'VBOX_OFFLINE_POWEROFF_OK' 1 30
wait_for_state poweroff 60
vm_info > "$RUN_DIR/evidence/offline-powered-off-vm-info.txt"

echo "accept-virtualbox: fase 5/5: rede, build-fonte offline e verify"
vbox modifyvm "$VM_UUID" --cable-connected1=on \
    --uart-mode1 file "$ONLINE_SERIAL"
SERIAL=$ONLINE_SERIAL
vm_info > "$RUN_DIR/evidence/after-cable-connected-vm-info.txt"
grep -Fq 'nic1="nat"' "$RUN_DIR/evidence/after-cable-connected-vm-info.txt" ||
    fail "VirtualBox perdeu a NIC NAT antes do terceiro boot"
grep -Fq 'nictype1="virtio"' "$RUN_DIR/evidence/after-cable-connected-vm-info.txt" ||
    fail "VirtualBox perdeu a NIC VirtIO antes do terceiro boot"
grep -Fq 'cableconnected1="on"' "$RUN_DIR/evidence/after-cable-connected-vm-info.txt" ||
    fail "VirtualBox não confirmou o cabo conectado no terceiro boot"
grep -Fq '"SATA-1-0"="emptydrive"' \
    "$RUN_DIR/evidence/after-cable-connected-vm-info.txt" ||
    fail "a ISO reapareceu antes do terceiro boot"

vbox startvm "$VM_UUID" --type=headless
wait_for_log 'distropica-live: kernel vivo iniciado' 1 "$BOOT_TIMEOUT"
wait_for_log 'distropica-live: raiz instalada encontrada em /dev/sda2' 1 "$BOOT_TIMEOUT"
wait_for_log 'distropica login:' 1 "$BOOT_TIMEOUT"
sleep 3
require_screen_text 'distropica login' terceiro-boot-login 30

type_text root
press_enter
sleep 2
type_text "$ephemeral_password"
press_enter
sleep 3
guest_command_and_wait \
    'echo VBOX_THIRD_BOOT_ROOT_UID_$(id -u) >/dev/ttyS0' \
    'VBOX_THIRD_BOOT_ROOT_UID_0' 30

# A base 0.2 deve executar udhcpc no rcS e materializar rota e resolv.conf.
# O runner não chama udhcpc: observar esses fatos depois do getty prova a
# política de boot instalada, não uma configuração feita pelo próprio teste.
type_text "network_timeout=$NETWORK_TIMEOUT"
press_enter
guest_command_and_wait \
    'network_attempt=0; while [ "$network_attempt" -lt "$network_timeout" ]; do network_route=$(ip -4 route show default 2>/dev/null | head -n 1); network_gateway=$(printf "%s\n" "$network_route" | sed -n "s/^default via \([^ ]*\) .*/\1/p"); network_iface=$(printf "%s\n" "$network_route" | sed -n "s/^default.* dev \([^ ]*\).*/\1/p"); network_address=$([ -n "$network_iface" ] && ip -4 addr show dev "$network_iface" 2>/dev/null | sed -n "s/.*inet \([0-9.]*\/[0-9]*\).*/\1/p" | head -n 1 || true); [ -n "$network_gateway" ] && [ -n "$network_iface" ] && [ -n "$network_address" ] && break; network_attempt=$((network_attempt + 1)); sleep 1; done; case "$network_address" in */*) ;; *) false ;; esac && case "$network_gateway" in *.*.*.*) ;; *) false ;; esac && printf "VBOX_DHCP_IPV4_OK iface=%s address=%s\n" "$network_iface" "$network_address" >/dev/ttyS0 && printf "VBOX_DEFAULT_ROUTE_OK gateway=%s\n" "$network_gateway" >/dev/ttyS0' \
    'VBOX_DHCP_IPV4_OK' "$((NETWORK_TIMEOUT + 15))"
wait_for_log 'VBOX_DEFAULT_ROUTE_OK' 1 15

guest_command_and_wait \
    'network_dns=$(sed -n "s/^nameserver[[:space:]][[:space:]]*\([0-9.]*\).*$/\1/p" /etc/resolv.conf 2>/dev/null | head -n 1); case "$network_dns" in *.*.*.*) ;; *) false ;; esac && printf "VBOX_RESOLV_CONF_OK nameserver=%s\n" "$network_dns" >/dev/ttyS0 && nslookup localhost "$network_dns" >/tmp/vbox-nslookup 2>&1 && grep -Eq "Address.*127\\.0\\.0\\.1|^127\\.0\\.0\\.1" /tmp/vbox-nslookup && echo VBOX_DNS_LOCALHOST_OK >/dev/ttyS0' \
    'VBOX_RESOLV_CONF_OK' "$NETWORK_TIMEOUT"
wait_for_log 'VBOX_DNS_LOCALHOST_OK' 1 "$NETWORK_TIMEOUT"

guest_command_and_wait \
    'ping -c 1 -W 5 "$network_gateway" >/dev/ttyS0 2>&1 && echo VBOX_NAT_GATEWAY_PING_OK >/dev/ttyS0' \
    'VBOX_NAT_GATEWAY_PING_OK' 30

# A conectividade serviu somente para aceitar DHCP/DNS da base. O build deve
# ocorrer sem sequer haver link: --offline precisa consumir o tar do Make, o
# Zig e sua assinatura já trazidos pelo cache da ISO, sem tentar a Internet.
vbox controlvm "$VM_UUID" setlinkstate1 off
sleep 1
vm_info > "$RUN_DIR/evidence/before-offline-source-build-vm-info.txt"
grep -Fq 'cableconnected1="off"' \
    "$RUN_DIR/evidence/before-offline-source-build-vm-info.txt" ||
    fail "VirtualBox não confirmou o cabo desconectado antes do build offline"

guest_command_and_wait_or_fail \
    'if /usr/bin/minitrue --offline --no-binary rectify make >/dev/ttyS0 2>&1; then if command -v make >/dev/null 2>&1 && command -v zig >/dev/null 2>&1 && [ -d /var/lib/minitrue/records/make ] && [ -d /var/lib/minitrue/records/zig ] && grep -Fqx VERSION=4.4.1 /var/lib/minitrue/records/make/meta && grep -Fqx ORIGIN=fonte /var/lib/minitrue/records/make/meta && grep -Fqx VERSION=0.16.0 /var/lib/minitrue/records/zig/meta && grep -Fqx ORIGIN=vendor /var/lib/minitrue/records/zig/meta; then echo VBOX_MAKE_SOURCE_OFFLINE_RECTIFY_OK >/dev/ttyS0; else echo VBOX_MAKE_SOURCE_OFFLINE_RECTIFY_FAILED_STATE >/dev/ttyS0; fi; else rectify_status=$?; printf "VBOX_MAKE_SOURCE_OFFLINE_RECTIFY_FAILED status=%s\n" "$rectify_status" >/dev/ttyS0; fi' \
    'VBOX_MAKE_SOURCE_OFFLINE_RECTIFY_OK' \
    'VBOX_MAKE_SOURCE_OFFLINE_RECTIFY_FAILED' "$SOURCE_BUILD_TIMEOUT"
guest_command_and_wait_or_fail \
    'if grep -Fqx make /etc/minitrue/world 2>/dev/null && ! grep -Fqx zig /etc/minitrue/world 2>/dev/null; then echo VBOX_BUILD_DEP_WORLD_POLICY_OK >/dev/ttyS0; else echo VBOX_BUILD_DEP_WORLD_POLICY_FAILED >/dev/ttyS0; fi' \
    'VBOX_BUILD_DEP_WORLD_POLICY_OK' 'VBOX_BUILD_DEP_WORLD_POLICY_FAILED' 30
guest_command_and_wait_or_fail \
    'if make --version >/tmp/vbox-make-version 2>&1 && grep -Eq "^GNU Make 4[.]4[.]1([[:space:]]|$)" /tmp/vbox-make-version; then cat /tmp/vbox-make-version >/dev/ttyS0; echo VBOX_MAKE_VERSION_OK >/dev/ttyS0; else echo VBOX_MAKE_VERSION_FAILED >/dev/ttyS0; fi' \
    'VBOX_MAKE_VERSION_OK' 'VBOX_MAKE_VERSION_FAILED' 30
guest_command_and_wait_or_fail \
    'if zig version >/tmp/vbox-zig-version 2>&1 && grep -Fqx "0.16.0" /tmp/vbox-zig-version; then cat /tmp/vbox-zig-version >/dev/ttyS0; echo VBOX_ZIG_VERSION_OK >/dev/ttyS0; else echo VBOX_ZIG_VERSION_FAILED >/dev/ttyS0; fi' \
    'VBOX_ZIG_VERSION_OK' 'VBOX_ZIG_VERSION_FAILED' 30
guest_command_and_wait_or_fail \
    'if /usr/bin/minitrue verify >/dev/ttyS0 2>&1; then echo VBOX_POST_SOURCE_BUILD_MINITRUE_VERIFY_OK >/dev/ttyS0; echo VBOX_MINITRUE_VERIFY_OK >/dev/ttyS0; else echo VBOX_POST_SOURCE_BUILD_MINITRUE_VERIFY_FAILED >/dev/ttyS0; fi' \
    'VBOX_POST_SOURCE_BUILD_MINITRUE_VERIFY_OK' \
    'VBOX_POST_SOURCE_BUILD_MINITRUE_VERIFY_FAILED' "$VERIFY_TIMEOUT"

type_text 'clear; id; rg --version | head -n 1; make --version | head -n 1; zig version; ip -4 addr; ip -4 route; cat /etc/resolv.conf; echo VBOX_THIRD_BOOT_SCREEN_OK'
press_enter
sleep 3
require_screen_text 'THIRD_BOOT_SCREEN_OK' terceiro-boot-root 30
vm_info > "$RUN_DIR/evidence/running-passed-vm-info.txt"
type_text 'sync; echo VBOX_THIRD_BOOT_SYNC_OK >/dev/ttyS0; /bin/busybox poweroff -f'
press_enter
wait_for_log 'VBOX_THIRD_BOOT_SYNC_OK' 1 30
wait_for_state poweroff 60
vm_info > "$RUN_DIR/evidence/powered-off-vm-info.txt"
vbox storageattach "$VM_UUID" --storagectl=SATA --port=0 --device=0 \
    --type=hdd --medium=none
vbox unregistervm "$VM_UUID"
VM_CREATED=no
vbox closemedium disk "$DISK"
DISK_REGISTERED=no
disk_sha=$(sha256sum "$DISK" | awk '{print $1}')
printf '%s\n' \
    'RUN_STATE=passed' \
    'ISO_EJECTED_BEFORE_WIPE=yes' \
    'INSTALL_AND_SECOND_BOOT_OFFLINE=yes' \
    'SECOND_BOOT_WITHOUT_ISO=yes' \
    'ROOT_LOGIN=yes' \
    'THIRD_BOOT_WITH_NAT=yes' \
    'THIRD_BOOT_GETTY=yes' \
    'THIRD_BOOT_ROOT_LOGIN=yes' \
    'DHCP_IPV4=yes' \
    'DEFAULT_ROUTE=yes' \
    'RESOLV_CONF_IPV4_NAMESERVER=yes' \
    'DNS_LOCALHOST=yes' \
    'NAT_GATEWAY_PING=yes' \
    'RIPGREP_DEFAULT_PRESENT=yes' \
    'RIPGREP_VERSION=15.2.0' \
    'ZIG_INITIAL_ABSENT=yes' \
    'MAKE_INITIAL_ABSENT=yes' \
    'NETWORK_DISCONNECTED_BEFORE_OFFLINE_SOURCE_BUILD=yes' \
    'MAKE_SOURCE_OFFLINE_RECTIFY=yes' \
    'MAKE_VERSION=4.4.1' \
    'ZIG_AUTO_INSTALLED_FOR_SOURCE_BUILD=yes' \
    'ZIG_VERSION=0.16.0' \
    'MAKE_EXPLICIT_IN_WORLD=yes' \
    'ZIG_NOT_EXPLICIT_IN_WORLD=yes' \
    'MINITRUE_VERIFY_AFTER_SOURCE_BUILD=yes' \
    'MINITRUE_VERIFY=yes' \
    "DISK_SHA256=$disk_sha" >> "$META"
(
    cd "$RUN_DIR/evidence"
    for artifact in *.png *.txt console*.serial; do
        [ -f "$artifact" ] || continue
        sha256sum "$artifact"
    done
) > "$RUN_DIR/evidence/SHA256SUMS"

echo "accept-virtualbox: PASS"
echo "evidência: $RUN_DIR/evidence"
