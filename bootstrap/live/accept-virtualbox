    'ipv6_iface=${network_iface:-eth0}; ping6 -c 1 -W 5 ::1 >/dev/null 2>&1 && echo VBOX_IPV6_LOOPBACK_OK >/dev/ttyS0; ipv6_ll=$(ip -6 addr show dev "$ipv6_iface" 2>/dev/null | sed -n "s#.*inet6 \(fe80[0-9a-f:]*\)/.*#\1#p" | head -n 1); [ -n "$ipv6_ll" ] && printf "VBOX_IPV6_LINK_LOCAL_OK iface=%s address=%s\n" "$ipv6_iface" "$ipv6_ll" >/dev/ttyS0; ipv6_global=$(ip -6 addr show dev "$ipv6_iface" 2>/dev/null | sed -n "s#.*inet6 \([^ /]*\)/.*#\1#p" | grep -v "^fe80" | head -n 1); if [ -n "$ipv6_global" ]; then printf "VBOX_IPV6_GLOBAL_PRESENT address=%s\n" "$ipv6_global" >/dev/ttyS0; else echo VBOX_IPV6_GLOBAL_ABSENT >/dev/ttyS0; fi; if grep -Eq "^nameserver[[:space:]]+[0-9a-fA-F]*:" /etc/resolv.conf 2>/dev/null; then echo VBOX_IPV6_NAMESERVER_PRESENT >/dev/ttyS0; else echo VBOX_IPV6_NAMESERVER_ABSENT >/dev/ttyS0; fi; echo VBOX_IPV6_PROBE_DONE >/dev/ttyS0' \
