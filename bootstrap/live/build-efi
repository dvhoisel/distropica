mkdir -p "$INITROOT/usr/share/distropica"
cp "$LIVE_COMPONENTS" "$INITROOT/usr/share/distropica/LIVE_COMPONENTS"
chmod 0644 "$INITROOT/usr/share/distropica/LIVE_COMPONENTS"

# A cópia exata que o kernel incorporará só é materializada depois do
# manifesto. O mtime inteiro do CPIO volta ao epoch como antes.
cp -a "$INITROOT" "$SOURCE/distropica-initramfs"
printf '%s\n' \
    'nod /dev/console 0600 0 0 c 5 1' \
    'nod /dev/null 0666 0 0 c 1 3' \
    > "$SOURCE/distropica-devices.list"
find "$SOURCE/distropica-initramfs" -exec touch -h -d "@$EPOCH" {} +
touch -d "@$EPOCH" "$SOURCE/distropica-devices.list"

# O kernel passa este texto a usr/gen_initramfs.sh, que o reconverte com
# `date -d` para fixar o mtime do CPIO. Dentro do rootfs, date e o BusyBox: ele
# aceita a forma ISO abaixo, mas nao a forma longa "Mon Jan ... UTC ...". Se a
# conversao falha, o script upstream a silencia e gen_init_cpio usa time(NULL),
# fazendo o bzImage variar a cada composicao.
BUILD_TIMESTAMP=$(date -u -d "@$EPOCH" '+%Y-%m-%d %H:%M:%S')
if [ -n "$ROOTFS" ]; then
    PARSED_BUILD_EPOCH=$(bwrap --ro-bind "$ROOTFS" / \
        --bind "$WORK" "$WORK_INNER" --proc /proc --dev /dev \
        --unshare-pid --die-with-parent --clearenv \
        --setenv PATH /usr/bin:/bin --setenv LC_ALL C --setenv TZ UTC \
        date -d "$BUILD_TIMESTAMP" +%s 2>/dev/null) || {
        echo "erro: date do rootfs nao parseia KBUILD_BUILD_TIMESTAMP" >&2
        exit 1
    }
else
    PARSED_BUILD_EPOCH=$(TZ=UTC date -d "$BUILD_TIMESTAMP" +%s 2>/dev/null) || {
        echo "erro: date do builder nao parseia KBUILD_BUILD_TIMESTAMP" >&2
        exit 1
    }
fi
[ "$PARSED_BUILD_EPOCH" = "$EPOCH" ] || {
    echo "erro: KBUILD_BUILD_TIMESTAMP nao volta ao SOURCE_DATE_EPOCH" >&2
    exit 1
}
# O -fdebug-prefix-map precisa usar o caminho que o COMPILADOR enxerga: com
# --rootfs ele compila dentro do bwrap e vê o caminho interno, não o do
# hospedeiro. Mapear o caminho errado deixaria o de verdade embutido no
# binário — e o caminho do workspace do mantenedor é justamente o que a
# reprodutibilidade não pode depender.
MAP_SOURCE=$SOURCE
if [ -n "$ROOTFS" ]; then MAP_SOURCE=$SOURCE_INNER; fi
kmake -j"$JOBS" \
    SOURCE_DATE_EPOCH="$EPOCH" \
    KBUILD_BUILD_TIMESTAMP="$BUILD_TIMESTAMP" \
    KBUILD_BUILD_USER=distropica KBUILD_BUILD_HOST=builder \
    KBUILD_BUILD_VERSION=1 \
    KCFLAGS="-ffile-prefix-map=$MAP_SOURCE=/usr/src/linux -fdebug-prefix-map=$MAP_SOURCE=/usr/src/linux -fmacro-prefix-map=$MAP_SOURCE=/usr/src/linux" \
    HOSTCFLAGS="-ffile-prefix-map=$MAP_SOURCE=/usr/src/linux -fdebug-prefix-map=$MAP_SOURCE=/usr/src/linux -fmacro-prefix-map=$MAP_SOURCE=/usr/src/linux" bzImage

BUILT=$SOURCE/arch/x86/boot/bzImage
file "$BUILT" | grep -q 'Linux kernel x86 boot executable' || {
    echo "erro: saída do kernel inválida" >&2; exit 1;
