# fica de fora: o do BusyBox já cobre o pouco que se faz sem GPT, e cada
# megabyte no initramfs é carregado pelo firmware a cada boot.
cp "$UTIL_LINUX_SRC/cfdisk" "$INITROOT/bin/cfdisk"
cp "$UTIL_LINUX_SRC/sfdisk" "$INITROOT/bin/sfdisk"
# mke2fs lê os perfis de recurso daqui; sem o arquivo ele cai em defaults
