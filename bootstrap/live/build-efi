    exit 1
}

release_regular() { # caminho hash-esperado rótulo
    release_path=$1
    release_expected=$2
    release_label=$3
    is_sha256 "$release_expected" || {
        echo "erro: sha256 esperado inválido para $release_label" >&2; exit 1;
    }
    if [ "$MODE" = release ] && [ -n "$LIVE_LOCK_TOOL" ] &&
       [ "$release_path" != "$LIVE_LOCK_TOOL" ]; then
        release_actual=$("$LIVE_LOCK_TOOL" \
            --self-sha256 "$LIVE_HELPER_BIN_SHA256" sha256 "$release_path") || {
            echo "erro: helper recusou $release_label" >&2; exit 1;
        }
        [ "$release_actual" = "$release_expected" ] || {
            echo "erro: sha256 divergente em $release_label" >&2
            echo "esperado: $release_expected" >&2
            echo "obtido:  $release_actual" >&2
            exit 1
        }
        return 0
    fi
    release_logical=$(realpath -s -- "$release_path" 2>/dev/null) || {
        echo "erro: $release_label não tem caminho canônico" >&2; exit 1;
    }
    release_physical=$(realpath -e -- "$release_path" 2>/dev/null) || {
        echo "erro: $release_label ausente" >&2; exit 1;
    }
    [ "$release_logical" = "$release_physical" ] || {
        echo "erro: $release_label atravessa symlink" >&2; exit 1;
    }
    [ -f "$release_physical" ] && [ ! -L "$release_physical" ] || {
        echo "erro: $release_label não é arquivo regular/no-follow" >&2; exit 1;
    }
    release_trusted_parent "$release_physical" || {
        echo "erro: pai de $release_label não é real/privado/do euid" >&2; exit 1;
    }
    [ "$(stat -c '%h' -- "$release_physical")" -eq 1 ] || {
        echo "erro: $release_label tem hardlinks" >&2; exit 1;
    }
    [ "$(stat -c '%u' -- "$release_physical")" = "$(id -u)" ] || {
        echo "erro: $release_label não pertence ao euid" >&2; exit 1;
    }
    release_mode=$(stat -c '%a' -- "$release_physical")
    release_mode=$(printf '%s\n' "$release_mode" | sed 's/.*\(...\)$/\1/')
    release_group=$(printf '%s' "$release_mode" | cut -c2)
    release_other=$(printf '%s' "$release_mode" | cut -c3)
    case "$release_group$release_other" in *2*|*3*|*6*|*7*)
        echo "erro: $release_label permite escrita a grupo/outros" >&2; exit 1 ;;
    esac
    release_before=$(stat -c '%F|%d|%i|%h|%s|%Y|%u|%a' -- "$release_physical")
    release_actual=$(sha256sum -- "$release_physical" | awk '{print $1}')
    release_after=$(stat -c '%F|%d|%i|%h|%s|%Y|%u|%a' -- "$release_physical")
    [ "$release_before" = "$release_after" ] || {
        echo "erro: $release_label mudou durante a leitura" >&2; exit 1;
    }
    [ "$release_actual" = "$release_expected" ] || {
        echo "erro: sha256 divergente em $release_label" >&2
        echo "esperado: $release_expected" >&2
        echo "obtido:  $release_actual" >&2
        exit 1
    }
}

# Release tem fronteira fechada: não existe descoberta pelo PATH nem build de
# executores Rust durante esta invocação. Os hashes esperados são parâmetros
# separados dos caminhos e entram, factualmente, no LIVE_COMPONENTS.
if [ "$MODE" = release ]; then
    [ "$EPOCH_WAS_EXPLICIT" = yes ] || {
        echo "erro: release exige --source-date-epoch explícito" >&2; exit 1;
    }
    [ "$WORK_WAS_EXPLICIT" = yes ] || {
        echo "erro: release exige --work explícito, novo e irmão externo do rootfs" >&2; exit 1;
    }
    if [ "$RELEASE_INNER" = no ]; then
        [ "$ROOTFS_WAS_EXPLICIT" = yes ] || {
            echo "erro: release exige --rootfs explícito" >&2; exit 1;
        }
        [ -n "$RUNNER_PATH" ] && [ -n "$RUNNER_SHA256" ] || {
            echo "erro: release exige --runner/--runner-sha256" >&2; exit 1;
        }
    else
        [ -n "$LIVE_HELPER_BIN" ] && [ -n "$LIVE_HELPER_BIN_SHA256" ] || {
            echo "erro: release inner exige helper medido+caminho+pin" >&2; exit 1;
        }
        [ -n "$WORK_REQUEST_SHA256" ] && [ -n "$WORK_MARKER_SHA256" ] || {
            echo "erro: release inner exige request+marcador pinados do WORK" >&2
            exit 1
        }
    fi
    [ -z "$BUSYBOX" ] || {
        echo "erro: release recusa --busybox prebuilt; forneça --busybox-tar" >&2; exit 1;
    }
    if [ -n "${E2FS_CC:-}" ] || [ -n "${CC_x86_64_unknown_linux_musl:-}" ] ||
       [ -n "${TARGET_CC:-}" ] || [ -n "${CC:-}" ] ||
       [ -n "${CROSS_COMPILE:-}" ] || [ -n "${ZIG:-}" ]; then
        echo "erro: release recusa CC/ZIG/sysroot implícito do ambiente" >&2
        echo "use --zig-tar e os pins --zig-sha256/--musl-tree-sha256" >&2
        exit 1
    fi
    for explicit_marker in LINUX_TAR_WAS_EXPLICIT BUSYBOX_TAR_WAS_EXPLICIT \
        E2FSPROGS_TAR_WAS_EXPLICIT NCURSES_TAR_WAS_EXPLICIT \
        UTIL_LINUX_TAR_WAS_EXPLICIT MINIPAX_WAS_EXPLICIT \
        MINITRUE_WAS_EXPLICIT; do
        eval "explicit_value=\${$explicit_marker}"
        [ "$explicit_value" = yes ] || {
            echo "erro: release exige flag explícita para $explicit_marker" >&2; exit 1;
        }
    done
    for required in LINUX_TAR BUSYBOX_TAR E2FSPROGS_TAR NCURSES_TAR \
        UTIL_LINUX_TAR MINIPAX_BIN MINITRUE_BIN MINIPAX_SHA256 \
        MINITRUE_SHA256 ZIG_TAR ZIG_TAR_EXPECTED ZIG_BIN_SHA256 \
        MUSL_TREE_SHA256 BUILDER_LOCK BUILDER_LOCK_SHA256 BUILDER_ID \
        RUNNER_PROOF RUNNER_PROOF_SHA256 SOURCE_SNAPSHOT \
        SOURCE_SNAPSHOT_SHA256 LICENSE_EVIDENCE \
        LICENSE_EVIDENCE_SHA256; do
        eval "value=\${$required}"
        [ -n "$value" ] || { echo "erro: release exige $required explícito" >&2; exit 1; }
    done
    for pin in "$MINIPAX_SHA256" "$MINITRUE_SHA256" "$ZIG_TAR_EXPECTED" \
        "$ZIG_BIN_SHA256" "$MUSL_TREE_SHA256" "$BUILDER_LOCK_SHA256" \
        "$RUNNER_PROOF_SHA256" "$SOURCE_SNAPSHOT_SHA256" \
        "$LICENSE_EVIDENCE_SHA256" "$LIVE_HELPER_BIN_SHA256" \
        "${WORK_REQUEST_SHA256:-$EMPTY_SHA256}" \
        "${WORK_MARKER_SHA256:-$EMPTY_SHA256}" \
        "${RUNNER_SHA256:-$EMPTY_SHA256}"; do
        is_sha256 "$pin" || { echo "erro: pin sha256 inválido no modo release" >&2; exit 1; }
    done
fi

