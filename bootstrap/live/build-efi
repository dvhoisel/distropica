#!/bin/sh
# Compõe um bzImage EFI-stub com initramfs vivo incorporado.

# Bootstrap externo do release. Esta seção roda antes de qualquer dirname,
# realpath, stat, PATH lookup ou leitura de checkout. A raiz inicial é
# deliberadamente externa: o pipeline autenticou o caminho absoluto do bwrap
# e os hashes passados. O primeiro processo de ferramentas já vive no builder
# ro-bind; depois ele compila o helper estático a partir do snapshot pinado.
live_outer_mode=development
live_outer_inner=no
live_expect_mode=no
for live_arg do
    case "$live_expect_mode" in
        yes) live_outer_mode=$live_arg; live_expect_mode=no; continue ;;
    esac
    case "$live_arg" in
        --mode) live_expect_mode=yes ;;
        --release-inner) live_outer_inner=yes ;;
    esac
done

if [ "$live_outer_mode" = release ] && [ "$live_outer_inner" = no ]; then
    # O prelude usa somente builtins antes da primeira raiz externa, mas ainda
    # precisa propagar toda falha: publish/verify ausentes jamais podem cair
    # até a mensagem de sucesso.
    set -eu
    live_output= live_work= live_rootfs= live_runner= live_runner_sha=
    live_proof= live_proof_sha= live_snapshot= live_snapshot_sha=
    live_linux= live_busybox= live_e2fs= live_ncurses= live_util=
    live_minipax= live_minitrue= live_minipax_sha= live_minitrue_sha=
    live_zig= live_zig_tar_sha= live_zig_sha= live_musl_sha=
    live_builder_lock= live_builder_lock_sha= live_builder_id=
    live_license= live_license_sha= live_helper= live_helper_sha=
    live_epoch= live_jobs=1 live_install=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --mode) shift 2 ;;
            --output) live_output=${2:?}; shift 2 ;;
            --work) live_work=${2:?}; shift 2 ;;
            --rootfs) live_rootfs=${2:?}; shift 2 ;;
            --runner) live_runner=${2:?}; shift 2 ;;
            --runner-sha256) live_runner_sha=${2:?}; shift 2 ;;
            --runner-proof) live_proof=${2:?}; shift 2 ;;
            --runner-proof-sha256) live_proof_sha=${2:?}; shift 2 ;;
            --source-snapshot) live_snapshot=${2:?}; shift 2 ;;
            --source-snapshot-sha256) live_snapshot_sha=${2:?}; shift 2 ;;
            --linux-tar) live_linux=${2:?}; shift 2 ;;
            --busybox-tar) live_busybox=${2:?}; shift 2 ;;
            --e2fsprogs-tar) live_e2fs=${2:?}; shift 2 ;;
            --ncurses-tar) live_ncurses=${2:?}; shift 2 ;;
            --util-linux-tar) live_util=${2:?}; shift 2 ;;
            --minipax) live_minipax=${2:?}; shift 2 ;;
            --minitrue) live_minitrue=${2:?}; shift 2 ;;
            --minipax-sha256) live_minipax_sha=${2:?}; shift 2 ;;
            --minitrue-sha256) live_minitrue_sha=${2:?}; shift 2 ;;
            --zig-tar) live_zig=${2:?}; shift 2 ;;
            --zig-tar-sha256) live_zig_tar_sha=${2:?}; shift 2 ;;
            --zig-sha256) live_zig_sha=${2:?}; shift 2 ;;
            --musl-tree-sha256) live_musl_sha=${2:?}; shift 2 ;;
            --builder-lock) live_builder_lock=${2:?}; shift 2 ;;
            --builder-lock-sha256) live_builder_lock_sha=${2:?}; shift 2 ;;
            --builder-id) live_builder_id=${2:?}; shift 2 ;;
            --license-evidence) live_license=${2:?}; shift 2 ;;
            --license-evidence-sha256) live_license_sha=${2:?}; shift 2 ;;
            --live-lock-helper) live_helper=${2:?}; shift 2 ;;
            --live-lock-helper-sha256) live_helper_sha=${2:?}; shift 2 ;;
            --source-date-epoch) live_epoch=${2:?}; shift 2 ;;
            --jobs) live_jobs=${2:?}; shift 2 ;;
            --install-device) live_install=${2:?}; shift 2 ;;
            --keep-work) shift ;;
            *) printf 'erro: opção release externa desconhecida: %s\n' "$1" >&2; exit 1 ;;
        esac
    done
    for live_required in "$live_output" "$live_work" "$live_rootfs" \
        "$live_runner" "$live_runner_sha" "$live_proof" "$live_proof_sha" \
        "$live_snapshot" "$live_snapshot_sha" "$live_linux" "$live_busybox" \
        "$live_e2fs" "$live_ncurses" "$live_util" "$live_minipax" \
        "$live_minitrue" "$live_minipax_sha" "$live_minitrue_sha" \
        "$live_zig" "$live_zig_tar_sha" "$live_zig_sha" "$live_musl_sha" \
        "$live_builder_lock" "$live_builder_lock_sha" "$live_builder_id" \
        "$live_license" "$live_license_sha" "$live_helper" \
        "$live_helper_sha" "$live_epoch"; do
        case "$live_required" in '') printf '%s\n' 'erro: release exige todos os insumos/pins explícitos' >&2; exit 1 ;; esac
    done
    for live_path in "$live_output" "$live_work" "$live_rootfs" "$live_runner" \
        "$live_proof" "$live_snapshot" "$live_linux" "$live_busybox" \
        "$live_e2fs" "$live_ncurses" "$live_util" "$live_minipax" \
        "$live_minitrue" "$live_zig" "$live_builder_lock" "$live_license" \
        "$live_helper" "$0"; do
        case "$live_path" in /*) ;; *) printf 'erro: release exige caminho absoluto: %s\n' "$live_path" >&2; exit 1 ;; esac
    done
    case "$live_jobs:$live_epoch" in *[!0-9:]*|:*|*:) printf '%s\n' 'erro: jobs/epoch release não canônicos' >&2; exit 1 ;; esac

    # O shell inicial e o caminho absoluto do runner pertencem à âncora
    # externa do pipeline. Antes de executar esse runner, porém, não lhe
    # propagamos PATH, hooks de shell nem knobs do loader do host. Tudo aqui é
    # assignment/export/unset builtin; nenhuma ferramenta do host foi aberta.
    IFS=' '
    PATH=/__distropica_release_no_path__
    HOME=/__distropica_release_no_home__
    TMPDIR=/__distropica_release_no_tmp__
    LC_ALL=C
    LANG=C
    TZ=UTC
    export PATH HOME TMPDIR LC_ALL LANG TZ
    unset CDPATH ENV BASH_ENV LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG \
        LD_PROFILE GLIBC_TUNABLES GCONV_PATH LOCPATH NLSPATH MALLOC_CHECK_ \
        MALLOC_PERTURB_ TAR_OPTIONS GZIP BZIP2 BZIP XZ_DEFAULTS XZ_OPT \
        CONFIG_SITE MAKEFLAGS MFLAGS CFLAGS CPPFLAGS CXXFLAGS LDFLAGS \
        RUSTFLAGS CARGO_ENCODED_RUSTFLAGS PKG_CONFIG_PATH PKG_CONFIG_LIBDIR

    # O pipeline já autenticou helper+caminho+pin. A opção --self-sha256 é
    # somente uma rechecagem pós-exec do inode efetivamente aberto; ela não
    # transforma um helper adversarial em raiz de confiança. Este processo
    # nativo mede o rootfs e todos os inputs antes de qualquer ferramenta dele.
    live_preflight_output=$("$live_helper" --self-sha256 "$live_helper_sha" \
        release-preflight "$live_proof" "$live_proof_sha" \
        "$live_runner" "$live_snapshot" "$live_rootfs" \
        "$live_builder_lock" "$live_license" "$live_license_sha" \
        "$live_output" "$live_work" "$0" "$live_linux" "$live_busybox" \
        "$live_e2fs" "$live_ncurses" "$live_util" "$live_minipax" \
        "$live_minitrue" "$live_zig" "$live_epoch") || {
        printf '%s\n' 'erro: preflight nativo externo do release falhou' >&2
        exit 1
    }
    live_builder_root_sha= live_work_request_sha= live_work_marker_sha=
    live_preflight_lines=0
    while IFS= read -r live_preflight_line; do
        live_preflight_lines=$((live_preflight_lines + 1))
        case "$live_preflight_line" in
            BUILDER_ROOTFS_TREE_SHA256=*)
                [ -z "$live_builder_root_sha" ] || exit 1
                live_builder_root_sha=${live_preflight_line#*=} ;;
            WORK_REQUEST_SHA256=*)
                [ -z "$live_work_request_sha" ] || exit 1
                live_work_request_sha=${live_preflight_line#*=} ;;
            WORK_MARKER_SHA256=*)
                [ -z "$live_work_marker_sha" ] || exit 1
                live_work_marker_sha=${live_preflight_line#*=} ;;
            *) printf '%s\n' 'erro: saída não canônica do preflight' >&2; exit 1 ;;
        esac
    done <<EOF
$live_preflight_output
EOF
    [ "$live_preflight_lines" -eq 3 ] || {
        printf '%s\n' 'erro: preflight não retornou três fatos canônicos' >&2
        exit 1
    }
    for live_preflight_sha in "$live_builder_root_sha" \
        "$live_work_request_sha" "$live_work_marker_sha"; do
        case "$live_preflight_sha" in *[!0-9a-f]*|'')
            printf '%s\n' 'erro: hash não canônico retornado pelo preflight' >&2
            exit 1 ;;
        esac
        [ "${#live_preflight_sha}" -eq 64 ] || {
            printf '%s\n' 'erro: tamanho de hash inválido no preflight' >&2
            exit 1
        }
    done

    # O helper externo criou e persistiu o WORK irmão do rootfs, com marcador
    # ligado a esta request/proof. As duas fases montam esse mesmo inode em
    # /work; a primeira exige inventário pristine, a segunda o revalida.
    if "$live_runner" \
        --ro-bind "$live_rootfs" / \
        --bind "$live_work" /work \
        --ro-bind "$live_rootfs" /run/live/builder-root \
        --ro-bind "$live_runner" /run/live/runner \
        --ro-bind "$live_proof" /run/live/runner-proof \
        --ro-bind "$live_snapshot" /run/live/source.snapshot \
        --ro-bind "$live_zig" /run/live/zig.tar.xz \
        --ro-bind "$live_builder_lock" /run/live/builder.lock \
        --ro-bind "$live_license" /run/live/license-evidence \
        --ro-bind "$live_helper" /run/live/preflight-helper \
        --proc /proc --dev /dev --unshare-pid --unshare-net \
        --die-with-parent --new-session --clearenv \
        --setenv PATH /usr/bin:/bin --setenv HOME /work/home \
        --setenv TMPDIR /work/tmp --setenv LC_ALL C --setenv LANG C \
        --setenv TZ UTC --setenv SOURCE_DATE_EPOCH "$live_epoch" \
        --setenv LIVE_PROOF_SHA "$live_proof_sha" \
        --setenv LIVE_SNAPSHOT_SHA "$live_snapshot_sha" \
        --setenv LIVE_RUNNER_SHA "$live_runner_sha" \
        --setenv LIVE_ZIG_TAR_SHA "$live_zig_tar_sha" \
        --setenv LIVE_ZIG_SHA "$live_zig_sha" \
        --setenv LIVE_HELPER_BINARY_SHA "$live_helper_sha" \
        --setenv LIVE_WORK_REQUEST_SHA "$live_work_request_sha" \
        --setenv LIVE_WORK_MARKER_SHA "$live_work_marker_sha" \
        /run/live/preflight-helper --self-sha256 "$live_helper_sha" \
        release-work-exec /run/live/builder-root "$live_builder_root_sha" \
        /work "$live_work_marker_sha" "$live_work_request_sha" \
        "$live_proof_sha" pristine \
        /bin/sh -eu -c '
            umask 077
            unset TAR_OPTIONS GZIP BZIP2 BZIP XZ_DEFAULTS XZ_OPT CONFIG_SITE MAKEFLAGS MFLAGS
            mkdir -p /work/home /work/tmp /work/inner-output
            printf "%s  %s\n" "$LIVE_PROOF_SHA" /run/live/runner-proof | sha256sum -c - >/dev/null
            printf "%s  %s\n" "$LIVE_SNAPSHOT_SHA" /run/live/source.snapshot | sha256sum -c - >/dev/null
            printf "%s  %s\n" "$LIVE_RUNNER_SHA" /run/live/runner | sha256sum -c - >/dev/null
            printf "%s  %s\n" "$LIVE_ZIG_TAR_SHA" /run/live/zig.tar.xz | sha256sum -c - >/dev/null
            [ ! -e /work/source ] && [ ! -e /work/bootstrap-zig ] && [ ! -e /work/bootstrap-helper ] || {
                echo "erro: WORK release não está vazio para bootstrap" >&2; exit 1;
            }
            tar -tf /run/live/source.snapshot | awk '\''
                /^\// || /(^|\/)\.\.($|\/)/ || /[[:cntrl:]]/ { exit 1 }
                { count++ } END { if (!count) exit 1 }
            '\''
            mkdir /work/source /work/bootstrap-zig
            tar -xf /run/live/source.snapshot -C /work/source --no-same-owner --no-same-permissions
            tar -xJf /run/live/zig.tar.xz -C /work/bootstrap-zig --strip-components=1 --no-same-owner --no-same-permissions
            printf "%s  %s\n" "$LIVE_ZIG_SHA" /work/bootstrap-zig/zig | sha256sum -c - >/dev/null
            proof_field() { awk -F= -v key="$1" '\''$1 == key { print substr($0, length(key)+2) }'\'' /run/live/runner-proof; }
            printf "%s  %s\n" "$(proof_field BUILD_EFI_SOURCE_SHA256)" /work/source/bootstrap/live/build-efi | sha256sum -c - >/dev/null
            printf "%s  %s\n" "$(proof_field LIVE_LOCK_SOURCE_SHA256)" /work/source/bootstrap/live/live-lock | sha256sum -c - >/dev/null
            printf "%s  %s\n" "$(proof_field LIVE_LOCK_HELPER_SOURCE_SHA256)" /work/source/bootstrap/live/live-lock-helper.c | sha256sum -c - >/dev/null
            printf "%s  %s\n" "$(proof_field BUSYBOX_CONFIG_SHA256)" /work/source/bootstrap/live/busybox-1.35.0.config | sha256sum -c - >/dev/null
            /work/bootstrap-zig/zig cc -target x86_64-linux-musl -static -Os -std=c17 \
                -ffile-prefix-map=/work/source=/usr/src/distropica \
                -fdebug-prefix-map=/work/source=/usr/src/distropica \
                -fmacro-prefix-map=/work/source=/usr/src/distropica \
                -o /work/bootstrap-helper /work/source/bootstrap/live/live-lock-helper.c
            chmod 0700 /work/bootstrap-helper
            [ "$(/run/live/preflight-helper --self-sha256 "$LIVE_HELPER_BINARY_SHA" \
                    sha256 /work/bootstrap-helper)" = "$LIVE_HELPER_BINARY_SHA" ] || {
                echo "erro: helper recompilado diverge do pin externo" >&2; exit 1;
            }
            /work/bootstrap-helper --self-sha256 "$LIVE_HELPER_BINARY_SHA" \
                verify-runner /run/live/runner-proof
            if readelf -l /work/bootstrap-helper | grep -q INTERP; then
                echo "erro: helper release não ficou estático" >&2; exit 1
            fi
        '; then :; else
        printf '%s\n' 'erro: bootstrap release dentro do builder falhou' >&2
        exit 1
    fi

    "$live_work/bootstrap-helper" --self-sha256 "$live_helper_sha" \
        work-verify "$live_work" "$live_work_marker_sha" \
        "$live_work_request_sha" "$live_proof_sha" populated
    "$live_work/bootstrap-helper" --self-sha256 "$live_helper_sha" \
        check-output "$live_output"

    # Fase 2: toda a composição reexecuta do snapshot conferido. Somente WORK
    # é persistente/gravável; inputs e rootfs continuam somente leitura.
    if "$live_runner" \
        --ro-bind "$live_rootfs" / --bind "$live_work" /work \
        --ro-bind "$live_rootfs" /run/live/builder-root \
        --ro-bind "$live_runner" /run/live/runner \
        --ro-bind "$live_proof" /run/live/runner-proof \
        --ro-bind "$live_snapshot" /run/live/source.snapshot \
        --ro-bind "$live_linux" /run/live/linux.tar.xz \
        --ro-bind "$live_busybox" /run/live/busybox.tar.bz2 \
        --ro-bind "$live_e2fs" /run/live/e2fsprogs.tar.xz \
        --ro-bind "$live_ncurses" /run/live/ncurses.tar.gz \
        --ro-bind "$live_util" /run/live/util-linux.tar.xz \
        --ro-bind "$live_minipax" /run/live/minipax \
        --ro-bind "$live_minitrue" /run/live/minitrue \
        --ro-bind "$live_zig" /run/live/zig.tar.xz \
        --ro-bind "$live_builder_lock" /run/live/builder.lock \
        --ro-bind "$live_license" /run/live/license-evidence \
        --ro-bind "$live_helper" /run/live/preflight-helper \
        --proc /proc --dev /dev --unshare-pid --unshare-net \
        --die-with-parent --new-session --clearenv \
        --setenv PATH /usr/bin:/bin --setenv HOME /work/home \
        --setenv TMPDIR /work/tmp --setenv LC_ALL C --setenv LANG C \
        --setenv TZ UTC --setenv SOURCE_DATE_EPOCH "$live_epoch" \
        --setenv LIVE_WORK_REQUEST_SHA "$live_work_request_sha" \
        --setenv LIVE_WORK_MARKER_SHA "$live_work_marker_sha" \
        /run/live/preflight-helper --self-sha256 "$live_helper_sha" \
        release-work-exec /run/live/builder-root "$live_builder_root_sha" \
        /work "$live_work_marker_sha" "$live_work_request_sha" \
        "$live_proof_sha" populated \
        /work/source/bootstrap/live/build-efi --mode release --release-inner \
        --output /work/inner-output/BOOTX64.EFI --work /work \
        --work-request-sha256 "$live_work_request_sha" \
        --work-marker-sha256 "$live_work_marker_sha" \
        --linux-tar /run/live/linux.tar.xz --busybox-tar /run/live/busybox.tar.bz2 \
        --e2fsprogs-tar /run/live/e2fsprogs.tar.xz \
        --ncurses-tar /run/live/ncurses.tar.gz \
        --util-linux-tar /run/live/util-linux.tar.xz \
        --minipax /run/live/minipax --minitrue /run/live/minitrue \
        --minipax-sha256 "$live_minipax_sha" --minitrue-sha256 "$live_minitrue_sha" \
        --zig-tar /run/live/zig.tar.xz --zig-tar-sha256 "$live_zig_tar_sha" \
        --zig-sha256 "$live_zig_sha" --musl-tree-sha256 "$live_musl_sha" \
        --builder-lock /run/live/builder.lock \
        --builder-lock-sha256 "$live_builder_lock_sha" --builder-id "$live_builder_id" \
        --runner "$live_runner" --runner-sha256 "$live_runner_sha" \
        --runner-proof /run/live/runner-proof --runner-proof-sha256 "$live_proof_sha" \
        --source-snapshot /run/live/source.snapshot \
        --source-snapshot-sha256 "$live_snapshot_sha" \
        --license-evidence /run/live/license-evidence \
        --license-evidence-sha256 "$live_license_sha" \
        --live-lock-helper /work/bootstrap-helper \
        --live-lock-helper-sha256 "$live_helper_sha" \
        --source-date-epoch "$live_epoch" --jobs "$live_jobs" \
        --install-device "$live_install" --keep-work; then :; else
        printf '%s\n' 'erro: composição release interna falhou' >&2
        exit 1
    fi

    "$live_work/bootstrap-helper" --self-sha256 "$live_helper_sha" \
        work-verify "$live_work" "$live_work_marker_sha" \
        "$live_work_request_sha" "$live_proof_sha" populated
    live_expected_efi=$("$live_work/bootstrap-helper" \
        --self-sha256 "$live_helper_sha" sha256 \
        "$live_work/inner-output/BOOTX64.EFI") || exit 1
    live_expected_components=$("$live_work/bootstrap-helper" \
        --self-sha256 "$live_helper_sha" sha256 \
        "$live_work/inner-output/BOOTX64.EFI.live-components") || exit 1
    live_expected_runner=$("$live_work/bootstrap-helper" \
        --self-sha256 "$live_helper_sha" sha256 \
        "$live_work/inner-output/BOOTX64.EFI.live-runner-proof") || exit 1
    live_expected_lock=$("$live_work/bootstrap-helper" \
        --self-sha256 "$live_helper_sha" sha256 \
        "$live_work/inner-output/BOOTX64.EFI.live-lock") || exit 1
    if ! "$live_work/bootstrap-helper" --self-sha256 "$live_helper_sha" publish \
        "$live_work/inner-output/BOOTX64.EFI" \
        "$live_work/inner-output/BOOTX64.EFI.live-components" \
        "$live_work/inner-output/BOOTX64.EFI.live-runner-proof" \
        "$live_work/build/LIVE_EMBED_PROOF" \
        "$live_work/inner-output/BOOTX64.EFI.live-lock" "$live_output"; then
        printf '%s\n' 'erro: publicação final do EFI/sidecars falhou' >&2
        exit 1
    fi
    live_check_published() {
        live_published_path=$1
        live_published_expected=$2
        [ -f "$live_published_path" ] && [ ! -L "$live_published_path" ] || {
            printf 'erro: output final ausente/não regular: %s\n' \
                "$live_published_path" >&2
            exit 1
        }
        live_published_actual=$("$live_work/bootstrap-helper" \
            --self-sha256 "$live_helper_sha" sha256 \
            "$live_published_path") || exit 1
        [ "$live_published_actual" = "$live_published_expected" ] || {
            printf 'erro: hash final divergente: %s\n' "$live_published_path" >&2
            exit 1
        }
    }
    live_check_published "$live_output" "$live_expected_efi"
    live_check_published "$live_output.live-components" \
        "$live_expected_components"
    live_check_published "$live_output.live-runner-proof" \
        "$live_expected_runner"
    live_check_published "$live_output.live-lock" "$live_expected_lock"
    if ! "$live_work/bootstrap-helper" --self-sha256 "$live_helper_sha" \
        verify "$live_output" \
        "$live_output.live-components" "$live_output.live-runner-proof" \
        "$live_work/build/LIVE_EMBED_PROOF" "$live_output.live-lock"; then
        printf '%s\n' 'erro: verificação terminal do EFI/sidecars falhou' >&2
        exit 1
    fi
    printf 'BOOTX64.EFI vivo release: %s\n' "$live_output"
    exit 0
fi

set -eu
umask 077
LC_ALL=C
export LC_ALL
unset TAR_OPTIONS GZIP BZIP2 BZIP XZ_DEFAULTS XZ_OPT CONFIG_SITE \
    MAKEFLAGS MFLAGS CFLAGS CPPFLAGS CXXFLAGS LDFLAGS RUSTFLAGS \
    CARGO_ENCODED_RUSTFLAGS PKG_CONFIG_PATH PKG_CONFIG_LIBDIR

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
LINUX_VERSION=7.1.8
LINUX_SHA256=ff01dcb449279d5b4cfccdb01fee639cf5ff1803f1749a77844dd33915422c49
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${LINUX_VERSION}.tar.xz
BUSYBOX_VERSION=1.35.0
BUSYBOX_SHA256=faeeb244c35a348a334f4a59e44626ee870fb07b6884d68c10ae8bc19f83a694
BUSYBOX_URL=https://busybox.net/downloads/busybox-${BUSYBOX_VERSION}.tar.bz2
# Compatibilidade exclusiva do modo development. Release nunca consome este
# binário: ele é construído do tar oficial acima e da configuração versionada.
BUSYBOX_PREBUILT_SHA256=6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348
BUSYBOX_CONFIG=$REPO/bootstrap/live/busybox-${BUSYBOX_VERSION}.config
BUSYBOX_CONFIG_SHA256=1b668913cfd8ba850814e4637ea1bf800d8c9f5e0d508c26048c769a8d70682e
E2FSPROGS_VERSION=1.47.4
E2FSPROGS_URL=https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${E2FSPROGS_VERSION}/e2fsprogs-${E2FSPROGS_VERSION}.tar.xz
E2FSPROGS_SHA256=fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b
# ncurses e util-linux vêm em par: o cfdisk é uma interface de texto, e quem a
# desenha é a ncursesw. Os dois hashes foram conferidos contra terceiros — o do
# ncurses bate com o pino do Void Linux E com a receita newspeak/ncurses desta
# árvore; o do util-linux, com o sha256sums.asc assinado do kernel.org.
NCURSES_VERSION=6.6
NCURSES_URL=https://ftp.gnu.org/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz
