    rustc_path=$(command -v rustc 2>/dev/null || true)
    cargo_hash=$EMPTY_SHA256
    rustc_hash=$EMPTY_SHA256
    [ -z "$cargo_path" ] || cargo_hash=$(sha_path "$cargo_path")
    [ -z "$rustc_path" ] || rustc_hash=$(sha_path "$rustc_path")
    RUST_TOOLCHAIN_HASH=$({
        printf '%s\n' "$cargo_hash" "$rustc_hash"
        cargo --version 2>/dev/null || true
        rustc --version --verbose 2>/dev/null || true
    } | sha_join)
