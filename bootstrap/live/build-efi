# Imprime arquivos que têm o cabeçalho de uma chave minisign secreta. Uma
# chave é, por formato, um texto de poucas centenas de bytes e o cabeçalho é a
# primeira linha. Ler só essa linha em arquivos pequenos evita transformar uma
# guarda barata numa releitura de gigabytes de tarballs/binários. `find` não
# segue symlinks e -xdev impede a auditoria de atravessar um mount acidental.
find_minisign_secret() { # arvore profundidade-maxima
    [ -d "$1" ] || return 0
    find "$1" -xdev -maxdepth "$2" -type f -size -32769c \
        -exec awk '
            FNR == 1 {
                if ($0 ~ /^untrusted comment: minisign (encrypted )?secret key.*$/)
                    print FILENAME
                nextfile
            }
        ' {} + 2>/dev/null || true
}

if [ -z "$WORK" ]; then
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/distropica-live.XXXXXXXX")
    [ "$KEEP_WORK" = yes ] || REMOVE_WORK=yes
elif [ "$MODE" = release ] && [ "$RELEASE_INNER" = yes ]; then
    # O outer criou este diretório como irmão do rootfs, persistiu seu marker
    # e o montou no único ponto RW /work. Não adotamos/criamos diretório algum
    # no inner; a validação nativa completa ocorre em validate_release_inner.
    [ -d "$WORK" ] && [ ! -L "$WORK" ] || {
        echo "erro: release inner exige WORK já montado e real" >&2; exit 1;
    }
    WORK=$(CDPATH= cd -- "$WORK" && pwd -P)
    WORK_INNER=$WORK
else
    work_was_new=no
    if [ ! -e "$WORK" ] && [ ! -L "$WORK" ]; then
        mkdir -- "$WORK"
        work_was_new=yes
    fi
    [ -d "$WORK" ] && [ ! -L "$WORK" ] || {
        echo "erro: --work precisa ser diretório real: $WORK" >&2; exit 1;
    }
    WORK=$(CDPATH= cd -- "$WORK" && pwd -P)
    WORK_INNER=$WORK
    WORK_MARKER=$WORK/.distropica-live-work
    if [ "$work_was_new" = yes ]; then
        (set -C; printf '%s\n' 'DISTROPICA_LIVE_WORK_FORMAT=1' > "$WORK_MARKER") || {
            echo "erro: não criei o marcador do --work: $WORK_MARKER" >&2; exit 1;
        }
    fi
    [ -f "$WORK_MARKER" ] && [ ! -L "$WORK_MARKER" ] &&
        [ "$(cat "$WORK_MARKER")" = 'DISTROPICA_LIVE_WORK_FORMAT=1' ] || {
        echo "erro: recusei --work existente sem marcador da Distrópica: $WORK" >&2
        exit 1
    }
fi

validate_release_inner() {
    [ "$RELEASE_INNER" = yes ] || {
        echo "erro: launcher release não reexecutou no builder medido" >&2
        exit 1
    }
    LIVE_LOCK_TOOL=$LIVE_HELPER_BIN
    [ -x "$LIVE_LOCK_TOOL" ] && [ -f "$LIVE_LOCK_TOOL" ] &&
        [ ! -L "$LIVE_LOCK_TOOL" ] || {
        echo "erro: helper nativo medido ausente no release inner" >&2; exit 1;
    }
    release_regular "$LIVE_LOCK_TOOL" "$LIVE_HELPER_BIN_SHA256" \
        'helper nativo recompilado'
    "$LIVE_LOCK_TOOL" --self-sha256 "$LIVE_HELPER_BIN_SHA256" \
        work-verify "$WORK" "$WORK_MARKER_SHA256" \
        "$WORK_REQUEST_SHA256" "$RUNNER_PROOF_SHA256" populated
    "$LIVE_LOCK_TOOL" --self-sha256 "$LIVE_HELPER_BIN_SHA256" \
        verify-runner "$RUNNER_PROOF"

    release_regular "$RUNNER_PROOF" "$RUNNER_PROOF_SHA256" 'runner proof'
    release_regular "$SOURCE_SNAPSHOT" "$SOURCE_SNAPSHOT_SHA256" 'source snapshot'
    release_regular "$BUILDER_LOCK" "$BUILDER_LOCK_SHA256" 'builder lock'
    [ "$(sed -n '1p' "$BUILDER_LOCK")" = 'LIVE_BUILDER_FORMAT=1' ] || {
        echo "erro: builder lock não tem LIVE_BUILDER_FORMAT=1" >&2; exit 1;
    }
    builder_lock_id=$(sed -n '2s/^ID=//p' "$BUILDER_LOCK")
    BUILDER_ROOTFS_SHA256=$(sed -n '3s/^ROOTFS_TREE_SHA256=//p' "$BUILDER_LOCK")
    [ "$(wc -l < "$BUILDER_LOCK" | tr -d ' ')" -eq 3 ] || {
        echo "erro: builder lock tem campo ausente/extra" >&2; exit 1;
    }
    case "$BUILDER_ID" in *[!A-Za-z0-9._:+-]*|'')
        echo "erro: --builder-id não é identidade canônica" >&2; exit 1 ;;
    esac
    [ "$builder_lock_id" = "$BUILDER_ID" ] || {
        echo "erro: identidade do builder lock diverge de --builder-id" >&2; exit 1;
    }
    is_sha256 "$BUILDER_ROOTFS_SHA256" || {
        echo "erro: ROOTFS_TREE_SHA256 inválido no builder lock" >&2; exit 1;
    }
    release_builder_view=/run/live/builder-root
    case "${DISTROPICA_LIVE_TEST_DISPATCH_ONLY:-}" in
        '')
            [ -z "${DISTROPICA_LIVE_TEST_ROOTFS_VIEW:-}" ] || {
                echo "erro: rootfs view de teste sem probe dispatch-only" >&2; exit 1;
            } ;;
        1)
            [ -n "${DISTROPICA_LIVE_TEST_ROOTFS_VIEW:-}" ] || {
                echo "erro: probe dispatch-only exige rootfs view explícita" >&2; exit 1;
            }
            release_builder_view=$DISTROPICA_LIVE_TEST_ROOTFS_VIEW ;;
        *) echo "erro: probe dispatch-only inválido" >&2; exit 1 ;;
    esac
    [ -d "$release_builder_view" ] && [ ! -L "$release_builder_view" ] || {
        echo "erro: release inner sem visão medida do builder" >&2; exit 1;
    }
    measured_builder=$("$LIVE_LOCK_TOOL" --self-sha256 \
        "$LIVE_HELPER_BIN_SHA256" tree-hash "$release_builder_view")
    [ "$measured_builder" = "$BUILDER_ROOTFS_SHA256" ] || {
        echo "erro: rootfs produtor diverge do builder lock" >&2
        echo "esperado: $BUILDER_ROOTFS_SHA256" >&2
        echo "obtido:  $measured_builder" >&2
        exit 1
    }
}

BUILDER_ROOTFS_SHA256=
if [ "$MODE" = release ]; then
    validate_release_inner
else
    LIVE_LOCK_TOOL=$WORK/live-lock-helper-development
    cc_path=$(command -v cc 2>/dev/null || true)
    [ -n "$cc_path" ] || {
        echo "erro: development exige compilador C para o helper live-lock" >&2
        exit 1
    }
    "$cc_path" -std=c17 -O2 -Wall -Wextra -Werror \
        -o "$LIVE_LOCK_TOOL" "$LIVE_LOCK_HELPER_SOURCE"
    chmod 0700 "$LIVE_LOCK_TOOL"
fi

# Kernel construído DENTRO do rootfs Distrópica.
#
# O kernel exige flex, bison, pkg-config e libelf. Pegá-los do hospedeiro
# significaria que a mídia depende do que a máquina do mantenedor por acaso
# tem instalado — e esta distro não depende de hospedeiro. Ela já constrói um
# kernel com as próprias ferramentas: é o que a receita newspeak/linux faz.
# Aqui é o mesmo, para o kernel VIVO.
#
# Em development legado, um segundo bwrap precisa enxergar o WORK sob o
# rootfs. Release já foi reexecutado com o WORK irmão montado separadamente em
# /work e não entra neste ramo.
if [ -n "$ROOTFS" ]; then
    command -v bwrap >/dev/null 2>&1 || {
        echo "erro: --rootfs exige bwrap" >&2; exit 1;
    }
    [ -d "$ROOTFS" ] && [ ! -L "$ROOTFS" ] || {
        echo "erro: --rootfs precisa ser diretório real: $ROOTFS" >&2; exit 1;
    }
    if [ "$MODE" = release ]; then
        rootfs_logical=$(realpath -s -- "$ROOTFS" 2>/dev/null || true)
        rootfs_physical=$(realpath -e -- "$ROOTFS" 2>/dev/null || true)
        [ -n "$rootfs_logical" ] && [ "$rootfs_logical" = "$rootfs_physical" ] &&
            release_trusted_parent "$ROOTFS/.distropica-probe" || {
            echo "erro: --rootfs release atravessa symlink ou não é privado/do euid" >&2
            exit 1
        }
    fi
    ROOTFS=$(CDPATH= cd -- "$ROOTFS" && pwd -P)

    # A chave que assina o canal nao e insumo do sistema instalado nem do
    # kernel vivo. Duas copias deixadas por invocacoes manuais ja apareceram
    # neste rootfs; a ISO daquela vez nao as levou por uma propriedade
    # incidental da composicao. A propriedade agora e guarda: recusa qualquer
    # arquivo que tenha a linha de cabecalho de uma chave secreta minisign.
    #
    # NAO se usa `grep -R` aqui. O rootfs de build medido tem 6 GiB, inclusive
    # 1,3 GiB de uma arvore temporaria do GCC; reler tudo acrescentava minutos
    # a cada EFI. Pior: `grep -R` segue links simbolicos e poderia sair da
    # arvore auditada. As chaves entram no rootfs apenas para o comando de
    # assinatura rodado no bwrap, portanto a guarda cobre os lugares de estado
    # e staging em que elas podem legitimamente ter sido deixadas. Limites de
    # profundidade excluem as arvores de compilacao, nao os arquivos no topo
    # de tmp/var/tmp — exatamente onde as duas copias reais foram encontradas.
    # Abaixo, uma segunda guarda percorre o initramfs INTEIRO depois de pronto:
    # o que efetivamente embarca nunca depende desta reducao de escopo.
    #
    # O casamento da linha inteira nao confunde o texto embutido no proprio
    # binario do minitrue com um arquivo de chave real.
    SECRET_KEY_FILE=$({
        find_minisign_secret "$ROOTFS" 1
        find_minisign_secret "$ROOTFS/etc" 16
        find_minisign_secret "$ROOTFS/root" 8
        find_minisign_secret "$ROOTFS/home" 8
        find_minisign_secret "$ROOTFS/tmp" 2
        find_minisign_secret "$ROOTFS/var/tmp" 2
        find_minisign_secret "$ROOTFS/var/lib" 6
        find_minisign_secret "$ROOTFS/var/cache" 2
        find_minisign_secret "$ROOTFS/usr/local" 6
    })
    if [ -n "$SECRET_KEY_FILE" ]; then
        echo "erro: chave minisign secreta encontrada dentro do rootfs" >&2
        echo "  caminho: $(printf '%s\n' "$SECRET_KEY_FILE" | sed -n '1p')" >&2
        echo "remova-a antes de compor a midia; a chave publica e o unico" >&2
        echo "material de canal que pode chegar ao sistema instalado" >&2
        exit 1
    fi
    case "$WORK" in
        "$ROOTFS"/?*) ;;
        *)
            echo "erro: em development com --rootfs, o --work precisa estar dentro dele" >&2
            echo "  rootfs: $ROOTFS" >&2
            echo "  work:  $WORK" >&2
            exit 1
            ;;
    esac
    WORK_INNER=${WORK#"$ROOTFS"}
fi

# make do kernel, no hospedeiro ou dentro do rootfs conforme --rootfs.
#
# HOSTLDFLAGS com -rpath-link: dentro do rootfs, o objtool liga contra a
# libelf, que por sua vez precisa da libz — e o ld nativo desta árvore não
# resolve dependência transitiva sozinho. É o mesmo tratamento que a receita
# newspeak/linux já aplica pelo mesmo motivo. No hospedeiro isso é inócuo,
# porque /usr/lib já está no caminho padrão do ld de lá.
release_run() {
    [ "$MODE" = release ] && [ "$RELEASE_INNER" = yes ] || {
        echo "erro: release_run fora do builder release interno" >&2; exit 1;
    }
    # O processo inteiro já foi reexecutado pelo launcher em rootfs ro-bind,
    # PATH fixo, rede isolada e somente /work gravável.
    "$@"
}

# Probe focal: atravessa exatamente validate_release_inner e o dispatcher
# acima, executa apenas /bin/true e para sem criar/copiar/publicar EFI ou
# sidecars. O launcher real usa --clearenv e nunca injeta estas variáveis.
# Mesmo numa invocação direta, o probe não qualifica saída alguma.
if [ "$MODE" = release ] &&
   [ "${DISTROPICA_LIVE_TEST_DISPATCH_ONLY:-}" = 1 ]; then
    for probe_output in "$OUTPUT" "$OUTPUT.live-components" \
        "$OUTPUT.live-runner-proof" "$OUTPUT.live-lock"; do
        [ ! -e "$probe_output" ] && [ ! -L "$probe_output" ] || {
            echo "erro: probe dispatch encontrou output" >&2; exit 1;
        }
    done
    case "${DISTROPICA_LIVE_TEST_DISPATCH_RESULT:-success}" in
        success) release_run /bin/true ;;
        failure) release_run /bin/false ;;
        *) echo "erro: resultado do probe inválido" >&2; exit 1 ;;
    esac
    probe_trace=$WORK/.distropica-live-inner-dispatch
    [ ! -e "$probe_trace" ] && [ ! -L "$probe_trace" ] || {
        echo "erro: trace do probe já existe" >&2; exit 1;
    }
    (set -C; umask 077; {
        printf '%s\n' 'DISTROPICA_LIVE_INNER_DISPATCH_FORMAT=1'
        printf 'RUNNER_PROOF_SHA256=%s\n' "$RUNNER_PROOF_SHA256"
    } > "$probe_trace") || {
        echo "erro: não criei trace do probe" >&2; exit 1;
    }
    chmod 0600 "$probe_trace"
    printf '%s\n' 'DISTROPICA_LIVE_INNER_DISPATCH_VALIDATED=1'
    exit 0
fi

kmake() {
    if [ -n "$ROOTFS" ]; then
        if [ "$MODE" = release ]; then
            release_run make -C "$SOURCE_INNER" \
                HOSTLDFLAGS="-Wl,-rpath-link,/usr/lib" "$@"
        else
            # TMPDIR E HOME PRECISAM APONTAR PARA O BIND DE ESCRITA, e nao para
            # o /tmp da view: o rootfs entra com --ro-bind, entao TUDO nele e
            # somente-leitura menos $WORK_INNER. Sem isto o `mktemp` do
            # gen_initramfs.sh do kernel falha com "mktemp: (null): Read-only
            # file system" ao gerar usr/initramfs_data.cpio — depois de compilar
            # objtool, init/main.o e meio kernel.
            #
            # Nao apareceu antes porque as chamadas anteriores de kmake sao so
            # olddefconfig, que nao usa temporario. Este e o primeiro build que
            # chega ao initramfs.
            #
            # O padrao ja existe neste script: as outras duas invocacoes de
            # bwrap (linhas 178 e 264) fazem --setenv TMPDIR /work/tmp.
            mkdir -p "$WORK/ktmp"
            bwrap --ro-bind "$ROOTFS" / --bind "$WORK" "$WORK_INNER" \
                --proc /proc --dev /dev \
                --unshare-pid --die-with-parent --clearenv \
                --setenv PATH /usr/bin:/bin \
                --setenv HOME "$WORK_INNER/ktmp" \
                --setenv TMPDIR "$WORK_INNER/ktmp" \
                --setenv LC_ALL C --setenv LANG C --setenv TZ UTC \
                --setenv SOURCE_DATE_EPOCH "$EPOCH" \
                make -C "$SOURCE_INNER" \
                HOSTLDFLAGS="-Wl,-rpath-link,/usr/lib" "$@"
        fi
    else
        make -C "$SOURCE" "$@"
    fi
}

cleanup() {
    if [ -n "$PUBLISH_TMP" ]; then
        rm -f -- "$PUBLISH_TMP"
    fi
    if [ "$REMOVE_WORK" = yes ]; then
        rm -rf -- "$WORK"
    fi
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

fetch() {
    url=$1
    destination=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --proto '=https' --tlsv1.2 --output "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget --https-only -O "$destination" "$url"
    else
        echo "erro: curl ou wget é necessário" >&2
        exit 1
    fi
}

check_hash() {
    expected=$1
    path=$2
    actual=$(sha256sum "$path" | awk '{print $1}')
    [ "$actual" = "$expected" ] || {
        echo "erro: sha256 divergente em $path" >&2
        echo "esperado: $expected" >&2
        echo "obtido:  $actual" >&2
        exit 1
    }
}

require_static() {
    path=$1
    [ -f "$path" ] && [ -x "$path" ] || {
        echo "erro: binário ausente/não executável: $path" >&2; exit 1;
    }
    elf_header=$(readelf -h "$path" 2>/dev/null) || {
        echo "erro: o initramfs exige ELF válido: $path" >&2
        exit 1
    }
    printf '%s\n' "$elf_header" | grep -q 'Machine:.*X86-64' || {
        echo "erro: o initramfs exige ELF x86-64: $path" >&2
        exit 1
    }
    printf '%s\n' "$elf_header" | grep -Eq 'Type:[[:space:]]+(EXEC|DYN)' || {
        echo "erro: o initramfs exige ELF executável/PIE, não objeto relocável: $path" >&2
        exit 1
    }
    program_headers=$(readelf -l "$path" 2>/dev/null) || {
        echo "erro: não li os program headers ELF de $path" >&2
        exit 1
    }
    if printf '%s\n' "$program_headers" | grep -q 'INTERP'; then
        echo "erro: o initramfs exige binário estático: $path" >&2
        exit 1
    fi
}

if [ -z "$LINUX_TAR" ]; then
    LINUX_TAR=$WORK/linux-${LINUX_VERSION}.tar.xz
