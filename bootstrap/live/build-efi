#!/bin/sh
# Compõe um bzImage EFI-stub com initramfs vivo incorporado.
set -eu
umask 022
LC_ALL=C
export LC_ALL

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
LINUX_VERSION=7.1.4
LINUX_SHA256=1c63922a119675d38e3ae0f8f6ee07f15c41a786ab9ed66563749bb8c9a08e2e
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${LINUX_VERSION}.tar.xz
BUSYBOX_SHA256=6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348
BUSYBOX_URL=https://www.busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox
E2FSPROGS_VERSION=1.47.4
E2FSPROGS_URL=https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${E2FSPROGS_VERSION}/e2fsprogs-${E2FSPROGS_VERSION}.tar.xz
E2FSPROGS_SHA256=fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b
# ncurses e util-linux vêm em par: o cfdisk é uma interface de texto, e quem a
# desenha é a ncursesw. Os dois hashes foram conferidos contra terceiros — o do
# ncurses bate com o pino do Void Linux E com a receita newspeak/ncurses desta
# árvore; o do util-linux, com o sha256sums.asc assinado do kernel.org.
NCURSES_VERSION=6.6
NCURSES_URL=https://ftp.gnu.org/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz
NCURSES_SHA256=355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11
UTIL_LINUX_VERSION=2.42.2
UTIL_LINUX_URL=https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-${UTIL_LINUX_VERSION}.tar.xz
UTIL_LINUX_SHA256=03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a
RUST_TARGET=x86_64-unknown-linux-musl
EPOCH=${SOURCE_DATE_EPOCH:-1704067200}
JOBS=${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}
OUTPUT=
WORK=
ROOTFS=${DISTROPICA_ROOTFS:-}
SOURCE_INNER=
KEEP_WORK=no
INSTALL_DEVICE=
REMOVE_WORK=no
PUBLISH_TMP=
LINUX_TAR=${DISTROPICA_LINUX_TAR:-}
BUSYBOX=${DISTROPICA_BUSYBOX:-}
MINIPAX_BIN=${MINIPAX:-}
MINITRUE_BIN=${MINITRUE:-}
E2FSPROGS_TAR=${DISTROPICA_E2FSPROGS_TAR:-}
NCURSES_TAR=${DISTROPICA_NCURSES_TAR:-}
UTIL_LINUX_TAR=${DISTROPICA_UTIL_LINUX_TAR:-}

usage() {
    cat <<'EOF'
uso: bootstrap/live/build-efi --output BOOTX64.EFI [opções]

  --work DIR          workspace novo ou já marcado pelo script (default: temporário)
  --rootfs DIR        compila o kernel DENTRO deste rootfs Distrópica, por bwrap,
                      em vez de usar flex/bison/pkg-config/libelf do hospedeiro;
                      exige que --work esteja sob ele
  --keep-work         preserva o diretório temporário
  --linux-tar ARQ     linux-7.1.4.tar.xz já baixado
  --busybox ARQ       BusyBox x86_64-musl estático já baixado
  --e2fsprogs-tar ARQ e2fsprogs já baixado (mke2fs/e2fsck estáticos)
  --ncurses-tar ARQ   ncurses já baixado (a interface do cfdisk)
  --util-linux-tar ARQ util-linux já baixado (cfdisk e sfdisk estáticos)
  --minipax ARQ       Minipax x86_64-musl estático já compilado
  --minitrue ARQ      Minitrue x86_64-musl estático já compilado
  --install-device D  autoriza instalação automática nesse disco no boot
  --jobs N            paralelismo do kernel

Sem os arquivos opcionais, baixa tudo com hashes pinados e compila
Minipax/Minitrue para x86_64-unknown-linux-musl. A saída não é sobrescrita.

O COMPILADOR C MUSL é insumo obrigatório e não vem deste script: mke2fs,
e2fsck, ncursesw, cfdisk e sfdisk são compilados estáticos porque o initramfs
não tem glibc. Ele é procurado, nesta ordem, em E2FS_CC, depois nos comandos
x86_64-linux-musl-gcc e musl-gcc do PATH. Não havendo nenhum, exporte

    ZIG=/caminho/para/zig

e o script monta um invólucro `zig cc -target x86_64-linux-musl`. Esta árvore
traz o zig em /opt/zig/<versão>/zig de um rootfs Distrópica construído.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --output) OUTPUT=${2:?}; shift 2 ;;
        --work) WORK=${2:?}; shift 2 ;;
        --rootfs) ROOTFS=${2:?}; shift 2 ;;
        --keep-work) KEEP_WORK=yes; shift ;;
        --linux-tar) LINUX_TAR=${2:?}; shift 2 ;;
        --busybox) BUSYBOX=${2:?}; shift 2 ;;
        --e2fsprogs-tar) E2FSPROGS_TAR=${2:?}; shift 2 ;;
        --ncurses-tar) NCURSES_TAR=${2:?}; shift 2 ;;
        --util-linux-tar) UTIL_LINUX_TAR=${2:?}; shift 2 ;;
        --minipax) MINIPAX_BIN=${2:?}; shift 2 ;;
        --minitrue) MINITRUE_BIN=${2:?}; shift 2 ;;
        --install-device) INSTALL_DEVICE=${2:?}; shift 2 ;;
        --jobs) JOBS=${2:?}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "erro: opção desconhecida: $1" >&2; usage >&2; exit 1 ;;
    esac
done

[ -n "$OUTPUT" ] || { echo "erro: --output é obrigatório" >&2; exit 1; }
[ ! -e "$OUTPUT" ] && [ ! -L "$OUTPUT" ] || {
    echo "erro: saída já existe: $OUTPUT" >&2; exit 1;
}
case "$INSTALL_DEVICE" in
    ""|/dev/*) ;;
    *) echo "erro: --install-device precisa estar sob /dev" >&2; exit 1 ;;
esac
case "$JOBS" in *[!0-9]*|"") echo "erro: --jobs inválido" >&2; exit 1 ;; esac
[ "$JOBS" -ge 1 ] || { echo "erro: --jobs precisa ser pelo menos 1" >&2; exit 1; }

if [ -z "$WORK" ]; then
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/distropica-live.XXXXXXXX")
    [ "$KEEP_WORK" = yes ] || REMOVE_WORK=yes
else
    work_was_new=no
    if [ ! -e "$WORK" ] && [ ! -L "$WORK" ]; then
        mkdir -- "$WORK"
        work_was_new=yes
    fi
    [ -d "$WORK" ] && [ ! -L "$WORK" ] || {
        echo "erro: --work precisa ser diretório real: $WORK" >&2; exit 1;
    }
    WORK=$(CDPATH= cd -- "$WORK" && pwd -P)
    WORK_MARKER=$WORK/.distropica-live-work
    if [ "$work_was_new" = yes ]; then
        (set -C; printf '%s\n' 'DISTROPICA_LIVE_WORK_FORMAT=1' > "$WORK_MARKER") || {
            echo "erro: não criei o marcador do --work: $WORK_MARKER" >&2; exit 1;
        }
    fi
    [ -f "$WORK_MARKER" ] && [ ! -L "$WORK_MARKER" ] &&
        [ "$(cat "$WORK_MARKER")" = 'DISTROPICA_LIVE_WORK_FORMAT=1' ] || {
        echo "erro: recusei --work existente sem marcador da Distrópica: $WORK" >&2
        exit 1
    }
fi

# Kernel construído DENTRO do rootfs Distrópica.
#
# O kernel exige flex, bison, pkg-config e libelf. Pegá-los do hospedeiro
# significaria que a mídia depende do que a máquina do mantenedor por acaso
# tem instalado — e esta distro não depende de hospedeiro. Ela já constrói um
# kernel com as próprias ferramentas: é o que a receita newspeak/linux faz.
# Aqui é o mesmo, para o kernel VIVO.
#
# O `--work` precisa estar sob o rootfs porque o bwrap monta o rootfs como /:
# um caminho de fora simplesmente não existe lá dentro. Guardamos a forma
# interna para passar ao make.
if [ -n "$ROOTFS" ]; then
    command -v bwrap >/dev/null 2>&1 || {
        echo "erro: --rootfs exige bwrap" >&2; exit 1;
    }
    [ -d "$ROOTFS" ] && [ ! -L "$ROOTFS" ] || {
        echo "erro: --rootfs precisa ser diretório real: $ROOTFS" >&2; exit 1;
    }
    ROOTFS=$(CDPATH= cd -- "$ROOTFS" && pwd -P)
    case "$WORK" in
        "$ROOTFS"/?*) ;;
        *)
            echo "erro: com --rootfs, o --work precisa estar dentro dele" >&2
            echo "  rootfs: $ROOTFS" >&2
            echo "  work:  $WORK" >&2
            exit 1
            ;;
    esac
    WORK_INNER=${WORK#"$ROOTFS"}
fi

# make do kernel, no hospedeiro ou dentro do rootfs conforme --rootfs.
#
# HOSTLDFLAGS com -rpath-link: dentro do rootfs, o objtool liga contra a
# libelf, que por sua vez precisa da libz — e o ld nativo desta árvore não
# resolve dependência transitiva sozinho. É o mesmo tratamento que a receita
# newspeak/linux já aplica pelo mesmo motivo. No hospedeiro isso é inócuo,
# porque /usr/lib já está no caminho padrão do ld de lá.
kmake() {
    if [ -n "$ROOTFS" ]; then
        bwrap --bind "$ROOTFS" / --proc /proc --dev /dev \
            --unshare-pid --die-with-parent --clearenv \
            --setenv PATH /usr/bin:/bin \
            --setenv HOME /tmp \
            --setenv LC_ALL C --setenv LANG C --setenv TZ UTC \
            --setenv SOURCE_DATE_EPOCH "$EPOCH" \
            make -C "$SOURCE_INNER" \
            HOSTLDFLAGS="-Wl,-rpath-link,/usr/lib" "$@"
    else
        make -C "$SOURCE" "$@"
    fi
}

cleanup() {
    if [ -n "$PUBLISH_TMP" ]; then
        rm -f -- "$PUBLISH_TMP"
    fi
    if [ "$REMOVE_WORK" = yes ]; then
        rm -rf -- "$WORK"
    fi
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

fetch() {
    url=$1
    destination=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --proto '=https' --tlsv1.2 --output "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget --https-only -O "$destination" "$url"
    else
        echo "erro: curl ou wget é necessário" >&2
        exit 1
    fi
}

check_hash() {
    expected=$1
    path=$2
    actual=$(sha256sum "$path" | awk '{print $1}')
    [ "$actual" = "$expected" ] || {
        echo "erro: sha256 divergente em $path" >&2
        echo "esperado: $expected" >&2
        echo "obtido:  $actual" >&2
        exit 1
    }
}

require_static() {
    path=$1
    [ -f "$path" ] && [ -x "$path" ] || {
        echo "erro: binário ausente/não executável: $path" >&2; exit 1;
    }
    elf_header=$(readelf -h "$path" 2>/dev/null) || {
        echo "erro: o initramfs exige ELF válido: $path" >&2
        exit 1
    }
    printf '%s\n' "$elf_header" | grep -q 'Machine:.*X86-64' || {
        echo "erro: o initramfs exige ELF x86-64: $path" >&2
        exit 1
    }
    printf '%s\n' "$elf_header" | grep -Eq 'Type:[[:space:]]+(EXEC|DYN)' || {
        echo "erro: o initramfs exige ELF executável/PIE, não objeto relocável: $path" >&2
        exit 1
    }
    program_headers=$(readelf -l "$path" 2>/dev/null) || {
        echo "erro: não li os program headers ELF de $path" >&2
        exit 1
    }
    if printf '%s\n' "$program_headers" | grep -q 'INTERP'; then
        echo "erro: o initramfs exige binário estático: $path" >&2
        exit 1
    fi
}

if [ -z "$LINUX_TAR" ]; then
    LINUX_TAR=$WORK/linux-${LINUX_VERSION}.tar.xz
    [ -f "$LINUX_TAR" ] || fetch "$LINUX_URL" "$LINUX_TAR"
fi
check_hash "$LINUX_SHA256" "$LINUX_TAR"

if [ -z "$BUSYBOX" ]; then
    BUSYBOX=$WORK/busybox
    [ -f "$BUSYBOX" ] || fetch "$BUSYBOX_URL" "$BUSYBOX"
    chmod 755 "$BUSYBOX"
fi
check_hash "$BUSYBOX_SHA256" "$BUSYBOX"
require_static "$BUSYBOX"

build_rust_binary() {
    package=$1
    manifest=$REPO/$package/Cargo.toml
    destination=$WORK/cargo-$package
    CARGO_TARGET_DIR=$destination cargo build --locked --release \
        --target "$RUST_TARGET" --manifest-path "$manifest"
    echo "$destination/$RUST_TARGET/release/$package"
}

configure_musl_cc() {
    if [ -n "${CC_x86_64_unknown_linux_musl:-}" ] ||
       [ -n "${TARGET_CC:-}" ] || [ -n "${CC:-}" ] ||
       [ -n "${CROSS_COMPILE:-}" ]; then
        return 0
    fi
    if command -v x86_64-linux-musl-gcc >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v x86_64-linux-musl-gcc)
    elif command -v musl-gcc >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v musl-gcc)
    elif command -v clang >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v clang)
    else
        echo "erro: compilador C para $RUST_TARGET ausente" >&2
        echo "defina CC_x86_64_unknown_linux_musl ou forneça --minitrue" >&2
        exit 1
    fi
    export CC_x86_64_unknown_linux_musl
}

# O CC acima serve ao alvo Rust, onde `clang` basta: o toolchain Rust traz a
# própria musl e usa o CC apenas como driver de link. Para C isso não vale —
# um `clang` pelado compila contra os headers e a libc do HOST. O resultado
# passaria pelo require_static (glibc estático também não tem INTERP) e a
# mídia levaria um mke2fs glibc dizendo-se musl. A prova é o pré-processador:
# a musl não define __GLIBC__.
require_musl_cc() {
    probe=$WORK/musl-probe
    mkdir -p "$probe"
    cat > "$probe/probe.c" <<'EOF'
#include <stdlib.h>
#ifdef __GLIBC__
#error "este compilador C é glibc, não musl"
#endif
int main(void) { return 0; }
EOF
    "$@" -static -o "$probe/probe" "$probe/probe.c" >/dev/null 2>&1 || return 1
    program_headers=$(readelf -l "$probe/probe" 2>/dev/null) || return 1
    printf '%s\n' "$program_headers" | grep -q 'INTERP' && return 1
    return 0
}

# Compilador C musl para o mke2fs. Duas origens aceitas, nesta ordem:
#
#   musl-gcc / x86_64-linux-musl-gcc — o caminho convencional, pacote do host;
#   zig cc -target x86_64-linux-musl — o Zig É um compilador C musl completo,
#     traz os próprios headers, e nesta distro ele não é uma dependência nova:
#     é a semente pinada e conferida por hash do SPEC-0005. Preferir um insumo
#     que o projeto já verifica a um pacote que o host por acaso tenha é a
#     mesma regra que vale para o resto da árvore.
#
# `clang` pelado NÃO entra: é glibc disfarçado, e é exatamente o que o probe
# acima existe para barrar.
select_e2fs_cc() {
    if [ -n "${E2FS_CC:-}" ]; then
        # shellcheck disable=SC2086
        require_musl_cc $E2FS_CC || {
            echo "erro: E2FS_CC='$E2FS_CC' não compila C musl estático" >&2
            exit 1
        }
        echo "$E2FS_CC"
        return 0
    fi
    for candidate in x86_64-linux-musl-gcc musl-gcc; do
        command -v "$candidate" >/dev/null 2>&1 || continue
        require_musl_cc "$candidate" && { echo "$candidate"; return 0; }
    done
    zig_binary=${ZIG:-$(command -v zig 2>/dev/null || true)}
    if [ -n "$zig_binary" ] && [ -x "$zig_binary" ]; then
        wrapper=$WORK/zig-musl-cc
        cat > "$wrapper" <<EOF
#!/bin/sh
exec "$zig_binary" cc -target x86_64-linux-musl "\$@"
EOF
        chmod 755 "$wrapper"
        require_musl_cc "$wrapper" && { echo "$wrapper"; return 0; }
    fi
    echo "erro: nenhum compilador C musl disponível para o mke2fs estático" >&2
    echo "o initramfs não tem glibc, então um mke2fs glibc não rodaria ali" >&2
    echo "forneça um destes:" >&2
    echo "  musl-gcc no PATH (pacote musl-tools)" >&2
    echo "  ZIG=/caminho/para/zig (a semente pinada desta distro serve)" >&2
    echo "  E2FS_CC='<comando>' que compile C musl estático" >&2
    exit 1
}

command -v readelf >/dev/null 2>&1 || { echo "erro: readelf ausente" >&2; exit 1; }
if [ -z "$MINIPAX_BIN" ]; then MINIPAX_BIN=$(build_rust_binary minipax); fi
if [ -z "$MINITRUE_BIN" ]; then
    configure_musl_cc
    MINITRUE_BIN=$(build_rust_binary minitrue)
fi
require_static "$MINIPAX_BIN"
require_static "$MINITRUE_BIN"

# mke2fs estático. O initramfs não tem glibc — busybox, minipax e minitrue são
# todos estáticos —, então um mkfs.ext4 dinâmico não rodaria ali. Compilado
# com o mesmo CC musl que já serve ao alvo Rust, e conferido pelo mesmo
# require_static.
#
# Por que não o mkfs.ext2 do busybox: ext2 não tem journal. Num disco real,
# desligamento sujo vira fsck completo em vez de replay do journal — e é
# exatamente o tipo de sistema que se instala em hardware de verdade.
build_static_mke2fs() {
    E2FSPROGS_TAR=${E2FSPROGS_TAR:-$WORK/e2fsprogs-${E2FSPROGS_VERSION}.tar.xz}
    [ -f "$E2FSPROGS_TAR" ] || fetch "$E2FSPROGS_URL" "$E2FSPROGS_TAR"
    check_hash "$E2FSPROGS_SHA256" "$E2FSPROGS_TAR"
    e2fs_src=$WORK/e2fsprogs-${E2FSPROGS_VERSION}
    rm -rf -- "$e2fs_src"
    mkdir -p "$e2fs_src"
    tar -xJf "$E2FSPROGS_TAR" -C "$e2fs_src" --strip-components=1
    e2fs_cc=$(select_e2fs_cc)
    echo "mke2fs estático: compilando com $e2fs_cc" >&2
    (
        cd "$e2fs_src"
        # Quem torna o binário estático é o LDFLAGS=-static, e só ele. Uma
        # versão anterior desta linha passava também --disable-shared e
        # --enable-static, que o configure do e2fsprogs NÃO tem: o autoconf
        # avisava "unrecognized options" e seguia. Saíram porque flag que não
        # existe é pior que flag ausente — ela faz o script afirmar uma
        # decisão que nunca tomou, e é a mesma armadilha que já custou duas
        # receitas nesta árvore.
        # -s (strip no link): sem ele o mke2fs e o e2fsck vão com símbolos de
        # depuração e somam 9 dos 16 MB do initramfs — medido. Isso incha o
        # BOOTX64.EFI de ~11 para ~19 MB, e o preço aparece em três lugares:
        # tempo de carga pelo firmware (que chegou a estourar o timeout de
        # boot do aceite), RAM ocupada no boot, e espaço na ESP de 64 MiB. Os
        # binários Rust já saem stripped pelo perfil de release do Cargo.
        CC="$e2fs_cc" LDFLAGS="-static -s" ./configure \
            --disable-nls \
            --disable-uuidd \
            --disable-fsck \
            --disable-defrag \
            --disable-testio-debug >/dev/null
        make -j"$JOBS" >/dev/null
    ) || { echo "erro: não compilei o mke2fs estático" >&2; exit 1; }
    echo "$e2fs_src"
}

E2FS_SRC=$(build_static_mke2fs)
require_static "$E2FS_SRC/misc/mke2fs"
require_static "$E2FS_SRC/e2fsck/e2fsck"

# ncursesw estático, insumo do cfdisk e de mais nada.
#
# --with-fallbacks É OBRIGATÓRIO, e não afinação: o initramfs não tem
# /usr/share/terminfo, então uma ncurses que dependa da base em disco não
# desenha uma única linha. Os sete terminais listados ficam COMPILADOS no
# binário; `linux` cobre o console da máquina real e `vt100`/`xterm` cobrem
# serial e emulador, que é como o aceite roda.
build_static_ncursesw() {
    NCURSES_TAR=${NCURSES_TAR:-$WORK/ncurses-${NCURSES_VERSION}.tar.gz}
    [ -f "$NCURSES_TAR" ] || fetch "$NCURSES_URL" "$NCURSES_TAR"
    check_hash "$NCURSES_SHA256" "$NCURSES_TAR"
    nc_src=$WORK/ncurses-${NCURSES_VERSION}
    nc_prefix=$WORK/ncursesw-prefix
    rm -rf -- "$nc_src" "$nc_prefix"
    mkdir -p "$nc_src" "$nc_prefix"
    tar -xzf "$NCURSES_TAR" -C "$nc_src" --strip-components=1
    nc_cc=$(select_e2fs_cc)
    echo "ncursesw estático: compilando com $nc_cc" >&2
    (
        cd "$nc_src"
        CC="$nc_cc" CFLAGS="-Os" ./configure \
            --host=x86_64-linux-musl \
            --prefix="$nc_prefix" \
            --without-shared --with-normal --enable-widec \
            --without-cxx --without-cxx-binding --without-ada \
            --without-manpages --without-progs --without-tests \
            --without-debug --disable-db-install --enable-termcap \
            --with-fallbacks=linux,vt100,vt220,xterm,xterm-256color,screen,ansi \
            >/dev/null
        make -j"$JOBS" >/dev/null
        make install >/dev/null
    ) || { echo "erro: não compilei a ncursesw estática" >&2; exit 1; }
    # O -ltinfo que o configure do util-linux insiste em pedir resolve AQUI.
    # Ver o comentário em build_static_cfdisk sobre por que isto não é gambiarra.
    ln -sf libncursesw.a "$nc_prefix/lib/libtinfo.a"
    echo "$nc_prefix"
}

# cfdisk, fdisk e sfdisk estáticos.
#
# O BusyBox tem `fdisk` e ele NÃO ESCREVE GPT — é por isso que o particionamento
# automático vive no Rust do minipax. Para o instalador oferecer particionamento
# MANUAL, porém, é preciso um particionador de verdade, e o cfdisk é o que
# existe: interface de texto, entende GPT, e cabe em 0,9 MiB estático.
#
# Os três vêm juntos porque a opção do configure é `--enable-fdisks`, no plural,
# e governa os três. O sfdisk paga o próprio peso: é o particionador
# SCRIPTÁVEL, e é por ele que um layout se descreve em texto em vez de byte a
# byte.
build_static_cfdisk() {
    ncw_prefix=$(build_static_ncursesw)
    UTIL_LINUX_TAR=${UTIL_LINUX_TAR:-$WORK/util-linux-${UTIL_LINUX_VERSION}.tar.xz}
    [ -f "$UTIL_LINUX_TAR" ] || fetch "$UTIL_LINUX_URL" "$UTIL_LINUX_TAR"
    check_hash "$UTIL_LINUX_SHA256" "$UTIL_LINUX_TAR"
    ul_src=$WORK/util-linux-${UTIL_LINUX_VERSION}
    rm -rf -- "$ul_src"
    mkdir -p "$ul_src"
    tar -xJf "$UTIL_LINUX_TAR" -C "$ul_src" --strip-components=1
    ul_cc=$(select_e2fs_cc)
    echo "cfdisk estático: compilando com $ul_cc" >&2
    (
        cd "$ul_src"
        # --enable-fdisks, NO PLURAL. O `--enable-cfdisk` que a intuição sugere
        # não existe, e o autoconf o aceita com um "unrecognized options" no
        # meio de trezentas linhas — a mesma armadilha que o comentário do
        # mke2fs acima descreve, e na qual se cai de novo se não se CONFERIR a
        # saída. Por isso a conferência logo abaixo é parte do build, e não
        # zelo: um configure que ignora uma opção produz um make que não
        # produz nada e devolve zero.
        #
        # --disable-all-programs desliga também as BIBLIOTECAS, então libfdisk,
        # libsmartcols, libblkid e libuuid voltam explicitamente. Sem elas o
        # configure para com "libfdisk is needed to build fdisk".
        CC="$ul_cc" \
        CFLAGS="-Os -I$ncw_prefix/include -I$ncw_prefix/include/ncursesw" \
        LDFLAGS="-static -s -L$ncw_prefix/lib" \
        NCURSESW_CFLAGS="-I$ncw_prefix/include/ncursesw" \
        NCURSESW_LIBS="-L$ncw_prefix/lib -lncursesw" \
        ./configure \
            --host=x86_64-linux-musl \
            --disable-shared --enable-static \
            --disable-all-programs --enable-fdisks \
            --enable-libfdisk --enable-libsmartcols \
            --enable-libblkid --enable-libuuid \
            --disable-nls --without-systemd --without-udev \
            --without-python --without-readline \
            --without-tinfo --with-ncursesw \
            > "$WORK/util-linux-configure.log" 2>&1
        # O configure NÃO honra o NCURSES_LIBS que se passa: ele o recalcula do
        # `ncursesw6-config` DO HOSPEDEIRO, e de lá vem um `-ltinfo` que não
        # existe no nosso prefixo musl. O link do libtinfo.a para a
        # libncursesw.a, feito em build_static_ncursesw, resolve — e resolve
        # honestamente, porque nesta compilação (--with-normal, sem
        # --with-termlib) as funções de terminfo ESTÃO dentro da libncursesw.
        nao_reconhecidas=$(grep -c 'unrecognized options' \
            "$WORK/util-linux-configure.log" || true)
        if [ "${nao_reconhecidas:-0}" -ne 0 ]; then
            echo "erro: o configure do util-linux ignorou opções:" >&2
            grep 'unrecognized options' "$WORK/util-linux-configure.log" >&2
            exit 1
        fi
        make -j"$JOBS" >/dev/null
    ) || { echo "erro: não compilei o cfdisk estático" >&2; exit 1; }
    echo "$ul_src"
}

UTIL_LINUX_SRC=$(build_static_cfdisk)
require_static "$UTIL_LINUX_SRC/cfdisk"
require_static "$UTIL_LINUX_SRC/sfdisk"

INITROOT=$WORK/initramfs
rm -rf -- "$INITROOT"
mkdir -p "$INITROOT/bin" "$INITROOT/dev" "$INITROOT/etc" "$INITROOT/proc" \
    "$INITROOT/sys" "$INITROOT/run" "$INITROOT/tmp" "$INITROOT/usr/bin" \
    "$INITROOT/sbin" "$INITROOT/media" "$INITROOT/target" "$INITROOT/newroot" \
