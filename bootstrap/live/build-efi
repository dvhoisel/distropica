configure_musl_cc() {
    if [ -n "${CC_x86_64_unknown_linux_musl:-}" ] ||
       [ -n "${TARGET_CC:-}" ] || [ -n "${CC:-}" ] ||
       [ -n "${CROSS_COMPILE:-}" ]; then
        return 0
    fi
    if command -v x86_64-linux-musl-gcc >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v x86_64-linux-musl-gcc)
    elif command -v musl-gcc >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v musl-gcc)
    elif command -v clang >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v clang)
    else
        echo "erro: compilador C para $RUST_TARGET ausente" >&2
        echo "defina CC_x86_64_unknown_linux_musl ou forneça --minitrue" >&2
        exit 1
    fi
    export CC_x86_64_unknown_linux_musl
}

# O CC acima serve ao alvo Rust, onde `clang` basta: o toolchain Rust traz a
# própria musl e usa o CC apenas como driver de link. Para C isso não vale —
# um `clang` pelado compila contra os headers e a libc do HOST. O resultado
# passaria pelo require_static (glibc estático também não tem INTERP) e a
# mídia levaria um mke2fs glibc dizendo-se musl. A prova é o pré-processador:
# a musl não define __GLIBC__.
require_musl_cc() {
    probe=$WORK/musl-probe
    mkdir -p "$probe"
    cat > "$probe/probe.c" <<'EOF'
#include <stdlib.h>
#ifdef __GLIBC__
#error "este compilador C é glibc, não musl"
#endif
int main(void) { return 0; }
EOF
    "$@" -static -o "$probe/probe" "$probe/probe.c" >/dev/null 2>&1 || return 1
    program_headers=$(readelf -l "$probe/probe" 2>/dev/null) || return 1
    printf '%s\n' "$program_headers" | grep -q 'INTERP' && return 1
    return 0
}

# Compilador C musl para o mke2fs. Duas origens aceitas, nesta ordem:
#
#   musl-gcc / x86_64-linux-musl-gcc — o caminho convencional, pacote do host;
#   zig cc -target x86_64-linux-musl — o Zig É um compilador C musl completo,
#     traz os próprios headers, e nesta distro ele não é uma dependência nova:
#     é a semente pinada e conferida por hash do SPEC-0005. Preferir um insumo
#     que o projeto já verifica a um pacote que o host por acaso tenha é a
#     mesma regra que vale para o resto da árvore.
#
# `clang` pelado NÃO entra: é glibc disfarçado, e é exatamente o que o probe
# acima existe para barrar.
select_e2fs_cc() {
    if [ "$MODE" = release ]; then
        [ -n "$RELEASE_MUSL_CC" ] && [ -x "$RELEASE_MUSL_CC" ] || {
            echo "erro: toolchain Zig/musl de release não foi materializada" >&2
            exit 1
        }
        echo "$RELEASE_MUSL_CC"
        return 0
    fi
    if [ -n "${E2FS_CC:-}" ]; then
        # shellcheck disable=SC2086
        require_musl_cc $E2FS_CC || {
            echo "erro: E2FS_CC='$E2FS_CC' não compila C musl estático" >&2
            exit 1
        }
        echo "$E2FS_CC"
        return 0
    fi
    for candidate in x86_64-linux-musl-gcc musl-gcc; do
        command -v "$candidate" >/dev/null 2>&1 || continue
        require_musl_cc "$candidate" && { echo "$candidate"; return 0; }
    done
    zig_binary=${ZIG:-$(command -v zig 2>/dev/null || true)}
    if [ -n "$zig_binary" ] && [ -x "$zig_binary" ]; then
        wrapper=$WORK/zig-musl-cc
        # O LINKER DO ZIG RECUSA TRES ARGUMENTOS QUE O BusyBox PASSA FIXO, e a
        # falha vem so na ligacao final, depois de compilar centenas de objetos —
        # com a mensagem enterrada em busybox_unstripped.out, invisivel no log
        # deste script: "error: unsupported linker arg: --warn-common".
        #
        # OS TRES SAO DIAGNOSTICO, e quem diz isso e o proprio upstream: no
        # scripts/trylink eles saem juntos de INFO_OPTS(), sob o cabecalho
        # "Informational" da linha 8. --warn-common avisa sobre simbolo comum
        # duplicado; -Map escreve o mapa de ligacao; --verbose despeja o script
        # de ligacao usado. Nenhum muda um byte do binario.
        #
        # Enumerados de uma vez em vez de um por vez, porque cada descoberta
        # custava uma compilacao inteira. Dos catorze -Wl, que o trylink pode
        # passar, o Zig aceita dez; o quarto recusado e --undefined=lbb_main, e
        # ele so aparece na ligacao da BIBLIOTECA COMPARTILHADA (trylink:255,
        # com -shared -fPIC), caminho que este build estatico nao percorre.
        #
        # Filtrar AQUI e o lugar certo: o wrapper existe para adaptar o Zig a uma
        # invocacao estilo gcc, e isto e uma adaptacao dessas. Remendar o
        # scripts/trylink significaria editar um tarball de sha256 pinado.
        cat > "$wrapper" <<EOF
#!/bin/sh
i=\$#
while [ "\$i" -gt 0 ]; do
    case "\$1" in
        -Wl,--warn-common|-Wl,--verbose|-Wl,-Map,*) ;;
        *) set -- "\$@" "\$1" ;;
    esac
    shift
    i=\$((i - 1))
done
exec "$zig_binary" cc -target x86_64-linux-musl "\$@"
EOF
        chmod 755 "$wrapper"
        require_musl_cc "$wrapper" && { echo "$wrapper"; return 0; }
    fi
    echo "erro: nenhum compilador C musl disponível para o mke2fs estático" >&2
    echo "o initramfs não tem glibc, então um mke2fs glibc não rodaria ali" >&2
    echo "forneça um destes:" >&2
    echo "  musl-gcc no PATH (pacote musl-tools)" >&2
    echo "  ZIG=/caminho/para/zig (a semente pinada desta distro serve)" >&2
    echo "  E2FS_CC='<comando>' que compile C musl estático" >&2
    exit 1
}

validate_tar_members() { # tar opção-de-listagem
    archive=$1
    list_flag=$2
    tar "$list_flag" "$archive" | awk '
        /^\// { exit 1 }
        /(^|\/)\.\.($|\/)/ { exit 1 }
        /[[:cntrl:]]/ { exit 1 }
        { count++ }
        END { if (count == 0) exit 1 }
    ' || { echo "erro: tar vazio ou com caminho inseguro: $archive" >&2; exit 1; }
}

if [ "$MODE" = release ]; then
    [ "$ZIG_TAR_EXPECTED" = "$ZIG_TAR_SHA256" ] || {
        echo "erro: release exige o tar Zig $ZIG_VERSION pinado por esta árvore" >&2
        exit 1
    }
    release_regular "$ZIG_TAR" "$ZIG_TAR_EXPECTED" 'tar Zig'
    validate_tar_members "$ZIG_TAR" -tJf
    zig_root=$WORK/zig-${ZIG_VERSION}-release
    rm -rf -- "$zig_root"
    mkdir -p "$zig_root"
    tar -xJf "$ZIG_TAR" -C "$zig_root" --strip-components=1
    RELEASE_ZIG=$zig_root/zig
    release_regular "$RELEASE_ZIG" "$ZIG_BIN_SHA256" 'binário Zig'
    zig_musl_tree=$zig_root/lib/libc/musl
    [ -d "$zig_musl_tree" ] && [ ! -L "$zig_musl_tree" ] || {
        echo "erro: sysroot musl ausente no tar Zig" >&2; exit 1;
    }
    measured_musl=$("$LIVE_LOCK_TOOL" tree-hash "$zig_musl_tree")
    [ "$measured_musl" = "$MUSL_TREE_SHA256" ] || {
        echo "erro: árvore musl do Zig diverge do pin" >&2
        echo "esperado: $MUSL_TREE_SHA256" >&2
        echo "obtido:  $measured_musl" >&2
        exit 1
    }
    RELEASE_MUSL_CC=$WORK/zig-musl-release-cc
    cat > "$RELEASE_MUSL_CC" <<'EOF'
#!/bin/sh
wrapper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec "$wrapper_dir/zig-0.16.0-release/zig" cc \
    -target x86_64-linux-musl "$@"
EOF
    chmod 0755 "$RELEASE_MUSL_CC"
    RELEASE_MUSL_CC_INNER=${RELEASE_MUSL_CC#"$ROOTFS"}
    require_musl_cc "$RELEASE_MUSL_CC" || {
        echo "erro: Zig pinado não produziu C musl estático" >&2; exit 1;
    }
    release_run "$RELEASE_MUSL_CC_INNER" -static \
        -o "$WORK_INNER/musl-probe/probe-release" \
        "$WORK_INNER/musl-probe/probe.c" >/dev/null 2>&1 || {
        echo "erro: Zig/musl falhou dentro do builder pinado" >&2; exit 1;
    }
    require_static "$WORK/musl-probe/probe-release"
fi

SELECTED_MUSL_CC=$(select_e2fs_cc)

REQUIRED_BUSYBOX_APPLETS='ash awk basename blockdev cat chmod chpasswd cp cryptpw cttyhack cut dd dirname echo findfs grep ifconfig ip ln mdev mkdir mkfs.vfat mkswap mktemp mount mv partprobe printf readlink reboot rm route sed setsid sh sha256sum sleep stat stty switch_root sync test tr udhcpc umount wc'

build_static_busybox() {
    busybox_src=$WORK/busybox-${BUSYBOX_VERSION}
    rm -rf -- "$busybox_src"
    mkdir -p "$busybox_src"
    validate_tar_members "$BUSYBOX_TAR" -tjf
    tar -xjf "$BUSYBOX_TAR" -C "$busybox_src" --strip-components=1
    cp "$BUSYBOX_CONFIG" "$busybox_src/.config"
    busybox_cc=$SELECTED_MUSL_CC
    echo "BusyBox estático: compilando fonte oficial com $busybox_cc" >&2
    # KCONFIG_NOTIMESTAMP mantém a configuração efetiva byte-idêntica à
    # versão controlada; oldconfig recusa deriva de símbolo/default.
    if [ "$MODE" = release ]; then
        busybox_inner=${busybox_src#"$ROOTFS"}
        release_run make -C "$busybox_inner" KCONFIG_NOTIMESTAMP=1 \
            oldconfig </dev/null >/dev/null || {
            echo "erro: oldconfig do BusyBox falhou no builder pinado" >&2; exit 1;
        }
        check_hash "$BUSYBOX_CONFIG_SHA256" "$busybox_src/.config"
        release_run make -C "$busybox_inner" KCONFIG_NOTIMESTAMP=1 \
            -j"$JOBS" CC="$RELEASE_MUSL_CC_INNER" \
            EXTRA_CFLAGS="-ffile-prefix-map=$busybox_inner=/usr/src/busybox -fdebug-prefix-map=$busybox_inner=/usr/src/busybox -fmacro-prefix-map=$busybox_inner=/usr/src/busybox" \
            >/dev/null || {
            echo "erro: build BusyBox falhou no builder pinado" >&2; exit 1;
        }
    else
        (
            cd "$busybox_src"
            KCONFIG_NOTIMESTAMP=1 make oldconfig </dev/null >/dev/null
            check_hash "$BUSYBOX_CONFIG_SHA256" .config
            KCONFIG_NOTIMESTAMP=1 make -j"$JOBS" CC="$busybox_cc" \
                EXTRA_CFLAGS="-ffile-prefix-map=$busybox_src=/usr/src/busybox -fdebug-prefix-map=$busybox_src=/usr/src/busybox -fmacro-prefix-map=$busybox_src=/usr/src/busybox" >/dev/null
        ) || { echo "erro: não compilei o BusyBox estático" >&2; exit 1; }
    fi
    echo "$busybox_src/busybox"
}

if [ -n "$BUSYBOX_TAR" ]; then
    BUSYBOX=$(build_static_busybox)
    require_static "$BUSYBOX"
fi
busybox_applets=$($BUSYBOX --list)
for required_applet in $REQUIRED_BUSYBOX_APPLETS; do
