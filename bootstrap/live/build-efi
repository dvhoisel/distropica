# mke2fs estático. O initramfs não tem glibc — busybox, minipax e minitrue são
# todos estáticos —, então um mkfs.ext4 dinâmico não rodaria ali. Compilado
# com o mesmo CC musl que já serve ao alvo Rust, e conferido pelo mesmo
# require_static.
#
# Por que não o mkfs.ext2 do busybox: ext2 não tem journal. Num disco real,
# desligamento sujo vira fsck completo em vez de replay do journal — e é
# exatamente o tipo de sistema que se instala em hardware de verdade.
build_static_mke2fs() {
    E2FSPROGS_TAR=${E2FSPROGS_TAR:-$WORK/e2fsprogs-${E2FSPROGS_VERSION}.tar.xz}
    [ -f "$E2FSPROGS_TAR" ] || fetch "$E2FSPROGS_URL" "$E2FSPROGS_TAR"
    if [ "$MODE" = release ]; then
        release_regular "$E2FSPROGS_TAR" "$E2FSPROGS_SHA256" 'tar e2fsprogs'
    else
        check_hash "$E2FSPROGS_SHA256" "$E2FSPROGS_TAR"
    fi
    validate_tar_members "$E2FSPROGS_TAR" -tJf
    e2fs_src=$WORK/e2fsprogs-${E2FSPROGS_VERSION}
    rm -rf -- "$e2fs_src"
    mkdir -p "$e2fs_src"
    tar -xJf "$E2FSPROGS_TAR" -C "$e2fs_src" --strip-components=1
    e2fs_cc=$SELECTED_MUSL_CC
    echo "mke2fs estático: compilando com $e2fs_cc" >&2
    # Quem torna o binário estático é o LDFLAGS=-static, e só ele. Uma
    # versão anterior desta linha passava também --disable-shared e
    # --enable-static, que o configure do e2fsprogs NÃO tem: o autoconf
    # avisava "unrecognized options" e seguia. Saíram porque flag que não
    # existe é pior que flag ausente — ela faz o script afirmar uma
    # decisão que nunca tomou, e é a mesma armadilha que já custou duas
    # receitas nesta árvore.
    # -s (strip no link): sem ele o mke2fs e o e2fsck vão com símbolos de
    # depuração e somam 9 dos 16 MB do initramfs — medido.
    if [ "$MODE" = release ]; then
        e2fs_inner=${e2fs_src#"$ROOTFS"}
        release_run sh -c '
            cd "$1"
            CC="$2" CFLAGS="-Os -ffile-prefix-map=$1=/usr/src/e2fsprogs -fdebug-prefix-map=$1=/usr/src/e2fsprogs -fmacro-prefix-map=$1=/usr/src/e2fsprogs" LDFLAGS="-static -s" ./configure \
                --disable-nls --disable-uuidd --disable-fsck \
                --disable-defrag --disable-testio-debug >/dev/null
        ' sh "$e2fs_inner" "$RELEASE_MUSL_CC_INNER" &&
            release_run make -C "$e2fs_inner" -j"$JOBS" >/dev/null || {
            echo "erro: não compilei e2fsprogs no builder pinado" >&2; exit 1;
        }
    else
        (
            cd "$e2fs_src"
            CC="$e2fs_cc" CFLAGS="-Os -ffile-prefix-map=$e2fs_src=/usr/src/e2fsprogs -fdebug-prefix-map=$e2fs_src=/usr/src/e2fsprogs -fmacro-prefix-map=$e2fs_src=/usr/src/e2fsprogs" LDFLAGS="-static -s" ./configure \
                --disable-nls \
                --disable-uuidd \
                --disable-fsck \
                --disable-defrag \
                --disable-testio-debug >/dev/null
            make -j"$JOBS" >/dev/null
        ) || { echo "erro: não compilei o mke2fs estático" >&2; exit 1; }
    fi
    echo "$e2fs_src"
}

E2FS_SRC=$(build_static_mke2fs)
require_static "$E2FS_SRC/misc/mke2fs"
require_static "$E2FS_SRC/e2fsck/e2fsck"

# ncursesw estático, insumo do cfdisk e de mais nada.
#
# --with-fallbacks É OBRIGATÓRIO, e não afinação: o initramfs não tem
# /usr/share/terminfo, então uma ncurses que dependa da base em disco não
# desenha uma única linha. Os sete terminais listados ficam COMPILADOS no
# binário; `linux` cobre o console da máquina real e `vt100`/`xterm` cobrem
# serial e emulador, que é como o aceite roda.
build_static_ncursesw() {
    NCURSES_TAR=${NCURSES_TAR:-$WORK/ncurses-${NCURSES_VERSION}.tar.gz}
    [ -f "$NCURSES_TAR" ] || fetch "$NCURSES_URL" "$NCURSES_TAR"
    if [ "$MODE" = release ]; then
        release_regular "$NCURSES_TAR" "$NCURSES_SHA256" 'tar ncurses'
    else
        check_hash "$NCURSES_SHA256" "$NCURSES_TAR"
    fi
    validate_tar_members "$NCURSES_TAR" -tzf
    nc_src=$WORK/ncurses-${NCURSES_VERSION}
    nc_stage=$WORK/ncursesw-stage
    nc_prefix=$NCURSESW_PREFIX
    rm -rf -- "$nc_src" "$nc_stage"
    mkdir -p "$nc_src" "$nc_stage"
    tar -xzf "$NCURSES_TAR" -C "$nc_src" --strip-components=1
    nc_cc=$SELECTED_MUSL_CC
    echo "ncursesw estático: compilando com $nc_cc" >&2
    if [ "$MODE" = release ]; then
        nc_inner=${nc_src#"$ROOTFS"}
        nc_stage_inner=${nc_stage#"$ROOTFS"}
        release_run sh -c '
            cd "$1"
            CC="$2" CFLAGS="-Os -ffile-prefix-map=$1=/usr/src/ncurses -fdebug-prefix-map=$1=/usr/src/ncurses -fmacro-prefix-map=$1=/usr/src/ncurses" ./configure \
                --host=x86_64-linux-musl --prefix=/usr \
                --without-shared --with-normal --enable-widec \
                --without-cxx --without-cxx-binding --without-ada \
                --without-manpages --without-progs --without-tests \
                --without-debug --disable-db-install --enable-termcap \
                --with-fallbacks=linux,vt100,vt220,xterm,xterm-256color,screen,ansi \
                >/dev/null
        ' sh "$nc_inner" "$RELEASE_MUSL_CC_INNER" &&
            release_run make -C "$nc_inner" -j"$JOBS" >/dev/null &&
            release_run make -C "$nc_inner" DESTDIR="$nc_stage_inner" install >/dev/null || {
            echo "erro: não compilei ncursesw no builder pinado" >&2; exit 1;
        }
    else
        (
            cd "$nc_src"
            CC="$nc_cc" CFLAGS="-Os -ffile-prefix-map=$nc_src=/usr/src/ncurses -fdebug-prefix-map=$nc_src=/usr/src/ncurses -fmacro-prefix-map=$nc_src=/usr/src/ncurses" ./configure \
                --host=x86_64-linux-musl \
                --prefix=/usr \
                --without-shared --with-normal --enable-widec \
                --without-cxx --without-cxx-binding --without-ada \
                --without-manpages --without-progs --without-tests \
                --without-debug --disable-db-install --enable-termcap \
                --with-fallbacks=linux,vt100,vt220,xterm,xterm-256color,screen,ansi \
                >/dev/null
            make -j"$JOBS" >/dev/null
            make DESTDIR="$nc_stage" install >/dev/null
        ) || { echo "erro: não compilei a ncursesw estática" >&2; exit 1; }
    fi
    # O -ltinfo que o configure do util-linux insiste em pedir resolve AQUI.
    # Ver o comentário em build_static_cfdisk sobre por que isto não é gambiarra.
    ln -sf libncursesw.a "$nc_prefix/lib/libtinfo.a"
    echo "$nc_prefix"
}

# cfdisk, fdisk e sfdisk estáticos.
#
# O BusyBox tem `fdisk` e ele NÃO ESCREVE GPT — é por isso que o particionamento
# automático vive no Rust do minipax. Para o instalador oferecer particionamento
# MANUAL, porém, é preciso um particionador de verdade, e o cfdisk é o que
# existe: interface de texto, entende GPT, e cabe em 0,9 MiB estático.
#
# Os três vêm juntos porque a opção do configure é `--enable-fdisks`, no plural,
# e governa os três. O sfdisk paga o próprio peso: é o particionador
# SCRIPTÁVEL, e é por ele que um layout se descreve em texto em vez de byte a
# byte.
build_static_cfdisk() {
    ncw_prefix=$(build_static_ncursesw)
    UTIL_LINUX_TAR=${UTIL_LINUX_TAR:-$WORK/util-linux-${UTIL_LINUX_VERSION}.tar.xz}
    [ -f "$UTIL_LINUX_TAR" ] || fetch "$UTIL_LINUX_URL" "$UTIL_LINUX_TAR"
    if [ "$MODE" = release ]; then
        release_regular "$UTIL_LINUX_TAR" "$UTIL_LINUX_SHA256" 'tar util-linux'
    else
        check_hash "$UTIL_LINUX_SHA256" "$UTIL_LINUX_TAR"
    fi
    validate_tar_members "$UTIL_LINUX_TAR" -tJf
    ul_src=$WORK/util-linux-${UTIL_LINUX_VERSION}
    rm -rf -- "$ul_src"
    mkdir -p "$ul_src"
    tar -xJf "$UTIL_LINUX_TAR" -C "$ul_src" --strip-components=1
    ul_cc=$SELECTED_MUSL_CC
    echo "cfdisk estático: compilando com $ul_cc" >&2
    # --enable-fdisks, NO PLURAL. O `--enable-cfdisk` que a intuição sugere
    # não existe, e o autoconf o aceita com um "unrecognized options" no
    # meio de trezentas linhas. --disable-all-programs desliga também as
    # bibliotecas, que por isso voltam explicitamente.
    if [ "$MODE" = release ]; then
        ul_inner=${ul_src#"$ROOTFS"}
        ncw_inner=${ncw_prefix#"$ROOTFS"}
        ul_log_inner=$WORK_INNER/util-linux-configure.log
        release_run sh -c '
            cd "$1"
            CC="$2" \
            CFLAGS="-Os -I$3/include -I$3/include/ncursesw -ffile-prefix-map=$1=/usr/src/util-linux -fdebug-prefix-map=$1=/usr/src/util-linux -fmacro-prefix-map=$1=/usr/src/util-linux" \
            LDFLAGS="-static -s -L$3/lib" \
            NCURSESW_CFLAGS="-I$3/include/ncursesw" \
            NCURSESW_LIBS="-L$3/lib -lncursesw" \
            ./configure \
                --host=x86_64-linux-musl \
                --disable-shared --enable-static \
                --disable-all-programs --enable-fdisks \
                --enable-libfdisk --enable-libsmartcols \
                --enable-libblkid --enable-libuuid \
                --disable-nls --without-systemd --without-udev \
                --without-python --without-readline \
                --without-tinfo --with-ncursesw >"$4" 2>&1
        ' sh "$ul_inner" "$RELEASE_MUSL_CC_INNER" "$ncw_inner" \
            "$ul_log_inner" || {
            echo "erro: configure util-linux falhou no builder pinado" >&2; exit 1;
        }
        nao_reconhecidas=$(release_run grep -c 'unrecognized options' \
            "$ul_log_inner" || true)
        if [ "${nao_reconhecidas:-0}" -ne 0 ]; then
            echo "erro: o configure do util-linux ignorou opções:" >&2
            release_run grep 'unrecognized options' "$ul_log_inner" >&2
            exit 1
        fi
        release_run make -C "$ul_inner" -j"$JOBS" >/dev/null || {
            echo "erro: não compilei util-linux no builder pinado" >&2; exit 1;
        }
    else
        (
            cd "$ul_src"
            CC="$ul_cc" \
            CFLAGS="-Os -I$ncw_prefix/include -I$ncw_prefix/include/ncursesw -ffile-prefix-map=$ul_src=/usr/src/util-linux -fdebug-prefix-map=$ul_src=/usr/src/util-linux -fmacro-prefix-map=$ul_src=/usr/src/util-linux" \
            LDFLAGS="-static -s -L$ncw_prefix/lib" \
            NCURSESW_CFLAGS="-I$ncw_prefix/include/ncursesw" \
            NCURSESW_LIBS="-L$ncw_prefix/lib -lncursesw" \
            ./configure \
                --host=x86_64-linux-musl \
                --disable-shared --enable-static \
                --disable-all-programs --enable-fdisks \
                --enable-libfdisk --enable-libsmartcols \
                --enable-libblkid --enable-libuuid \
                --disable-nls --without-systemd --without-udev \
                --without-python --without-readline \
                --without-tinfo --with-ncursesw \
                > "$WORK/util-linux-configure.log" 2>&1
            nao_reconhecidas=$(grep -c 'unrecognized options' \
                "$WORK/util-linux-configure.log" || true)
            if [ "${nao_reconhecidas:-0}" -ne 0 ]; then
                echo "erro: o configure do util-linux ignorou opções:" >&2
                grep 'unrecognized options' "$WORK/util-linux-configure.log" >&2
                exit 1
            fi
            make -j"$JOBS" >/dev/null
        ) || { echo "erro: não compilei o cfdisk estático" >&2; exit 1; }
    fi
    echo "$ul_src"
}

# O PREFIXO DA NCURSESW ESTATICA MORA AQUI, no escopo que os dois usos enxergam.
# Ele e usado em dois lugares: a funcao que compila a ncursesw, e o inventario de
# licencas la embaixo (NCURSES_PAYLOAD_SHA256).
#
# A funcao NAO pode ser a dona do valor, e isto custou uma rodada inteira: ela roda
# em SUBSHELL DUPLO — build_static_cfdisk e chamada com $(...) e chama
# build_static_ncursesw tambem com $(...) —, entao o nc_prefix que ela define morre
# com ela. O inventario lia $nc_prefix e o `set -u` matava o script com
# "nc_prefix: parameter not set", DEPOIS de compilar o kernel inteiro.
NCURSESW_PREFIX=$WORK/ncursesw-stage/usr

UTIL_LINUX_SRC=$(build_static_cfdisk)
require_static "$UTIL_LINUX_SRC/cfdisk"
require_static "$UTIL_LINUX_SRC/sfdisk"

INITROOT=$WORK/initramfs
rm -rf -- "$INITROOT"
mkdir -p "$INITROOT/bin" "$INITROOT/dev" "$INITROOT/etc" "$INITROOT/proc" \
    "$INITROOT/sys" "$INITROOT/run" "$INITROOT/tmp" "$INITROOT/usr/bin" \
    "$INITROOT/sbin" "$INITROOT/media" "$INITROOT/target" "$INITROOT/newroot" \
    "$INITROOT/usr/share/licenses/distropica"
cp "$BUSYBOX" "$INITROOT/bin/busybox"
cp "$MINIPAX_BIN" "$INITROOT/bin/minipax"
cp "$MINITRUE_BIN" "$INITROOT/bin/minitrue"
cp "$REPO/bootstrap/live/init" "$INITROOT/init"
cp "$E2FS_SRC/misc/mke2fs" "$INITROOT/bin/mke2fs"
cp "$E2FS_SRC/e2fsck/e2fsck" "$INITROOT/bin/e2fsck"
# cfdisk para o particionamento MANUAL do instalador; sfdisk porque é o mesmo
# build e é ele que permite descrever um layout em texto. O fdisk do util-linux
# fica de fora: o do BusyBox já cobre o pouco que se faz sem GPT, e cada
# megabyte no initramfs é carregado pelo firmware a cada boot.
cp "$UTIL_LINUX_SRC/cfdisk" "$INITROOT/bin/cfdisk"
cp "$UTIL_LINUX_SRC/sfdisk" "$INITROOT/bin/sfdisk"
# mke2fs lê os perfis de recurso daqui; sem o arquivo ele cai em defaults
# compilados e não liga o conjunto de features do ext4.
cp "$E2FS_SRC/misc/mke2fs.conf" "$INITROOT/etc/mke2fs.conf"
mkdir -p "$INITROOT/usr/share/udhcpc"
cp "$REPO/newspeak/base/files/udhcpc.script" \
    "$INITROOT/usr/share/udhcpc/default.script"
cp "$REPO/LICENSE" \
    "$INITROOT/usr/share/licenses/distropica/GPL-3.0-or-later.txt"
cp "$REPO/NOTICE" "$INITROOT/usr/share/licenses/distropica/NOTICE"
cp "$REPO/LICENSING.md" \
    "$INITROOT/usr/share/licenses/distropica/LICENSING.md"
chmod 755 "$INITROOT/init" "$INITROOT/bin/busybox" \
    "$INITROOT/bin/minipax" "$INITROOT/bin/minitrue" \
    "$INITROOT/bin/mke2fs" "$INITROOT/bin/e2fsck" \
    "$INITROOT/usr/share/udhcpc/default.script"
chmod 644 "$INITROOT/usr/share/licenses/distropica/GPL-3.0-or-later.txt"
chmod 644 "$INITROOT/usr/share/licenses/distropica/NOTICE"
chmod 644 "$INITROOT/usr/share/licenses/distropica/LICENSING.md"
chmod 644 "$INITROOT/etc/mke2fs.conf"
# Antes do laço de applets: ele só cria link para nome ainda inexistente, então
# estes vencem os mkfs.ext2/mke2fs/e2fsck do busybox.
for name in mkfs.ext2 mkfs.ext3 mkfs.ext4; do
    ln -sf mke2fs "$INITROOT/bin/$name"
done
ln -sf e2fsck "$INITROOT/bin/fsck.ext4"
for applet in $("$BUSYBOX" --list); do
    case "$applet" in */*) continue ;; esac
    [ -e "$INITROOT/bin/$applet" ] || ln -s busybox "$INITROOT/bin/$applet"
done
ln -s ../bin/busybox "$INITROOT/sbin/init"
printf 'root:x:0:0:root:/root:/bin/sh\n' > "$INITROOT/etc/passwd"
printf 'root:x:0:\n' > "$INITROOT/etc/group"
printf 'nameserver 1.1.1.1\n' > "$INITROOT/etc/resolv.conf"

# Esta é a garantia sobre o ARTEFATO, não só sobre a higiene do rootfs que
# forneceu o compilador: todos os arquivos que entrarão no initramfs já estão
# materializados, e a árvore é pequena o bastante para ser percorrida inteira.
INIT_SECRET_KEY=$(find_minisign_secret "$INITROOT" 32)
if [ -n "$INIT_SECRET_KEY" ]; then
    echo "erro: chave minisign secreta entrou no initramfs" >&2
    echo "  caminho: $(printf '%s\n' "$INIT_SECRET_KEY" | sed -n '1p')" >&2
    exit 1
fi

# Na mídia interativa, tty0 precisa continuar sendo /dev/console para que os
# prompts apareçam no monitor. O artefato automatizado inverte a prioridade:
# assim toda a prova do instalador chega ao log serial do QEMU.
CMDLINE='console=ttyS0,115200 console=tty0 panic=-1 rdinit=/init'
if [ -n "$INSTALL_DEVICE" ]; then
    CMDLINE="console=tty0 console=ttyS0,115200 panic=-1 rdinit=/init"
    CMDLINE="$CMDLINE distropica.install=$INSTALL_DEVICE distropica.test=1"
fi

SOURCE=$WORK/linux-source
if [ -n "$ROOTFS" ]; then SOURCE_INNER=$WORK_INNER/linux-source; fi
rm -rf -- "$SOURCE"
mkdir -p "$SOURCE"
validate_tar_members "$LINUX_TAR" -tJf
tar -xJf "$LINUX_TAR" -C "$SOURCE" --strip-components=1

# Estas ferramentas o kernel exige de quem o constrói. Com --rootfs quem
# constrói é a Distrópica, e a conferência é lá dentro: exigi-las do
# hospedeiro seria pedir ao mantenedor que instale flex e bison para produzir
# uma distro que já os tem.
if [ -n "$ROOTFS" ]; then
    for ferramenta in make gcc flex bison pkg-config bc perl; do
        [ -e "$ROOTFS/usr/bin/$ferramenta" ] || {
            echo "erro: $ferramenta ausente no rootfs $ROOTFS" >&2; exit 1;
        }
    done
    [ -e "$ROOTFS/usr/lib/pkgconfig/libelf.pc" ] || {
        echo "erro: libelf ausente no rootfs (pkgconfig/libelf.pc)" >&2; exit 1;
    }
else
    command -v make >/dev/null 2>&1 || { echo "erro: make ausente" >&2; exit 1; }
    command -v gcc >/dev/null 2>&1 || { echo "erro: gcc ausente" >&2; exit 1; }
    command -v flex >/dev/null 2>&1 || { echo "erro: flex ausente" >&2; exit 1; }
    command -v bison >/dev/null 2>&1 || { echo "erro: bison ausente" >&2; exit 1; }
    command -v pkg-config >/dev/null 2>&1 || { echo "erro: pkg-config ausente" >&2; exit 1; }
    pkg-config --exists libelf || {
        echo "erro: headers/biblioteca libelf ausentes (pkg-config libelf)" >&2; exit 1;
    }
fi

kmake defconfig
CONFIG=$SOURCE/scripts/config
set_config() {
    "$CONFIG" --file "$SOURCE/.config" "$@"
}
# O EFI vivo nao distribui um unico .ko: todos os drivers desta imagem sao
# guardados como built-in abaixo. Desligar o carregador de modulos fecha essa
# fronteira em vez de manter uma API inutil que aceitaria bytes externos depois
# do switch_root. A reconciliacao e a guarda posteriores provam que nenhum dos
# drivers obrigatorios caiu com MODULES=n.
set_config --disable MODULES
set_config --disable DEBUG_INFO_BTF
set_config --disable LOCALVERSION_AUTO
set_config --set-str LOCALVERSION "-distropica-live"
set_config --disable IKCONFIG
# SOUND SAIU DESTA LISTA. Ele estava aqui por tamanho, junto com o resto que
# a mídia não usa — e a conta fazia sentido enquanto este kernel só instalava.
# Não faz mais: ele é o kernel que o sistema INSTALADO boota, e um desktop com
# Firefox e sem áudio não é um desktop. O custo medido do stack HDA builtin é
# de algumas centenas de KiB num EFI de 17 MiB.
for symbol in NETWORK_FILESYSTEMS NFS_FS SECURITY_SELINUX \
    IO_URING HIBERNATION SUSPEND KEXEC KEXEC_FILE CRASH_DUMP CGROUPS \
    PERF_EVENTS FTRACE BPF_SYSCALL NUMA CPU_FREQ WIRELESS; do
    set_config --disable "$symbol"
done
# Wi-Fi. BUILTIN, e não em módulo — e essa diferença é o defeito inteiro.
#
# O newspeak/linux constrói estes drivers como '=m', com um argumento correto
# para ELE: módulo não carregado não ocupa memória em máquina que não tem
# aquele rádio. Só que quem boota o sistema instalado é ESTE kernel, e ele não
# instala módulo em lugar nenhum — o initramfs não leva nenhum, e o EFI é um
# bzImage só. Os módulos que existem no disco estão em /lib/modules/7.1.8, do
# pacote linux, e o kernel em execução é 7.1.8-distropica-live: o modprobe
# procura pela versão em execução e não acha nada.
#
# O resultado medido era o pior tipo de meia-verdade: a pilha 802.11 presente
# (WLAN, CFG80211, MAC80211, RFKILL builtin), o firmware de 65 MiB embarcado na
# mídia, o iwd instalado — e ZERO drivers, então nenhuma interface de rádio
# aparecia e não havia o que configurar. Sessenta e cinco megabytes de firmware
# para hardware que ninguém conseguia acionar.
#
# Builtin custa tamanho no EFI e resolve isso de vez. A alternativa honesta
# seria instalar os módulos deste kernel no alvo, o que exige o build-efi
# emiti-los e o instalador depositá-los — mudança maior, e que não muda o que
# o usuário obtém no fim.
for symbol in WLAN CFG80211 MAC80211 RFKILL \
    WLAN_VENDOR_INTEL IWLWIFI IWLDVM IWLMVM \
    WLAN_VENDOR_ATH ATH9K ATH9K_PCI ATH9K_HTC ATH10K ATH10K_PCI \
    ATH11K ATH11K_PCI \
    WLAN_VENDOR_REALTEK RTL8XXXU RTW88 RTW88_8822BE RTW88_8822CE \
    RTW88_8821CE RTW89 RTW89_8852AE RTW89_8852BE RTW89_8852CE \
    CRYPTO_USER_API CRYPTO_USER_API_HASH CRYPTO_USER_API_SKCIPHER \
    CRYPTO_AES CRYPTO_CBC CRYPTO_CTR CRYPTO_ECB CRYPTO_CMAC CRYPTO_HMAC \
    CRYPTO_DES \
    CRYPTO_MD4 CRYPTO_MD5 CRYPTO_SHA1 CRYPTO_SHA256 CRYPTO_SHA512 \
    KEY_DH_OPERATIONS ASYMMETRIC_KEY_TYPE X509_CERTIFICATE_PARSER \
    FW_LOADER; do
    set_config --enable "$symbol"
done

# Áudio. Builtin, como todo o resto: o initramfs não leva módulo, e um driver
# de som em módulo não seria carregado por ninguém.
#
# Três controladoras, porque três é o que se encontra:
#   SND_HDA_INTEL   Intel HD Audio — o padrão em máquina real, o
#                   '-device intel-hda' do QEMU e a opção "Intel HD Audio" do
#                   VirtualBox
#   SND_INTEL8X0    AC'97, que é o default de VM antiga e do VirtualBox
#   SND_ENS1371     a Ensoniq que o VirtualBox oferece como SoundBlaster 16
#
# Os codecs importam tanto quanto a controladora. GENERIC cobre o que a VM
# emula; REALTEK cobre a maioria das máquinas reais; HDMI cobre monitor. Mas
# Analog Devices, IDT/Sigmatel, VIA, Conexant, Senarytech, Creative, C-Media e
# Cirrus têm drivers próprios para os quirks de pinos e amplificadores. Sem
# eles a placa pode aparecer em /proc/asound e continuar sem saída analógica.
# O 7.1 reorganizou o HDA para sound/hda/, e os nomes abaixo foram LIDOS do
# Kconfig de lá. Esta lista já esteve errada DUAS VEZES, em direções opostas, e
# vale registrar as duas porque o modo de errar é o mesmo:
#
#   1. SND_HDA_CODEC_GENERIC foi inventado. O certo é SND_HDA_GENERIC, e a
#      guarda derrubou o build — funcionou.
#   2. Ao consertar, concluí que SND_HDA_CODEC_REALTEK e SND_HDA_CODEC_HDMI
#      também não existiam, e os troquei por dez símbolos ALC* mais dois
#      HDMI_*. ELES EXISTEM: são declarados com 'menuconfig' e não com
#      'config', e o grep que usei procurava '^config '. Como não estavam na
#      lista de guardas, o set_config aceitou os doze nomes em silêncio, o
#      olddefconfig os descartou por serem invisíveis sem o guarda-chuva, e o
#      kernel saiu com UM codec: sound/hda/codecs/generic.o. Som em VM, nada de
#      ajuste em máquina real — e nenhuma mensagem em lugar nenhum.
#
# Por isso os guarda-chuvas entram aqui E na lista de guardas lá embaixo. Os
# codecs que o Kconfig declara como `config`, e não `menuconfig`, entram
# explicitamente: ligar REALTEK nunca ligaria CONEXANT por consequência.
#
# SND_HDA_GENERIC continua sendo o que importa para máquina virtual: é o
# analisador de fallback, que dirige codec sem driver específico, e é ele que
# faz som sair no QEMU e no VirtualBox.
# SND_VIRTIO é a quarta controladora, e a única que o QEMU moderno oferece por
# padrão quando se pede áudio sem escolher placa: '-device virtio-sound-pci'.
# Estava desligada, e o efeito era o mesmo das outras ausências desta lista —
# uma máquina onde o áudio simplesmente não existe, sem uma linha dizendo por
# quê. As três dependências foram CONFERIDAS na config viva antes de acrescentar
# o símbolo, e não deduzidas: VIRTIO=y, SND_PCM=y e SND_JACK=y já estavam lá, e
# o próprio Kconfig de sound/virtio declara SND_VIRTIO como 'config' — não como
# 'menuconfig', que foi a armadilha que já custou os codecs HDA duas vezes.
for symbol in SOUND SND SND_PCM SND_TIMER SND_HRTIMER \
    SND_HDA SND_HDA_INTEL SND_HDA_GENERIC \
    SND_HDA_CODEC_REALTEK SND_HDA_CODEC_HDMI SND_HDA_CODEC_CIRRUS \
    SND_HDA_CODEC_CS8409 SND_HDA_CODEC_ANALOG SND_HDA_CODEC_SIGMATEL \
    SND_HDA_CODEC_VIA SND_HDA_CODEC_CONEXANT SND_HDA_CODEC_SENARYTECH \
    SND_HDA_CODEC_CA0110 SND_HDA_CODEC_CMEDIA SND_HDA_CODEC_CM9825 \
    SND_INTEL8X0 SND_ENS1371 SND_USB_AUDIO SND_VIRTIO; do
    set_config --enable "$symbol"
done
# Hardware amd64 real. Até aqui o perfil cobria máquina virtual: virtio, AHCI
# e teclado PS/2. Numa máquina de verdade isso não basta e falha do pior jeito
# possível — o instalador sobe e não encontra disco, ou sobe e não aceita
# tecla. Tudo builtin: o initramfs não leva módulo.
#
#   NVMe e VMD: disco de qualquer laptop/desktop moderno. Sem VMD o NVMe fica
#     invisível nas máquinas Intel que o escondem atrás dele.
#   USB (xHCI/EHCI, storage, HID): teclado de desktop sem PS/2 e — mais
#     importante — a própria mídia, quando gravada em pendrive.
#   MMC/SDHCI: armazenamento de tablets e notebooks pequenos.
#   NICs com fio mais comuns (Intel e Realtek). Wi-Fi continua fora: exige
#     blob de firmware, que é outra decisão.
#   CPU_IDLE/INTEL_IDLE: sem estados de baixa energia, um laptop instala
#     quente e com a ventoinha a plena carga.
#   MICROCODE: sem os blobs é inócuo, mas é o gancho para carregá-los.
for symbol in BLK_DEV_NVME NVME_CORE VMD ATA_GENERIC \
    MMC MMC_BLOCK MMC_SDHCI MMC_SDHCI_PCI \
    USB_SUPPORT USB USB_PCI USB_XHCI_HCD USB_XHCI_PCI USB_EHCI_HCD \
    USB_EHCI_PCI USB_STORAGE USB_UAS HID HID_GENERIC USB_HID \
    E1000 E1000E IGB IGC R8169 \
    CPU_IDLE INTEL_IDLE MICROCODE ACPI_BUTTON; do
    set_config --enable "$symbol"
done
# Perfil de rede do sistema INSTALADO. Este kernel não é só o do instalador:
# a ESP do alvo recebe este mesmo BOOTX64.EFI, então é ele que roda depois do
# boot. Ligar os knobs em newspeak/linux não muda nada enquanto isso for
# verdade — e embarcar nftables e wireguard-tools contra um kernel sem
# NETFILTER nem WIREGUARD seria distribuir userspace que não tem com o que
# falar. Espelha o que o alvo declara; a divergência acaba quando o instalado
# passar a bootar o próprio kernel.
for symbol in USER_NS TUN WIREGUARD \
    NETFILTER NETFILTER_ADVANCED NETFILTER_NETLINK NF_CONNTRACK \
    NF_TABLES NF_TABLES_INET NFT_CT NFT_FIB NFT_FIB_INET \
    NFT_FIB_IPV4 NFT_FIB_IPV6 IPV6 IPV6_MULTIPLE_TABLES; do
    set_config --enable "$symbol"
done
set_config --set-str SYSTEM_TRUSTED_KEYS ""
set_config --set-str SYSTEM_REVOCATION_KEYS ""
set_config --set-str INITRAMFS_SOURCE \
    "distropica-initramfs distropica-devices.list"
# A ausência de compressão é parte do contrato de prova: o intervalo
# `.init.ramfs` do ELF pode ser comparado diretamente ao newc que contém
# LIVE_COMPONENTS, sem delegar a associação a um descompressor externo.
set_config --enable INITRAMFS_COMPRESSION_NONE
for symbol in INITRAMFS_COMPRESSION_GZIP INITRAMFS_COMPRESSION_BZIP2 \
    INITRAMFS_COMPRESSION_LZMA INITRAMFS_COMPRESSION_XZ \
    INITRAMFS_COMPRESSION_LZO INITRAMFS_COMPRESSION_LZ4 \
    INITRAMFS_COMPRESSION_ZSTD; do
    set_config --disable "$symbol"
done
# -1 é a convenção do kernel para mapear o uid/gid do produtor para root no
# arquivo gerado. Ao contrário de `id -u`, deixa .config e CPIO idênticos sob
# builders que executem com IDs diferentes.
set_config --set-val INITRAMFS_ROOT_UID -1
set_config --set-val INITRAMFS_ROOT_GID -1
set_config --enable CMDLINE_BOOL
set_config --set-str CMDLINE "$CMDLINE"
for symbol in EFI EFI_STUB BLK_DEV_INITRD DEVTMPFS DEVTMPFS_MOUNT TMPFS \
    PROC_FS SYSFS UNIX INET PACKET PCI VIRTIO VIRTIO_PCI VIRTIO_BLK \
    VIRTIO_NET SCSI BLK_DEV_SD BLK_DEV_SR ATA SATA_AHCI ATA_PIIX \
    MSDOS_PARTITION EFI_PARTITION EXT4_FS EXT4_USE_FOR_EXT2 FAT_FS \
    MSDOS_FS VFAT_FS NLS_CODEPAGE_437 NLS_ISO8859_1 ISO9660_FS \
    SERIAL_8250 SERIAL_8250_CONSOLE SYSFB_SIMPLEFB DRM_SIMPLEDRM \
    DRM_FBDEV_EMULATION DRM_CLIENT_DEFAULT_FBDEV FRAMEBUFFER_CONSOLE \
    INPUT_KEYBOARD KEYBOARD_ATKBD SERIO SERIO_I8042 VT VT_CONSOLE \
    VGA_CONSOLE FONT_SUPPORT FONT_8x16; do
    set_config --enable "$symbol"
done
# Drivers de KMS por hardware, espelhando newspeak/linux pelo mesmo motivo do
# bloco de rede acima: quem boota o sistema INSTALADO é este kernel, o
# instalador exporta este EFI para a ESP, e por isso ligar os knobs lá não
# muda nada enquanto a divergência existir. Foi medido: um sistema instalado
# reporta 'Linux version 7.1.8-distropica-live'.
#
# O simpledrm sozinho já entrega /dev/dri/card0 a partir do framebuffer que a
# firmware EFI deixa pronto, e é com ele que o weston sobe hoje — mas ele NÃO
# faz modeset: a resolução fica congelada na que a firmware escolheu e
# redimensionar a janela da máquina virtual não muda nada. Cada driver abaixo
# cobre uma máquina real: vmwgfx é a VMSVGA do VirtualBox e do VMware,
# vboxvideo é a placa legada do VirtualBox, bochs é a '-vga std' do QEMU e
# virtio_gpu é a '-device virtio-gpu-pci'.
for symbol in DRM_VMWGFX DRM_VBOXVIDEO DRM_BOCHS DRM_VIRTIO_GPU; do
    set_config --enable "$symbol"
done
kmake olddefconfig
grep -q '^CONFIG_CMDLINE_BOOL=y$' "$SOURCE/.config" || {
    echo "erro: kernel descartou CONFIG_CMDLINE_BOOL=y" >&2; exit 1;
}
grep -q '^# CONFIG_MODULES is not set$' "$SOURCE/.config" || {
    echo "erro: kernel vivo nao fixou CONFIG_MODULES=n" >&2; exit 1;
}
grep -q '^CONFIG_LOCALVERSION="-distropica-live"$' "$SOURCE/.config" || {
    echo "erro: kernel descartou o release isolado da mídia" >&2; exit 1;
}
grep -q '^CONFIG_INITRAMFS_ROOT_UID=-1$' "$SOURCE/.config" || {
    echo "erro: UID do initramfs não foi normalizado para root" >&2; exit 1;
}
grep -q '^CONFIG_INITRAMFS_ROOT_GID=-1$' "$SOURCE/.config" || {
    echo "erro: GID do initramfs não foi normalizado para root" >&2; exit 1;
}
grep -q '^CONFIG_INITRAMFS_COMPRESSION_NONE=y$' "$SOURCE/.config" || {
    echo "erro: kernel não fixou initramfs newc sem compressão" >&2; exit 1;
}
grep -Fqx "CONFIG_CMDLINE=\"$CMDLINE\"" "$SOURCE/.config" || {
    echo "erro: kernel descartou a cmdline viva" >&2; exit 1;
}
for symbol in EFI EFI_STUB BLK_DEV_INITRD VIRTIO_BLK VIRTIO_NET BLK_DEV_SR \
    SATA_AHCI EXT4_FS EXT4_USE_FOR_EXT2 VFAT_FS NLS_CODEPAGE_437 \
    NLS_ISO8859_1 ISO9660_FS SERIAL_8250_CONSOLE SYSFB_SIMPLEFB \
    DRM_SIMPLEDRM DRM_FBDEV_EMULATION DRM_CLIENT_DEFAULT_FBDEV \
    FRAMEBUFFER_CONSOLE SYSFB DRM_SYSFB_HELPER DRM_CLIENT_SELECTION \
    DRM_CLIENT_LIB DRM_CLIENT DRM_CLIENT_SETUP DRM_KMS_HELPER \
    DRM_GEM_SHMEM_HELPER FB_CORE FRAMEBUFFER_CONSOLE_DETECT_PRIMARY \
    VT_HW_CONSOLE_BINDING CRC32 INPUT_KEYBOARD KEYBOARD_ATKBD SERIO \
    SERIO_I8042 VT VT_CONSOLE VGA_CONSOLE FONT_SUPPORT FONT_8x16 \
    BLK_DEV_NVME USB_XHCI_HCD USB_XHCI_PCI USB_STORAGE USB_HID HID_GENERIC \
    E1000E R8169 \
    DRM_VMWGFX DRM_VBOXVIDEO DRM_BOCHS DRM_VIRTIO_GPU \
    SOUND SND SND_PCM SND_HDA SND_HDA_INTEL SND_HDA_GENERIC SND_INTEL8X0 \
    SND_ENS1371 SND_USB_AUDIO SND_HDA_CODEC_REALTEK SND_HDA_CODEC_HDMI \
    SND_HDA_CODEC_CIRRUS SND_HDA_CODEC_CS8409 SND_HDA_CODEC_ANALOG \
    SND_HDA_CODEC_SIGMATEL SND_HDA_CODEC_VIA SND_HDA_CODEC_CONEXANT \
    SND_HDA_CODEC_SENARYTECH SND_HDA_CODEC_CA0110 SND_HDA_CODEC_CMEDIA \
    SND_HDA_CODEC_CM9825 \
    SND_VIRTIO \
    IWLWIFI IWLMVM ATH9K ATH10K RTW88 RTW89 RTL8XXXU FW_LOADER \
    CRYPTO_USER_API_SKCIPHER CRYPTO_CBC CRYPTO_ECB CRYPTO_DES \
    USER_NS TUN WIREGUARD NETFILTER NF_TABLES NF_TABLES_INET NFT_CT \
    NFT_FIB_INET NF_CONNTRACK IPV6 IPV6_MULTIPLE_TABLES; do
    grep -q "^CONFIG_${symbol}=y$" "$SOURCE/.config" || {
        echo "erro: kernel não fixou CONFIG_${symbol}=y" >&2; exit 1;
    }
done

# Raiz factual dos componentes, gerada somente depois do olddefconfig. O
# próprio bzImage não pode aparecer aqui: ele contém este manifesto e criaria
# um ciclo. Linux fica preso pelo tar oficial + .config efetiva + contrato; o
# LIVE_LOCK sem ciclo prende o hash do bzImage final.
sha_join() {
    sha256sum | awk '{print $1}'
}
sha_path() {
    sha256sum -- "$1" | awk '{print $1}'
}

EMPTY_SHA256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
BUILD_CONTRACT_SHA256=$({
    sha_path "$REPO/bootstrap/live/build-efi"
    sha_path "$LIVE_LOCK_SOURCE"
    sha_path "$LIVE_LOCK_HELPER_SOURCE"
    sha_path "$LIVE_LOCK_TOOL"
    sha_path "$BUSYBOX_CONFIG"
    printf '%s\n' \
        'LIVE_COMPONENTS_FORMAT=1' 'LIVE_LOCK_FORMAT=1' \
        'linux-payload=source+effective-config;efi-payload=live-lock' \
        'busybox=official-source+versioned-config+static-musl'
} | sha_join)

BUSYBOX_BINARY_SHA256=$(sha_path "$BUSYBOX")
E2FS_PAYLOAD_SHA256=$({
    sha_path "$E2FS_SRC/misc/mke2fs"
    sha_path "$E2FS_SRC/e2fsck/e2fsck"
    sha_path "$E2FS_SRC/misc/mke2fs.conf"
} | sha_join)
E2FS_CONFIG_SHA256=$({
    sha_path "$E2FS_SRC/misc/mke2fs.conf"
    printf '%s\n' '--disable-nls --disable-uuidd --disable-fsck --disable-defrag --disable-testio-debug' 'LDFLAGS=-static -s'
} | sha_join)
NCURSES_CONFIG_SHA256=$(printf '%s\n' \
    '--without-shared --with-normal --enable-widec --without-cxx --without-cxx-binding --without-ada --without-manpages --without-progs --without-tests --without-debug --disable-db-install --enable-termcap' \
    '--with-fallbacks=linux,vt100,vt220,xterm,xterm-256color,screen,ansi' | sha_join)
UTIL_LINUX_PAYLOAD_SHA256=$({
    sha_path "$UTIL_LINUX_SRC/cfdisk"
    sha_path "$UTIL_LINUX_SRC/sfdisk"
} | sha_join)
UTIL_LINUX_CONFIG_SHA256=$(printf '%s\n' \
    '--disable-shared --enable-static --disable-all-programs --enable-fdisks' \
    '--enable-libfdisk --enable-libsmartcols --enable-libblkid --enable-libuuid' \
    '--disable-nls --without-systemd --without-udev --without-python --without-readline --without-tinfo --with-ncursesw' \
    'CFLAGS=-Os;LDFLAGS=-static -s' | sha_join)
LINUX_CONFIG_SHA256=$(sha_path "$SOURCE/.config")
SCRIPTS_SHA256=$({
    sha_path "$REPO/bootstrap/live/init"
    sha_path "$REPO/newspeak/base/files/udhcpc.script"
} | sha_join)

# O checkout pode ser compartilhado por grupo (este workspace é 0775). O
# parser de identidade não o trata como pai trusted: cria snapshots privados,
# com modos normalizados, e mede somente esses snapshots. Em release os
# executores são prebuilt/pinados; estes trees são provenance identity-only.
SOURCE_IDENTITY_STAGE=$WORK/live-source-identities
rm -rf -- "$SOURCE_IDENTITY_STAGE"
mkdir -m 0700 "$SOURCE_IDENTITY_STAGE"
for source_identity in minipax-src minitrue-src vendor-scrypt; do
    mkdir -m 0700 "$SOURCE_IDENTITY_STAGE/$source_identity"
done
cp -a "$REPO/minipax/src/." "$SOURCE_IDENTITY_STAGE/minipax-src/"
cp -a "$REPO/minitrue/src/." "$SOURCE_IDENTITY_STAGE/minitrue-src/"
cp -a "$REPO/minitrue/vendor-scrypt/." "$SOURCE_IDENTITY_STAGE/vendor-scrypt/"
find "$SOURCE_IDENTITY_STAGE" -type d -exec chmod 0700 {} +
find "$SOURCE_IDENTITY_STAGE" -type f -exec chmod 0600 {} +
MINIPAX_SRC_TREE_SHA256=$("$LIVE_LOCK_TOOL" tree-hash \
    "$SOURCE_IDENTITY_STAGE/minipax-src")
MINITRUE_SRC_TREE_SHA256=$("$LIVE_LOCK_TOOL" tree-hash \
    "$SOURCE_IDENTITY_STAGE/minitrue-src")
VENDOR_SCRYPT_SHA256=$("$LIVE_LOCK_TOOL" tree-hash \
    "$SOURCE_IDENTITY_STAGE/vendor-scrypt")
CARGO_LOCKS_SHA256=$({
    sha_path "$REPO/minipax/Cargo.lock"
    sha_path "$REPO/minitrue/Cargo.lock"
} | sha_join)
MINIPAX_CRATES_SHA256=$({
    sha_path "$REPO/minipax/Cargo.toml"
    sha_path "$REPO/minipax/Cargo.lock"
    printf '%s\n' "$MINIPAX_SRC_TREE_SHA256"
} | sha_join)
MINITRUE_CRATES_SHA256=$({
    sha_path "$REPO/minitrue/Cargo.toml"
    sha_path "$REPO/minitrue/Cargo.lock"
    printf '%s\n' "$MINITRUE_SRC_TREE_SHA256" "$VENDOR_SCRYPT_SHA256"
} | sha_join)

# A identidade observada de development é útil para diagnóstico, mas nunca é
# promovida a release. Release usa exclusivamente os pinos já validados.
if [ "$MODE" = release ]; then
    BUILDER_IDENTITY_HASH=$BUILDER_LOCK_SHA256
    BUILDER_PAYLOAD_HASH=$BUILDER_ROOTFS_SHA256
    BUILDER_TOOLCHAIN_ID=builder-$BUILDER_ID
    MUSL_INPUT_SHA256=$ZIG_TAR_EXPECTED
    MUSL_PAYLOAD_SHA256=$MUSL_TREE_SHA256
    MUSL_CONFIG_SHA256=$MUSL_TREE_SHA256
    MUSL_TOOLCHAIN_HASH=$({
        printf '%s\n' "$ZIG_TAR_EXPECTED" "$ZIG_BIN_SHA256" "$MUSL_TREE_SHA256"
    } | sha_join)
    MUSL_TOOLCHAIN_ID=zig-${ZIG_VERSION}-x86_64-linux-musl
    ZIG_INPUT_SHA256=$ZIG_TAR_EXPECTED
    ZIG_PAYLOAD_SHA256=$ZIG_BIN_SHA256
    ZIG_VARIANT=official-release-tar
else
    cc_first=$(printf '%s\n' "$SELECTED_MUSL_CC" | awk '{print $1}')
    cc_path=$(command -v "$cc_first" 2>/dev/null || true)
    cc_file_hash=$EMPTY_SHA256
    [ -z "$cc_path" ] || cc_file_hash=$(sha_path "$cc_path")
    cc_driver_id=$(basename -- "$cc_first")
    musl_probe_contract=$(printf '%s\n' \
        'compile:-static:x86_64-linux-musl' \
        'reject-preprocessor:__GLIBC__' 'reject-elf-program-header:INTERP' | sha_join)
    MUSL_TOOLCHAIN_HASH=$({
        printf '%s\n' "$cc_driver_id" "$cc_file_hash" "$musl_probe_contract"
    } | sha_join)
    BUILDER_IDENTITY_HASH=$({
        for build_command in make gcc flex bison pkg-config bc perl; do
            build_path=$(command -v "$build_command" 2>/dev/null || true)
            if [ -n "$build_path" ] && [ -f "$build_path" ]; then
                printf '%s|' "$build_command"
                sha_path "$build_path"
            else
                printf '%s|%s\n' "$build_command" "$EMPTY_SHA256"
            fi
        done
    } | sha_join)
    BUILDER_TOOLCHAIN_ID=development-observed-builder
    BUILDER_PAYLOAD_HASH=$BUILDER_IDENTITY_HASH
    MUSL_INPUT_SHA256=$cc_file_hash
    MUSL_PAYLOAD_SHA256=$cc_file_hash
    MUSL_CONFIG_SHA256=$musl_probe_contract
    MUSL_TOOLCHAIN_ID=development-observed-musl
    ZIG_INPUT_SHA256=$EMPTY_SHA256
    ZIG_PAYLOAD_SHA256=$EMPTY_SHA256
    ZIG_VARIANT=not-pinned-development
fi

MINIPAX_INPUT_SHA256=$MINIPAX_CRATES_SHA256
MINITRUE_INPUT_SHA256=$MINITRUE_CRATES_SHA256
