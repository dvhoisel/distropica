is_sha256() {
    case "$1" in *[!0-9a-f]*|'') return 1 ;; esac
    [ "${#1}" -eq 64 ]
}

release_trusted_parent() {
    input_parent=$(dirname -- "$1")
    logical_parent=$(realpath -s -- "$input_parent" 2>/dev/null) || return 1
    physical_parent=$(realpath -e -- "$input_parent" 2>/dev/null) || return 1
    [ "$logical_parent" = "$physical_parent" ] || return 1
    [ -d "$physical_parent" ] && [ ! -L "$physical_parent" ] || return 1
    [ "$(stat -c '%u' -- "$physical_parent")" = "$(id -u)" ] || return 1
    parent_mode=$(stat -c '%a' -- "$physical_parent") || return 1
    parent_mode=$(printf '%s\n' "$parent_mode" | sed 's/.*\(...\)$/\1/')
    parent_group=$(printf '%s' "$parent_mode" | cut -c2)
    parent_other=$(printf '%s' "$parent_mode" | cut -c3)
    case "$parent_group$parent_other" in *2*|*3*|*6*|*7*) return 1 ;; esac
    return 0
}

