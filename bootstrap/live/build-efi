build_rust_binary() {
    package=$1
    manifest=$REPO/$package/Cargo.toml
    destination=$WORK/cargo-$package
    cargo_feature_flags=
    [ "$package" != minitrue ] || cargo_feature_flags=--no-default-features
    CARGO_TARGET_DIR=$destination cargo build --locked --release \
        --target "$RUST_TARGET" $cargo_feature_flags --manifest-path "$manifest"
