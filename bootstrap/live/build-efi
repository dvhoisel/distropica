    echo "erro: kernel não materializou blob/cpio do initramfs" >&2; exit 1;
}
"$LIVE_LOCK_TOOL" compare "$INITRAMFS_BLOB" "$INITRAMFS_CPIO"
EXTRACTOR_SHA256=$(sha_path "$SOURCE/scripts/extract-vmlinux")
EMBED_PROOF=$WORK/LIVE_EMBED_PROOF
"$LIVE_LOCK_TOOL" embed-proof "$BUILT" "$VMLINUX" "$INITRAMFS_BLOB" \
    "$INITRAMFS_BLOB" "$INITRAMFS_CPIO" "$LIVE_COMPONENTS" \
    "$EXTRACTOR_SHA256" "$EMBED_PROOF"
LIVE_LOCK=$WORK/LIVE_LOCK
"$LIVE_LOCK_TOOL" lock "$BUILT" "$LIVE_COMPONENTS" "$RUNNER_PROOF" \
    "$EMBED_PROOF" "$EFI_PAYLOAD_LICENSE" \
    "$MATERIAL_LICENSE_EVIDENCE_SHA256" "$LIVE_LOCK"

output_parent=$(dirname -- "$OUTPUT")
output_name=$(basename -- "$OUTPUT")
case "$output_name" in ""|.|..) echo "erro: nome de saída inválido" >&2; exit 1 ;; esac
if [ "$MODE" = release ]; then
    [ -d "$output_parent" ] && [ ! -L "$output_parent" ] || {
        echo "erro: release exige pai da saída previamente existente" >&2; exit 1;
    }
    release_trusted_parent "$OUTPUT" || {
        echo "erro: pai da saída release não é real/privado/do euid" >&2; exit 1;
    }
fi
output_parent=$(CDPATH= cd -- "$output_parent" && pwd -P)
OUTPUT=$output_parent/$output_name
[ ! -e "$OUTPUT" ] && [ ! -L "$OUTPUT" ] || {
    echo "erro: saída apareceu durante o build: $OUTPUT" >&2; exit 1;
}
"$LIVE_LOCK_TOOL" publish "$BUILT" "$LIVE_COMPONENTS" "$RUNNER_PROOF" \
    "$EMBED_PROOF" "$LIVE_LOCK" "$OUTPUT"
"$LIVE_LOCK_TOOL" verify "$OUTPUT" "$OUTPUT.live-components" \
    "$OUTPUT.live-runner-proof" "$EMBED_PROOF" "$OUTPUT.live-lock"
echo "BOOTX64.EFI vivo: $OUTPUT"
echo "modo do EFI vivo: $MODE"
[ "$MODE" = release ] || echo 'aviso: saída development; não é artefato de release'
sha256sum "$OUTPUT"
sha256sum "$OUTPUT.live-components" "$OUTPUT.live-runner-proof" \
    "$OUTPUT.live-lock"
if [ "$KEEP_WORK" = yes ]; then echo "work preservado: $WORK"; fi
