#!/bin/sh
# Confere a versão pinada de CADA receita contra o estável mais novo do upstream
# e também versões literais de fontes secundárias em receitas compostas.
#
# Exigência de publicação da SPEC-0011 §7.1, e o mecanismo que faltava à P7. A
# premissa "sempre o estável mais recente" existia desde a SPEC-0001 e foi
# violada em silêncio: a 0.12 saiu com o kernel 7.1.4 enquanto o kernel.org
# publicava o 7.1.8. Nada acusou, porque nenhum guarda da árvore olha para FORA
# dela — a receita não sabe que existe versão mais nova, os aceites provam que a
# mídia instala e não que está atual, e o `channel emit` audita fechamento de
# dependências, não idade. Este script olha.
#
# CINCO VEREDITOS, E OS CINCO APARECEM:
#
#   atual        pinado == estável mais novo
#   atrasado     há estável mais novo, e nenhuma ressalva registrada
#   pinado       há estável mais novo E existe newspeak/<pkg>/versao-pinada
#                explicando por quê — a ressalva pragmática da P7
#   ?            NAO CONFERIDO: o upstream respondeu e não deu para ler
#   !            CONSULTA FALHOU: não se chegou ao upstream (HTTP no motivo)
#
# '?' E '!' SÃO CATEGORIAS DIFERENTES, e separá-las foi conserto, não enfeite.
# Enquanto eram uma só, a lista mudava de composição a cada rodada sem que nada
# mudasse na árvore — 8 numa, 23 na seguinte —, e lista que muda sozinha não dá
# para agir em cima. São problemas de naturezas opostas: o '!' é o 403 de limite
# de taxa do GitHub, é do minuto e some sozinho ao rodar de novo; o '?' é defeito
# DESTA ferramenta, não some sozinho, e cada um só sai daqui com código novo —
# foi assim que caíram os dois últimos, o '-stable' do libevent e o '3.7b' do
# tmux, ambos com a árvore JÁ atual e o conferidor sem saber ler.
#
# As duas são listadas por nome no fim, nunca somadas num total. Um relatório
# que diz "112 de 135 conferidos" e cala sobre os 23 faz parecer conferido o que
# não foi.
#
# A RESSALVA MORA FORA DA RECEITA pelo mesmo motivo do `fontes-correspondentes`:
# o FINGERPRINT cobre o texto do recipe, e acrescentar um campo lá recompilaria
# o pacote e tudo o que depende dele sem que uma linha de código mudasse.
set -u
umask 022
LC_ALL=C
export LC_ALL

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
TSV=
SO_PROBLEMAS=no
CACHE=${VERSOES_CACHE:-${TMPDIR:-/tmp}/distropica-versoes-cache}
ESPERA=25

usage() {
    cat <<'EOF'
uso: bootstrap/versoes [--tsv ARQ] [--so-problemas] [--espera N]

  --tsv ARQ       grava o relatório legível por máquina
  --so-problemas  imprime só o que não está atual
  --espera N      segundos de teto por consulta (default: 25)

Sai 0 quando tudo está atual ou pinado com motivo; 1 quando há atrasado sem
ressalva; 2 quando algo não pôde ser conferido. O maior vence.

O cache de respostas vive em $TMPDIR/distropica-versoes-cache e evita repetir
consulta na mesma sessão. Apague-o para forçar releitura.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --tsv) TSV=${2:?}; shift 2 ;;
        --so-problemas) SO_PROBLEMAS=sim; shift ;;
        --espera) ESPERA=${2:?}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "erro: opção desconhecida: $1" >&2; usage >&2; exit 1 ;;
    esac
done

command -v curl >/dev/null 2>&1 || { echo "erro: curl é necessário" >&2; exit 1; }
mkdir -p "$CACHE"

# Onde o `busca` deixa recado quando a REQUISIÇÃO falha. É arquivo, e não
# variável, porque `upstream_de` é chamado dentro de `$( )`: o handler roda em
# subshell e nada que ele atribua volta para o laço.
FALHAS=$CACHE/.falhas.$$
trap 'rm -f "$FALHAS"' EXIT INT TERM

# Lê um campo do recipe juntando as linhas terminadas em '\'. Mesma regra do
# `source-bundle`, e pela mesma razão: o rust escreve cinco fontes em cinco
# linhas, e um `grep | head -1` lê só a primeira.
campo() {
    awk -v chave="$2" '
        $0 ~ "^" chave "=" { dentro = 1 }
        dentro {
            linha = $0
            sub(/^[A-Za-z0-9_]+=/, "", linha)
            cont = (linha ~ /\\[[:space:]]*$/)
            sub(/\\[[:space:]]*$/, "", linha)
            gsub(/"/, "", linha)
            texto = texto " " linha
            if (!cont) {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", texto)
                gsub(/[[:space:]]+/, " ", texto)
                print texto
                exit
            }
        }
    ' "$1"
}

# Extrai "componente|versão" de um tarball/zip cujo nome traz uma versão
# literal. Esta é a forma das fontes secundárias de mathlibs-glibc:
# mpfr-4.2.2.tar.xz e mpc-1.4.1.tar.xz. Falhar em reconhecer NÃO autoriza
# ignorar a fonte: o chamador a transforma em "não conferido" e fecha o gate.
versao_fixa_da_fonte() {  # url
    arquivo=${1##*/}
    arquivo=${arquivo%%\?*}
    case "$arquivo" in
        *.tar.*) base=${arquivo%.tar.*} ;;
        *.tgz)   base=${arquivo%.tgz} ;;
        *.zip)   base=${arquivo%.zip} ;;
        *) return 1 ;;
    esac
    printf '%s\n' "$base" | sed -n \
        -e 's/^\(.*\)-v\([0-9][0-9A-Za-z._+~-]*\)$/\1|\2/p' \
        -e 's/^\(.*\)-\([0-9][0-9A-Za-z._+~-]*\)$/\1|\2/p'
}

# Emite "rótulo|versão|url|erro" para cada versão que precisa ser consultada.
# A primeira fonte representa VERSION e conserva o comportamento histórico.
# Fonte secundária que também usa $VERSION (os quatro componentes adicionais
# do Rust) é o MESMO pino e não deve repetir consulta nem poluir o relatório.
# Já uma versão secundária LITERAL é software empacotado independente e entra
# no gate — foi assim que mathlibs-glibc deixou MPC 1.3.1 sobreviver depois de
# a receita canônica mpc subir para 1.4.1.
fontes_conferiveis() {  # pacote versao "fontes"
    fc_pacote=$1
    fc_versao=$2
    fc_fontes=$3
    fc_indice=0
    for fc_fonte in $fc_fontes; do
        fc_indice=$((fc_indice + 1))
        if [ "$fc_indice" -eq 1 ]; then
            fc_url=$(printf '%s\n' "$fc_fonte" |
                sed "s/\${VERSION}/$fc_versao/g; s/\$VERSION/$fc_versao/g")
            printf '%s|%s|%s|\n' "$fc_pacote" "$fc_versao" "$fc_url"
            continue
        fi
        case "$fc_fonte" in
            *'$VERSION'*|*'${VERSION}'*) continue ;;
        esac
        fc_info=$(versao_fixa_da_fonte "$fc_fonte")
        if [ -n "$fc_info" ]; then
            fc_componente=${fc_info%%|*}
            fc_pin=${fc_info#*|}
            printf '%s/%s|%s|%s|\n' \
                "$fc_pacote" "$fc_componente" "$fc_pin" "$fc_fonte"
        else
            printf '%s/fonte-%s||%s|versão fixa não reconhecida na fonte secundária\n' \
                "$fc_pacote" "$fc_indice" "$fc_fonte"
        fi
    done
}

# A ressalva da P7 é governança auditável, não apenas a existência de um
# arquivo-sentinela. Exija motivo e uma data ISO em qualquer linha do arquivo;
# assim um pino esquecido não permanece verde indefinidamente.
ressalva_pinada() {  # arquivo
    [ -f "$1" ] || return 1
    rp_motivo=$(grep -v '^#' "$1" | grep -v '^[[:space:]]*$' | head -1)
    [ -n "$rp_motivo" ] || return 1
    grep -Eq '(^|[^0-9])[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])([^0-9]|$)' "$1" ||
        return 1
    printf '%s\n' "$rp_motivo"
}

# Busca com cache. A chave é o sha256 da URL — nomes de arquivo derivados da URL
# esbarram em '/' e em limite de tamanho.
busca() {
    url=$1
    chave=$(printf '%s' "$url" | sha256sum | cut -d' ' -f1)
    if [ -f "$CACHE/$chave" ]; then
        cat "$CACHE/$chave"
        return 0
    fi
    # O código HTTP é guardado porque "o upstream não deu resposta legível" e "a
    # consulta nem chegou lá" são problemas DIFERENTES, e por três rodadas eles
    # apareceram na mesma lista: o 403 de limite de taxa do GitHub some sozinho
    # e é do dia, um índice ilegível é defeito DESTA ferramenta e não some. Foi
    # o que fez a lista de não conferidos mudar de composição entre rodadas sem
    # que nada tivesse mudado na árvore — e uma lista que muda sozinha não dá
    # para agir em cima.  000 = nem resposta houve (DNS, timeout, conexão).
    codigo=$(curl -fsSL --max-time "$ESPERA" -H 'User-Agent: distropica-versoes' \
                  -w '%{http_code}' -o "$CACHE/$chave.tmp" "$url" 2>/dev/null)
    if [ "$?" -eq 0 ]; then
        mv "$CACHE/$chave.tmp" "$CACHE/$chave"
        cat "$CACHE/$chave"
        return 0
    fi
    rm -f "$CACHE/$chave.tmp"
    printf '%s %s\n' "${codigo:-000}" "$url" >> "$FALHAS"
    return 1
}

# Maior versão de uma lista, por ordenação de versão. Descarta o que tiver cara
# de pré-lançamento: a P7 é EDGE, não bleeding edge — nada de rc, beta, alpha,
# pre ou snapshot de git.
maior() {
    grep -vE '(^|[-.])(rc|alpha|beta|pre|dev|snapshot|nightly)[-.0-9]*$' |
        # o sufixo de patch do OpenSSH ('10.4p1') é versão estável, não
        # pré-lançamento — recusá-lo punha o openssh em "não conferido". E a
        # letra pode vir SOZINHA: o tmux lança 3.7, 3.7a, 3.7b, e exigir dígito
        # depois dela matava o 3.7b — sobrava o 3.7, mais VELHO que o pinado, e
        # o tmux caía em "não conferido" com a árvore já atual. Uma letra só,
        # que é o que distingue '3.7b' de '1.2.3rc'.
        grep -E '^[0-9]+(\.[0-9]+)*([a-z][0-9]*)?$' |
        sort -V | tail -1
}

# FILTRA CANDIDATOS, e cada regra tem uma origem diferente de autoridade.
#
# Três esquemas convivem nos upstreams desta árvore, e eu errei ao tratá-los
# como um só. As correções vieram todas de olhar os dados de cada projeto:
#
#   glib      2.88.2 2.88.3 2.89.0 ... 2.89.3     minor ímpar = desenvolvimento
#   wayland   1.24.0 1.24.91 1.25.0 1.25.91 1.26.0   micro >= 90 = rc do minor+1
#   libdrm    2.4.130 ... 2.4.134                 nenhum dos dois; só conta
#   minicom   2.9 2.10 2.11 2.11.1                nenhum dos dois; só conta
#
# O wayland desfaz a leitura ingênua: 1.25.0 é RELEASE, com minor ímpar, e é o
# 1.25.91 que é rc — de 1.26. Aplicar "minor ímpar = dev" ali descartaria uma
# versão estável. E aplicar "micro >= 90 = rc" ao libdrm descarta o 2.4.134, que
# é o topo da série.
#
# Daí as três regras terem fontes distintas:
#
#   MAGNITUDE — vale para todos, e não é convenção: um candidato cujo primeiro
#   componente tem muito mais dígitos que o pinado é tag de data no meio das
#   tags de versão. Foi o 20021030 "atualizando" o fontconfig 2.18.1.
#
#   MINOR ÍMPAR — vale por FAMÍLIA: GNOME e Perl, os dois que esta árvore usa.
#   Os números não distinguem "2.89 é dev do glib" de "2.11 é release do
#   minicom", e nenhum dos dois publica o fato de forma legível — no GNOME há
#   LATEST-IS-2.88.3 dentro da série 2.88, mas nada diz qual série é estável.
#
#   A lista de famílias cresce por DESCOBERTA, e cada entrada custou um erro: o
#   Perl entrou porque o conferidor mandou a árvore para o 5.45.1, que é série
#   de desenvolvimento — o CPAN lista 5.43.x e 5.45.x ao lado do 5.44.0 estável.
#
#   MICRO >= 90 — no GNOME é pré-release declarado pela família; o librsvg
#   2.62.90, por exemplo, anuncia dentro do próprio NEWS a crate 2.63.0-beta.0.
#   Fora do GNOME só vale quando os dados provam: X.Y.Z com Z >= 90 é rc se
#   existir candidato X.(Y+1).*. É o que separa o wayland 1.25.91 (existe
#   1.26.0) do libdrm 2.4.134 (não existe 2.5.x).
filtra_candidatos() {  # versao_pinada [gnome]
    awk -F. -v pin="$1" -v gnome="${2:-nao}" '
        {
            linha[++n] = $0
            split($0, v, ".")
            if (v[1] != "" && v[2] != "") maior_minor[v[1]] = \
                (v[2] + 0 > maior_minor[v[1]] + 0) ? v[2] + 0 : maior_minor[v[1]] + 0
        }
        END {
            split(pin, p, ".")
            digitos_pin = length(p[1])
            usa_impar = (gnome == "sim" && p[2] != "" && p[2] % 2 == 0)
            for (i = 1; i <= n; i++) {
                split(linha[i], v, ".")
                if (length(v[1]) > digitos_pin + 1) continue
                if (usa_impar && v[2] != "" && v[2] % 2 == 1) continue
                # GNOME declara .90 como pré-release; nas outras famílias a
                # inferência só vale quando existe minor acima no mesmo major.
                if (v[3] != "" && v[3] + 0 >= 90 && \
                    (gnome == "sim" || maior_minor[v[1]] + 0 > v[2] + 0)) continue
                print linha[i]
            }
        }'
}

# NORMALIZA UM NOME DE TAG PARA UMA VERSÃO, e cada regra aqui veio de um caso
# real que o script leu errado contra a árvore.
#
#   R_2_8_2        expat: versão inteira em underscores, prefixada por letra
#   pcre2-10.47    o NOME do projeto tem dígito, e um strip de [A-Za-z_-]* não
#                  o alcança — a versão saía como "pcre2-10.47"
#   xkbcommon-1.14.0-beta1   prefixo com hífen, e sufixo de pré-lançamento
#   libdrm-2.4.134           prefixo com hífen, caso comum
#   v1.26.0                  prefixo de uma letra
normaliza_tag() {
    # `jpeg-10` no libjpeg-turbo nomeia a compatibilidade com a série IJG,
    # não uma versão 10 do projeto. Preserve-o como texto não numérico para o
    # `maior` rejeitar, em vez de promover 3.2.0 para um falso 10.
    sed -e 's/^jpeg-\([0-9]\)/jpegABI\1/' |
        sed -e 's/^[vV]\([0-9]\)/\1/' |
        # versão toda em underscores atrás de um prefixo alfabético (R_2_8_2)
        sed -e 's/^[A-Za-z][A-Za-z]*_\([0-9][0-9_]*\)$/\1/' -e '/^[0-9][0-9_]*$/ s/_/./g' |
        # o Little CMS usa especificamente `lcms2.19.1`. Não generalize para
        # qualquer palavra colada a dígito: tags históricas como `beta4` (expat)
        # e `testCI3` (exiv2) não são versões, e viravam falsos 4 e 3.
        sed -e 's/^lcms\([0-9][0-9.]*\)$/\1/' |
        # prefixo <nome>- onde o nome pode conter dígitos; repete até a string
        # começar por dígito, o que resolve pcre2- e xkbcommon- de uma vez
        sed -e ':a' -e 's/^[^0-9][^-]*-//' -e 'ta' |
        # o json-c sufixa a data da publicação à versão da ABI
        sed -e 's/^\([0-9][0-9.]*\)-[0-9]\{8\}$/\1/' |
        # sufixo '-stable' do libevent (release-2.1.13-stable). SÓ este: os
        # irmãos '-alpha', '-beta' e '-rc' TÊM de sobreviver até o `maior`, que
        # é quem os recusa. Apagá-los aqui promoveria o 2.2.2-alpha a estável.
        sed -e 's/-stable$//'
}

# ---------------------------------------------------------------------------
# Tratadores por upstream. Cada um imprime a versão estável mais nova, ou nada.
# ---------------------------------------------------------------------------

de_github() {   # url, versao pinada
    caminho=$(printf '%s' "$1" | sed -n 's|^https\?://github\.com/\([^/]*\)/\([^/]*\)/.*|\1/\2|p')
    [ -n "$caminho" ] || return 1
    # A API de releases devolve o mais novo NÃO pré-lançamento. Onde o projeto
    # não usa releases, cai nas tags.
    # A tag do release passa pelo MESMO normalizador e pelo MESMO filtro das
    # tags soltas. A primeira versão normalizava só o caminho de fallback, e o
    # resultado foi o script mandando atualizar o expat 2.8.2 para "R_2_8_2" e o
    # pcre2 10.47 para "pcre2-10.47" — a própria versão pinada, com o nome da
    # tag em volta.
    # Nem todo projeto promove a tag estável mais nova a GitHub Release. O
    # mypaint-brushes, por exemplo, ainda marcava 1.3.1 como `latest` embora a
    # tag estável 2.0.2 e seu tarball oficial existissem. Compare as duas
    # autoridades, em vez de só consultar tags quando `releases/latest` falha.
    v_release=$(busca "https://api.github.com/repos/$caminho/releases/latest" |
        sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
    # O feed público não consome a cota anônima da API. Consultar também
    # `/tags?per_page=100` dobrava as requisições e esgotava o limite de 60 no
    # meio de uma árvore de 170 receitas. O href carrega o nome exato da tag.
    v_tags=$(busca "https://github.com/$caminho/tags.atom" |
        grep -oE 'href="[^"]*/releases/tag/[^"]+' |
        sed 's|.*/releases/tag/||')
    # Respostas JSON não são obrigadas a terminar em newline. Sem este printf,
    # `1.10.8` do latest e `1.10.8` das tags viravam `1.10.81.10.8`.
    v=$(printf '%s\n%s\n' "$v_release" "$v_tags" |
        normaliza_tag | filtra_candidatos "$2" | maior)
    printf '%s' "$v"
}

# A SÉRIE PINADA NA URL LIMITA OS CANDIDATOS, e isto não é detalhe do GNOME: é
# como esta árvore expressa "quero o GTK 3, não o GTK 4". A receita gtk3 aponta
# para .../sources/gtk/3.24/gtk-3.24.52.tar.xz, e o cache.json do pacote `gtk`
# traz TODAS as séries — sem a restrição, o script mandava atualizar o gtk3 para
# 4.22.4, que nesta árvore é outro pacote, com outra receita.
serie_da_url() {  # url
    printf '%s' "$1" | sed -n 's|.*/sources/[^/]*/\([0-9][0-9.]*\)/.*|\1|p'
}

de_gnome() {    # url, versao pinada, todas_as_series [sim|nao]
    pkg=$(printf '%s' "$1" | sed -n 's|.*/sources/\([^/]*\)/.*|\1|p')
    [ -n "$pkg" ] || return 1
    serie=$(serie_da_url "$1")
    # Uma ressalva `versao-pinada` só tem valor se for comparada com o topo
    # estável real. gexiv2 0.14.7, por exemplo, fica em /0.14/ porque o GIMP
    # recusa >=0.15, enquanto o upstream já está em 0.16.2. Sem abrir as séries
    # nesse caso, o gate chamava o pino conhecido de "atual".
    [ "${3:-nao}" = sim ] && serie=
    busca "https://download.gnome.org/sources/$pkg/cache.json" |
        tr ',' '\n' | grep -oE '"[0-9]+(\.[0-9]+)*"' | tr -d '"' |
        awk -v serie="$serie" \
            'serie == "" || $0 == serie || index($0, serie ".") == 1' |
        filtra_candidatos "$2" sim | maior
}

de_pypi() {     # url
    pkg=$(printf '%s' "$1" | sed -n 's|.*/packages/source/./\([^/]*\)/.*|\1|p')
    [ -n "$pkg" ] || pkg=$(printf '%s' "$1" | sed -n 's|.*/\([A-Za-z0-9_.-]*\)-[0-9].*|\1|p')
    [ -n "$pkg" ] || return 1
    busca "https://pypi.org/pypi/$pkg/json" |
        sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1
}

de_gitlab_fdo() {  # url, versao pinada
    proj=$(printf '%s' "$1" | sed -n 's|^https\?://gitlab\.freedesktop\.org/\([^/]*\)/\([^/]*\)/.*|\1%2F\2|p')
    [ -n "$proj" ] || return 1
    busca "https://gitlab.freedesktop.org/api/v4/projects/$proj/repository/tags?per_page=100" |
        grep -oE '"name":"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/' |
        sed 's/^[vV]//; s/^[A-Za-z_-]*-//' | filtra_candidatos "$2" | maior
}

de_kernel_org() {  # url
    case "$1" in
        # O releases.json vem indentado em várias linhas, e um sed de uma linha
        # não o lê — foi assim que o kernel caiu em "não conferido" no primeiro
        # ensaio, justamente o pacote que motivou este script. Achatar antes de
        # casar resolve sem precisar de um analisador de JSON.
        # '/pub/linux/kernel/v' e nao '*linux-*': o linux-firmware mora no
        # mesmo host e casava com o padrao largo, recebendo a versao do KERNEL
        # como se fosse a sua — 7.1.8 contra um pino de 20260622.
        */pub/linux/kernel/v*)
            busca 'https://www.kernel.org/releases.json' | tr -d ' \n' |
                sed -n 's/.*"latest_stable":{"version":"\([^"]*\)".*/\1/p' | head -1 ;;
        *) de_listagem "$1" ;;
    esac
}

# O caminho GENÉRICO, e o que cobre mais receitas: pega o diretório-pai da URL,
# lista, e procura o maior '<nome>-<versão>.tar.*'. Serve para ftp.gnu.org,
# x.org, netfilter, tcpdump, alsa, cairo, busybox e a maioria dos tarballs
# clássicos.
# O Perl usa o mesmo esquema do GNOME e não está no download.gnome.org: o CPAN
# lista 5.43.x e 5.45.x (desenvolvimento) ao lado do 5.44.0 (estável). Sem esta
# entrada o conferidor mandava a árvore para o 5.45.1, uma série de
# desenvolvimento, que a P7 proíbe com todas as letras.
de_cpan() {  # url, versao pinada
    dir=${1%/*}/
    busca "$dir" |
        grep -oE 'perl-[0-9]+(\.[0-9]+)+\.tar\.[a-z]+' |
        sed 's/^perl-//; s/\.tar\..*$//' |
        filtra_candidatos "$2" sim | maior
}

de_listagem() {  # url
    dir=${1%/*}/
    base=$(basename "$1")
    # o nome do pacote é tudo antes do primeiro '-<dígito>'
    nome=$(printf '%s' "$base" | sed -n 's/^\(.*\)-[0-9].*/\1/p')
    [ -n "$nome" ] || return 1
    busca "$dir" |
        grep -oE "$nome-[0-9][0-9A-Za-z.]*\.(tar\.[a-z0-9]+|tgz|zip)" |
        sed "s/^$nome-//; s/\.\(tar\..*\|tgz\|zip\)$//" |
        maior
}

# O URL do elfutils contém a própria versão como diretório. Consultar apenas o
# pai do tarball confina a busca à versão já pinada e produz um falso "atual".
# A autoridade que enumera releases é um nível acima: 0.193/, 0.194/, 0.195/…
de_elfutils() {
    busca 'https://sourceware.org/elfutils/ftp/' |
        grep -oE 'href="[0-9]+(\.[0-9]+)+/"' |
        sed 's/^href="//; s|/"$||' | maior
}

de_go() {
    busca 'https://go.dev/dl/?mode=json' |
        grep -oE '"go[0-9]+(\.[0-9]+)+"' | tr -d '"' | sed 's/^go//' | maior
}

de_zig() {
    busca 'https://ziglang.org/download/index.json' |
        grep -oE '"[0-9]+\.[0-9]+\.[0-9]+"' | tr -d '"' | maior
}

# O canal estavel do Rust e um TOML, e a versao que interessa esta no bloco
# [pkg.rust] — nao no `version` do topo, que e o formato do arquivo.
de_rust() {
    busca 'https://static.rust-lang.org/dist/channel-rust-stable.toml' |
        awk '/^\[pkg\.rust\]/{d=1;next} d && /^version *=/{
                 gsub(/[^0-9.]/," "); split($0,a," "); print a[1]; exit }'
}

# O best_release.json do SourceForge devolve o caminho do arquivo recomendado;
# a versao sai do proprio caminho.
de_sourceforge() {  # url
    proj=$(printf '%s' "$1" | sed -n 's|.*sourceforge\.net/projects/\([^/]*\)/.*|\1|p')
    [ -n "$proj" ] || proj=$(printf '%s' "$1" | sed -n 's|.*downloads\.sourceforge\.net/\([^/]*\)/.*|\1|p')
    [ -n "$proj" ] || return 1
    busca "https://sourceforge.net/projects/$proj/best_release.json" |
        grep -oE '"filename": *"[^"]*"' | head -1 |
        grep -oE '/[0-9]+(\.[0-9]+)+/' | tr -d '/' | maior
}

de_sourcehut() {  # url
    caminho=$(printf '%s' "$1" | sed -n 's|^https\?://git\.sr\.ht/\(~[^/]*/[^/]*\)/.*|\1|p')
    [ -n "$caminho" ] || return 1
    busca "https://git.sr.ht/$caminho/refs" |
        grep -oE 'refs/[0-9]+(\.[0-9]+)+' | sed 's|refs/||' | maior
}

de_cgit() {  # url
    raiz=$(printf '%s' "$1" | sed -n 's|^\(https\?://[^/]*/[^/]*\)/.*|\1|p')
    [ -n "$raiz" ] || return 1
    busca "$raiz/refs/tags" |
        grep -oE '>v?[0-9]+(\.[0-9]+)+<' | tr -d '><v' | maior
}

# Qualquer GitLab: o caminho do projeto sai da URL, e as tags da API.
de_gitlab() {  # url, versao pinada
    host=$(printf '%s' "$1" | sed -n 's|^https\?://\([^/]*\)/.*|\1|p')
    proj=$(printf '%s' "$1" | sed -n 's|^https\?://[^/]*/\([^/]*\)/\([^/]*\)/.*|\1%2F\2|p')
    # A API generic-packages traz o id numerico no lugar do caminho.
    id=$(printf '%s' "$1" | sed -n 's|.*/api/v4/projects/\([0-9]*\)/.*|\1|p')
    [ -n "$id" ] && proj=$id
    [ -n "$proj" ] || return 1
    busca "https://$host/api/v4/projects/$proj/repository/tags?per_page=100" |
        grep -oE '"name":"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/' |
        normaliza_tag | filtra_candidatos "$2" | maior
}

# O cacert.pem carrega a data de extracao no cabecalho, e e essa data que a
# receita pina como VERSION.
de_curl_ca() {
    busca 'https://curl.se/ca/cacert.pem' | head -8 |
        sed -n 's/.*as of: \(.*\) GMT.*/\1/p' | head -1 |
        while read -r d; do date -u -d "$d" +%Y-%m-%d 2>/dev/null; done
}

de_busybox_bin() {
    busca 'https://www.busybox.net/downloads/binaries/' |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+-x86_64-linux-musl' |
        sed 's/-x86_64.*//' | maior
}

# A listagem dentro de /releases/$VERSION só consegue devolver a própria
# versão e chamaria qualquer ESR pinado de "atual". A Mozilla publica a linha
# rápida estável num índice primário legível; compare contra ela para que um
# `versao-pinada` de ESR apareça como a ressalva que de fato é.
de_mozilla_firefox() {
    busca 'https://product-details.mozilla.org/1.0/firefox_versions.json' |
        sed -n 's/^[[:space:]]*"LATEST_FIREFOX_VERSION":[[:space:]]*"\([^"]*\)".*/\1/p' |
        head -1
}

upstream_de() {  # url, versao pinada
    case "$1" in
        *mozilla.net/pub/firefox/releases/*|*mozilla.org/pub/firefox/releases/*)
                                      de_mozilla_firefox ;;
        *sourceware.org/elfutils/ftp/*) de_elfutils ;;
        *github.com/*)               de_github "$1" "$2" ;;
        *download.gnome.org/*)       de_gnome "$1" "$2" "${3:-nao}" ;;
        *pypi.org/*|*files.pythonhosted.org/*) de_pypi "$1" ;;
        *gitlab.*|*salsa.debian.org/*) de_gitlab "$1" "$2" ;;
        *kernel.org/*)               de_kernel_org "$1" ;;
        *dl.google.com/go/*)         de_go ;;
        *ziglang.org/*)              de_zig ;;
        *static.rust-lang.org/*)     de_rust ;;
        *sourceforge.net/*)          de_sourceforge "$1" ;;
        *git.sr.ht/*)                de_sourcehut "$1" ;;
        *git.zx2c4.com/*)            de_cgit "$1" ;;
        *curl.se/ca/*)               de_curl_ca ;;
        *busybox.net/downloads/binaries/*) de_busybox_bin ;;
        *cpan.org/src/*)             de_cpan "$1" "$2" ;;
        *)                           de_listagem "$1" ;;
    esac
}

# ---------------------------------------------------------------------------

atrasados=
naoconferidos=
falhou=
pinados=
atuais=0
[ -n "$TSV" ] && printf '# pacote\tpinada\tupstream\tveredito\tmotivo\n' > "$TSV"

for receita in "$REPO"/newspeak/*/recipe; do
    pacote=$(basename "$(dirname "$receita")")
    versao_receita=$(grep -m1 '^VERSION=' "$receita" | cut -d= -f2- | tr -d '"')
    src=$(campo "$receita" SRC)

    if [ -z "$versao_receita" ] || [ -z "$src" ]; then
        veredito='-'; nova='-'; motivo='receita de montagem, sem fonte upstream'
        [ -n "$TSV" ] && printf '%s\t%s\t%s\t%s\t%s\n' \
            "$pacote" "${versao_receita:--}" "-" "$veredito" "$motivo" >> "$TSV"
        continue
    fi

    fontes=$(fontes_conferiveis "$pacote" "$versao_receita" "$src")
    while IFS='|' read -r rotulo versao url erro_fonte; do
        [ -n "$rotulo" ] || continue
        decl="$REPO/newspeak/$pacote/versao-pinada"
        motivo=
        nova=
        if [ -n "$erro_fonte" ]; then
            # Fonte fixa que o extrator não entende não some em silêncio. É
            # software no payload sem versão auditada, portanto o gate fecha.
            veredito='?'
            motivo=$erro_fonte
            naoconferidos="$naoconferidos $rotulo"
        else
            : > "$FALHAS"
            todas_series=nao
            [ -f "$decl" ] && todas_series=sim
            nova=$(upstream_de "$url" "$versao" "$todas_series" 2>/dev/null | head -1)
            if [ -z "$nova" ]; then
                # A falha só vale quando o handler NÃO produziu resposta. O
                # `de_github` tenta releases/latest e cai nas tags: em projeto
                # sem releases aquele 404 é caminho normal, não avaria.
                if [ -s "$FALHAS" ]; then
                    veredito='!'
                    motivo="consulta falhou (HTTP $(cut -d' ' -f1 "$FALHAS" | sort -u | tr '\n' '/' | sed 's|/$||'))"
                    falhou="$falhou $rotulo"
                else
                    veredito='?'
                    naoconferidos="$naoconferidos $rotulo"
                fi
            elif [ "$nova" = "$versao" ]; then
                veredito=atual
                atuais=$((atuais + 1))
            elif [ "$(printf '%s\n%s\n' "$versao" "$nova" | sort -V | tail -1)" = "$versao" ]; then
                # Pinado maior que o índice: índice incompleto ou nome inferido
                # errado. Não é legítimo promover isso a "atual".
                veredito='?'
                naoconferidos="$naoconferidos $rotulo"
            elif motivo=$(ressalva_pinada "$decl"); then
                veredito=pinado
                pinados="$pinados $rotulo"
            else
                veredito=atrasado
                if [ -f "$decl" ]; then
                    motivo='ressalva sem motivo ou data ISO válida'
                fi
                atrasados="$atrasados $rotulo"
            fi
        fi

        [ -n "$TSV" ] && printf '%s\t%s\t%s\t%s\t%s\n' \
            "$rotulo" "${versao:--}" "${nova:--}" "$veredito" "$motivo" >> "$TSV"
        if [ "$SO_PROBLEMAS" = no ] || [ "$veredito" != atual ]; then
            printf '  %-9s %-22s %-14s %s\n' \
                "$veredito" "$rotulo" "${versao:--}" "${nova:-—}"
        fi
    done <<EOF
$fontes
EOF
done

echo
printf 'atual: %d\n' "$atuais"
if [ -n "$pinados" ]; then
    printf 'pinado com motivo registrado:%s\n' "$pinados"
fi
if [ -n "$atrasados" ]; then
    printf 'ATRASADO, sem ressalva:%s\n' "$atrasados"
fi
# LISTADO POR NOME, e não somado. Ver o cabeçalho: é a categoria que finge
# cobertura quando vira número.
if [ -n "$naoconferidos" ]; then
    printf 'NAO CONFERIDO — o upstream não deu resposta legível:%s\n' "$naoconferidos"
fi
# Separada da de cima de propósito: esta some ao rodar de novo mais tarde, a de
# cima não. Juntá-las fazia parecer que a ferramenta tinha 23 buracos quando
# tinha 8 buracos e 15 consultas recusadas naquele minuto.
if [ -n "$falhou" ]; then
    printf 'CONSULTA FALHOU — não chegou ao upstream, tente de novo:%s\n' "$falhou"
fi
[ -n "$TSV" ] && echo "relatório: $TSV"

if [ -n "$naoconferidos" ] || [ -n "$falhou" ]; then exit 2; fi
if [ -n "$atrasados" ]; then exit 1; fi
exit 0
