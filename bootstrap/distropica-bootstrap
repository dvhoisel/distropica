#!/bin/sh
# Casca pública de desenvolvimento. O bundle de release substituirá o Cargo
# por binários estáticos assinados e verificados; a lógica de instalação/mídia
# vive no minipax.
set -eu
umask 022
LC_ALL=C
export LC_ALL

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUILD_TARGET=${DISTROPICA_TARGET_DIR:-"$REPO/target/bootstrap"}
RUST_TARGET=x86_64-unknown-linux-musl
RUSTC_BIN=${RUSTC:-rustc}
MINIPAX_BIN=${MINIPAX:-}
MINITRUE_BIN=${MINITRUE:-}

canonical_executable() {
    name=$1
    path=$2
    [ -f "$path" ] && [ -x "$path" ] || {
        echo "erro: $name não é arquivo regular executável: $path" >&2
        exit 1
    }
    directory=$(CDPATH= cd -- "$(dirname -- "$path")" && pwd -P)
    printf '%s/%s\n' "$directory" "$(basename -- "$path")"
}

require_rust_target() {
    command -v cargo >/dev/null 2>&1 || {
        echo "erro: cargo ausente; instale o toolchain Rust ou forneça MINIPAX e MINITRUE" >&2
        exit 1
    }
    command -v "$RUSTC_BIN" >/dev/null 2>&1 || {
        echo "erro: compilador Rust ausente ($RUSTC_BIN); instale o toolchain ou forneça MINIPAX e MINITRUE" >&2
        exit 1
    }

    if ! target_libdir=$("$RUSTC_BIN" --print target-libdir --target "$RUST_TARGET" 2>/dev/null); then
        echo "erro: o toolchain Rust ativo não consegue consultar o alvo $RUST_TARGET" >&2
        echo "verifique o toolchain ativo ou forneça MINIPAX e MINITRUE" >&2
        exit 1
    fi
    target_available=no
    if [ -n "$target_libdir" ] && [ -d "$target_libdir" ]; then
        for rustlib in "$target_libdir"/libstd-*.rlib; do
            if [ -f "$rustlib" ]; then
                target_available=yes
                break
            fi
        done
    fi
    [ "$target_available" = yes ] || {
        echo "erro: alvo Rust $RUST_TARGET ausente no toolchain ativo" >&2
        echo "instale-o com 'rustup target add $RUST_TARGET' ou forneça MINIPAX e MINITRUE" >&2
        exit 1
    }
}

configure_musl_cc() {
    if [ -n "${CC_x86_64_unknown_linux_musl:-}" ] || \
       [ -n "${TARGET_CC:-}" ] || [ -n "${CC:-}" ] || \
       [ -n "${CROSS_COMPILE:-}" ]; then
        return
    fi

    if command -v x86_64-linux-musl-gcc >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v x86_64-linux-musl-gcc)
    elif command -v musl-gcc >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v musl-gcc)
    elif command -v clang >/dev/null 2>&1; then
        CC_x86_64_unknown_linux_musl=$(command -v clang)
    else
        echo "erro: compilador C para $RUST_TARGET ausente; ele é necessário para construir o Minitrue" >&2
        echo "instale um cross-compiler musl/clang, defina CC_x86_64_unknown_linux_musl ou forneça MINITRUE" >&2
        exit 1
    fi
    export CC_x86_64_unknown_linux_musl
}

build_rust_binary() {
    package=$1
    destination=$BUILD_TARGET/$package
    cargo_feature_flags=
    [ "$package" != minitrue ] || cargo_feature_flags=--no-default-features
    CARGO_TARGET_DIR="$destination" \
        cargo build --locked --release --quiet --target "$RUST_TARGET" \
        $cargo_feature_flags --manifest-path "$REPO/$package/Cargo.toml"
    binary=$destination/$RUST_TARGET/release/$package
    chmod 755 "$binary"
    printf '%s\n' "$binary"
}

require_elf_inspector() {
    command -v readelf >/dev/null 2>&1 || {
        echo "erro: readelf ausente; ele é necessário para validar os builds musl" >&2
        exit 1
    }
}

require_no_interp() {
    path=$1
    elf_header=$(readelf -h "$path" 2>/dev/null) || {
        echo "erro: build não produziu um ELF válido: $path" >&2
        exit 1
    }
    printf '%s\n' "$elf_header" | grep -q 'Machine:.*X86-64' || {
        echo "erro: build não produziu ELF x86-64: $path" >&2
        exit 1
    }
    printf '%s\n' "$elf_header" | grep -Eq 'Type:[[:space:]]+(EXEC|DYN)' || {
        echo "erro: build não produziu ELF executável/PIE: $path" >&2
        exit 1
    }
    program_headers=$(readelf -l "$path" 2>/dev/null) || {
        echo "erro: não li os program headers ELF: $path" >&2
        exit 1
    }
    if printf '%s\n' "$program_headers" | grep -q 'INTERP'; then
        echo "erro: build para $RUST_TARGET produziu binário com INTERP: $path" >&2
        exit 1
    fi
}

if [ -n "$MINIPAX_BIN" ]; then
    MINIPAX_BIN=$(canonical_executable MINIPAX "$MINIPAX_BIN")
fi
if [ -n "$MINITRUE_BIN" ]; then
    MINITRUE_BIN=$(canonical_executable MINITRUE "$MINITRUE_BIN")
fi

if [ -z "$MINIPAX_BIN" ] || [ -z "$MINITRUE_BIN" ]; then
    require_rust_target
    require_elf_inspector
    mkdir -p "$BUILD_TARGET"
    BUILD_TARGET=$(CDPATH= cd -- "$BUILD_TARGET" && pwd -P)

    if [ -z "$MINIPAX_BIN" ]; then
        MINIPAX_BIN=$(build_rust_binary minipax)
        require_no_interp "$MINIPAX_BIN"
    fi
    if [ -z "$MINITRUE_BIN" ]; then
        configure_musl_cc
        MINITRUE_BIN=$(build_rust_binary minitrue)
        require_no_interp "$MINITRUE_BIN"
    fi
fi

MINIPAX=$MINIPAX_BIN
MINITRUE=$MINITRUE_BIN
export MINITRUE
export DISTROPICA_NEWSPEAK=${DISTROPICA_NEWSPEAK:-"$REPO/newspeak"}
exec "$MINIPAX" "$@"
