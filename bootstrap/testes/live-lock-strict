mkdir "$OUTER/out-proof-bad"
chmod 0700 "$OUTER/out-proof-bad"
if invoke_outer "$FAKE_RUNNER" "$outer_runner_sha" "$ABC" \
    "$OUTER/out-proof-bad/BOOTX64.EFI" "$OUTER/work-proof-bad" \
