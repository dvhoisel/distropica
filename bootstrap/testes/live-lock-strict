# Failpoints próprios da recuperação: journal reaberto, quarteto reconciliado
# e cauda vazia depois do último unlink persistente.
recovery_case() { # nome primeiro-ponto ponto-de-retry
    recovery_name=$1; first_point=$2; retry_point=$3
    recovery_dir=$TMP/recovery-$recovery_name
    mkdir "$recovery_dir"; chmod 0700 "$recovery_dir"
    set +e
    "$HELPER" publish "$TMP/a/efi" "$TMP/a/components" "$TMP/a/runner" \
        "$TMP/a/embed" "$TMP/a/lock" "$recovery_dir/BOOTX64.EFI" \
        --failpoint "$first_point" >/dev/null 2>&1
    first_status=$?
    "$HELPER" publish "$TMP/a/efi" "$TMP/a/components" "$TMP/a/runner" \
        "$TMP/a/embed" "$TMP/a/lock" "$recovery_dir/BOOTX64.EFI" \
        --failpoint "$retry_point" >/dev/null 2>&1
    retry_status=$?
    set -e
    if [ "$first_status" -ne 137 ] || [ "$retry_status" -ne 137 ]; then
        fail "failpoint de recuperação $recovery_name não deu SIGKILL real"
        return
    fi
    if "$HELPER" publish "$TMP/a/efi" "$TMP/a/components" "$TMP/a/runner" \
        "$TMP/a/embed" "$TMP/a/lock" "$recovery_dir/BOOTX64.EFI" &&
       [ ! -e "$recovery_dir/.BOOTX64.EFI.live-publish" ]; then
        ok "recuperação persiste $retry_point e converge"
    else
        fail "recuperação não convergiu após $retry_point"
    fi
}
