        "$OUTER/work-marker-$marker_case" "$OUTER/log-marker-$marker_case" \
        >"$TMP/bad/outer-marker-$marker_case.log" 2>&1; then
        fail "release aceitou marker $marker_case antes da fase 1"
    else
        ok "release recusa marker $marker_case antes da fase 1"
    fi
    unset FIXTURE_MARKER_MUTATION
done

mkdir "$OUTER/out-work-swap"
chmod 0700 "$OUTER/out-work-swap"
FIXTURE_SWAP_WORK=yes
