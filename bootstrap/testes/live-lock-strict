unset FIXTURE_MUTATE_ROOTFS
rm -f "$OUTER/rootfs/mutated-after-preflight"

cat > "$OUTER/lying-helper" <<'EOF'
#!/bin/sh
# Deliberadamente ignora --self-sha256: isso prova por que a autenticação é
# responsabilidade anterior do pipeline, não uma propriedade autorreferente.
printf '%s\n' "$FIXTURE_ROOT_SHA"
exit 0
EOF
chmod 0700 "$OUTER/lying-helper"
lying_helper_sha=$(sha256sum "$OUTER/lying-helper" | awk '{print $1}')
if [ "$lying_helper_sha" != "$helper_pin" ]; then
    ok 'âncora externa rejeita helper mentiroso antes de invocar build-efi'
else
    fail 'fixture de helper mentiroso colidiu com pin autorizado'
fi

# Prebuilt é atribuição exclusiva de development; o launcher release nem
# aceita a opção legada.
must_fail 'release recusa BusyBox prebuilt antes do builder' "$BUILDER" \
    --mode release --busybox "$TMP/a/efi"

# Applets usados pelo init/udhcpc e configuração estática versionada.
for mapping in \
    ash:ASH awk:AWK basename:BASENAME blockdev:BLOCKDEV cat:CAT chmod:CHMOD \
    chpasswd:CHPASSWD cp:CP cryptpw:CRYPTPW cttyhack:CTTYHACK cut:CUT dd:DD \
    dirname:DIRNAME echo:ECHO findfs:FINDFS grep:GREP ifconfig:IFCONFIG ip:IP \
    ln:LN mdev:MDEV mkdir:MKDIR mkfs.vfat:MKFS_VFAT mkswap:MKSWAP \
    mktemp:MKTEMP mount:MOUNT mv:MV partprobe:PARTPROBE printf:PRINTF \
    readlink:READLINK reboot:REBOOT rm:RM route:ROUTE sed:SED setsid:SETSID \
    sh:SH_IS_ASH sha256sum:SHA256SUM sleep:SLEEP stat:STAT stty:STTY \
    switch_root:SWITCH_ROOT sync:SYNC test:TEST tr:TR udhcpc:UDHCPC \
    umount:UMOUNT wc:WC; do
    applet=${mapping%%:*}; symbol=${mapping#*:}
    grep -Fqx "CONFIG_${symbol}=y" "$CONFIG" || fail "BusyBox não fixa $applet"
done
grep -Fqx 'CONFIG_STATIC=y' "$CONFIG" &&
grep -Fqx '# CONFIG_FEATURE_SHARED_BUSYBOX is not set' "$CONFIG" &&
    ok 'BusyBox 1.35.0 versionado exige estático/applets completos'

# ASan+UBSan são apenas instrumentos host; nunca são qualificados como release.
if cc -std=c17 -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer \
    -o "$TMP/bin/live-lock-helper-sanitize" "$SOURCE" >/dev/null 2>&1; then
    SAN=$TMP/bin/live-lock-helper-sanitize
    ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 \
        "$SAN" sha256 "$TMP/a/abc" >/dev/null
    ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 \
        "$SAN" tree-hash "$TMP/tree-a" >/dev/null
    ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 \
        "$SAN" cpio-member "$TMP/a/initramfs.cpio" \
        usr/share/distropica/LIVE_COMPONENTS "$TMP/a/components" >/dev/null
    ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 \
        "$SAN" elf-initramfs "$TMP/a/vmlinux" "$TMP/a/blob" >/dev/null
    ok 'ASan+UBSan passam fixtures SHA/tree/CPIO/ELF válidas'
else
    ok 'ASan+UBSan indisponíveis no host (gate pulado explicitamente)'
fi

if [ "$FAILURES" -ne 0 ]; then
    printf '\n%d falha(s) no lock vivo\n' "$FAILURES" >&2
    exit 1
fi
printf '\nlock vivo estrito: tudo certo\n'
