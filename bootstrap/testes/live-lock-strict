# Renomear o pathname do pai durante uma publicação em curso não muda os fds
# já autenticados. O replacement recebe um sentinela e não pode ser limpo.
parent_swap_base=$TMP/parent-swap
mkdir "$parent_swap_base" "$parent_swap_base/publish"
chmod 0700 "$parent_swap_base" "$parent_swap_base/publish"
"$HELPER" publish "$TMP/a/efi" "$TMP/a/components" "$TMP/a/runner" \
    "$TMP/a/embed" "$TMP/a/lock" "$parent_swap_base/publish/BOOTX64.EFI" \
    --failpoint stop:after-journal-create-parent-fsync \
    >"$TMP/bad/parent-swap.log" 2>&1 &
parent_swap_pid=$!
parent_stopped=no
parent_wait=0
while [ "$parent_wait" -lt 500 ]; do
    if [ -r "/proc/$parent_swap_pid/status" ] &&
       [ "$(sed -n 's/^State:[[:space:]]*\([A-Z]\).*/\1/p' "/proc/$parent_swap_pid/status")" = T ]; then
        parent_stopped=yes
        break
    fi
    kill -0 "$parent_swap_pid" 2>/dev/null || break
    sleep 0.01
    parent_wait=$((parent_wait + 1))
done
if [ "$parent_stopped" != yes ]; then
    fail 'pausepoint não parou publicação para parent-swap'
    kill "$parent_swap_pid" 2>/dev/null || true
    wait "$parent_swap_pid" 2>/dev/null || true
else
    mv "$parent_swap_base/publish" "$parent_swap_base/publish-original"
    mkdir "$parent_swap_base/publish"; chmod 0700 "$parent_swap_base/publish"
    printf replacement > "$parent_swap_base/publish/SENTINEL"
    chmod 0600 "$parent_swap_base/publish/SENTINEL"
    kill -CONT "$parent_swap_pid"
    if wait "$parent_swap_pid" &&
       [ -f "$parent_swap_base/publish-original/BOOTX64.EFI" ] &&
       [ "$(find "$parent_swap_base/publish" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')" -eq 1 ] &&
       [ "$(cat "$parent_swap_base/publish/SENTINEL")" = replacement ]; then
        ok 'parent-swap mantém publicação/fsync/cleanup no fd original'
    else
        fail 'parent-swap tocou replacement ou abandonou o pai original'
    fi
fi

