if roda --artifact "$TMP/emissao-sem-raiz/index" \
    --output "$TMP/bundle-canal-sem-raiz" --cache "$CACHE" \
    --minitrue-root "$ROOT" --strict > "$TMP/bundle-canal-sem-raiz.log" 2>&1; then
    echo '  FALHOU  gate aceitou índice isolado sem prova de raiz release'
    falhas=$((falhas + 1))
elif grep -q 'index/emit.meta v4.*INDEX_SHA256 correspondentes' \
    "$TMP/bundle-canal-sem-raiz.log"; then
    echo '  ok      índice isolado não ganha confiança implícita no gate estrito'
else
    echo '  FALHOU  índice sem emit.meta release não teve diagnóstico útil'
    falhas=$((falhas + 1))
fi

# RELEASE_ROOT sozinho não basta: misturar o index de A com o emit.meta de B
# precisa morrer no vínculo criptográfico antes de produzir qualquer bundle.
mkdir -p "$TMP/emissao-b" "$TMP/emissao-misturada/plans"
{
    printf '%s\n' 'CHANNEL_INDEX_FORMAT=4' 'RELEASE_ROOT=yes'
    printf 'extra 2 x86_64 %s pool/extra-2-x86_64.tar.zst %s %s %s\n' \
        "$zero64" "$one64" "$two64" "$producer_plan_sha"
} > "$TMP/emissao-b/index"
emissao_b_sha=$(sha256sum "$TMP/emissao-b/index" | cut -d' ' -f1)
cat > "$TMP/emissao-b/emit.meta" <<EOF
CHANNEL_EMIT_FORMAT=4
ARCH=x86_64
COMPRESSION=ruzstd-0.8.3-fastest
INDEX_SIGNED=no
INDEX_SHA256=$emissao_b_sha
PRODUCER_PLAN_LOCK_SHA256=$producer_plan_sha
RELEASE_ROOT=yes
EOF
cp "$TMP/emissao-release/index" "$TMP/emissao-misturada/index"
cp "$TMP/emissao-b/emit.meta" "$TMP/emissao-misturada/emit.meta"
cp "$TMP/producer.lock" "$TMP/emissao-misturada/plans/$producer_plan_sha.lock"
if roda --artifact "$TMP/emissao-misturada/index" \
    --output "$TMP/bundle-canal-misturado" --cache "$CACHE" \
    --minitrue-root "$ROOT" --strict > "$TMP/bundle-canal-misturado.log" 2>&1; then
    echo '  FALHOU  gate aceitou index A com emit.meta release de B'
    falhas=$((falhas + 1))
elif grep -q 'INDEX_SHA256/RELEASE_ROOT do emit.meta não corresponde ao index' \
    "$TMP/bundle-canal-misturado.log"; then
    echo '  ok      vínculo INDEX_SHA256 recusa mistura de duas emissões'
else
    echo '  FALHOU  mistura index/emit.meta sem diagnóstico do vínculo'
    falhas=$((falhas + 1))
fi

# O script entra no repositório para arquivar a revisão. Caminhos relativos
# precisam continuar relativos ao cwd do operador, inclusive os dois insumos
# vivos; antes da regressão eles eram reinterpretados a partir de FIXTURE.
mkdir -p "$TMP/outside/a/b"
if (
    cd "$TMP/outside/a/b"
    PATH="$TMP/bin:$PATH" "$FIXTURE/bootstrap/source-bundle" \
        --media ../../../media.iso --output ../../../relativos \
        --cache ../../../cache --minitrue-root ../../../root \
        --minitrue-bin ../../../produtor/minitrue \
        --live-kernel-config ../../../config-live \
        --live-util-linux-tar ../../../arquivo-content-addressed --strict
) > "$TMP/relativos.log" 2>&1 &&
   grep -qx "ARTIFACT_SHA256=$sha_media" "$TMP/relativos/ARTEFATO" &&
   cmp -s "$TMP/config-live" "$TMP/relativos/kernel/config-live" &&
   cmp -s "$TMP/arquivo-content-addressed" \
       "$TMP/relativos/upstream/$util_sha"; then
    echo '  ok      caminhos relativos preservam o cwd anterior ao cd no repo'
else
    echo '  FALHOU  caminhos relativos foram reinterpretados após cd no repo'
    falhas=$((falhas + 1))
fi

if [ "$falhas" -eq 0 ]; then
    echo 'source-bundle/strict: todos os casos passam'
    exit 0
fi
printf 'source-bundle/strict: %d caso(s) falharam\n' "$falhas"
exit 1
