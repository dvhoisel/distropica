#!/bin/sh
# Exercita a guarda real do build-efi sem chegar ao download/build do kernel.
set -eu
umask 077

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
TMP=${TMPDIR:-/tmp}/distropica-teste-chave-efi.$$
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/bin" "$TMP/root/etc" "$TMP/root/tmp" "$TMP/fora"

# O build-efi verifica a presenca do bwrap antes da guarda. Neste teste ele
# nunca sera executado: --work fica de proposito fora do rootfs, que e a
# parada imediatamente posterior a auditoria.
cat > "$TMP/bin/bwrap" <<'EOF'
#!/bin/sh
exit 99
EOF
chmod +x "$TMP/bin/bwrap"

roda() {
    PATH="$TMP/bin:$PATH" "$REPO/bootstrap/live/build-efi" \
        --output "$TMP/BOOTX64.EFI" --rootfs "$TMP/root" \
        --work "$TMP/fora/work" 2>&1
}

# Texto embutido em binario/documentacao nao e chave: o marcador nao ocupa a
# primeira linha inteira. Um link para fora tambem nao embarca o alvo e nao
# pode fazer a busca escapar do rootfs.
printf '%s\n' \
    'prefixo: untrusted comment: minisign encrypted secret key: sufixo' \
    > "$TMP/root/etc/texto-inofensivo"
printf '%s\n' 'untrusted comment: minisign encrypted secret key' \
    > "$TMP/fora/chave-fora"
ln -s "$TMP/fora/chave-fora" "$TMP/root/tmp/link-para-fora"

saida=$(roda || true)
printf '%s\n' "$saida" | grep -q 'o --work precisa estar dentro dele' || {
    echo 'FALHOU: rootfs limpo nao chegou a guarda seguinte' >&2
    printf '%s\n' "$saida" >&2
    exit 1
}
printf '%s\n' "$saida" | grep -q 'chave minisign secreta' && {
    echo 'FALHOU: texto embutido ou symlink virou falso positivo' >&2
    exit 1
}

# Formatos criptografado e sem senha usam cabecalhos distintos. Ambos sao
# segredo, ambos devem parar antes de qualquer trabalho de composicao.
for cabecalho in \
    'untrusted comment: minisign encrypted secret key' \
    'untrusted comment: minisign secret key'; do
    printf '%s\n' "$cabecalho" > "$TMP/root/tmp/canal.key"
    saida=$(roda || true)
    printf '%s\n' "$saida" | grep -q 'chave minisign secreta encontrada' || {
        echo "FALHOU: cabecalho nao recusado: $cabecalho" >&2
        printf '%s\n' "$saida" >&2
        exit 1
    }
    printf '%s\n' "$saida" | grep -q '/tmp/canal.key' || {
        echo 'FALHOU: diagnostico nao nomeou a chave' >&2
        exit 1
    }
done

echo 'build-efi/chave secreta: guarda e falsos positivos passam'
